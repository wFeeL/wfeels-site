---
import '../styles/fonts.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Rail from '../components/Rail.astro';
import BackgroundLine from '../components/BackgroundLine.astro';
import { dict, localeFromPath, type Locale } from '../i18n/locales';
import { showFooterCta } from '../lib/nav';
import { buildMeta, productionSite } from '../lib/seo';
import { pageSchema, serializeSchema, type SchemaKind } from '../lib/schema';
import { THEME_COLOR } from '../lib/theme';
/* Предзагрузка двух подмножеств, нужных первому экрану русской страницы
 * (правка 2026-08-21, диагноз FOUC — прыжок заголовка и метки бренда при
 * подмене запасного начертания на своё). Только `cyrillic`: `latin` и
 * `symbols` на первом экране не задействованы (в заголовке и метке бренда
 * нет латиницы/₽/→), а лишний `<link rel="preload">` сам стоит байтов и
 * конкурирует за полосу с тем, что реально нужно первому кадру.
 *
 * Импорт ассета, а НЕ строка пути: имя файла в сборке хешируется
 * (`/_astro/unbounded-cyrillic-wght-normal.C627f1f8.woff2`), и вписанная
 * руками строка протухнет молча на следующей сборке. */
import unboundedCyrillicHref from '../fonts/unbounded-cyrillic-wght-normal.woff2?url';
import onestCyrillicHref from '../fonts/onest-cyrillic-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Язык страницы. По умолчанию ВЫВОДИТСЯ ИЗ АДРЕСА (`localeFromPath`), а не
   *  задаётся страницей: `/en` и всё под ним — английские, остальное русское.
   *
   *  Так атрибут `lang` на `<html>` не может разойтись с содержимым страницы.
   *  Раньше язык объявляла сама страница пропом, и английская главная была
   *  единственным местом, где его помнили; страница, забывшая проп, молча
   *  отдавала бы английский текст с `lang="ru"` — а это не косметика:
   *  переносы, чтение с экрана и `hyphens: auto` работают по объявленному
   *  языку. Проп остаётся как перекрытие для случая, когда адрес и язык
   *  расходятся намеренно, и в сегодняшнем коде им никто не пользуется. */
  lang?: Locale;
  noindex?: boolean;
  /** Только для служебных конечных экранов. Публичные правовые документы
   *  остаются `noindex, follow`, чтобы их обычные ссылки можно было пройти. */
  nofollow?: boolean;
  progress?: boolean;
  /** Страница несёт рельс-скроллспай (`Rail.astro`) — сегодня только главная
   *  (план `02-home-plan.md`, задача 4). Рельс рисуется здесь, а не в
   *  `Header`, и не внутри `<main>`: клавиатурный фокус обязан идти
   *  skip-link → шапка → содержимое → подвал → рельс, а не перехватываться
   *  фиксированным элементом раньше содержимого страницы. */
  rail?: boolean;
  /** Линия на фоне (`BackgroundLine.astro`, спека `02-home.md`, раздел 15).
   *  Сегодня только главная — первая страница, где линия появляется
   *  по-настоящему; на посадочных она тоньше и бледнее (спека 03, вне этого
   *  плана), и там подключается своим значением этого же пропа, а не вторым
   *  компонентом. */
  line?: boolean;
  /** Полоса действия подвала (`.footer-cta`) — спека `09-footer-brief.md`,
   *  раздел 3.1. По умолчанию ВЫВОДИТСЯ ИЗ АДРЕСА (`showFooterCta`), тем же
   *  приёмом, что уже даёт умолчание `lang` из `localeFromPath` выше:
   *  страница сама этот проп не задаёт, а решение о том, есть ли у неё
   *  собственная форма внизу, принимает одна чистая функция на весь сайт.
   *  Проп остаётся как перекрытие для случая, когда адрес и содержание
   *  страницы разойдутся намеренно. */
  cta?: boolean;
  /** Структурированная разметка страницы, если она у страницы есть. */
  schema?: SchemaKind;
  /** Дополнительные подтверждённые сущности страницы: Service,
   *  CollectionPage или CreativeWork. Принимает объект либо массив; Base
   *  сериализует их тем же безопасным способом, что основной schema. */
  structuredData?: unknown | readonly unknown[];
}
const {
  title, description, lang = localeFromPath(Astro.url.pathname), noindex = false,
  nofollow = false, progress = true, rail = false, line = false,
  cta = showFooterCta(Astro.url.pathname), schema, structuredData,
} = Astro.props;
const t = dict(lang);

const site = productionSite(Astro.site?.toString());
const meta = buildMeta({
  title,
  description,
  pathname: Astro.url.pathname,
  site,
  noindex,
  nofollow,
});

const structured = [
  ...(schema
    ? [pageSchema(schema, {
      site,
      canonical: meta.canonical,
      title,
      description,
      lang,
    })]
    : []),
  ...(structuredData === undefined
    ? []
    : Array.isArray(structuredData) ? structuredData : [structuredData]),
].map(serializeSchema);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Предзагрузка двух шрифтовых подмножеств первого экрана — раньше
        favicon и мета-тегов, но после charset/viewport (см. фронтматтер).
        `crossorigin` обязателен даже для своего домена: без него браузер
        трактует предзагруженный и настоящий запрос шрифта как разные
        ресурсы (шрифты всегда идут в анонимном режиме CORS) и скачивает
        файл дважды. */}
    <link rel="preload" as="font" type="font/woff2" href={unboundedCyrillicHref} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={onestCyrillicHref} crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Полоса браузера над страницей красится в цвет фона темы. Две записи по
        системной схеме — то, что видит посетитель без своего выбора; выбор,
        сделанный переключателем, переписывает обе (ThemeToggle.astro). */}
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
    {/* Скрипт ниже красит полосу браузера РАЗМЕТКОЙ, до первого кадра. Две
        записи `theme-color` выше отвечают на системную схему, а выбранная
        вручную тема им противоречит: человек с тёмной темой на светлой
        системе получил бы светлую полосу и её перекраску через кадр — ту же
        вспышку, только в хроме браузера. Тот же расчёт делает ThemeToggle
        при нажатии; здесь он нужен раньше, чем загрузится модуль. Комментарий
        вынесен из тела `<script is:inline>` (2026-08-26): Astro отгружает
        содержимое инлайнового скрипта дословно, включая комментарии. */}
    <script is:inline define:vars={{ THEME_COLOR }}>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') return;
        document.documentElement.dataset.theme = t;
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < metas.length; i++) {
          metas[i].setAttribute('content', THEME_COLOR[t]);
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Сабуров Даниил Денисович" />
    <link rel="canonical" href={meta.canonical} />
    <meta name="robots" content={meta.robots} />
    {meta.alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    {meta.alternates.length > 0 && (
      <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_US' : 'ru_RU'} />
    )}
    <meta property="og:site_name" content="wfeels" />
    <meta property="og:image" content={meta.socialImage} />
    <meta property="og:image:secure_url" content={meta.socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={meta.socialImage} />
    <meta name="twitter:image:alt" content={title} />
    {/* `is:inline` обязателен: без него Astro приняла бы содержимое за модуль
        и попыталась собрать JSON как код. */}
    {structured.map((item) => (
      <script type="application/ld+json" is:inline set:html={item} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <Header lang={lang} progress={progress} rail={rail} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {/* Сквозная шторка линии (`70-workshop/specs/site-v3/
        15-line-through-scale-brief.md`, раздел 2) — ОДИН узел на всю
        страницу, `position: fixed`, z-index -3. Стоит ПОСЛЕ `<main>`
        сознательно: она и все `.line` внутри секций делят один и тот же
        z-index (-3), а при равном z-index порядок покраски решает порядок
        в DOM — шторка обязана идти ПОЗЖЕ каждого `.line`, иначе рисунок
        покрасился бы поверх неё, а не наоборот. `<footer>`, идущий следом,
        несёт свой фон на z-index -2 (D-126, правка раздела 2.4 брифа
        `15-…`) — выше шторки независимо от DOM-порядка, поэтому подвал
        всегда виден поверх неё. */}
    {line && <BackgroundLine />}
    <Footer lang={lang} line={line} cta={cta} />
    {rail && <Rail />}

    {/* Плавная прокрутка колесом на весь сайт (правка владельца 2026-08-20).
        Скрипт стоит ЗДЕСЬ, в общем макете, а не в компонентах: во-первых, он
        нужен каждой странице, во-вторых, поднимаемый `<script>` из слота
        (`CaseIllustrationField`) до сборки молча не доезжает. */}
    <script>
      import Lenis from 'lenis';

      /* Единая точка входа для программной прокрутки к элементу этой
         страницы — заведена вместе с находкой про рельс (правка 2026-08-26,
         разбор — у `anchors: true` ниже). Рельс (`Rail.astro`) двигал окно
         СВОИМ вызовом `element.scrollIntoView({behavior:'smooth'})` — родной
         механизм, тот же самый, что раньше вели анкоры через CSS, и с тем же
         пороком: пока Lenis ещё доезжает инерцией от колеса, его раф-цикл
         каждый кадр пишет позицию к СТАРОЙ цели и рвёт чужую smooth-анимацию.
         Перевод анкоров на `anchors: true` рельса не касался вовсе — это
         отдельный клик по `<button>`, не по `<a>`, Lenis его не видит.
         Вместо второго особого случая в Rail.astro — общий контракт: когда
         Lenis жив, он же и возит; когда его нет (`prefers-reduced-motion:
         reduce`), вызывающий код падает на родной `scrollIntoView` сам —
         тем же мгновенным путём, что и раньше. */
      declare global {
        interface Window {
          __scrollToElement?: (el: HTMLElement) => void;
        }
      }

      /* Величина плавности — доля остатка пути, проходимая за кадр. Выбрана
         замером, а не на слух: `smooth-scroll.spec.ts` на одном повороте
         колеса (600 px, 1440×900) даёт время до 90% пути и до полной
         остановки.

           0,08 — 467 мс до 90%, 1469 мс до остановки, 46 px за первый кадр;
                  страница заметно тянется за рукой, и сторож её отвергает
                  (движение дольше секунды);
           0,12 — 317 мс до 90%, 984 мс до остановки, 68 px за первый кадр;
           0,15 — 250 мс до 90%, 785 мс до остановки, 83 px за первый кадр;
                  за первый же кадр уходит седьмая часть пути — от родной
                  прокрутки почти неотличимо, правка теряет смысл.

         Взято 0,12: рука ведёт, страница догоняет за треть секунды и не
         повисает. Хвост движения (от 90% до полной остановки) двигает уже
         меньше пикселя за кадр и глазом не читается — судить по нему о
         «плывёт/не плывёт» нельзя, поэтому в сторожа вынесены оба числа. */
      const LERP = 0.12;

      const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      let lenis: Lenis | null = null;

      /* При `prefers-reduced-motion: reduce` экземпляр не создаётся ВООБЩЕ, а
         не глушится опцией `respectReducedMotion`. Разница существенная: с
         опцией Lenis всё равно перехватывает колесо и доводит позицию за
         несколько кадров (`lerp: 1` — это не «мгновенно», а 62% пути за кадр).
         Читателю, попросившему убрать движение, обязана достаться РОДНАЯ
         прокрутка браузера, без единой чужой строки на пути события. */
      const enable = () => {
        if (lenis) return;
        lenis = new Lenis({
          lerp: LERP,
          // Свой цикл кадров: другого потребителя rAF на сайте нет, сводить
          // их в один незачем.
          autoRaf: true,
          /* На касании плавность НЕ включаем. У пальца инерция уже своя,
             системная; вторая поверх неё читается как залипание — экран
             продолжает ехать после того, как палец остановился. Это
             умолчание библиотеки, оно назначено здесь явно, чтобы
             следующий читатель не счёл его недосмотром. */
          syncTouch: false,
          /* Якоря переведены на Lenis (правка 2026-08-26, жалоба владельца:
             клик по пункту шапки иногда не долистывает до секции).

             Прежде здесь стояло `anchors: false` с обоснованием «Lenis не
             знает scroll-margin-top секций, родной переход — знает». Проверено
             рендером и оказалось НЕВЕРНО для установленной версии
             (`lenis@1.3.26`, `node_modules/lenis/dist/lenis.mjs`, метод
             `scrollTo`, ~строка 783): цель считается как
             `rect.top + animatedScroll - scrollMarginTop - scrollPaddingTop`,
             то есть Lenis читает `getComputedStyle(node).scrollMarginTop` —
             то же значение, что и браузер. Проверка на всех трёх отступах
             `Section.astro` (150 / 132 / 90 px, брейкпоинты 390 / 600 / 1000 /
             1440 px) дала точную посадку — расхождений нет ни на одной точке.

             Настоящая причина срывов клика была не в этом, а в том, что на
             странице ОДНОВРЕМЕННО жили два независимых механизма прокрутки:
             родной `scroll-behavior: smooth` (`styles/base.css`) вёл окно к
             цели клика, а раф-цикл Lenis — если в момент клика ещё доезжал
             инерцией от предыдущего поворота колеса — писал позицию каждый
             кадр к своей СТАРОЙ цели через `scrollTo({behavior:'instant'})`.
             Такая инстант-запись обрывает браузерную smooth-анимацию
             мгновенно (спецификация: любая программная запись позиции
             прерывает текущий smooth-scroll), и родной переход к цели клика
             не успевал прожить ни кадра — итоговая позиция страницы
             оставалась там, куда вёл СТАРЫЙ, не связанный с кликом путь Lenis.

             Замер (клик по пункту шапки через ~60 мс после поворота колеса на
             900 px, headless Chromium, 20 попыток): 20/20 срывов на исходной
             схеме. Выключение только `scroll-behavior: smooth` симптом НЕ
             СНЯЛО — снова 20/20: конфликт не в CSS. Выключение самого Lenis
             (анкоры при этом ещё родные) убрало срывы полностью — 0/20:
             источник — активный цикл Lenis, а не сама смена `anchors`.
             `anchors: true` отдаёт Lenis прокрутку и по клику — с этого
             момента на цель есть только ОДИН активный источник истины,
             конкурировать при клике во время инерции больше не с чем (тоже
             измерено — 0/20 на всех проверенных сценариях: клик в покое,
             клик во время инерции, быстрые клики подряд, рельс, мобильное
             меню, `/en`). Сторож — `nav-click-during-momentum.spec.ts`. */
          anchors: true,
        });
        window.__scrollToElement = (el) => lenis?.scrollTo(el);
      };

      const disable = () => {
        lenis?.destroy();
        lenis = null;
        window.__scrollToElement = undefined;
      };

      /* `scroll-behavior: smooth` (`styles/base.css`) остаётся ради ОДНОГО
         пути, который Lenis не перехватывает вовсе, — прокрутки с клавиатуры
         (`PageDown`/`Space`/`Home`/`End`, сторож в `smooth-scroll.spec.ts`).
         Переходы по клику CSS больше не ведёт: с `anchors: true` (см.
         комментарий там) их полностью забрал Lenis. Прежняя редакция этого
         комментария утверждала, что Lenis и CSS «не конфликтуют» на кликах
         тоже — это было неверно ровно в том случае, из-за которого пришла
         жалоба владельца: разбор и числа — у `anchors: true`. */
      const sync = () => (reduceQuery.matches ? disable() : enable());
      sync();
      reduceQuery.addEventListener('change', sync);
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 8px;
        /* Общее правило в base.css растит коробку до 44 px, а текст в блоке
           ложится сверху. Здесь это видно первому, кто идёт по сайту с
           клавиатуры. */
        display: inline-flex;
        align-items: center;
        background: var(--accent);
        color: var(--text-on-accent);
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        z-index: 200;
      }
      .skip:focus { left: 8px; }

      /* Рамка вокруг всей страницы выглядела бы плохо, но и молчать нельзя:
         человек, нажавший skip-link, должен увидеть, что переход случился.
         Отсюда метка слева, а не outline по периметру. */
      main:focus {
        outline: none;
        box-shadow: inset 3px 0 0 0 var(--accent);
      }
    </style>
  </body>
</html>
