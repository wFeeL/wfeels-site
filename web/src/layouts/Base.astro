---
import '@fontsource-variable/manrope';
import '@fontsource-variable/golos-text';
import '@fontsource-variable/jetbrains-mono';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dict } from '../i18n/locales';

interface Props {
  title: string;
  description: string;
  lang?: 'ru' | 'en';
}
const { title, description, lang = 'ru' } = Astro.props;
const t = dict(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.dataset.theme = t;
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <Header lang={lang}>
      <slot name="lang" slot="lang" />
    </Header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 8px;
        background: var(--accent);
        color: var(--text-on-accent);
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        z-index: 200;
      }
      .skip:focus { left: 8px; }

      /* Рамка вокруг всей страницы выглядела бы плохо, но и молчать нельзя:
         человек, нажавший skip-link, должен увидеть, что переход случился.
         Отсюда метка слева, а не outline по периметру. */
      main:focus {
        outline: none;
        box-shadow: inset 3px 0 0 0 var(--accent);
      }
    </style>
  </body>
</html>
