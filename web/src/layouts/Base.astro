---
import '../styles/fonts.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Rail from '../components/Rail.astro';
import BackgroundLine from '../components/BackgroundLine.astro';
import { dict } from '../i18n/locales';
import { buildMeta } from '../lib/seo';
import { pageSchema, serializeSchema, type SchemaKind } from '../lib/schema';
import { THEME_COLOR } from '../lib/theme';

interface Props {
  title: string;
  description: string;
  lang?: 'ru' | 'en';
  noindex?: boolean;
  progress?: boolean;
  /** Страница несёт рельс-скроллспай (`Rail.astro`) — сегодня только главная
   *  (план `02-home-plan.md`, задача 4). Рельс рисуется здесь, а не в
   *  `Header`, и не внутри `<main>`: клавиатурный фокус обязан идти
   *  skip-link → шапка → содержимое → подвал → рельс, а не перехватываться
   *  фиксированным элементом раньше содержимого страницы. */
  rail?: boolean;
  /** Линия на фоне (`BackgroundLine.astro`, спека `02-home.md`, раздел 15).
   *  Сегодня только главная — первая страница, где линия появляется
   *  по-настоящему; на посадочных она тоньше и бледнее (спека 03, вне этого
   *  плана), и там подключается своим значением этого же пропа, а не вторым
   *  компонентом. */
  line?: boolean;
  /** Структурированная разметка страницы, если она у страницы есть. */
  schema?: SchemaKind;
}
const {
  title, description, lang = 'ru', noindex = false, progress = true,
  rail = false, line = false, schema,
} = Astro.props;
const t = dict(lang);

const site = Astro.site?.toString() ?? 'http://localhost:4321';
const meta = buildMeta({
  title,
  description,
  pathname: Astro.url.pathname,
  site,
  noindex,
});

const structured = schema
  ? serializeSchema(pageSchema(schema, {
      site,
      canonical: meta.canonical,
      title,
      description,
      lang,
    }))
  : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Полоса браузера над страницей красится в цвет фона темы. Две записи по
        системной схеме — то, что видит посетитель без своего выбора; выбор,
        сделанный переключателем, переписывает обе (ThemeToggle.astro). */}
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
    <script is:inline define:vars={{ THEME_COLOR }}>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') return;
        document.documentElement.dataset.theme = t;
        // Полосу браузера красит РАЗМЕТКА, до первого кадра. Две записи выше
        // отвечают на системную схему, а выбранная вручную тема им противоречит:
        // человек с тёмной темой на светлой системе получил бы светлую полосу и
        // её перекраску через кадр — ту же вспышку, только в хроме браузера.
        // Тот же расчёт делает ThemeToggle при нажатии; здесь он нужен раньше,
        // чем загрузится модуль.
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < metas.length; i++) {
          metas[i].setAttribute('content', THEME_COLOR[t]);
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={meta.canonical} />
    <meta name="robots" content={meta.robots} />
    {meta.alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* `is:inline` обязателен: без него Astro приняла бы содержимое за модуль
        и попыталась собрать JSON как код. */}
    {structured && (
      <script type="application/ld+json" is:inline set:html={structured} />
    )}
  </head>
  <body>
    {line && <BackgroundLine />}
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <Header lang={lang} progress={progress} rail={rail}>
      <slot name="lang" slot="lang" />
    </Header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} line={line} />
    {rail && <Rail />}

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 8px;
        /* Общее правило в base.css растит коробку до 44 px, а текст в блоке
           ложится сверху. Здесь это видно первому, кто идёт по сайту с
           клавиатуры. */
        display: inline-flex;
        align-items: center;
        background: var(--accent);
        color: var(--text-on-accent);
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        z-index: 200;
      }
      .skip:focus { left: 8px; }

      /* Рамка вокруг всей страницы выглядела бы плохо, но и молчать нельзя:
         человек, нажавший skip-link, должен увидеть, что переход случился.
         Отсюда метка слева, а не outline по периметру. */
      main:focus {
        outline: none;
        box-shadow: inset 3px 0 0 0 var(--accent);
      }
    </style>
  </body>
</html>
