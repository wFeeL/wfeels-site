---
import '@fontsource-variable/manrope';
import '@fontsource-variable/golos-text';
import '@fontsource-variable/jetbrains-mono';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dict } from '../i18n/locales';
import { buildMeta } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  lang?: 'ru' | 'en';
  noindex?: boolean;
  progress?: boolean;
}
const { title, description, lang = 'ru', noindex = false, progress = true } = Astro.props;
const t = dict(lang);

const meta = buildMeta({
  title,
  description,
  pathname: Astro.url.pathname,
  site: Astro.site?.toString() ?? 'http://localhost:4321',
  noindex,
});
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.dataset.theme = t;
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={meta.canonical} />
    <meta name="robots" content={meta.robots} />
    {meta.alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <Header lang={lang} progress={progress}>
      <slot name="lang" slot="lang" />
    </Header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 8px;
        background: var(--accent);
        color: var(--text-on-accent);
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        z-index: 200;
      }
      .skip:focus { left: 8px; }

      /* Рамка вокруг всей страницы выглядела бы плохо, но и молчать нельзя:
         человек, нажавший skip-link, должен увидеть, что переход случился.
         Отсюда метка слева, а не outline по периметру. */
      main:focus {
        outline: none;
        box-shadow: inset 3px 0 0 0 var(--accent);
      }
    </style>
  </body>
</html>
