---
/* Вычерченное ядро в тизере фабрики — вариант владельца «А Разводка», бриф
 * `70-workshop/specs/site-v3/02-home-core.md`. Читать бриф целиком: этот файл
 * реализует направление, а не выбирает его.
 *
 * Оба раскроя лежат в разметке одновременно; невидимый скрыт `display:none`
 * обычным медиазапросом на 900 px (та же точка перелома, что у навигации).
 * Переключение между ними не тратит ни строки JavaScript.
 *
 * Геометрия СЧИТАЕТСЯ здесь из `data/factory.ts` на этапе сборки Astro — ни
 * одна координата, ни один счётчик тика не написаны в разметке руками.
 * Добавили тему во `FACTORY` — рисунок и аудио-описание обновятся сами;
 * тест-сторож `data/factory.test.ts` не даст забыть про сумму.
 *
 * Геометрия держит ортогональ: только вертикали (`V`), горизонтали (`H`) и
 * дуги постоянного радиуса 16 (`a16,16 0 …`). Команд `C`/`S`/`Q`/`T` в файле
 * нет — это отдельный критерий приёмки (бриф, раздел 13, пункт 14) и
 * осознанное разделение ролей с кривой линией фона (задача 13).
 *
 * Общие свойства обводки (цвет/ширина/непрозрачность волосяной линии) вынесены
 * в CSS-классы (`.core-bold` / `.core-line` / `.core-hair` / `.core-tick`), а
 * не повторены атрибутами на каждом узле: то же самое повторено 32 раза на
 * тиках при двух раскроях, и атрибутами это заметно раздувает `dist/`.
 */
import { FACTORY, FACTORY_TOTALS, type FactoryTemplate } from '../data/factory';

const N = FACTORY.length;

// ---------------------------------------------------------------------
// Раскрой А (от 900 px) — viewBox 0 0 704 288, натуральный масштаб 1:1.
// ---------------------------------------------------------------------
const AXIS_A = 144;
const ROW_STEP_A = 48;
const UP_COUNT_A = Math.ceil(N / 2);

interface RowA {
  t: FactoryTemplate;
  y: number;
  dir: 'up' | 'down';
}

// Первые ⌈n/2⌉ шаблонов — вверх от оси, остальные — вниз, тем же шагом
// (бриф, раздел 4). Порядок массива уже читается сверху вниз: у элемента 0
// самое большое удаление от оси среди «up»-строк.
const rowsA: RowA[] = FACTORY.map((t, i) => {
  if (i < UP_COUNT_A) {
    return { t, y: AXIS_A - ROW_STEP_A * (UP_COUNT_A - i), dir: 'up' as const };
  }
  const j = i - UP_COUNT_A;
  return { t, y: AXIS_A + ROW_STEP_A * (j + 1), dir: 'down' as const };
});

const busTopA = Math.min(...rowsA.map((r) => r.y)) + 16;
const busBottomA = Math.max(...rowsA.map((r) => r.y)) - 16;

function branchPathA(row: RowA): string {
  return row.dir === 'up'
    ? `M176,${row.y + 16} a16,16 0 0 1 16,-16 H288`
    : `M176,${row.y - 16} a16,16 0 0 0 16,16 H288`;
}

// Высота тика: реперный каждый пятый (1-indexed) выше остальных — без него
// двенадцать одинаковых штрихов не пересчитать глазом (бриф, раздел 4).
function tickHeight(oneIndexed: number): number {
  return oneIndexed % 5 === 0 ? 26 : 18;
}

function combEndX(themes: number): number {
  return 352 + (themes - 1) * 16 + 16;
}
function countXA(themes: number): number {
  return 352 + (themes - 1) * 16 + 32;
}

// ---------------------------------------------------------------------
// Раскрой Б (ниже 900 px) — viewBox 0 0 288 448, ствол вниз, ветви вправо.
// ---------------------------------------------------------------------
const ROW_STEP_B = 72;
const ROW0_Y_B = 160;

interface RowB {
  t: FactoryTemplate;
  y: number;
}
const rowsB: RowB[] = FACTORY.map((t, i) => ({ t, y: ROW0_Y_B + ROW_STEP_B * i }));
const busBottomB = rowsB[rowsB.length - 1].y - 16;

function branchPathB(row: RowB): string {
  return `M64,${row.y - 16} a16,16 0 0 0 16,16 H96`;
}

interface CombLineB {
  l: number;
  startTick: number; // индекс первого тика строки в сквозной нумерации
  count: number;
}
// Гребёнка ломается по 6: 12 → 6+6, 8 → 6+2, 6 → 6 (бриф, раздел 5).
function combLinesB(themes: number): CombLineB[] {
  if (themes <= 6) return [{ l: 0, startTick: 0, count: themes }];
  return [
    { l: 0, startTick: 0, count: 6 },
    { l: 1, startTick: 6, count: themes - 6 },
  ];
}
function axisEndXB(count: number): number {
  return 128 + (count - 1) * 16 + 8;
}

// ---------------------------------------------------------------------
// Общее для обоих раскроёв
// ---------------------------------------------------------------------

// «Схема: один движок и четыре шаблона. Запись — 12 тем, 4 демо. …»
// Собран из тех же данных — читать 32 прямоугольника скринридером было бы
// шумом (бриф, раздел 10), поэтому `role="img"` сворачивает рисунок в одно
// описание, а легенда ниже поясняет условное обозначение отдельно.
const ariaLabel = `Схема: один движок и ${FACTORY_TOTALS.templates} шаблона. `
  + FACTORY.map((t) => {
    const label = t.label.charAt(0) + t.label.slice(1).toLowerCase();
    const demoText = t.demos === 0 ? 'демо нет' : `${t.demos} демо`;
    return `${label} — ${t.themes} тем, ${demoText}.`;
  }).join(' ');
---
<div class="factory-core">
  <svg
    class="core-svg core-a"
    viewBox="0 0 704 288"
    width="704"
    height="288"
    role="img"
    aria-label={ariaLabel}
    focusable="false"
  >
    {/* Ядро: рамка, внутренний квадрат, точка центра, ствол. */}
    <rect class="core-draw core-phase-1 core-bold" x="16" y="96" width="96" height="96" pathLength="1" />
    <g class="core-fade core-phase-2">
      <rect class="core-line" x="48" y="128" width="32" height="32" />
      <circle class="core-dot" cx="64" cy="144" r="3.5" />
    </g>
    <path class="core-draw core-phase-3 core-line" d={`M112,${AXIS_A} H176`} pathLength="1" />

    {/* Шина — от верхней до нижней строки. */}
    <path class="core-draw core-phase-4 core-line" d={`M176,${busTopA} V${busBottomA}`} pathLength="1" />

    {/* Четыре ветви, узел и подпись каждого шаблона. */}
    {rowsA.map((row) => (
      <>
        <path class="core-draw core-phase-5 core-line" d={branchPathA(row)} pathLength="1" />
        <g class="core-fade core-phase-5">
          <rect class="core-node" x="288" y={row.y - 12} width="24" height="24" />
          <text class="core-mono core-label" x="288" y={row.y - 22}>{row.t.label}</text>
        </g>

        {/* Отвод, ось и гребёнка тиков. */}
        <path class="core-draw core-phase-6 core-line" d={`M312,${row.y} H336`} pathLength="1" />
        <path class="core-draw core-phase-6 core-hair" d={`M336,${row.y} H${combEndX(row.t.themes)}`} pathLength="1" />

        <g class="core-fade core-phase-7">
          {Array.from({ length: row.t.themes }, (_, k) => {
            const h = tickHeight(k + 1);
            return (
              <rect class="core-tick" x={352 + k * 16 - 3} y={row.y - h / 2} width="6" height={h}
                data-filled={k < row.t.demos ? '1' : '0'} />
            );
          })}
          <text class="core-mono core-label" x={countXA(row.t.themes)} y={row.y + 4}>{row.t.themes} ТЕМ · {row.t.demos} ДЕМО</text>
        </g>
      </>
    ))}

    <text class="core-fade core-phase-1 core-mono core-label" x="16" y="216">BOT_FACTORY</text>
  </svg>

  <svg
    class="core-svg core-b"
    viewBox="0 0 288 448"
    width="288"
    height="448"
    role="img"
    aria-label={ariaLabel}
    focusable="false"
  >
    <rect class="core-draw core-phase-1 core-bold" x="16" y="16" width="96" height="96" pathLength="1" />
    <g class="core-fade core-phase-2">
      <rect class="core-line" x="48" y="48" width="32" height="32" />
      <circle class="core-dot" cx="64" cy="64" r="3.5" />
    </g>

    <path class="core-draw core-phase-4 core-line" d={`M64,112 V${busBottomB}`} pathLength="1" />

    {rowsB.map((row) => (
      <>
        <path class="core-draw core-phase-5 core-line" d={branchPathB(row)} pathLength="1" />
        <g class="core-fade core-phase-5">
          <rect class="core-node" x="96" y={row.y - 12} width="24" height="24" />
          <text class="core-mono core-label" x="128" y={row.y - 6}>{row.t.label}</text>
        </g>

        <g class="core-fade core-phase-7">
          <text class="core-mono core-label" x="128" y={row.y + 10}>{row.t.themes} ТЕМ · {row.t.demos} ДЕМО</text>
          {combLinesB(row.t.themes).map((line) => {
            const ly = row.y + 26 + line.l * 16;
            return (
              <>
                <path class="core-draw core-phase-6 core-hair" d={`M120,${ly} H${axisEndXB(line.count)}`} pathLength="1" />
                {Array.from({ length: line.count }, (_, j) => (
                  <rect class="core-tick" x={128 + j * 16 - 3} y={ly - 6} width="6" height="12"
                    data-filled={(line.startTick + j) < row.t.demos ? '1' : '0'} />
                ))}
              </>
            );
          })}
        </g>
      </>
    ))}

    <text class="core-fade core-phase-1 core-mono core-label" x="16" y="432">BOT_FACTORY</text>
  </svg>

  <p class="core-legend">Закрашенный тик — снятое демо · полый — тема без демо</p>
</div>

<style>
  .factory-core {
    display: block;
  }

  .core-svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  /* Раскрой А — от 900 px. Раскрой Б — ниже. Один и тот же порог, что у
     навигации (`01-foundation.md`). Невидимый раскрой скрыт `display:none` —
     это убирает его и из дерева доступности, второй `role="img"` не мешает. */
  .core-a { display: block; }
  .core-b { display: none; }
  @media (max-width: 899px) {
    .core-a { display: none; }
    .core-b { display: block; }
  }

  /* Три ширины обводки (бриф, раздел 8): главное / несущее / вспомогательное. */
  .core-bold { fill: none; stroke: var(--text); stroke-width: var(--stroke-bold); }
  .core-line { fill: none; stroke: var(--text); stroke-width: var(--stroke-line); }
  .core-hair { fill: none; stroke: var(--text-muted); stroke-width: var(--stroke-hair); opacity: var(--stroke-hair-opacity); }
  .core-node { fill: var(--bg); stroke: var(--text); stroke-width: var(--stroke-line); }
  .core-dot  { fill: var(--accent); }

  /* Тик гребёнки: полый по умолчанию, закрашен только когда `data-filled="1"`
     (бриф, раздел 4: «закрашен первые demos штук — это счёт, а не
     утверждение о том, какие именно темы сняты»). Непрозрачность —
     собственная, статичная (волосяная линия), НЕ то же свойство, которым
     ниже проявляется группа при раскрутке: тик лежит внутри `<g
     class="core-fade">`, и его локальная непрозрачность 0.45/0.6
     перемножается с непрозрачностью группы (0→1) — на входе тик уже дан
     верным затемнением, группа лишь проявляет его целиком, а не поверх
     затемнения. */
  .core-tick { stroke: var(--text-muted); stroke-width: var(--stroke-hair); opacity: var(--stroke-hair-opacity); fill: none; }
  .core-tick[data-filled="1"] { fill: var(--accent); }

  .core-mono {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .core-label { fill: var(--text-muted); }

  .core-legend {
    margin: 16px 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Запасное состояние — состояние ПО УМОЛЧАНИЮ (бриф, раздел 9 и 10): без
     этого блока рисунок и так уже полностью виден — ни `opacity:0`, ни
     `stroke-dashoffset` здесь нет. Анимация навешивается только внутри
     `@supports`, поверх статичного состояния, никогда наоборот. Одно и то же
     запасное состояние закрывает оба случая — `prefers-reduced-motion:
     reduce` и браузер без поддержки `animation-timeline` (Firefox держит её
     за флагом на 2026-08). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .core-draw,
      .core-fade {
        animation-timeline: view();
        animation-range: entry 15% cover 65%;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }
      .core-draw {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation-name: core-draw;
      }
      /* Проявляет ГРУППУ целиком (узел+подпись, или все тики строки+счёт) —
         не каждый тик отдельным keyframes: их непрозрачность в покое и так
         разная (0 против 0.45/0.6 полых и закрашенных), а множитель группы
         сохраняет это соотношение на любом кадре анимации. */
      .core-fade {
        opacity: 0;
        animation-name: core-fade;
      }

      /* Восемь фаз хореографии (бриф, раздел 9). `animation-timeline: view()`
         не течёт как время: `animation-duration` здесь не «сколько идёт
         анимация», а лишь относительный вес фазы внутри одного и того же
         диапазона видимости — MDN отмечает, что у view-progress таймлайнов
         он смещает завершение анимации ближе к концу диапазона. Порядок
         чисел ниже воспроизводит порядок брифа (рамка → квадрат → ствол →
         шина → ветви и узлы → оси гребёнок → тики и счёт → печать
         `FactoryStamp.astro`), и это единственное, что здесь важно: сами
         числа не секунды, второго механизма (JS) на расстановку фаз нет. */
      .core-phase-1 { animation-duration: 1ms; }
      .core-phase-2 { animation-duration: 60ms; }
      .core-phase-3 { animation-duration: 120ms; }
      .core-phase-4 { animation-duration: 180ms; }
      .core-phase-5 { animation-duration: 240ms; }
      .core-phase-6 { animation-duration: 320ms; }
      .core-phase-7 { animation-duration: 380ms; }
    }
  }

  @keyframes core-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes core-fade {
    to { opacity: 1; }
  }
</style>
