---
/* Иллюстрация «Пример диалога» (кейс «ИИ-консультант»), бриф
 * `70-workshop/specs/site-v3/02-case-illustrations.md`, раздел 5. Читать
 * бриф целиком.
 *
 * Настоящий текст в HTML, не картинка и не `aria-hidden` (раздел 2.5): он
 * весит около нуля, читается программой чтения и работает без JavaScript.
 * Сценарий клиента, решение владельца (D-030, пункт 3): бот отвечает
 * покупателю груминг-салона, а не рассказывает о наших услугах. Салон
 * безымянный — выдуманные названия организаций запрещены наравне с
 * выдуманным заказчиком (00-overview, раздел 7; `40-portfolio/CLAUDE.md`).
 *
 * Реплики и метка поля читаются из `data/case-illustrations.ts` —
 * единственного источника; модуль падает на сборке, если реплик не ровно
 * четыре, они не чередуются посетитель/бот, содержат цифру или ₽, или вторая
 * реплика бота перестала быть честным отказом (раздел 5.3).
 *
 * Классы короткие (`.v`/`.bt`, `.p1`…`.p4`) — тот же бюджетный приём, что у
 * `CaseFlowIllustration.astro`: секция кейсов тесно ограничена по байтам
 * (бриф, раздел 6), а имена длиной в слово повторялись бы четыре раза.
 *
 * ДВИЖЕНИЕ (решение владельца 2026-08-13, второй заход — отменяет заход
 * выше по тому же дню): зациклённая анимация снята дизайн-ревью с замером —
 * на полном 12-секундном обороте `no-preference` большую часть времени видны
 * одна-две реплики, а 40–60% рамки пустует, и единственное место сайта, где
 * читатель «трогает товар», читалось как «не загрузилось». Владельцу
 * показали замер, он решил цикл снять.
 *
 * Теперь ОДНОКРАТНОЕ появление по прокрутке (`animation-timeline: view()`,
 * тот же приём, что у `CaseFlowIllustration.astro` и
 * `CaseWeightIllustration.astro`): реплики проступают по очереди при въезде
 * поля в кадр и дальше стоят статично, без повтора. Запасное состояние —
 * оно же состояние ПО УМОЛЧАНИЮ (не обёрнутые стили ниже, `reduce`, и браузер
 * без поддержки `animation-timeline`, все три одним блоком): все четыре
 * реплики видны сразу и статично.
 *
 * Следствие: все четыре реплики теперь видны ВО ВСЕХ режимах (не только под
 * `reduce`, как раньше), значит поле обязано вмещать их всегда — высота
 * `CaseIllustrationField` для этого блока подобрана в `Cases.astro`
 * (`ILLUSTRATION_HEIGHT['ai-consultant']`) под содержимое этого файла, а не
 * взята произвольно. Специального переопределения высоты здесь больше нет:
 * оно было нужно только пока `reduce` и `no-preference` показывали разное
 * число реплик.
 */
import { DIALOGUE_FIELD_LABEL, DIALOGUE_LINES, type DialogueRole } from '../../data/case-illustrations';

const ROLE_LABEL: Record<DialogueRole, string> = {
  visitor: 'ПОСЕТИТЕЛЬ',
  bot: 'БОТ',
};
const ROLE_CLASS: Record<DialogueRole, string> = { visitor: 'v', bot: 'bt' };
---
<div class="dialogue">
  <p id="dialogue-field-label" class="lbl">{DIALOGUE_FIELD_LABEL}</p>
  <ol class="lines" aria-labelledby="dialogue-field-label">
    {DIALOGUE_LINES.map((line, i) => (
      <li class={`${ROLE_CLASS[line.role]} p${i + 1}`}>
        <p class="role">{ROLE_LABEL[line.role]}</p>
        <p class="msg">
          <span class="txt">{line.text}</span>
          {line.source && <span class="chip">ИСТОЧНИК: {line.source}</span>}
        </p>
      </li>
    ))}
  </ol>
</div>

<style>
  .dialogue { flex: 1; min-height: 0; display: flex; flex-direction: column; }

  /* Единственная метка-заголовок поля — 11 px допустим только здесь (бриф,
     раздел 2.3), не для содержательных подписей ниже. */
  .lbl {
    margin: 0 0 20px;
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* База = запасное состояние = состояние по умолчанию: все четыре реплики
     друг под другом, статично, ритм 14/4/12/8 нетронут. Появление ниже
     только ДОБАВЛЯЕТ однократное движение поверх этой раскладки — никогда
     наоборот. */
  .lines { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .lines > li { display: flex; flex-direction: column; gap: 4px; min-width: 0; opacity: 1; translate: 0 0; }
  .v { align-items: flex-start; }
  .bt { align-items: flex-end; }

  /* Метки ролей — моно small (16 px, шкала `base.css`), --text-muted: это
     информация (кто говорит), не декор, значит не --text-faint (бриф,
     раздел 5.4). Две вертикали меток (слева/справа) отличают блок от
     «пометок на полях». */
  .role { margin: 0; font: 500 1rem/1.3 var(--font-mono); color: var(--text-muted); }

  /* Реплики — не пузыри мессенджера: прямоугольники с волосяной рамкой,
     заливка --surface, радиус 8, ни одной тени (бриф, раздел 5.4). */
  .msg {
    margin: 0;
    padding: 12px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font: 400 1rem/1.4 var(--font-text);
    color: var(--text);
    box-sizing: border-box;
  }
  .txt { opacity: 1; }
  .v .msg { max-width: 384px; }
  .bt .msg { margin-left: 32px; width: calc(100% - 32px); }
  /* Сдвиг реплики бота (32 px) остаётся на всех ширинах; ниже 900 px
     реплика посетителя тоже растягивается до края поля (бриф, раздел 5.4). */
  @media (max-width: 899px) {
    .v .msg { max-width: none; }
  }

  /* Чип источника — единственный акцент рисунка (бриф, раздел 5.4). Кегль
     не мельче small (раздел 2.3) — «label» здесь означает стиль (моно,
     капслок, трекинг), не буквальные 11 px: чип несёт содержательную
     информацию, а не декор.
     НАХОДКА 2026-08-18 (родственная проверка задачи о масштабе Заявки-Хаба):
     комментарий выше требовал «не буквальные 11px», а `font-size` ниже был
     ровно `0.6875rem` = 11px — замер `getComputedStyle` подтвердил 11px на
     экране. Приведено к `small` шкалы (1rem/16px, тот же кегль, что у
     `.role` этого же компонента) — комментарий и код были в противоречии,
     теперь совпадают. */
  .chip {
    display: inline-block;
    margin-top: 8px;
    padding: 4px 10px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    font: 600 1rem/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 1;
  }

  /* Запасное состояние — состояние ПО УМОЛЧАНИЮ (см. верх файла): без этого
     блока все четыре реплики уже полностью видны и статичны (`.lines > li`
     выше). Анимация — только внутри `@supports`, поверх готового рисунка,
     никогда наоборот — закрывает и `prefers-reduced-motion: reduce`, и
     браузер без поддержки таймлайнов прокрутки одним и тем же блоком. Тот же
     приём, что `CaseFlowIllustration.astro` и `CaseWeightIllustration.astro`:
     однократное появление по `animation-timeline: view()`, каждая реплика —
     свой шаг длительности внутри одного и того же диапазона входа в кадр. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .lines > li {
        opacity: 0;
        translate: 0 8px;
        animation-timeline: view();
        animation-range: entry 15% cover 65%;
        /* Раздельные свойства, не сокращение `animation:` — сборка сводит
           `animation` + `animation-timeline` в один шорткод, а собранный
           Chromium такую форму не разбирает и молча роняет анимацию целиком
           (`css-no-animation-shorthand-with-timeline.test.ts`). */
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-name: dlg-line-in;
      }
      .p1 { animation-duration: 100ms; }
      .p2 { animation-duration: 180ms; }
      .p3 { animation-duration: 260ms; }
      .p4 { animation-duration: 340ms; }
    }
  }

  /* Только opacity и сдвиг 8 px (тот же ритм, что был в статике раньше) —
     ни мигания, ни подпрыгивания, ни горизонтальной езды. */
  @keyframes dlg-line-in {
    to { opacity: 1; translate: 0 0; }
  }
</style>
