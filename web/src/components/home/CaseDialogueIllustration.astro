---
/* Иллюстрация «Пример диалога» (кейс «ИИ-консультант»), бриф
 * `70-workshop/specs/site-v3/04-cases-brief.md`, раздел 4. Читать бриф
 * целиком: этот файл реализует устройство переписки, а не выбирает его.
 *
 * Устройство снято с живого `50-code/rag-consultant` (`app/web/widget.html`):
 * шапка окна (подпись + волосяная линия), реплики двумя сторонами со
 * срезанным углом-«хвостом», строка ввода с подсказкой и кнопкой отправки,
 * строка источника под ответом. Отклонено: аватар-кружок (знак несуществующей
 * организации), лаймовый акцент (прежний сайт), чипы-подсказки (цена вне
 * PRICING.md), «печатает…»/галочки/статус «в сети» (нечем проверить). Ни
 * одной строки кода из `rag-consultant` сюда не попадает — только приём.
 *
 * Настоящий текст в HTML, не картинка и не `aria-hidden` (кроме поля ввода,
 * раздел 4.6): он весит около нуля, читается программой чтения и работает
 * без JavaScript. Сценарий клиента (D-011): бот отвечает покупателю
 * груминг-салона, салон безымянный — выдуманные названия организаций
 * запрещены наравне с выдуманным заказчиком (00-overview, раздел 7;
 * `40-portfolio/CLAUDE.md`).
 *
 * Реплики и метка поля читаются из `data/case-illustrations.ts` —
 * единственного источника; модуль падает на сборке, если реплик не ровно
 * четыре, они не чередуются посетитель/бот, содержат цифру или ₽, или вторая
 * реплика бота перестала быть честным отказом (раздел 5.3 общей спеки).
 *
 * ДВИЖЕНИЕ: однократное появление по прокрутке (`animation-timeline:
 * view()`) — реплики проступают по очереди при въезде поля в кадр и дальше
 * стоят статично. Шапка (метка + волосяная линия) и строка ввода НЕ
 * анимируются — видны сразу: рамка окна переписки не «приезжает» (бриф,
 * раздел 4.8). Запасное состояние — оно же состояние ПО УМОЛЧАНИЮ: все
 * четыре реплики видны сразу и статично.
 *
 * Метки ролей «ПОСЕТИТЕЛЬ»/«БОТ» сняты с экрана (сторона, цвет заливки и
 * «хвост» пузыря говорят это без слов — бриф, раздел 4.5) и живут только в
 * дереве доступности: `.sr` — локальное правило компонента, скрывает текст
 * визуально, но не от программы чтения (`display:none`/`visibility:hidden`
 * этого не гарантируют).
 */
import {
  DIALOGUE_FIELD_LABEL,
  DIALOGUE_LINES,
  DIALOGUE_INPUT_PLACEHOLDER,
  type DialogueRole,
} from '../../data/case-illustrations';
import TelegramMark from '../TelegramMark.astro';

const ROLE_LABEL: Record<DialogueRole, string> = {
  visitor: 'Посетитель:',
  bot: 'Бот:',
};
const ROLE_CLASS: Record<DialogueRole, string> = { visitor: 'v', bot: 'bt' };
---
<div class="dialogue">
  <p id="dialogue-field-label" class="lbl">{DIALOGUE_FIELD_LABEL}</p>
  <div class="hr" aria-hidden="true"></div>
  <ol class="lines" aria-labelledby="dialogue-field-label">
    {DIALOGUE_LINES.map((line, i) => (
      <li class={`${ROLE_CLASS[line.role]} p${i + 1}`}>
        <span class="sr">{ROLE_LABEL[line.role]}</span>
        <p class="msg">
          <span class="txt">{line.text}</span>
          {line.source && (
            <span class="src">
              <span class="src-label">ИСТОЧНИК: {line.source}</span>
            </span>
          )}
        </p>
      </li>
    ))}
  </ol>
  {/* Строка ввода — рисунок, не форма (бриф, раздел 3.2/4.6): настоящее
      поле внутри блока-ссылки (раздел 3 брифа, вариант В) стало бы ловушкой
      клавиатуры. Ни `<input>`, ни `<button>`, ни `contenteditable`, ни
      `tabindex` — обычный `<div aria-hidden="true">`. */}
  <div class="input" aria-hidden="true">
    <span class="placeholder">{DIALOGUE_INPUT_PLACEHOLDER}</span>
    <span class="send"><TelegramMark size={20} /></span>
  </div>
</div>

<style>
  .dialogue { flex: 1; min-height: 0; display: flex; flex-direction: column; }

  /* Метка-заголовок поля — 11 px допустим только здесь (бриф раздел 2.3
     общей спеки), не для содержательных подписей ниже. */
  .lbl {
    margin: 0;
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Линия шапки — в край поля: приём, по которому глаз узнаёт «окно
     переписки», а не «список цитат» (бриф, раздел 4.3). Метка → линия: 16;
     линия → первая реплика: 24. */
  .hr {
    margin: 16px -32px 24px;
    width: calc(100% + 64px);
    border-top: 1px solid var(--border);
  }

  .lines { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .lines > li {
    display: flex;
    min-width: 0;
    opacity: 1;
    translate: 0 0;
  }
  /* Реплика посетителя — справа; реплика бота — слева. Каждая прижата к
     СВОЕМУ краю поля вплотную, свободное место остаётся у противоположного
     края (бриф, раздел 4.3). */
  .v { justify-content: flex-end; }
  .bt { justify-content: flex-start; }

  /* Скрытая подпись роли — для программы чтения, не для глаза (бриф,
     раздел 4.5). `display:none`/`visibility:hidden` не годятся — прячут
     текст и от читалки тоже. */
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Пузыри — не прямоугольники с волосяной рамкой (было), а мессенджер:
     заливка по роли, «хвост» срезанным углом (бриф, раздел 4.3/4.4). Ни
     одной тени. */
  .msg {
    margin: 0;
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    font: 400 1rem/1.4 var(--font-text);
    box-sizing: border-box;
    min-width: 0;
  }
  .v .msg {
    background: var(--accent);
    color: var(--text-on-accent);
    border-bottom-right-radius: 4px;
    max-width: 78%;
  }
  .bt .msg {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-bottom-left-radius: 4px;
    max-width: 86%;
  }
  @media (max-width: 479px) {
    .v .msg, .bt .msg { max-width: 92%; }
  }

  /* Строка источника — под волосяной линией ВНУТРИ пузыря бота (бриф,
     раздел 4.4): доказательство держится словами и местом, а не цветом —
     акцент рисунка теперь у реплики посетителя (раздел 4.4, расхождение с
     [[02-case-illustrations]] названо вслух там же). */
  .src {
    display: block;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
    font: 600 1rem/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Строка ввода — рисунок статичного состояния виджета, не форма (бриф,
     раздел 4.6). */
  .input {
    margin-top: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 8px 0 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    box-sizing: border-box;
  }
  .placeholder {
    flex: 1;
    min-width: 0;
    font: 400 1rem/1.4 var(--font-text);
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .send {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--text-on-accent);
  }

  /* Запасное состояние — состояние ПО УМОЛЧАНИЮ (см. верх файла): без этого
     блока все четыре реплики уже полностью видны и статичны (`.lines > li`
     выше), шапка и строка ввода не участвуют в анимации вовсе. Анимация —
     только внутри `@supports`, поверх готового рисунка, никогда наоборот —
     закрывает и `prefers-reduced-motion: reduce`, и браузер без поддержки
     таймлайнов прокрутки одним и тем же блоком. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .lines > li {
        opacity: 0;
        translate: 0 8px;
        animation-timeline: view();
        animation-range: entry 15% cover 65%;
        /* Раздельные свойства, не сокращение `animation:` — сборка сводит
           `animation` + `animation-timeline` в один шорткод, а собранный
           Chromium такую форму не разбирает и молча роняет анимацию целиком
           (`css-no-animation-shorthand-with-timeline.test.ts`). */
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-name: dlg-line-in;
      }
      .p1 { animation-duration: 100ms; }
      .p2 { animation-duration: 180ms; }
      .p3 { animation-duration: 260ms; }
      .p4 { animation-duration: 340ms; }
    }
  }

  /* Только opacity и сдвиг 8 px — ни мигания, ни подпрыгивания, ни
     горизонтальной езды. */
  @keyframes dlg-line-in {
    to { opacity: 1; translate: 0 0; }
  }
</style>
