---
/* Одна карточка кейса секции 5. Анатомия: заголовок → описание → строка
 * стека моношрифтом (спека 02-home.md, раздел 8) — без метки происхождения:
 * общая спека, раздел 7, запрещает подпись на карточке. Вся карточка — одна
 * ссылка на страницу кейса (`/cases/<slug>`, спека 04, пока 404 — см.
 * `tests/e2e/links.spec.ts`). Содержимое приходит целиком из `data/cases.ts`.
 */
import Card from '../Card.astro';
import type { CaseCard as CaseCardData } from '../../data/cases';

interface Props { item: CaseCardData }
const { item } = Astro.props;
---
<Card href={`/cases/${item.slug}`}>
  <div class="body">
    <h3 class="t-h3">{item.title}</h3>
    {item.description && <p class="description">{item.description}</p>}
  </div>
  {item.stack && <p class="stack"><code>{item.stack}</code></p>}
</Card>

<style>
  :global(.card) {
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
    transition: border-color var(--dur-micro) var(--ease);
  }
  :global(a.card:hover),
  :global(a.card:focus-visible) {
    border-color: var(--accent);
  }
  .body { display: flex; flex-direction: column; gap: 4px; }
  .description {
    margin: 4px 0 0;
    color: var(--text-muted);
    max-width: 42ch;
  }
  .stack {
    margin: auto 0 0;
    padding-top: 4px;
  }
  .stack code {
    font: 400 0.8125rem/1.4 var(--font-mono);
    color: var(--text-muted);
    background: none;
    padding: 0;
  }
</style>
