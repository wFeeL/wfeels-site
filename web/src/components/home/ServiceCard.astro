---
/* Одна карточка-группа секции 3. Анатомия (спека 02-home.md, раздел 6):
 * иконка → заголовок → описание в две строки → 3–4 пункта с галочками →
 * ссылки на посадочные → строка стека моношрифтом. Содержимое приходит
 * целиком из `data/services.ts` — карточка ничего не хранит сама.
 */
import Card from '../Card.astro';
import ServiceIcon from './ServiceIcon.astro';
import type { ServiceGroup } from '../../data/services';

interface Props { group: ServiceGroup }
const { group } = Astro.props;
---
<Card stack={true}>
  <div class="body">
    <ServiceIcon kind={group.icon} />
    <h3 class="t-h3">{group.title}</h3>
    <p class="description">{group.description}</p>
    <ul class="points" role="list">
      {group.points.map((p) => (
        <li>
          <svg class="check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M3 8.5 6.2 11.5 13 4.5" fill="none" stroke="currentColor"
              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {p}
        </li>
      ))}
    </ul>
    <ul class="links" role="list">
      {group.links.map((l) => (
        <li><a href={l.href}>{l.text} <span aria-hidden="true">→</span></a></li>
      ))}
    </ul>
  </div>
  <p class="stack"><code>{group.stack}</code></p>
</Card>

<style>
  .body { display: flex; flex-direction: column; gap: 4px; }
  h3 { margin-top: 4px; }
  .description {
    margin: 4px 0 4px;
    color: var(--text-muted);
    max-width: 42ch;
  }
  .points {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .points li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    /* Было 15 px — самовольный кегль, вне шкалы. Пункты — обычный текст
       карточки, ступень `body` (16 px), правка 2026-08-13, свод к семи
       объявленным. */
    font-size: 1.125rem;
  }
  /* Задача 19 (правка 2026-08-18): галочка стояла не по центру строки.
     `.points li` держит `align-items: flex-start` намеренно — многострочный
     пункт должен нести галочку у ВЕРХА текста, а не у геометрического
     центра всего пункта, иначе на переносе она уезжала бы вниз, в пустоту
     между строк. Раньше центровку внутри первой строки решал фиксированный
     `margin-top: 3px` — число, подобранное на глаз под прежний кегль пункта
     (15 px, самовольный, до свода шкалы 2026-08-13). Пункт с тех пор вырос
     до 18 px (`body`, тот же свод), высота строки выросла вместе с ним
     (`line-height: 1.65`, унаследован от `body` в `base.css`), а отступ
     галочки — нет: знак перестал стоять по центру первой строки. Формула
     ниже — половина зазора line-height за вычетом собственной высоты
     знака — центрует его по ПЕРВОЙ СТРОКЕ при любом кегле пункта, а не
     числом, верным для одного случайно застывшего кегля. */
  .check {
    flex: none;
    margin-top: calc((1.65em - 14px) / 2);
    color: var(--accent);
  }

  .links {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }
  .links a {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    /* Цель нажатия пальцем — дизайн-ревью (мобильные дефекты, часть 2):
       ссылка без своего `min-height` была высотой строки текста (30 px на
       390 px, замер ревью), не целью нажатия — общее правило `a[class]`
       (`base.css`) сюда не достаёт, ссылка без атрибута `class`.
       `align-items: center` уже стоял выше — коробка выросла, текст
       остался на середине. */
    min-height: 44px;
  }
  .links a span { color: var(--accent); transition: transform var(--dur-micro) var(--ease); }
  /* Находка дизайн-ревью 2026-08-22 (находка 4, D-055): ссылка стоит в
     СПИСКЕ (`.links`, под чертой карточки-группы) — по решению подчёркивание
     у такой ссылки появляется только при наведении и фокусе, в покое его
     нет. Цвет и сдвиг стрелки здесь уже работали (замер до правки: они и
     не были дефектом дизайн-ревью); недоставало ровно черты. `:focus-visible`
     — тем же селектором, что и `:hover`, тот же приём, что и в `NavLinks.astro`
     (список — не проза, второй словарь для того же правила не заводится). */
  /* ПРАВКА ВЛАДЕЛЬЦА 2026-08-23: подчёркивания при наведении и фокусе
     здесь БОЛЬШЕ НЕТ, и это осознанная частная отмена D-055 для двух мест
     полки и списка услуг (второе — `.shelf-label` в `home/Pricing.astro`).
     Не возвращать «ради соответствия D-055»: решение владельца новее.

     Ссылка не остаётся без отклика — это проверено перед снятием: цвет
     меняется на акцентный (правило ниже) и стрелка сдвигается
     (`.links a:hover span`). Именно поэтому снятие черты не воскрешает
     находку W9/W2 дизайн-ревью 2026-08-22 («ссылка выглядит мёртвой»). */
  .links a:hover,
  .links a:focus-visible {
    color: var(--accent);
  }
  .links a:hover span,
  .links a:focus-visible span { transform: translateX(2px); }

  .stack {
    margin: auto 0 0;
    padding-top: 4px;
  }
  /* Было 13 px — самовольный кегль, вне шкалы, свод к семи объявленным
     2026-08-13. Кегль поднят с 0.6875rem (ступень `label`, 11px) до 1rem
     (ступень `small`, 16px) — правка 21 (03-redesign-2026-08-14.md).
     Мелкий кегль был формально в шкале, но моношрифт при равном кегле с
     наборным читается мельче (та же ступень уже применяется к другим
     моно-подписям стека, `CaseWeightIllustration.astro`). */
  .stack code {
    font: 400 1rem/1.4 var(--font-mono);
    color: var(--text-muted);
    background: none;
    padding: 0;
  }
</style>
