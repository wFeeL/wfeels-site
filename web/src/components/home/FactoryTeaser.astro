---
/* Тизер фабрики под тремя карточками кейсов (спека 02-home.md, раздел 10;
 * текст — 02-texts.md, секция 5, переписан брифом `02-home-core.md`, раздел
 * 12; плита — тот же бриф, вариант владельца А «Плита»). Панель непрозрачна
 * (`--surface`) намеренно: линия на фоне (задача 13) проходит позади неё и
 * не выходит на полосу тизера ни в одной теме — обе задачи проверены вместе
 * (бриф, раздел 11).
 *
 * Порядок сверху вниз — из брифа, раздел 6: метка → заголовок → абзац →
 * рисунок → ссылка. Легенды в этом порядке больше нет — вариант «Плита» не
 * использует тики и условные обозначения. Действие стоит под доказательством,
 * а не над ним.
 */
import FactoryPlate from '../FactoryPlate.astro';
import FactoryStamp from '../FactoryStamp.astro';
import { FACTORY_TEASER } from '../../data/cases';
---
<div class="teaser">
  <p class="fabric-label">ФАБРИКА БОТОВ</p>
  <h3 class="t-h3">{FACTORY_TEASER.title}</h3>
  <p class="lead">{FACTORY_TEASER.text}</p>
  <FactoryPlate />
  <p class="link">
    <a href={FACTORY_TEASER.href}>
      <FactoryStamp />
      <span class="link-text">{FACTORY_TEASER.linkText} <span aria-hidden="true">→</span></span>
    </a>
  </p>
</div>

<style>
  .teaser {
    margin: 32px 0 0;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  @media (min-width: 900px) {
    .teaser { padding: 32px; }
  }

  /* Метка «ФАБРИКА БОТОВ» — тот же вид, что `Label.astro` (label, трекинг
     .16em, капслок, моно), но `--text-muted`, а не `--accent`: это подпись
     внутри панели, а не заголовок раздела главной (бриф, раздел 6). */
  .fabric-label {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .t-h3 { margin: 8px 0 0; }

  .lead {
    margin: 8px 0 0;
    color: var(--text-muted);
    max-width: 62ch;
  }

  .teaser > :global(.factory-plate) {
    margin-top: 32px;
  }

  .link {
    margin: 24px 0 0;
  }
  .link a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    /* Цель нажатия пальцем — тот же приём, что у прочих ссылок-переходов
       главной: было 32 px. В список дизайн-ревью не попала, найдена
       собственным замером при приёмке правки. */
    min-height: 44px;
  }
  .link-text { display: inline-flex; align-items: center; gap: 4px; }
  .link-text span { transition: transform var(--dur-micro) var(--ease); }
  .link a:hover { text-decoration: underline; }
  .link a:hover .link-text span { transform: translateX(2px); }

  /* Печать реагирует на наведение и фокус ссылки, не на своё собственное —
     это иллюстрация внутри действия, а не отдельная цель (бриф, раздел 10).
     `:global()` нужен, потому что `FactoryStamp.astro` — другой файл со
     своим скоупом стилей: класс изнутри него сюда без `:global()` не достал
     бы. Обвод фокуса — общий (`base.css`), свой здесь не заводится. */
  .link a:hover :global(.core-stamp-square),
  .link a:focus-visible :global(.core-stamp-square) {
    fill: var(--accent-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .link a:hover :global(.core-stamp-square),
    .link a:focus-visible :global(.core-stamp-square) {
      transition-duration: 0.01ms;
    }
  }
</style>
