---
/* Иллюстрация «Замер» (кейс «Этот сайт»), секция кейсов главной. Композиция
 * утверждена владельцем 2026-08-13 (диспетч задачи «Иллюстрация кейса «Этот
 * сайт»»): полоса сравнения «эта страница / медиана рынка» — главный
 * элемент, строка мелких метрик под ней — второстепенный (задача 2 этого
 * захода). Раньше здесь стояла одна голая цифра (правка ревью 2026-08-13,
 * часть 2) — обещание «сравнение с медианой» несла только подпись под
 * полем словами, само поле его не показывало.
 *
 * Каждое число здесь читается из `data/pageWeight.ts` через
 * `data/case-illustrations.ts:WEIGHT_ILLUSTRATION` — единственный источник,
 * второй ручной копии нет. Длина полосы «этот сайт» — точная доля
 * `ourKb / typicalKb`, посчитанная здесь же из тех же чисел: полоса не может
 * соврать пропорцией, потому что не несёт собственного литерала длины.
 *
 * ВНИМАНИЕ будущему редактору: эта композиция (залитые полосы) отличается
 * от «волосяной размерной линии с засечками», которую предписывал
 * `70-workshop/specs/site-v3/02-case-illustrations.md`, раздел 3.3, — решение
 * владельца сменилось в тот же день. Спека не переписана этим заходом (не
 * моя область правок) — см. отчёт задачи, раздел «Влияние на базу».
 */
import { WEIGHT_ILLUSTRATION } from '../../data/case-illustrations';

const { ourKb, typicalKb, typicalMbText, jsGzipKbText, thirdPartyScriptsCount } = WEIGHT_ILLUSTRATION;

// Доля полосы «этот сайт» от полосы медианы — не второй литерал длины, а
// вычисление из тех же двух чисел, что стоят рядом текстом.
const ourPct = (ourKb / typicalKb) * 100;
---
<div class="weight">
  <p id="weight-lbl" class="lbl">СКОЛЬКО ВЕСИТ ЭТА СТРАНИЦА</p>
  <div class="bars" aria-labelledby="weight-lbl">
    <div class="bar-row ours">
      <span class="bar-label">ЭТОТ САЙТ</span>
      <span class="track">
        <span class="fill accent" style={`--target:${ourPct.toFixed(2)}%`} />
      </span>
      <span class="bar-value">{ourKb} КБ</span>
    </div>
    <div class="bar-row typical">
      <span class="bar-label">СРЕДНИЙ</span>
      <span class="track">
        <span class="fill" style="--target:100%" />
      </span>
      <span class="bar-value">{typicalMbText} МБ</span>
    </div>
  </div>
  {/* Мелкие метрики — только числа, у которых есть сторож (`check-budget
      .mjs`, гейт задачи 2 захода 2026-08-13): без сторожа число сюда не
      попадает, число тестов сюда не попадает никогда. */}
  <p class="metrics">
    <span>{jsGzipKbText} КБ JS</span>
    <span class="dot" aria-hidden="true">·</span>
    <span>{thirdPartyScriptsCount} сторонних скриптов</span>
  </p>
</div>

<style>
  .weight {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
  }

  /* Единственная метка-заголовок поля — 11 px допустим только здесь (бриф
     `02-case-illustrations.md`, раздел 2.3), не для содержательных подписей
     ниже. */
  .lbl {
    margin: 0;
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .bars { display: flex; flex-direction: column; gap: 20px; }

  .bar-row {
    display: grid;
    grid-template-columns: 104px 1fr auto;
    align-items: center;
    gap: 16px;
  }

  .bar-label {
    font: 500 1rem/1.3 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  /* НЕ `overflow: hidden`: скругление полосы обеспечено собственным
     `border-radius` `.fill`, а не обрезкой родителя. `overflow: hidden` на
     `.track` делает его «контейнером прокрутки» по спецификации CSS
     Overflow — а именно ближайший контейнер прокрутки становится ИСТОЧНИКОМ
     таймлайна для `animation-timeline: view()` у потомка (не окно и не
     страница). `.track` сам никогда не скроллится, поэтому источник
     оказывается замороженным, и полоса застревает на одном и том же
     промежуточном прогрессе независимо от прокрутки страницы — поймано
     `getAnimations()[0].timeline.source` на живой странице при проверке
     этой задачи (см. отчёт, `Оставшиеся риски`). */
  .track {
    display: block;
    height: 16px;
    background: var(--grid);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  /* Заливка полосы медианы была `--border` (`#CBD3DE`) по дорожке `--grid`
     (`#E6EBF2`) — контраст 1,09:1, замер дизайн-ревью 2026-08-13: полоса
     сравнения читалась наоборот («наша» видна на 1/6, «средняя» выглядит
     пустой, хотя смысл графика — обратный). `--text-muted` даёт 4,87:1
     (светлая тема) и 5,88:1 (тёмная) против `--grid` — соотношение читается
     глазом без подписи, а сама пропорция полос не тронута: обе дорожки
     `.track` физически равной ширины (моно-шрифт, значения `410 КБ`/`2,4 МБ`
     — одинаковое число знаков), заливка «этого сайта» остаётся ровно в
     шесть раз короче, как и посчитано `ourPct`. */
  .fill {
    display: block;
    height: 100%;
    width: var(--target);
    background: var(--text-muted);
    border-radius: var(--radius-sm);
  }
  /* Акцент — только на своей полосе (бриф, раздел 2.3: «одна роль на
     рисунок»): доказательство, а не украшение. */
  .fill.accent { background: var(--accent); }

  .bar-value {
    font: 700 1.75rem/1.3 var(--font-mono);
    color: var(--text);
    text-align: right;
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    .bar-row { grid-template-columns: 1fr; row-gap: 8px; }
    .bar-value { text-align: left; }
  }

  /* Мелкие метрики — второстепенные по отношению к полосе сравнения,
     поэтому мельче подписей полос, но не мельче small (бриф раздела 2.3:
     кегль подписи внутри рисунка — не меньше 14 px). */
  .metrics {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    font: 500 1rem/1.4 var(--font-mono);
    color: var(--text-muted);
  }
  /* `--text-faint` не используется ни в одном из трёх рисунков секции
     кейсов (бриф `02-case-illustrations.md`, раздел 2.3) — разделитель
     остаётся на `--text-muted`, как и сами метрики рядом. */

  /* Запасное состояние — состояние ПО УМОЛЧАНИЮ (бриф раздела 2.4): без
     этого блока обе полосы уже нарисованы в полную длину (`.fill { width:
     var(--target); }` выше). Анимация навешивается только внутри
     `@supports`, поверх готового рисунка, никогда наоборот — закрывает и
     `prefers-reduced-motion: reduce`, и браузер без поддержки таймлайнов
     прокрутки одним и тем же блоком. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .fill {
        width: 0;
        animation-timeline: view();
        animation-range: entry 15% cover 65%;
        /* Раздельные свойства, не сокращение `animation:` — сборка сводит
           `animation` + `animation-timeline` в один шорткод, а собранный
           Chromium такую форму не разбирает и молча роняет анимацию целиком
           (`css-no-animation-shorthand-with-timeline.test.ts`). */
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-name: bar-grow;
      }
      /* Полоса медианы растёт первой (контекст), полоса этого сайта —
         следом (вывод): тот же порядок «сначала контекст, потом
         доказательство», что и в остальных двух рисунках секции. */
      .bar-row.typical .fill { animation-duration: 1ms; }
      .bar-row.ours .fill { animation-duration: 160ms; }
    }
  }

  @keyframes bar-grow {
    to { width: var(--target); }
  }
</style>
