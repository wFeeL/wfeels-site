---
/* Правка ревью 2026-08-13 (часть 2): полная иллюстрация «Замер» (две
 * размерные линии, сравнение с медианой) — по-прежнему задача 3 плана
 * (`70-workshop/specs/site-v3/02-case-illustrations.md`, раздел 3), она
 * здесь не строится. Эта правка закрывает только дефект пустой рамки:
 * подпись под полем (`WEIGHT_CLAIM`, `Cases.astro`) уже несёт доказательство
 * словами — число просто стояло подписью под пустотой вместо того, чтобы
 * быть содержимым поля. Число берётся из того же источника, что и подпись
 * (`data/pageWeight.ts`), второй копии веса здесь не заводится.
 */
import { PAGE_WEIGHT_KB } from '../../data/pageWeight';
---
<div class="weight">
  <span class="weight-label">Вес страницы</span>
  <p class="weight-value">{PAGE_WEIGHT_KB}</p>
  <span class="weight-unit">КБ</span>
</div>

<style>
  .weight {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 4px;
  }
  .weight-label {
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .weight-value {
    margin: 0;
    font: 800 clamp(3rem, 9vw, 4.75rem)/1 var(--font-head);
    color: var(--accent);
  }
  .weight-unit {
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text);
  }
</style>
