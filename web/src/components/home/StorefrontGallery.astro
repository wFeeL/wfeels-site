---
/* Иллюстрация второго кейса главной: три реально собранные витрины одного
 * Storefront-шаблона, по три экрана на каждую. Кадры сняты из приложений при
 * 390×844 и DPR 2, затем сохранены в AVIF без уменьшения исходных 780×1688.
 * В первом HTML лежит только главный экран Yasmina; остальные восемь кадров
 * подгружаются по стрелкам и не утяжеляют первую загрузку. Стрелки проходят
 * все девять кадров одним циклом, а под изображением стоит только название
 * текущего магазина — отдельных переключателей магазина и экрана нет по
 * прямой правке владельца 2026-08-24.
 * Переключение — направленный fade/slide после декодирования следующего AVIF:
 * изображение не мигает пустым кадром, быстрые клики становятся очередью, а
 * при `prefers-reduced-motion: reduce` смена остаётся мгновенной. Общий
 * контроллер двух галерей стоит после всех строк в `Cases.astro`: так он видит
 * и Telegram Mini App, и следующую за ним галерею сайтов, не дублируя JS. */
import phosphor from '@iconify-json/ph/icons.json';
import { CASE_GALLERIES_URL, STOREFRONT_SLIDES } from '../../data/case-galleries';

const CARET_LEFT = phosphor.icons['caret-left'].body;
const CARET_RIGHT = phosphor.icons['caret-right'].body;

const firstSlide = STOREFRONT_SLIDES[0];
---

<div
  class="gallery"
  role="group"
  aria-label="Экраны Telegram Mini App"
  data-case-gallery
  data-storefront-gallery
  data-gallery-key="storefront"
  data-slides-src={CASE_GALLERIES_URL}
>
  <div class="stage">
    <button class="nav previous" type="button" data-step="-1" aria-label="Предыдущий экран">
      <svg viewBox="0 0 256 256" aria-hidden="true">
        <g set:html={CARET_LEFT}></g>
      </svg>
    </button>

    <figure>
      <img
        src={firstSlide.src}
        alt={firstSlide.alt}
        width="780"
        height="1688"
        loading="lazy"
        decoding="async"
        data-gallery-screen
        data-storefront-screen
      />
    </figure>

    <button class="nav next" type="button" data-step="1" aria-label="Следующий экран">
      <svg viewBox="0 0 256 256" aria-hidden="true">
        <g set:html={CARET_RIGHT}></g>
      </svg>
    </button>
  </div>

  <div class="meta">
    <span class="store-name" data-gallery-project data-storefront-store>{firstSlide.project}</span>
    <span class="counter" data-gallery-counter data-storefront-counter>01 / 09</span>
  </div>

  <p class="sr-only" aria-live="polite" data-gallery-status data-storefront-status>
    Показан экран {firstSlide.label} магазина {firstSlide.project}, 1 из {STOREFRONT_SLIDES.length}
  </p>
</div>

<style>
  .gallery {
    /* 780 / 1688 = 0,462085. Высотный предел переводится в ту же ширину,
       чтобы подпись всегда совпадала со скрином и на низком ноутбуке.
       125 px оставляют место sticky-шапке, подписи и 8 px воздуха сверху
       и снизу;
       стрелки держатся рядом со скрином, а не у краёв широкой колонки. */
    --screen-target-width: min(
      390px,
      calc(46.2085dvh - 57.761px)
    );
    --screen-width: min(var(--screen-target-width), calc(100% - 112px));
    width: min(100%, 502px, calc(var(--screen-target-width) + 112px));
    height: auto;
    min-width: 0;
    margin-inline: auto;
    align-self: center;
    display: grid;
    grid-template-rows: auto auto;
    gap: 12px;
  }

  .stage {
    position: relative;
    min-width: 0;
    min-height: 0;
    display: grid;
    place-items: center;
    overflow: clip;
  }

  figure {
    margin: 0;
    width: 100%;
    min-width: 0;
    display: grid;
    place-items: center;
  }

  figure img {
    display: block;
    width: auto;
    height: min(844px, calc(100dvh - 125px));
    max-width: var(--screen-width);
    aspect-ratio: 780 / 1688;
    object-fit: contain;
    pointer-events: none;
    border: 1px solid var(--border);
  }

  .gallery[data-transitioning='out'] figure img,
  .gallery[data-transitioning='in'] figure img {
    will-change: opacity, transform;
  }

  .nav {
    position: absolute;
    top: 50%;
    z-index: 1;
    width: 44px;
    height: 44px;
    padding: 0;
    display: grid;
    place-items: center;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      color var(--dur-micro) var(--ease),
      background-color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease),
      transform var(--dur-micro) var(--ease);
  }

  .previous { left: 0; }
  .next { right: 0; }

  .nav svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .nav:hover {
    color: var(--bg);
    background: var(--text);
    border-color: var(--text);
  }

  .nav:active { transform: translateY(-50%) scale(0.94); }

  .meta {
    width: var(--screen-width);
    min-height: 32px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .store-name {
    grid-column: 2;
    color: var(--text);
    font: 700 1rem/1.2 var(--font-mono);
    text-align: center;
  }

  .counter {
    grid-column: 3;
    justify-self: end;
    color: var(--text-muted);
    font: 600 1rem/1 var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    .gallery {
      --screen-width: min(
        300px,
        calc(46.2085dvh - 92.417px),
        calc(100% - 24px)
      );
      width: min(100%, 358px);
    }

    .meta { width: var(--screen-width); }

    figure img {
      width: auto;
      height: min(649px, calc(100dvh - 200px));
      max-width: var(--screen-width);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav { transition: none; }
  }
</style>
