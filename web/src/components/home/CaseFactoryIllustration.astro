---
/* Иллюстрация «Стеллаж» (кейс «Фабрика ботов»), схема Ф-2 — D-046, бриф
 * `70-workshop/specs/site-v3/04-cases-brief.md`, раздел 6. Читать раздел 6
 * целиком: этот файл реализует заданную геометрию, а не выбирает её.
 *
 * HTML/CSS, ноль <svg> (раздел 6.1, вариант Р-2): у SVG кегль подписи падает
 * вместе с масштабом холста — измерено на «Заявке-Хаб» (11,6 px при правиле
 * «не мельче 14»). В HTML кегль всегда настоящий, рисунок перетекает по
 * ширине.
 *
 * Один узел («КАРКАС»), одна шина, четыре полки — каждая с подписью и рядом
 * меток числом FACTORY[i].themes. Ни одно число и ни одна подпись не
 * написаны в разметке руками — всё приходит из `data/factory.ts`. Пустых
 * данных не бывает: модуль данных бросает исключение на сборке, если
 * FACTORY или FACTORY_FRAME неполны (см. тот же модуль).
 *
 * D-036 — три приёма честности (раздел 6.1 брифа), все три обязательны:
 *  1. подпись под узлом называет ГЛАГОЛ ДВИЖЕНИЯ («переезжает») — язык
 *     копирования, не хаба (`FACTORY_CAPTIONS.moves`);
 *  2. стрелки только наружу: узел → шина → полки, обратной линии нет —
 *     геометрия ниже физически не рисует линию от полки к узлу;
 *  3. запрещённые подписи пучка («используется всеми», «общий для четырёх»,
 *     «подключается») нигде не встречаются — подпись жёстко равна
 *     `FACTORY_CAPTIONS.moves`, вторым литералом не подменяется.
 *
 * Рисунок неинтерактивен: `pointer-events: none`, вне таб-порядка,
 * `role="img"` с `aria-label`, собранным из тех же данных — весь визуальный
 * слой (узел, шина, полки, метки) стоит внутри `aria-hidden`, чтобы не
 * задвоить объявление программой чтения (тот же приём, что `role="img"` у
 * `<svg>` в `CaseFlowIllustration.astro`: подписи внутри — презентационные,
 * единственное произносимое — `aria-label`).
 *
 * Стили — `<style is:global>` с префиксом `cf-` (Case Factory), а не
 * скоуп Astro по умолчанию: у схемы 51 элемент (4 полки × N меток), и
 * скоуп-атрибут на каждом стоил бы ≈1,3 КБ разметки и CSS сверх бюджета
 * задачи (раздел 16 брифа, потолок прироста +6 КБ) без единого визуального
 * отличия. Префикс проверен на отсутствие коллизий с остальными
 * компонентами (`grep '\.cf-' src/components` — пусто до этого файла).
 *
 * ХОРЕОГРАФИЯ ПОЯВЛЕНИЯ (правка 2026-08-18, владелец: «должна быть слева
 * направо, а не сверху вниз»). Геометрия схемы (D-046) не меняется — меняется
 * только порядок, в котором она проявляется по прокрутке. Раньше каждый
 * элемент нёс СВОЙ анонимный `animation-timeline: view()` — таймлайн любого
 * элемента считается от его СОБСТВЕННОГО положения на странице, и четыре
 * полки, физически стоящие одна под другой, поэтому проявлялись один за
 * другим сверху вниз — просто потому, что нижняя полка позже пересекает
 * границу экрана, а не потому, что так задумано. Починка — ОДИН именованный
 * таймлайн (`view-timeline-name`, источник — `.cf-stellar` целиком), на
 * который подписываются все элементы через `animation-timeline: --cfr`.
 * Порядок появления теперь задаётся ЯВНО числом (`animation-range` на
 * каждом элементе), а не положением элемента в документе — узел, затем
 * отвод и гребёнка, затем ветки с подписями (ряды почти одновременно, с
 * малым сдвигом), затем плитки тем (тот же малый сдвиг между рядами, а
 * внутри ряда — `clip-path` неизменно раскрывает слева направо), затем
 * подпись пучка последней.
 *
 * ОСТАТОК ВЕРТИКАЛИ (правка 2026-08-19, ревью дизайна: «порядок фаз уже
 * слева направо, но `.cf-shelves` — самый длинный движущийся объект в
 * кадре — по-прежнему растёт сверху вниз, `transform: scaleY(0) → 1` от
 * `transform-origin: top center`»). Порядок фаз (выше) эту ось не трогал —
 * она внутри одной фазы 2, «гребёнка». Правка: `.cf-shelves` растёт от
 * `transform-origin: center` — точки, где к шине физически подходит
 * `.cf-branch` (`.cf-rack { align-items: center }` центрирует узел, отвод
 * и шину по одной горизонтали) — раскрытие в обе стороны от места стыка,
 * а не падение сверху. Тем же ревью отмечена узкая раскладка (< 900px,
 * `.cf-rack .cf-branch`): там отвод узла к шине физически вертикален
 * (раздел 6.5), и второй объект со `scaleY` усиливал ту же ось — вместо
 * роста он теперь проявляется прозрачностью (`cf-branch-in` — тот же
 * переход, что у `cf-node-in`, но отдельным именем, см. комментарий у
 * самого правила), геометрия отвода не меняется ни на кадр.
 */
import { FACTORY, FACTORY_CAPTIONS } from '../../data/factory';

if (FACTORY.length === 0) {
  throw new Error('CaseFactoryIllustration: FACTORY пуст — рисовать нечего.');
}

// Вес фазы 3 (полки заполняются слева направо) — весом больше у полки с
// бóльшим числом тем: длинная полка заполняется дольше короткой, картинка
// не имеет права соврать о равенстве (раздел 6.6 брифа).
function shelfFillDuration(themes: number): number {
  return 140 + themes * 20;
}

const shelfWords = FACTORY
  .map((t) => `${t.label.toLowerCase()} — ${t.themes} ${FACTORY_CAPTIONS.themes}`)
  .join(', ');
const ariaLabel =
  `Схема каркаса фабрики ботов. Узел «${FACTORY_CAPTIONS.node}» ${FACTORY_CAPTIONS.moves} ` +
  `у типов: ${shelfWords}.`;
---
<div class="cf-stellar" role="img" aria-label={ariaLabel}>
  <div class="cf-visual" aria-hidden="true">
    <div class="cf-rack">
      <div class="cf-node">
        <span class="cf-node-label">{FACTORY_CAPTIONS.node}</span>
      </div>
      <i class="cf-branch" />
      <ul class="cf-shelves">
        {FACTORY.map((t) => (
          <li class="cf-shelf" style={`--cf-dur:${shelfFillDuration(t.themes)}ms`}>
            <p class="cf-shelf-label">
              <span class="cf-name">{t.label}</span> · {t.themes} {FACTORY_CAPTIONS.themes}
            </p>
            <div class="cf-marks">
              {Array.from({ length: t.themes }).map(() => <span class="cf-mark" />)}
            </div>
          </li>
        ))}
      </ul>
    </div>
    <p class="cf-caption">{FACTORY_CAPTIONS.moves}</p>
  </div>
</div>

<style is:global>
  .cf-stellar {
    flex: 1;
    min-height: 0;
    display: flex;
    pointer-events: none;
  }
  .cf-visual {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
  }

  .cf-rack {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  /* Узел — коробка 96×64, острые углы: чертёжный узел, не карточка (раздел
     6.1/6.2). Акцент — ровно один объект рисунка: кромка узла, от которой
     начинается пучок (раздел 6.2). */
  .cf-node {
    flex: 0 0 96px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--stroke-bold) solid var(--text);
    border-right-color: var(--accent);
    background: var(--bg);
  }
  .cf-node-label {
    font: 500 1rem/1.3 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
  }

  /* Отрезок узел → шина (раздел 6.2: «от узла к шине — горизонтальный
     отрезок»). Декоративный элемент — тот же приём, что `.fp-legs i` у
     снятой плиты: соединительная графика не несёт текста. */
  .cf-branch {
    display: block;
    flex: 0 0 32px;
    height: 0;
    border-top: var(--stroke-line) solid var(--text);
    transform-origin: left center;
  }

  /* Шина — вертикальная линия слева от списка полок (`border-left`, раздел
     6.2), от верхней полки до нижней. Стержни к каждой полке — `::before`
     полки (`border-top`, 16px) — не отдельные элементы. */
  .cf-shelves {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-left: var(--stroke-line) solid var(--text);
    /* Точка стыка с `.cf-branch`, не верхний край (правка 2026-08-19,
       комментарий у шапки файла): растёт в обе стороны от места, где шину
       встречает отвод узла — раскрытие, а не падение сверху вниз. */
    transform-origin: center;
  }

  .cf-shelf {
    position: relative;
    padding-left: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cf-shelf::before {
    content: '';
    position: absolute;
    left: 0;
    top: 12px; /* примерный вертикальный центр строки подписи */
    width: 16px;
    height: 0;
    border-top: var(--stroke-line) solid var(--text);
    transform-origin: left center;
  }

  .cf-shelf-label {
    margin: 0;
    font: 500 1rem/1.3 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
  .cf-shelf-label .cf-name {
    color: var(--text);
    text-transform: uppercase;
  }

  /* Метки тем — ряд из N квадратов 12×12, шаг 16 (gap 4). Длина ряда — не
     литерал, а естественная сумма N элементов: лестница длин 12·8·6·6
     (раздел 6.2) получается сама, без пересчёта пикселей в разметке.
     Радиус 2 — не карточка (раздел 6.2), не путать с `--radius-sm`. */
  .cf-marks {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .cf-mark {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
    border-radius: 2px;
    background: var(--border);
    border: 1px solid var(--text-muted);
  }

  /* Подпись пучка — несущая конструкция честности блока (D-036, раздел
     6.3). Не сокращается, не прячется ни при каких условиях (раздел 9). */
  .cf-caption {
    margin: 0;
    font: 500 1rem/1.4 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Раскрой Б — ниже 900 px (тот же порог, что у навигации и соседей).
     Узел уходит наверх, шина становится вертикальной СВЯЗКОЙ под узлом:
     `.cf-rack` меняет ось (`flex-direction: column`), отрезок узел → шина
     поворачивается на 90° тем же элементом — не второй копией разметки
     (раздел 6.5: «переключается медиазапросом на одном и том же HTML»). */
  @media (max-width: 899px) {
    .cf-rack {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }
    .cf-branch {
      flex: 0 0 16px;
      width: 0;
      height: 16px;
      border-top: none;
      border-left: var(--stroke-line) solid var(--text);
      transform-origin: top center;
      margin-left: 47px; /* вертикаль под серединой узла (96px / 2 − 1px) */
    }
    .cf-shelves {
      width: 100%;
    }

    /* Раскрой Б поворачивает отрезок узел → шина на 90° (`.cf-branch`
       выше) — на этой ширине он и так физически вертикален, а `.cf-shelves`
       рядом (правка 2026-08-19) растёт из своего центра, а не сверху вниз.
       Второй объект с ростом по той же оси только усиливал бы вертикальное
       чтение (ревью дизайна, комментарий у шапки файла), поэтому фаза 2
       здесь — не рост, а проявление прозрачностью (`cf-node-in`, тот же
       кадр, что у узла и подписи пучка): геометрия отвода не искажается ни
       на кадр, раздел 8.1 соблюдён без растяжения по оси. Селектор
       `.cf-rack .cf-branch` — с одним классом-предком, специфичность
       (0,0,2,0) — нарочно выше, чем у общего `.cf-branch` из фазы 2 ниже
       (0,0,1,0): два правила задают РАЗНОЕ поведение для узкой и широкой
       раскладки, и без перевеса в специфичности победитель зависел бы от
       порядка блоков в файле, а не от ширины экрана.

       Кадр — `cf-branch-in`, не `cf-node-in` (тот же переход `opacity 0→1`,
       но отдельное имя): тест `factory-shelf.spec.ts`
       (`cutSupportsBlock`) находит блок «Стеллажа» по подстроке
       `cf-node-in` и вырезает ПЕРВЫЙ `@supports`, где она встретилась —
       если бы этот вложенный в `@media` блок тоже нёс `cf-node-in`, тест
       вырезал бы его вместо основного блока (узел/подпись/шина/ветки) и
       перестал бы проверять запасное состояние на широкой раскладке, для
       которой он и написан. */
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .cf-rack .cf-branch {
          transform: none;
          opacity: 0;
          animation-name: cf-branch-in;
        }
      }
    }
  }

  /* Запасное состояние — состояние ПО УМОЛЧАНИЮ (раздел 8.1): без блока
     ниже узел, шина, стержни и полки уже полностью нарисованы. Анимация —
     только внутри `@supports`, поверх готового рисунка, никогда наоборот.

     Один именованный таймлайн (`--cfr`), источник — `.cf-stellar`
     целиком: все фазы читают ОДНУ и ту же прокрутку, поэтому порядок между
     ними решает исключительно `animation-range` (число), а не собственное
     положение элемента в потоке документа (это и было причиной «сверху
     вниз» — см. комментарий у шапки файла).

     ДИАПАЗОН — `contain`, не `entry` (правка 2026-08-19, второе замечание
     того же ревью дизайна: «анимация заканчивается до того, как на неё
     посмотрят — полное состояние достигается примерно за 300px до того,
     как схема встаёт в кадр»). Замер той же схемы на 1440×1000
     (`.tmp/measure-range.mjs`, не входит в репозиторий): при живой
     `entry`-хореографии узел начинал проявляться на scrollY=5975 — ровно
     там же, где `.cf-stellar` показывает первый пиксель, — а подпись
     пучка завершалась на scrollY=6263, и это ЧИСЛО В ЧИСЛО совпадало со
     scrollY, на котором схема впервые становится видна ЦЕЛИКОМ (замер:
     `fullyVisibleStart=6263`). Пока схема въезжает в кадр — идёт вся
     анимация; как только она встала в кадр — на неё уже нечего смотреть,
     дальше и до `fullyVisibleEnd=6971` (ещё ≈700px прокрутки) — готовая
     картинка. `entry` физически не может дать диапазон ПОСЛЕ полного
     появления: 100% этой фазы по определению есть момент полного входа.
     Нужный кусок прокрутки — `contain` (0% = впервые целиком в кадре,
     100% = начинает выходить), тот же замер даёт под него ≈708px. Пять фаз
     ниже используют те же СООТНОШЕНИЯ, что были в `entry` (0/10/14/22/
     /25/26/40/43/68/85/100), пересчитанные в диапазон 0–65% этого окна
     (коэффициент 0,65) — показ идёт, пока схема уже целиком в кадре, и
     оставляет ≈35% окна (≈250px) на готовую картинку до начала выхода. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .cf-stellar {
        view-timeline-name: --cfr; /* ось по умолчанию block — прокрутка вниз, ось не переопределяем */
      }

      /* Фазы 1 и 5 — узел и подпись пучка: общий кадр появления
         (`cf-node-in`, прозрачность), различается только `animation-range`
         — узел первым, подпись пучка последней (раздел «что требуется»,
         пункты 1 и 5). */
      .cf-node,
      .cf-caption {
        opacity: 0;
        animation-timeline: --cfr;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-name: cf-node-in;
        animation-duration: 60ms;
      }
      .cf-node { animation-range: contain 0% contain 9%; }
      .cf-caption { animation-range: contain 55% contain 65%; }

      /* Фаза 2 — отвод узла и вертикальная гребёнка (шина), следом за узлом. */
      .cf-branch,
      .cf-shelves {
        animation-timeline: --cfr;
        animation-range: contain 7% contain 17%;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-duration: 140ms;
      }
      .cf-branch {
        transform: scaleX(0);
        animation-name: cf-line-x-in;
      }
      .cf-shelves {
        transform: scaleY(0);
        animation-name: cf-line-y-in;
      }

      /* Фаза 3 — ветки (стержень к полке) и их подписи, следом за
         гребёнкой. Чётные ряды сдвинуты на 3 п.п. позже нечётных — «почти
         одновременно, с малым сдвигом» (раздел «что требуется»), а не
         строгая очередь сверху вниз: сдвиг задан НОМЕРОМ ряда (`nth-child`),
         а не унаследован от вертикальной позиции полки на странице — та
         связь и была причиной прежнего дефекта. */
      .cf-shelf::before,
      .cf-shelf-label {
        animation-timeline: --cfr;
        animation-range: contain 14% contain 26%;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-duration: 100ms;
      }
      .cf-shelf::before {
        transform: scaleX(0);
        animation-name: cf-line-x-in;
      }
      .cf-shelf-label {
        opacity: 0;
        animation-name: cf-node-in;
      }
      .cf-shelf:nth-child(even)::before,
      .cf-shelf:nth-child(even) .cf-shelf-label {
        animation-range: contain 16% contain 28%;
      }

      /* Фаза 4 — плитки тем: каждый ряд заполняется слева направо
         (`clip-path` сужается от правого края к нулю — направление не
         менялось и не было причиной прежнего дефекта). Ряды почти
         одновременно (бюджет веса раздела 16 брифа не даёт четвёртого
         набора чисел на сдвиг рядов — малый сдвиг уже виден на фазе 3),
         после её конца. */
      .cf-marks {
        clip-path: inset(0 100% 0 0);
        animation-timeline: --cfr;
        animation-range: contain 26% contain 44%;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-name: cf-marks-in;
        animation-duration: var(--cf-dur);
      }
    }
  }

  @keyframes cf-node-in { to { opacity: 1; } }
  @keyframes cf-branch-in { to { opacity: 1; } }
  @keyframes cf-line-x-in { to { transform: scaleX(1); } }
  @keyframes cf-line-y-in { to { transform: scaleY(1); } }
  @keyframes cf-marks-in { to { clip-path: inset(0 0 0 0); } }
</style>
