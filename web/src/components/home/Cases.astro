---
/* Секция 5 — кейсы. Три полноширинных блока (бриф `70-workshop/specs/
 * site-v3/04-cases-brief.md`), не карточки: слева короткий текст, справа —
 * иллюстрация. Стороны чередуются (раздел 2.1 брифа) — рисуется циклом по
 * `homeCases()`, а не тремя ручными блоками, чтобы порядок и зеркало
 * читались из данных, а не дублировались в разметке. Текст читается из
 * `data/cases.ts` — единственного источника, второй ручной копии здесь нет.
 *
 * Четвёртым блоком до 2026-08-19 стояла «Фабрика ботов» со схемой «Стеллаж»
 * (D-048). Владелец снял её с главной — вместе с блоком ушли рисунок
 * `CaseFactoryIllustration.astro`, его данные `data/factory.ts` и строка
 * «что переезжает» (проп `frame` у `CaseRow`), у которой других читателей
 * не было. Ничего условного «на случай возврата» здесь не остаётся: код
 * лежит в истории репозитория.
 */
import Label from '../Label.astro';
import Button from '../Button.astro';
import CaseRow from './CaseRow.astro';
import CaseWeightIllustration from './CaseWeightIllustration.astro';
import CaseFlowIllustration from './CaseFlowIllustration.astro';
import CaseDialogueIllustration from './CaseDialogueIllustration.astro';
import { homeCases, CASES_CATALOG_HREF } from '../../data/cases';

const cases = homeCases();

/* Высота поля иллюстрации — своя у каждого блока, кратная 32, в коридоре
 * 288…448 (бриф `70-workshop/specs/site-v3/02-case-illustrations.md`, раздел
 * 2.1). Число здесь, а не в `data/cases.ts`: это решение вёрстки секции 5, а
 * не факт о кейсе.
 *
 * Исключение — «Пример диалога»: `70-workshop/specs/site-v3/
 * 04-cases-brief.md`, раздел 4.7, задаёт 576 (от 900 px) дословно, по составу
 * — шапка окна (метка + линия) + четыре пузыря переписки (пузырь бота с
 * блоком источника — самый высокий) + строка ввода 48. Число проверено
 * замером собранной страницы (раздел 13, пункт 9 брифа): поле не
 * прокручивается и ни одна реплика не обрезана на 900…1440 px. */
const ILLUSTRATION_HEIGHT: Record<string, number> = {
  'site-v3': 384,
  'zayavka-hub': 352,
  'ai-consultant': 576,
};

/* У «Заявки-Хаба» отдельной мобильной высоты БОЛЬШЕ НЕТ (бриф
 * `07-flow-motion-brief.md`, раздел 2): поле держит 352 px на всех ширинах.
 * Прежние 544 обслуживали вертикальную колонку 320×480 раскроя Б — она и
 * была источником дефекта: на 900…1179 px поле даёт 286 по высоте, и рисунок
 * срезался на 194 px, сорок процентов, включая весь возврат. Раскрой Б
 * переразмечен под холст 320×272 и помещается в 352 на всех ширинах, а
 * секция на мобильной ширине стала на 192 px короче. */

/* «Пример диалога» ниже 899 px: высота задана брифом дословно (`70-workshop/
 * specs/site-v3/04-cases-brief.md`, раздел 4.7) — 672, а не расчётом от
 * прежнего устройства (список цитат без шапки и строки ввода). Состав
 * изменился — четыре пузыря мессенджера плюс статичные шапка (метка + линия)
 * и строка ввода — и число пересчитано под новый состав. Кратно 32,
 * проверяется замером после вёрстки (раздел 13, пункт 9): поле не
 * прокручивается и ни одна реплика не обрезана. */
const AI_CONSULTANT_MOBILE_HEIGHT = 672;

/* «Замер» ниже 899 px: композиция владельца 2026-08-19 — четыре числа с
   подписями, вывод и оговорка. На узкой колонке подпись под числом уходит на
   три строки, а оговорка на две, и в 384 раскрой не помещается — замер
   `e2e/case-weight-fit.spec.ts` на 390 px: содержимому нужно 339 px при
   доступных 320. 416 (кратно 32, в коридоре 288…448 раздела 2.1 брифа) даёт
   352 при 327 после поджатия промежутков — запас, а не впритык. */
const SITE_V3_MOBILE_HEIGHT = 416;

const MOBILE_HEIGHT: Record<string, number | undefined> = {
  'site-v3': SITE_V3_MOBILE_HEIGHT,
  'ai-consultant': AI_CONSULTANT_MOBILE_HEIGHT,
};

/* Компонент иллюстрации по slug — читается циклом, не тремя ручными
 * блоками (бриф, раздел 2.1: чередование сторон выражается формулой, а не
 * флагом у каждого блока). */
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const ILLUSTRATIONS: Record<string, any> = {
  'site-v3': CaseWeightIllustration,
  'zayavka-hub': CaseFlowIllustration,
  'ai-consultant': CaseDialogueIllustration,
};

---
<Label>ЧТО УЖЕ СДЕЛАНО</Label>
<h2 class="t-h2">Кейсы</h2>

<div class="rows">
  {cases.map((item) => {
    const Illustration = ILLUSTRATIONS[item.slug];
    return (
      <CaseRow
        item={item}
        mirrored={(item.homeOrder ?? 0) % 2 === 0}
        illustrationHeight={ILLUSTRATION_HEIGHT[item.slug]}
        illustrationMobileHeight={MOBILE_HEIGHT[item.slug]}
      >
        {Illustration && <Illustration />}
      </CaseRow>
    );
  })}
</div>

{/* Класс 2 «В каталог» (D-047, бриф раздел 3.3) — ровно та форма, что
    принята для «Все услуги» (`Services.astro`): контурная кнопка
    `Button.astro`, без стрелки — два разных вида одной роли (стрелка уже
    занята меткой класса 1 «Разобрать кейс →») были бы той самой болезнью,
    которую вариант В лечит. Собственных стилей `.all-cases a` не остаётся:
    цвет, радиус, контур, кегль и высота 44 приходят из `Button.astro`. */}
<p class="all-cases">
  <Button href={CASES_CATALOG_HREF} variant="secondary">Все кейсы</Button>
</p>

<style>
  .rows {
    margin: 32px 0 0;
    border-top: 1px solid var(--border);
  }
  .rows :global(.row:last-child) { border-bottom: none; }

  .all-cases {
    margin: 32px 0 0;
  }
</style>
