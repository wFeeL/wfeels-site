---
/* Секция 5 — кейс. Полноширинный блок (бриф `70-workshop/specs/site-v3/
 * 04-cases-brief.md`), не карточка: слева короткий текст, справа —
 * иллюстрация. Рисуется циклом по `homeCases()`, а не одним ручным блоком:
 * состав и порядок читаются из данных, и возврат второго кейса будет
 * правкой `data/cases.ts`, а не перевёрсткой секции. Текст читается из
 * `data/cases.ts` — единственного источника, второй ручной копии здесь нет.
 *
 * Блок с 2026-08-20 ОДИН — правка владельца: на главной остаётся «Этот
 * сайт», остальные кейсы уходят на страницу каталога (спека 04). Тогда же
 * снята кнопка «Все кейсы»: страницы `/cases` не существует, и кнопка вела
 * в 404. Кнопка вернётся вместе со страницей, а не раньше неё.
 *
 * Заголовок секции поэтому «Кейс», в единственном числе, и метка рельса —
 * «КЕЙС» (`lib/sections.ts`): заголовок во множественном числе над одним
 * блоком читался бы как недогрузившийся список.
 *
 * Рисунки снятых кейсов (`CaseFlowIllustration.astro`,
 * `CaseDialogueIllustration.astro`) остаются в коде и ждут ту же страницу
 * каталога. Здесь они больше не импортируются: импорт без вывода тянул бы
 * их разметку и стили в вес главной.
 */
import Label from '../Label.astro';
import CaseRow from './CaseRow.astro';
import CaseWeightIllustration from './CaseWeightIllustration.astro';
import { homeCases } from '../../data/cases';

const cases = homeCases();

/* Высота поля иллюстрации — своя у каждого блока, кратная 32, в коридоре
 * 288…448 (бриф `70-workshop/specs/site-v3/02-case-illustrations.md`, раздел
 * 2.1). Число здесь, а не в `data/cases.ts`: это решение вёрстки секции 5, а
 * не факт о кейсе.
 *
 * Исключения из коридора БОЛЬШЕ НЕТ. «Пример диалога» держал 576/672 под
 * четыре реплики; с переработкой окна переписки 2026-08-19 (решение
 * владельца: ровно одна пара реплик, метка поля снята) содержимое требует
 * максимум 360 px — это на ширинах 390…900, где вопрос переносится на две
 * строки. 360 + 64 поля паспарту = 424, ближайшее кратное 32 сверху — 448,
 * верхняя граница коридора. Одна высота на все ширины: отдельной мобильной
 * больше не нужно. Замер живой сборки на 390/900/1180/1440 в обеих темах:
 * поле не прокручивается ни по одной оси. */
const ILLUSTRATION_HEIGHT: Record<string, number> = {
  'site-v3': 384,
};

/* Отдельная мобильная высота осталась одна — у «Замера», и заведена она в
 * обратную сторону: не потому что рисунок не влезал по старой мерке, а
 * потому что замер показал нехватку. Проп `illustrationMobileHeight`
 * (`CaseRow.astro` → `CaseIllustrationField.astro`) остаётся объявленным: он
 * общий механизм поля, а не приспособление под конкретный рисунок. */

/* «Замер» ниже 899 px: композиция владельца 2026-08-19 — четыре числа с
   подписями и вывод. На узкой колонке подпись под числом уходит на три
   строки, и в 384 раскрой не помещается — замер `e2e/case-weight-fit.spec.ts`
   на 390 px: содержимому нужно 339 px при доступных 320. 416 (кратно 32, в
   коридоре 288…448 раздела 2.1 брифа) даёт 352 при 327 после поджатия
   промежутков — запас, а не впритык.

   Замер (339 px) снят ДО правки владельца 2026-08-21, которая сняла с рисунка
   строку-оговорку «ПОЛНАЯ ЗАГРУЗКА ПРИ 10 МБИТ/С»: содержимого с тех пор
   стало меньше, а не больше, поэтому 416 остаётся запасом, не дефицитом;
   переполнения `e2e/case-weight-fit.spec.ts` по-прежнему не находит. */
const SITE_V3_MOBILE_HEIGHT = 416;

const MOBILE_HEIGHT: Record<string, number | undefined> = {
  'site-v3': SITE_V3_MOBILE_HEIGHT,
};

/* Компонент иллюстрации по slug — читается тем же циклом, что и текст.
 * Запись остаётся картой, а не единственной переменной: второй кейс на
 * главной будет строкой здесь и строкой в `data/cases.ts`, без правки
 * разметки. */
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const ILLUSTRATIONS: Record<string, any> = {
  'site-v3': CaseWeightIllustration,
};

---
<Label>ЧТО УЖЕ СДЕЛАНО</Label>
<h2 class="t-h2">Кейс</h2>

<div class="rows">
  {cases.map((item) => {
    const Illustration = ILLUSTRATIONS[item.slug];
    return (
      <CaseRow
        item={item}
        mirrored={(item.homeOrder ?? 0) % 2 === 0}
        illustrationHeight={ILLUSTRATION_HEIGHT[item.slug]}
        illustrationMobileHeight={MOBILE_HEIGHT[item.slug]}
      >
        {Illustration && <Illustration />}
      </CaseRow>
    );
  })}
</div>

<style>
  .rows {
    margin: 32px 0 0;
    border-top: 1px solid var(--border);
  }
  .rows :global(.row:last-child) { border-bottom: none; }
</style>
