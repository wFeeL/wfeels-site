---
/* Секция 5 — кейсы. Полноширинные блоки (бриф `70-workshop/specs/site-v3/
 * 04-cases-brief.md`), не карточки: слева короткий текст, справа —
 * иллюстрация. Рисуется циклом по `homeCases()`, а не одним ручным блоком:
 * состав и порядок читаются из данных: добавление второго кейса потребовало
 * записи в `data/cases.ts`, а не перевёрстки секции. Текст читается из
 * `data/cases.ts` — единственного источника, второй ручной копии здесь нет.
 *
 * С 2026-08-24 блоков три: к «Этому сайту» добавлены Telegram Mini App и
 * сайты с тремя самостоятельными визуальными направлениями. После выпуска
 * detail-страниц заголовки снова ведут на них; адрес строится тем же модулем
 * данных, что и каталог, поэтому ссылка не может жить отдельно от маршрута.
 *
 * Рисунки снятых кейсов (`CaseFlowIllustration.astro`,
 * `CaseDialogueIllustration.astro`) остаются в коде и ждут ту же страницу
 * каталога. Здесь они больше не импортируются: импорт без вывода тянул бы
 * их разметку и стили в вес главной.
 */
import Label from '../Label.astro';
import CaseRow from './CaseRow.astro';
import CaseWeightIllustration from './CaseWeightIllustration.astro';
import StorefrontGallery from './StorefrontGallery.astro';
import WebsiteGallery from './WebsiteGallery.astro';
import { CASES_CATALOG_HREF, caseHref, homeCases } from '../../data/cases';
import { dict, localeFromPath } from '../../i18n/locales';

const locale = localeFromPath(Astro.url.pathname);
const t = dict(locale);

const cases = homeCases(locale);

/* Высота поля иллюстрации — своя у каждого блока, кратная 32, в коридоре
 * 288…448 (бриф `70-workshop/specs/site-v3/02-case-illustrations.md`, раздел
 * 2.1). Число здесь, а не в `data/cases.ts`: это решение вёрстки секции 5, а
 * не факт о кейсе. Для Telegram Mini App значения 800/704 остаются в общем
 * интерфейсе поля, но вариант `bare` снимает фиксированную высоту: прозрачный
 * контейнер следует за адаптивным скрином, подписью и стрелками и не хранит
 * невидимую пустоту. Сам скрин ограничен высотой окна.
 *
 * «Замер» (slug `site-v3`) в этой карте БОЛЬШЕ НЕТ. Была фиксированная
 * 384/416 (см. историю ниже) — под готовым рисунком (222…237 px по факту
 * содержимого) в коробке 320…352 px свободной высоты (после вычета паспарту)
 * оставался запас 50…60 px СВЕРХУ И СНИЗУ разом, потому что `.weight` внутри
 * поля центрирован (`justify-content: center`). На странице кейса та же
 * иллюстрация стоит в панели БЕЗ фиксированной высоты (`CaseSpread.astro`,
 * `.frame.inset`, П-3 брифа `12-case-pages-brief.md`) и собрана вплотную —
 * подтверждено сторожем `e2e/case-spread-fill.spec.ts`, который отдельно
 * фиксировал разницу («поле «Замера» на главной ниже порога… раздел 4.5
 * брифа переносит рисунок в панель разворота отдельной задачей»). Эта задача
 * и есть перенос: `CaseIllustrationField` получил тот же авторазмер под
 * содержимое, что и `.frame.inset` (проп `height` необязателен), и «Замер»
 * на карту высот больше не претендует — только `storefront`/`websites`. */
const ILLUSTRATION_HEIGHT: Partial<Record<string, number>> = {
  storefront: 800,
  websites: 416,
};

const MOBILE_HEIGHT: Partial<Record<string, number>> = {
  storefront: 704,
  websites: 288,
};

/* Компонент иллюстрации по slug — читается тем же циклом, что и текст.
 * Запись остаётся картой: новый кейс требует только новой пары slug →
 * компонент, без отдельной ручной разметки строки. */
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const ILLUSTRATIONS: Record<string, any> = {
  'site-v3': CaseWeightIllustration,
  storefront: StorefrontGallery,
  websites: WebsiteGallery,
};

---
<Label>{t.casesLabel}</Label>
<h2 class="t-h2">{t.casesHeading}</h2>

<div class="rows">
  {cases.map((item) => {
    const Illustration = ILLUSTRATIONS[item.slug];
    return (
      <CaseRow
        item={item}
        mirrored={(item.homeOrder ?? 0) % 2 === 0}
        illustrationHeight={ILLUSTRATION_HEIGHT[item.slug]}
        illustrationMobileHeight={MOBILE_HEIGHT[item.slug]}
        illustrationBare={item.slug === 'storefront' || item.slug === 'websites'}
        {/* Раздел 5.2 брифа `15-line-through-scale-brief.md`: единственное
            поле секции, которое реестр 12.5 называет пересечённым —
            «лист «Замера»» (`CaseWeightIllustration`, slug `site-v3`).
            `storefront`/`websites` идут `bare` (см. выше) — паспарту у них
            нет вовсе, целью становиться нечему. */}
        illustrationTrace={item.slug === 'site-v3'}
        centerCopy={item.slug === 'storefront' || item.slug === 'websites'}
        href={caseHref(item.slug)}
        hreflang={locale === 'en' ? 'ru' : undefined}
      >
        {Illustration && <Illustration />}
      </CaseRow>
    );
  })}
</div>

{/* Ссылка на каталог `/cases` (D-068 снята правкой владельца, условие
    «вела в никуда» отпало: каталог построен, отдаёт 200, на нём пять
    кейсов, `dist-cases.test.ts` это проверяет). Без неё каталог был
    достижим только через хлебную крошку detail-страницы — то есть только
    для того, кто уже стоит на кейсе. Разметка и стили — тот же приём, что
    у ссылок-переходов в `.links a` (`ServiceCard.astro`): текст плюс
    стрелка-`span`, стрелка сдвигается и текст меняет цвет при наведении и
    фокусе. Кнопкой не сделана нарочно — это не второе главное действие
    секции, а честный минимум, отдельный от «Все услуги»
    (`Services.astro`), который решает другую задачу — уводит с каталога
    услуг, а не в каталог кейсов. */}
<p class="all-cases">
  <a href={CASES_CATALOG_HREF}>{t.casesAll} <span aria-hidden="true">→</span></a>
</p>

{/* Общий контроллер двух галерей находится в самом `Cases.astro`, а не в
     компонентах, переданных через слот: их обычный поднятый Astro-скрипт
     теряется при сборке (ловушка 1 в `50-code/CLAUDE.md`). Здесь скрипт
     безопасно собирается в один сжатый модуль и видит обе готовые строки. */}
<script>
  (function () {
    var manifestPromise;
    var loadManifest = function (url) {
      if (!manifestPromise) {
        manifestPromise = fetch(url).then(function (response) {
          if (!response.ok) throw new Error('Gallery manifest unavailable');
          return response.json();
        });
      }
      return manifestPromise;
    };

    var init = function () {
      var isEnglish = document.documentElement.lang === 'en';
      document.querySelectorAll('[data-case-gallery]').forEach(function (root) {
        if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;

        var slidesUrl = root.dataset.slidesSrc;
        var galleryKey = root.dataset.galleryKey;
        var image = root.querySelector('[data-gallery-screen]');
        var counter = root.querySelector('[data-gallery-counter]');
        var projectName = root.querySelector('[data-gallery-project]');
        var status = root.querySelector('[data-gallery-status]');
        var buttons = Array.from(root.querySelectorAll('[data-step]'));
        if (!slidesUrl || !galleryKey || !(image instanceof HTMLImageElement) || !counter ||
            !projectName || !status) return;

        var slides = [];
        var currentIndex = 0;
        var switching = false;
        var loaded = root.dataset.defer !== 'true';
        var queuedSteps = [];
        /* Правка 3 очереди: тап на кнопку до готовности данных раньше просто
           терялся — кнопка была `disabled`. Теперь кнопка кликабельна с
           первого кадра, и такой тап запоминается здесь и проигрывается,
           как только `revealDeferred()` заканчивается (см. её хвост ниже),
           вместо того чтобы требовать повторного нажатия. */
        var pendingStep = null;
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        var ensureSlides = async function () {
          if (slides.length > 0) return slides;
          var manifest = await loadManifest(slidesUrl);
          var nextSlides = manifest[galleryKey];
          if (!Array.isArray(nextSlides) || nextSlides.length === 0) {
            throw new Error('Gallery data unavailable');
          }
          slides = nextSlides;
          return slides;
        };

        var setButtonsDisabled = function (disabled) {
          buttons.forEach(function (button) {
            if (button instanceof HTMLButtonElement) button.disabled = disabled;
          });
        };

        var show = function (nextIndex) {
          currentIndex = (nextIndex + slides.length) % slides.length;
          var slide = slides[currentIndex];
          if (!slide) return;

          image.alt = slide.alt;
          image.src = slide.src;
          projectName.textContent = slide.project;
          counter.textContent = String(currentIndex + 1).padStart(2, '0') + ' / ' +
            String(slides.length).padStart(2, '0');
          var detail = isEnglish
            ? slide.project + ' ' + slide.subject + ' ' + slide.label.toLowerCase() + ' screen'
            : slide.label + ' ' + slide.subject + ' ' + slide.project;
          status.textContent = (isEnglish ? 'Showing ' : 'Показан экран ') + detail + ', ' +
            String(currentIndex + 1) + (isEnglish ? ' of ' : ' из ') + String(slides.length);
        };

        var waitForImageLoad = function (candidate) {
          if (candidate.complete) {
            return candidate.naturalWidth > 0
              ? Promise.resolve()
              : Promise.reject(new Error('Gallery image unavailable'));
          }
          return new Promise(function (resolve, reject) {
            candidate.addEventListener('load', function () { resolve(); }, { once: true });
            candidate.addEventListener('error', function () {
              reject(new Error('Gallery image unavailable'));
            }, { once: true });
          });
        };

        /* Safari и некоторые Chromium-сборки могут отклонить `decode()` при
           смене ресурса, хотя сам файл чуть позже успешно приходит по сети.
           Такой отказ не означает, что изображение сломано: ждём `load`, а не
           считаем предзагрузку завершённой и не подменяем видимый кадр белым. */
        var decodeImage = function (candidate) {
          var loaded = waitForImageLoad(candidate);
          return typeof candidate.decode === 'function'
            ? candidate.decode().catch(function () { return loaded; })
            : loaded;
        };

        var preload = function (slide) {
          var candidate = new Image();
          candidate.decoding = 'async';
          candidate.src = slide.src;
          return decodeImage(candidate);
        };

        var waitForAnimation = function (animation) {
          return animation.finished.catch(function () {});
        };

        var revealDeferred = async function () {
          if (loaded || switching) return;
          switching = true;
          root.dataset.transitioning = 'preload';
          try {
            await ensureSlides();
            await preload(slides[0]);
            show(0);
            await decodeImage(image);
            loaded = true;
            root.dataset.loaded = 'true';
            root.setAttribute('aria-busy', 'false');
            if (!reduceMotion.matches) {
              root.dataset.transitioning = 'initial';
              var initial = image.animate([
                { opacity: 0, transform: 'translate3d(0, 8px, 0)' },
                { opacity: 1, transform: 'translate3d(0, 0, 0)' },
              ], {
                duration: 320,
                easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                fill: 'both',
              });
              await waitForAnimation(initial);
              initial.cancel();
            }
          } catch (_error) {
            root.dataset.error = 'true';
            root.setAttribute('aria-busy', 'false');
            status.textContent = isEnglish
              ? 'Gallery screens could not be loaded'
              : 'Не удалось загрузить экраны галереи';
          } finally {
            root.dataset.transitioning = 'idle';
            switching = false;
            if (loaded) setButtonsDisabled(false);
          }
          /* Направление, запрошенное тапом во время загрузки, проигрывается
             только теперь — после того, как `switching` уже снят веткой
             `finally` выше, иначе `switchBy` увидел бы галерею занятой и
             просто поставил бы шаг в `queuedSteps` второй раз. */
          if (loaded && pendingStep !== null) {
            var step = pendingStep;
            pendingStep = null;
            switchBy(step);
          }
        };

        var switchBy = async function (step) {
          if (!loaded) {
            pendingStep = step;
            revealDeferred();
            return;
          }
          if (switching) {
            queuedSteps.push(step);
            return;
          }

          switching = true;
          var previousIndex = currentIndex;
          var targetIndex = currentIndex;
          var slide;
          var direction = step < 0 ? -1 : 1;
          var outgoing;
          var incoming;
          var shown = false;

          try {
            await ensureSlides();
            targetIndex = (currentIndex + step + slides.length) % slides.length;
            slide = slides[targetIndex];
            if (!reduceMotion.matches) {
              root.dataset.transitioning = 'preload';
              await preload(slide);
              root.dataset.transitioning = 'out';
              outgoing = image.animate([
                { opacity: 1, transform: 'translate3d(0, 0, 0)' },
                { opacity: 0, transform: 'translate3d(' + String(direction * -12) + 'px, 0, 0)' },
              ], {
                duration: 160,
                easing: 'cubic-bezier(0.4, 0, 1, 1)',
                fill: 'both',
              });
              await waitForAnimation(outgoing);
            }

            show(targetIndex);
            shown = true;

            if (!reduceMotion.matches) {
              await decodeImage(image);
              root.dataset.transitioning = 'in';
              incoming = image.animate([
                { opacity: 0, transform: 'translate3d(' + String(direction * 12) + 'px, 0, 0)' },
                { opacity: 1, transform: 'translate3d(0, 0, 0)' },
              ], {
                duration: 280,
                easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                fill: 'both',
              });
              if (outgoing) outgoing.cancel();
              await waitForAnimation(incoming);
            }
          } catch (_error) {
            if (shown) {
              show(previousIndex);
              status.textContent = isEnglish
                ? 'The new screen could not be loaded; the previous one is still shown'
                : 'Не удалось загрузить новый экран, показан предыдущий';
            } else if (slide) {
              status.textContent = isEnglish
                ? 'The new screen could not be loaded; the previous one is still shown'
                : 'Не удалось загрузить новый экран, показан предыдущий';
            } else if (!slide) {
              root.dataset.error = 'true';
              status.textContent = isEnglish
                ? 'Gallery screens could not be loaded'
                : 'Не удалось загрузить экраны галереи';
              setButtonsDisabled(true);
            }
          } finally {
            if (outgoing) outgoing.cancel();
            if (incoming) incoming.cancel();
            root.dataset.transitioning = 'idle';
            switching = false;
            var queuedStep = queuedSteps.shift();
            if (queuedStep) switchBy(queuedStep);
          }
        };

        buttons.forEach(function (button) {
          button.addEventListener('click', function () {
            switchBy(Number(button.getAttribute('data-step')));
          });
        });

        root.dataset.transitioning = 'idle';
        root.dataset.ready = 'true';
        if (loaded) {
          root.dataset.loaded = 'true';
          root.setAttribute('aria-busy', 'false');
          setButtonsDisabled(false);
        } else {
          /* Кнопки НЕ гасятся здесь (`setButtonsDisabled(true)` снято правкой
             3 очереди): `switchBy` сам ставит направление в `pendingStep` и
             запускает `revealDeferred()`, если тап пришёл раньше срабатывания
             наблюдателя ниже — эту гонку решает `if (loaded || switching)
             return;` в самой `revealDeferred`, вызов идемпотентен. */
          if ('IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function (entries) {
              if (!entries.some(function (entry) { return entry.isIntersecting; })) return;
              observer.disconnect();
              revealDeferred();
            }, { rootMargin: '400px 0px' });
            observer.observe(root);
          } else {
            revealDeferred();
          }
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
</script>

<style>
  .rows {
    margin: 32px 0 0;
    border-top: 1px solid var(--border);
  }
  .rows :global(.row:last-child) { border-bottom: none; }

  /* Тот же приём, что `.links a` в `ServiceCard.astro`: текст плюс стрелка,
     цвет и сдвиг стрелки при наведении/фокусе, цель нажатия не меньше
     44 px. Второй словарь того же правила здесь не заводится — это разметка
     другой секции, но решение то же самое, повторено, а не изобретено
     заново. */
  .all-cases {
    margin: 24px 0 0;
  }
  .all-cases a {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
  }
  .all-cases a span { color: var(--accent); transition: translate var(--dur-micro) var(--ease); }
  .all-cases a:hover,
  .all-cases a:focus-visible {
    color: var(--accent);
  }
  .all-cases a:hover span,
  .all-cases a:focus-visible span { translate: 4px 0; }
</style>
