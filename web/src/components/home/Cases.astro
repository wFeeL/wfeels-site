---
/* Секция 5 — кейсы. Три полноширинных блока (D-030, бриф `02-case-
 * illustrations.md`), не карточки: слева короткий текст и ссылка на страницу
 * кейса, справа — иллюстрация. Плюс тизер фабрики под ними
 * (`FactoryTeaser.astro`). Текст читается из `data/cases.ts` — единственного
 * источника, второй ручной копии здесь нет.
 */
import Label from '../Label.astro';
import CaseRow from './CaseRow.astro';
import CaseWeightIllustration from './CaseWeightIllustration.astro';
import CaseFlowIllustration from './CaseFlowIllustration.astro';
import CaseDialogueIllustration from './CaseDialogueIllustration.astro';
import FactoryTeaser from './FactoryTeaser.astro';
import { homeCases, CASES_CATALOG_HREF } from '../../data/cases';
import { WEIGHT_CLAIM } from '../../data/pageWeight';

const cases = homeCases();
const [siteV3, zayavkaHub, aiConsultant] = cases;

/* Высота поля иллюстрации — своя у каждого блока, кратная 32, в коридоре
 * 288…448 (бриф, раздел 2.1). Число здесь, а не в `data/cases.ts`: это
 * решение вёрстки секции 5, а не факт о кейсе. */
const ILLUSTRATION_HEIGHT: Record<string, number> = {
  'site-v3': 384,
  'zayavka-hub': 352,
  'ai-consultant': 416,
};

/* Раскрой Б «Заявки-Хаба» (ниже 899 px) — вертикальная схема 288×480 (бриф,
 * раздел 4.4), а не десктопные 576×288: 480 + 64 паспарту = 544, кратно 32.
 * Иллюстрации 1 и 3 перетекают внутри одной и той же высоты (раздел 2.2). */
const ZAYAVKA_HUB_MOBILE_HEIGHT = 544;
---
<Label>ЧТО УЖЕ СДЕЛАНО</Label>
<h2 class="t-h2">Кейсы</h2>

<div class="rows">
  <CaseRow item={siteV3} illustrationHeight={ILLUSTRATION_HEIGHT[siteV3.slug]}>
    <CaseWeightIllustration />
    <p slot="caption" class="t-small weight-caption">{WEIGHT_CLAIM}</p>
  </CaseRow>
  <CaseRow
    item={zayavkaHub}
    illustrationHeight={ILLUSTRATION_HEIGHT[zayavkaHub.slug]}
    illustrationMobileHeight={ZAYAVKA_HUB_MOBILE_HEIGHT}
  >
    <CaseFlowIllustration />
  </CaseRow>
  <CaseRow item={aiConsultant} illustrationHeight={ILLUSTRATION_HEIGHT[aiConsultant.slug]}>
    <CaseDialogueIllustration />
  </CaseRow>
</div>

<p class="all-cases">
  <a href={CASES_CATALOG_HREF}>Все кейсы <span aria-hidden="true">→</span></a>
</p>

<FactoryTeaser />

<style>
  .rows {
    margin: 32px 0 0;
    border-top: 1px solid var(--border);
  }
  .rows :global(.row:last-child) { border-bottom: none; }

  .weight-caption {
    margin: 16px 0 0;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .all-cases {
    margin: 32px 0 0;
  }
  .all-cases a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .all-cases a:hover { text-decoration: underline; }
</style>
