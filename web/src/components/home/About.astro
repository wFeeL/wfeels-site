---
/* Секция 9 — обо мне. Единственная секция сайта, где называется
 * происхождение реального бизнеса — без имени (D-011,
 * `ABOUT_CLIENT_LABEL` в `data/about.ts`). Содержимое читается из
 * `data/about.ts`, второй ручной копии текста здесь нет.
 *
 * Раскрой — брифом `70-workshop/specs/site-v3/04-sections-brief.md`,
 * раздел 4 (пункт 15 списка правок 2026-08-14):
 *   1. подпись «Даниил…» ушла ПОД фотографию мелким моно-текстом;
 *   2. весь остальной текст, вместе с меткой и заголовком, — в правую часть;
 *   3. подзаголовки блоков сняты (`ABOUT_BLOCKS` — теперь плоский список
 *      текстов, не объектов с `title`);
 *   4. текст про ИИ идёт первым, про полтора года — вторым.
 *
 * Особый режим текста (раздел 4 брифа): весь текст ниже — ДОСЛОВНО из
 * `data/about.ts`. Ни одно слово в самих текстах здесь не редактируется —
 * только их положение на странице.
 *
 * Объёмная вставка фото — пункт 6 списка правок 2026-08-14, приём взят у
 * `portfolio-site/src/pages/home/Hero.jsx:13-45` (GSAP там), пересобран
 * без GSAP (D-024) на CSS-анимациях + пятнадцать строк ванильного JS для
 * наклона за курсором. Три части:
 *   1. появление «шторкой» — див `.photo-curtain` поверх фото уходит вниз
 *      `translate`-ом + само фото сдвигается по Y, на загрузке;
 *   2. бесконечное дыхание — сдвиг по Y, `sine.inOut`-подобная кривая;
 *   3. наклон за курсором — только `pointer: fine`, свой `<script>` ниже.
 * `translate` (везде, части 1 и 2) и `transform: rotateX/rotateY` (часть 3,
 * из скрипта) — разные CSS-свойства, компонуются браузером сами, конфликта
 * между CSS-анимацией и JS-наклоном нет.
 * Часть 1 до 2026-08-21 была на `clip-path` — заменена на див-шторку задачей
 * «пролагивает при листании»: анимация `clip-path` у Chromium не композитится
 * (ни при `will-change`, ни без `round`, ни при `contain: paint` — проверено)
 * и перерисовывает фото на каждом кадре все 1,1 с; замер `headed.mjs` (линия
 * фона скрыта) — 42 пропущенных кадра из 42 «карточных» приходились ровно на
 * эту анимацию. Подробности приёма — у `.photo-curtain` в `<style>` ниже.
 */
import Label from '../Label.astro';
import Prose from '../Prose.astro';
import BrandMark from '../BrandMark.astro';
import InkText from '../InkText.astro';
import { splitBrandText } from '../../lib/brandMarkers';
import { ABOUT_PHOTO, aboutText } from '../../data/about';
import { dict, localeFromPath } from '../../i18n/locales';

const locale = localeFromPath(Astro.url.pathname);
const t = dict(locale);
/* Фотография одна на обе версии — переводится только её `alt`. Размеры и
   адрес приходят из `ABOUT_PHOTO`, текст — из `aboutText(locale)`. */
const about = aboutText(locale);

if (about.blocks.length !== 2) {
  throw new Error('home/About.astro: секция 9 несёт ровно два блока сверх лида и закрытия.');
}
---
<div class="layout">
  <div class="photo-col">
    {/* `.photo-frame` несёт `perspective` для наклона `.photo` (часть 3) —
        ровно как `data-hero-visual` у образца: перспектива на обёртке,
        наклоняется только сам img. Подпись — вне обёртки, она не наклоняется
        и не участвует в дыхании. */}
    <div class="photo-frame" data-about-photo-wrap>
      <img
        class="photo"
        data-about-photo
        src={ABOUT_PHOTO.src}
        width={ABOUT_PHOTO.width}
        height={ABOUT_PHOTO.height}
        alt={about.photoAlt}
        loading="lazy"
        decoding="async"
      />
      {/* Шторка — див поверх фото, не свойство `clip-path` на самом фото (см.
          комментарий у `.photo-curtain` ниже, часть 1). Декоративный, без
          содержимого — `aria-hidden`. */}
      <div class="photo-curtain" aria-hidden="true"></div>
    </div>
    {/* Подпись — моно, приглушённая, тире + неразрывный пробел перед
        текстом, как у образца (D-044: устройство, не формулировка). */}
    <p class="caption">— {about.lead}</p>
  </div>

  <div class="text-col">
    <Label>{t.aboutLabel}</Label>
    <h2 class="t-h2">{t.aboutHeading}</h2>
    <Prose>
      {/* Текст абзаца несёт места под фирменные значки марок (`{claude}` и
          прочие) прямо внутри предложения — разбор в `lib/brandMarkers.ts`,
          сам знак в `BrandMark.astro`. Кусок текста уходит на страницу
          дословно.
          Значок печатается НЕ один: разбор отдаёт его вместе со словом, к
          которому он относится, и `BrandMark` печатает пару неразрывной
          обёрткой. Иначе знак встаёт последним символом строки, а его слово
          уезжает вниз — снимок владельца 2026-08-20, 1440 px, «Postgres». */}
      {about.blocks.map((text) => (
        <p class="body-text">{splitBrandText(text).map((part) => (
          part.kind === 'text' ? part.value : <BrandMark name={part.name} word={part.word} />
        ))}</p>
      ))}
      <p class="closing ink"><strong><InkText text={about.closing} /></strong></p>
    </Prose>
  </div>
</div>

<style>
  /* Столбик на телефоне: фото сверху во всю ширину, подпись под ним, дальше
     метка/заголовок/текст. С 700 px (точка перелома этой секции уже стоит
     в коде и не двигается — раздел 0.1 брифа, исключение «Обо мне») — фото
     слева фиксированной долей, текст занимает остаток и держит собственную
     меру (`Prose`). */
  .layout {
    display: grid;
    gap: 24px;
  }
  /* Промежуток между фотографией и текстом — 48 px: следующая ступень шкалы
     отступов после 40 (правка владельца 2026-08-20, «делаем больший отступ
     между текстом и фоткой»).

     Через ступень (64) НЕ идём, и это замер, а не осторожность. Колонка
     фотографии держит свои 340 px на любой ширине, поэтому весь прирост
     промежутка снимается с колонки текста:

       ширина   gap 40        gap 48        gap 64
       1180 px  колонка 720   712           696   — мера абзаца 450 во всех
                              высота секции 722,6 во всех трёх
       700 px   колонка 272   264           248
                абзац 2: 356,3 px  356,3 px  385,9 px (+1 строка)
                высота секции 998,8  998,8   1058,2

     Читается так: от 1180 px и выше промежуток на ТЕКСТ не влияет вовсе —
     меру абзаца держит `Prose` (450 px), и лишние пиксели уходят в пустое
     поле справа. А на самой узкой ширине этой раскладки (700 px, точка
     перелома секции) колонка и есть мера, и 64 px стоят читателю лишней
     строки. 48 не стоят ничего.

     Заголовок «Обо мне» проверен отдельно — тот дефект уже ловили в секции
     контакта: 32 px и ОДНА строка на 700 px при всех трёх промежутках,
     посреди слова не рвётся. */
  @media (min-width: 700px) {
    .layout {
      /* «Полоса отвода» (`70-workshop/specs/site-v3/11-line-narrator-brief.md`,
         раздел 10.14, Р-6): фотография — непрозрачная картинка, калька
         (`base.css`) на неё не действует, и на 1180px без этой правки линия
         тонула под ней (223 слепых строки, 33,5% высоты секции). Столбец
         фото растёт на `--ink-lane` (`Container.astro`), сама фотография
         остаётся 340×227 на любой ширине — колонка ТЕКСТА отдаёт ровно
         столько же (мера держит `Prose`, 450px, лишние пиксели уходили в
         пустое поле справа), ни одной перевёрстанной строки на 1180px. */
      grid-template-columns: minmax(240px, calc(340px + var(--ink-lane))) 1fr;
      gap: 48px;
      align-items: start;
    }
  }

  /* Перспектива для наклона (часть 3) стоит на обёртке, не на самом `img` —
     как `data-hero-visual` у образца: наклоняется только фото, подпись
     остаётся плоской и не участвует в 3D-контексте.
     `position: relative` — для `.photo-curtain` (абсолютный потомок).
     `overflow: clip`, не `hidden` — сеть не становится источником
     `ViewTimeline` и не роняет `position: sticky` у предков (общее правило
     сайта); здесь у обёртки и так нет sticky-предков, но приём один на весь
     сайт. Обрезка нужна самой шторке (часть 1 ниже) — без неё уехавший вниз
     див была бы виден за пределами рамки фото. */
  /* «Полоса отвода» (Р-6, см. `.layout` выше) — отступ слева, той же
     переменной, что расширяет колонку: краска линии идёт по левому доку
     секции, и без этого отступа фотография закрывала бы её на 1180px. */
  :global(#about) .photo-col {
    padding-left: var(--ink-lane);
  }

  .photo-frame {
    perspective: 1000px;
    position: relative;
    overflow: clip;
    border-radius: var(--radius-md);
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    /* Базовое (оно же конечное, оно же запасное без JS/при reduced-motion)
       состояние: фото целиком видно, без сдвига и без наклона. Ничего из
       движения ниже не переопределяет это вне своих условий — безголовый
       Chromium (просит `reduce`) и страница без CSS-анимаций видят именно
       эту разметку.
       `clip-path` здесь больше нет (было до 2026-08-21) — см. `.photo-curtain`
       ниже, часть 1: та же самая «шторка» переехала на `translate`. */
    translate: 0 0;
  }

  /* Часть 1 (переработана 2026-08-21) — «шторка», закрывающая фото на
     загрузке, div поверх `.photo`, а не `clip-path` на самом фото.
     Причина: анимация `clip-path` не композитится Chromium ни при каких
     условиях (проверено — ни `will-change: clip-path`, ни снятие `round`,
     ни `contain: paint` результата не дают) и заставляет главный поток
     перерисовывать фото целиком на каждом кадре все 1,1 с. Замер headed.mjs
     (линия фона скрыта, 90 колёс): 42 пропущенных кадра из 42 «карточных»
     приходились ровно на это — с отключённой анимацией `.photo` пропусков 0.
     `translate` — то же свойство, что уже используется в `.reveal` и
     `about-photo-breathe`, композитится без перерисовки.
     Математика идентична прежнему `clip-path`: там видимая часть фото росла
     от кромки СВЕРХУ вниз, пока `inset(...100%...)` уменьшался до `0%`.
     Здесь шторка — непрозрачный див `inset:0` (полностью закрывает фото),
     который `translate`-ится ВНИЗ на 100% СВОЕЙ высоты (= высоте кадра):
     чем больше translate, тем больше открытой сверху полосы фото, а рамка
     (`overflow: clip` выше) отрезает ушедший за нижний край хвост. Тот же
     видимый эффект, другое свойство. Цвет — `var(--bg)`: за фото на живой
     странице ровный фон без узора (проверено скриншотом секции), рамка и
     радиус шторке не нужны — их даёт обрезка родителя. */
  .photo-curtain {
    position: absolute;
    inset: 0;
    background: var(--bg);
    /* По умолчанию — как и `.photo` выше, конечное состояние: шторка ушла
       вниз за рамку и не видна. */
    translate: 0 100%;
  }

  /* Часть 3 — наклон за курсором, ставится своим `<script>` ниже через
     `photo.style.transform`. Сглаживание — на CSS-переходе, а не в JS-цикле:
     скрипт просто перезаписывает значение на каждом `mousemove`, браузер сам
     анимирует переход между значениями. 0,5 с, приближение к `power2.out`. */
  @media (prefers-reduced-motion: no-preference) {
    .photo {
      transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
  }

  /* Части 1 и 2 — появление «шторкой» на загрузке и бесконечное дыхание.
     Обе — по умолчанию (без `animation-timeline`): секция не всегда в первом
     экране, а сдвиг по времени с `--reveal-i` здесь ни при чём — движения
     всего одно на странице, координировать нечего. `--reveal-i`-механику
     `.reveal` не переиспользуем: та обнуляет всё до `animation-timeline`,
     этой анимации он не нужен.
     Порядок в `animation-name` важен: `about-photo-breathe` идёт ВТОРЫМ,
     чтобы после 1,5 с он забирал `translate` — обе анимации метят одно и то
     же свойство, и в CSS при пересечении по времени побеждает последняя в
     списке (part 1 к 1,5 с уже завершена и держит `to`, конфликта нет, но
     порядок фиксирует победителя явно и обозримо). */
  @media (prefers-reduced-motion: no-preference) {
    .photo {
      animation-name: about-photo-reveal, about-photo-breathe;
      animation-duration: 1.1s, 3.8s;
      animation-delay: 0.25s, 1.5s;
      animation-timing-function:
        cubic-bezier(0.215, 0.61, 0.355, 1),
        cubic-bezier(0.445, 0.05, 0.55, 0.95);
      animation-iteration-count: 1, infinite;
      animation-direction: normal, alternate;
      animation-fill-mode: both, both;
    }

    /* Шторка идёт своей, одной анимацией — те же длительность, задержка и
       кривая, что у `about-photo-reveal`, чтобы обе половины приёма
       («открывается» + «приподнимается») шли синхронно, как и раньше. */
    .photo-curtain {
      animation-name: about-photo-curtain;
      animation-duration: 1.1s;
      animation-delay: 0.25s;
      animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
      animation-iteration-count: 1;
      animation-fill-mode: both;
    }
  }

  @keyframes about-photo-reveal {
    from { translate: 0 26px; }
    to { translate: 0 0; }
  }

  @keyframes about-photo-curtain {
    from { translate: 0 0; }
    to { translate: 0 100%; }
  }

  @keyframes about-photo-breathe {
    from { translate: 0 0; }
    to { translate: 0 -8px; }
  }

  /* Подпись под фото — `.t-small` моно, приглушённая, мера в символах (не
     em/px): она держит короткую строку из имени и профессии независимо от
     того, насколько широка колонка фото. */
  .caption {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 34ch;
  }

  /* Метка и заголовок стоят здесь, внутри правой колонки, а не снаружи всей
     секции (в отличие от `pain`/`process`/`faq`) — прямое требование
     пункта 15, а не вкус: весь текст, вместе с заголовком, уходит в правую
     часть. Отбивка до первого абзаца — 32 px, как и у остальных секций
     главной; между абзацами держит `Prose` (16px её собственным `p`), между
     закрывающей строкой и текстом перед ней — 32 (див `.closing` ниже). */
  .text-col :global(h2) { margin: 0 0 32px; }
  /* 24 px между двумя абзацами вместо `Prose`-умолчания 16 px (раздел 4.2
     брифа): специфичнее правила `.prose :global(p)`, поэтому переопределяет
     его без `:global()` — оба `<p>` написаны прямо в этом файле, Astro
     скоупит их атрибутом собственной, не чужой области видимости. Margin
     двух смежных `<p>` схлопывается по максимуму (не сумме) — 24 забивает
     16 у соседа без per-nth-child исключений. */
  .text-col p.body-text { margin-bottom: 24px; }
  /* Перед закрывающей строкой — 32, тем же схлопыванием: `margin-top: 32`
     побеждает `margin-bottom: 24` предыдущего абзаца, а не складывается с
     ним. */
  .closing { margin-top: 32px; }
</style>

<script>
  /* Часть 3 — наклон фото за курсором (пункт 6). Минимальный ванильный
     обработчик, без библиотек — GSAP не ставится (D-024), а слежение за
     курсором на CSS невозможно. Условия обязательные:
     - только `pointer: fine` — на телефоне наклона нет;
     - выключен при `prefers-reduced-motion: reduce`;
     - без JS ничего не выполняется — `.photo` уже стоит на месте по CSS
       (см. `<style>` выше), скрипт только ДОБАВЛЯЕТ наклон поверх. */
  const wrap = document.querySelector<HTMLElement>('[data-about-photo-wrap]');
  const photo = wrap?.querySelector<HTMLElement>('[data-about-photo]');
  const fine = window.matchMedia('(pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wrap && photo && fine && !reduced) {
    const MAX_X = 6; // deg, наклон по X (вверх-вниз курсора)
    const MAX_Y = 8; // deg, наклон по Y (влево-вправо курсора)

    const onMove = (e: MouseEvent) => {
      const r = wrap.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - 0.5;
      const py = (e.clientY - r.top) / r.height - 0.5;
      photo.style.transform = `rotateX(${py * -MAX_X}deg) rotateY(${px * MAX_Y}deg)`;
    };
    const onLeave = () => {
      photo.style.transform = '';
    };

    wrap.addEventListener('mousemove', onMove);
    wrap.addEventListener('mouseleave', onLeave);
  }
</script>
