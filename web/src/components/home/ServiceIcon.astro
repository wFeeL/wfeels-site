---
/* Четыре линейных иконки карточек секции 3. Только SVG-обводка токеном
 * `--accent` — второго акцентного цвета и сторонних наборов иконок нет
 * (план, задача 7 / общая спека, раздел 4 «Один акцент на весь сайт»).
 * Геометрия от руки, viewBox 24×24, обводка 1.5 px — тот же язык, что у
 * значка Telegram в шапке (`Header.astro`): паттерн узнаётся на обеих
 * поверхностях сайта.
 */
import type { ServiceIconKind } from '../../data/services';
interface Props { kind: ServiceIconKind }
const { kind } = Astro.props;
---
<svg
  class="service-icon"
  viewBox="0 0 24 24"
  width="28"
  height="28"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {kind === 'sites' && (
    <>
      <rect x="3" y="4.5" width="18" height="15" rx="2" />
      <line x1="3" y1="9" x2="21" y2="9" />
      <circle cx="6" cy="6.75" r="0.55" fill="currentColor" stroke="none" />
      <circle cx="8.4" cy="6.75" r="0.55" fill="currentColor" stroke="none" />
    </>
  )}
  {kind === 'automation' && (
    <>
      <circle cx="5" cy="6" r="2" />
      <circle cx="5" cy="18" r="2" />
      <circle cx="19" cy="12" r="2" />
      <path d="M7 6.9 13 11.2 M7 17.1 13 12.8 M15 12h2" />
    </>
  )}
  {/* «ИИ» и «Telegram» перечерчены полировкой перед приёмкой (находки 3 и 4,
      2026-08-12) — см. комментарий у каждого блока. Оба рисуются в языке
      «ядра» (`FactoryCore.astro`): только H/V-отрезки и дуги постоянного
      радиуса, три толщины обводки из общих токенов (`--stroke-bold` —
      главное, `--stroke-line` — несущее, `--stroke-hair` — вспомогательное),
      узел — квадрат с точкой-акцентом в центре, тот же мотив, что у
      «ствола» ядра. Поэтому здесь `stroke-linecap="butt"
      stroke-linejoin="miter"` — в отличие от диагональных «sites»/
      «automation» выше, у этих двух скруглены только те повороты, что
      нарисованы явной дугой, а не все стыки подряд через CSS. */}
  {kind === 'ai' && (
    <g class="icon-blueprint" stroke-linecap="butt" stroke-linejoin="miter">
      {/* «ИИ отвечает по вашим материалам и показывает источник» — документ
          со строками текста (главное, жирная обводка) и приложенная к его
          нижнему правому углу метка источника — узел с точкой (несущая
          обводка + акцент), а не звёздочка. Прежняя четырёхлучевая звезда —
          самый растиражированный дженерик-значок «ИИ» и единственный
          шаблонный элемент страницы (задача полировки, находка 4); эта
          замена про документ и ссылку на место в нём, а не про магию. */}
      <rect class="icon-bold" x="4" y="3" width="12" height="16" rx="2" />
      <path class="icon-line" d="M7,7.5 H13 M7,11 H13 M7,14.5 H10.5" />
      <rect class="icon-node" x="14.5" y="15.5" width="6" height="6" rx="1.5" />
      <circle class="icon-dot" cx="17.5" cy="18.5" r="1.1" />
    </g>
  )}
  {kind === 'telegram' && (
    <g class="icon-blueprint" stroke-linecap="butt" stroke-linejoin="miter">
      {/* Карточка услуги значит «делаю ботов и мини-приложения», не «напишите
          мне» — тот смысл уже занят бумажным самолётиком в шапке. Замена —
          окно интерфейса (главное, жирная обводка) с полосой заголовка
          (несущая обводка) и узлом-движком внутри (несущая обводка + точка
          акцентом): бот как программа, которая живёт внутри мессенджера
          (находка 3). Один и тот же глиф в шапке и в карточке значил бы два
          разных действия на одном экране — вместо этого меняется карточка,
          а не фирменный знак площадки в шапке. */}
      <rect class="icon-bold" x="3.5" y="4" width="17" height="16" rx="3" />
      <path class="icon-line" d="M3.5,9 H20.5" />
      <rect class="icon-node" x="10" y="13" width="4" height="4" rx="1" />
      <circle class="icon-dot" cx="12" cy="15" r="1" />
    </g>
  )}
</svg>

<style>
  .service-icon {
    flex: none;
    color: var(--accent);
  }

  /* Три ширины обводки — те же токены и та же лестница ролей, что у
     `FactoryCore.astro` (`.core-bold` / `.core-line` / `.core-hair`):
     главное / несущее / вспомогательное. Цвет везде остаётся `currentColor`
     (акцент карточки) — вариативна только толщина, второй акцент не заведён. */
  .icon-bold { stroke-width: var(--stroke-bold); }
  .icon-line { stroke-width: var(--stroke-line); }
  .icon-node { stroke-width: var(--stroke-line); fill: var(--surface); }
  .icon-dot { fill: currentColor; stroke: none; }
</style>
