---
/* Секция 3 — что я делаю. Четыре карточки-группы в сетке 2×2 (спека
 * 02-home.md, раздел 6). Содержимое карточек читается из
 * `data/services.ts` — единственного источника, второй ручной копии текста
 * здесь нет.
 */
import Label from '../Label.astro';
import Button from '../Button.astro';
import ServiceCard from './ServiceCard.astro';
import { serviceGroups, SERVICES_CATALOG_HREF } from '../../data/services';
import { dict, localeFromPath } from '../../i18n/locales';

const locale = localeFromPath(Astro.url.pathname);
const t = dict(locale);
---
<Label>{t.servicesLabel}</Label>
<h2 class="t-h2">{t.servicesHeading}</h2>

{/* `trace` — раздел 5.2 брифа `70-workshop/specs/site-v3/
    15-line-through-scale-brief.md`: три из четырёх карточек — цели траверса
    линии-рассказчика (`linePaths.ts`, `services: traversePath(...)`), одна
    («ИИ») — нет. Замерено геометрически (`getScreenCTM`/`getPointAtLength`
    траверса против `getBoundingClientRect()` каждой карточки, 1180/1440/1920,
    метод раздела 0 того же брифа): траверс проходит сквозь «Сайты»,
    «Автоматизация и интеграции» и «Telegram» (заметно, ~65–140 точек выборки
    из 400 на каждую), «ИИ» не задевает вовсе (0 точек на всех трёх ширинах) —
    S-дуга идёт по верхнему ряду и по правой карточке нижнего, левая нижняя
    остаётся вне хода. `icon` — устойчивый идентификатор группы (не индекс,
    не заголовок), не порядковый номер: правило переживёт переупорядочивание
    карточек в `data/services.ts`, если оно случится. */}
<div class="grid">
  {serviceGroups(locale).map((group) => <ServiceCard group={group} trace={group.icon !== 'ai'} />)}
</div>

{/* Строка ниш («Под вашу отрасль: …») снята правкой владельца 2026-08-21:
    ссылки на неё вели на несуществующие нишевые страницы, а страниц не
    будет и в ближайшее время. */}

{/* Правка владельца 2026-08-13, пункт 4: текстовой ссылкой под сеткой она
    терялась («выглядит странно и отстранённо… совсем непримечательно»).
    Собственный элемент — кнопка `Button`, но `variant="secondary"` (контур
    токеном `--border`, без заливки акцентом): на странице уже три залитые
    акцентные кнопки (находка ревью №7), четвёртой становиться нельзя. Тот же
    контурный вариант, что у «Смотреть цены» в первом экране — не спорит
    весом с главным действием страницы. */}
<p class="all-services">
  <Button href={SERVICES_CATALOG_HREF} variant="secondary">
    {t.servicesAll} <span aria-hidden="true">→</span>
  </Button>
</p>

<style>
  .grid {
    margin: 32px 0 0;
    display: grid;
    /* `minmax(0, 1fr)`, а не голый `1fr`: голый — это `minmax(auto, 1fr)`, где
       нижняя граница колонки равна МИНИМАЛЬНОЙ ШИРИНЕ СОДЕРЖИМОГО. Достаточно
       одного неразрывного куска внутри карточки (длинное слово, моно-строка
       стека), чтобы колонка перестала сжиматься и вылезла за окно вместе с
       карточкой. Соседнее правило на две колонки эту защиту уже несло, а
       одноколоночное — нет; дыра существовала давно и вскрылась при смене
       шрифта на более широкий (замер 2026-08-18: при окне 320 карточка
       занимала 335 px, переполнение 33 px). */
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  @media (min-width: 700px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* Каскад появления по столбцу — правило общее с `Guarantees.astro`
     (буквально то же значение для той же чётной колонки), заведено один
     раз в `styles/base.css` как `.grid > :nth-child(2n)`, а не дважды здесь
     и там: класс `.grid` в разметке уникален для этих двух секций,
     дублировать правило — платить весом за копию. */

  .all-services {
    margin: 24px 0 0;
  }
  .all-services :global(a span) {
    display: inline-block;
    transition: translate var(--dur-micro) var(--ease);
  }
  .all-services :global(a:hover span),
  .all-services :global(a:focus-visible span) { translate: 4px 0; }
</style>
