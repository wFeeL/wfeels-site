---
/* Главная целиком — ОДНА разметка на обе языковые версии.
 *
 * Страницы `pages/index.astro` и `pages/en/index.astro` — тонкие обёртки
 * вокруг этого компонента и не несут ни одной собственной строки. Копия
 * таблицы `GAP` во второй странице разошлась бы с первой молча: отступ,
 * подложка и заголовок секции — ровно те решения, которые правят по одному и
 * забывают продублировать. В этом репозитории список путей уже дважды
 * расходился именно так.
 *
 * Язык компонент выводит из адреса (`localeFromPath`) — тем же выводом, каким
 * `Base.astro` ставит `lang` на `<html>`, а каждая секция берёт свой текст.
 * Одна страница — один источник языка. */
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import { HOME_SECTIONS } from '../../lib/sections';
import { dict, localeFromPath } from '../../i18n/locales';
import HomeSection from './HomeSection.astro';
import MobileCtaBar from './MobileCtaBar.astro';
import Hero from './Hero.astro';
import Pain from './Pain.astro';
import Services from './Services.astro';
import Pricing from './Pricing.astro';
import Cases from './Cases.astro';
import Process from './Process.astro';
import Guarantees from './Guarantees.astro';
import About from './About.astro';
import Reviews from './Reviews.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';

const locale = localeFromPath(Astro.url.pathname);
const t = dict(locale);

/** Секции с настоящим текстом (план `02-home-plan.md`, задачи 5–13). Читает
 *  отсюда цикл ниже вместо `if`-цепочки в разметке — второй список секций
 *  здесь не заводится: и этот, и заглушка ниже используют один и тот же `id`
 *  из `lib/sections.ts`. */
const HOME_COMPONENTS: Partial<Record<string, typeof Hero>> = {
  hero: Hero,
  pain: Pain,
  services: Services,
  pricing: Pricing,
  cases: Cases,
  process: Process,
  guarantees: Guarantees,
  about: About,
  /* `reviews` — О-2 (`70-workshop/specs/site-v3/14-reviews-brief.md`).
   *  `HOME_SECTIONS` не несёт этот `id` вовсе, пока `homeReviews()` пуст
   *  (`lib/sections.ts`) — запись здесь просто не имеет потребителя в этот
   *  день, тем же приёмом, каким реестр линии (`lib/linePaths.ts`) держит
   *  путь без потребителя. */
  reviews: Reviews,
  faq: Faq,
  contact: Contact,
};

/** Ритм главной: зазор между секциями ОДИН и тот же на всех стыках — 128 px
 *  на столе (`topGap: 'wide'`, шкала 64/96/128 в `Section.astro`). Правка
 *  владельца 2026-08-20: «сделай равные отступы между секциями, чтобы не
 *  получалось такого маленького расстояния… мне нравится размер отступов
 *  между „Как обычно бывает“ и „Что я делаю“» — то есть прежние 128 стыка
 *  становятся общим числом, а прежние 96 внутри «акта» исчезают.
 *
 *  Этим отменено деление главной на три акта как источник ритма ОТСТУПОВ
 *  (решение 2026-08-13). Поле `act` в `lib/sections.ts` живёт дальше, но
 *  теперь у него один читатель — линия на фоне (`computeActGroups`); функция
 *  `isActStitch`, выводившая из смены акта разный зазор, снята вместе с
 *  различием, которое обслуживала.
 *
 *  Внешние края страницы — своя логика полей, и она сохранена: у `hero` в
 *  этой таблице нет ни одной записи (шапка→hero держит правило
 *  `main > section:first-child` из `base.css`, 48 px на столе), а у `contact`
 *  записан только `topGap` — низ секции перед подвалом остаётся симметричным
 *  умолчанием `Section` (96 px на столе).
 *
 *  Каждая секция отдаёт зазор своему верху (`topGap`), низ гасится в
 *  `'none'`, чтобы 128 не удваивались соседним верхом — см. комментарий в
 *  `Section.astro`. У `pain` `topGap` нет: её верхний зазор — это зазор от
 *  первого экрана, край, а не стык внутри страницы.
 *
 *  `surface` — подложка на странице ОДНА, у «Частых вопросов». Секции, где
 *  уже стоят карточки на `--surface` (услуги, цены, кейсы, гарантии),
 *  подложки не носили никогда: карточка увидела бы себя внутри поверхности
 *  того же цвета и растворилась. Две другие сняты двумя правками владельца
 *  одной и той же формулировкой «убираем задний белый фон для текста»:
 *  «Как обычно бывает» 2026-08-19, «Как я работаю» 2026-08-20 — ведомость
 *  шагов встала прямо на фон страницы, как до неё ведомость пунктов и
 *  карточка-ответ первой секции. Прежнего условия «две подложки, но не
 *  подряд» больше нет: выбирать не из чего, подложка одна.
 *
 *  `label`/`heading` рисует `Section.astro` (правило владельца 2026-08-18,
 *  пункт 11): у панельной секции — снаружи `.panel`. `pain` и `process`
 *  эти пропы сохраняют и без панели: их тела (`Pain.astro`,
 *  `Process.astro`) своего `<h2>` не рисуют, и второго места для заголовка
 *  не заводится. Строки читаются из словаря языка страницы (`i18n/ru.ts`,
 *  `i18n/en.ts`) — второй копии текста здесь нет. До перевода 2026-08-22 они
 *  приходили константами из самих секций; словарь заменил их потому, что
 *  экспорт из компонента не знает языка страницы.
 *
 *  `bottomGap: 'none'` у `faq` — следствие того же пункта 11, найденное
 *  дизайн-ревью 2026-08-18. Пока подложкой была сама секция, её собственные
 *  96 px нижнего поля лежали ВНУТРИ подложки и в зазор до соседа не
 *  попадали. Панель стала отдельным узлом — и эти 96 сложились с тогдашним
 *  верхним зазором секции контакта (96): 192 px пустоты ровно перед формой
 *  заявки, вдвое больше любого другого стыка страницы (замер ревью: 1440 px,
 *  низ панели 10634, метка контакта 10826). Секция контакта существует
 *  ради одного — получить заявку; страница, которая перед ней читается как
 *  закончившаяся, эту задачу проваливает. Правка выравняла `faq` с
 *  остальными секциями, у которых `bottomGap: 'none'` стоял с самого
 *  начала.
 *
 *  `topGap: 'wide'` стоит здесь литералом у всех восьми стыков и специально
 *  одинаковым: раньше два значения выводились из поля `act`, и увидеть в
 *  таблице, какая секция какой зазор получит, было нельзя — приходилось идти
 *  за `isActStitch`. Теперь число одно, и оно видно прямо в записи секции. */
const GAP: Record<
  string,
  {
    topGap?: 'wide';
    bottomGap?: 'none';
    surface?: boolean;
    label?: string;
    heading?: string;
    lineLast?: boolean;
  }
> = {
  pain: { bottomGap: 'none', label: t.painLabel, heading: t.painHeading },
  services: { topGap: 'wide', bottomGap: 'none' },
  pricing: { topGap: 'wide', bottomGap: 'none' },
  cases: { topGap: 'wide', bottomGap: 'none' },
  process: {
    topGap: 'wide',
    bottomGap: 'none', label: t.processLabel, heading: t.processHeading,
  },
  guarantees: { topGap: 'wide', bottomGap: 'none' },
  about: { topGap: 'wide', bottomGap: 'none' },
  /* `reviews` — та же раскладка, что `faq` (метка+`h2` снаружи, читает
   *  `home/Reviews.astro`), но БЕЗ `surface`: подложка на главной ровно одна
   *  (раздел 4.4 брифа `14-reviews-brief.md`, «Частые вопросы»), вторая
   *  встала бы прямо над первой. Запись остаётся в таблице безусловно —
   *  `GAP['reviews']` просто не имеет потребителя, пока `reviews` нет в
   *  `HOME_SECTIONS` (тот же приём, что у `LINE_PATHS.reviews`). */
  reviews: { topGap: 'wide', bottomGap: 'none', label: t.reviewsLabel, heading: t.reviewsHeading },
  faq: { topGap: 'wide', bottomGap: 'none', surface: true, label: t.faqLabel, heading: t.faqHeading },
  /* У контакта только ВЕРХ: стык `faq → contact` — такой же стык страницы,
     как и семь предыдущих, и до этой правки он держался умолчанием 96, то
     есть был одним из тех «маленьких расстояний», на которые указал
     владелец. Низ намеренно остаётся умолчанием (96 на столе) — это внешний
     край страницы перед подвалом, а не стык между секциями.

     `lineLast: true` — переезд `data-line-last` с подвала (раздел 12.1
     брифа `11-line-narrator-brief.md`, В-4): `contact` теперь последняя
     секция главной, реально несущая линию — подвал её больше не рисует. */
  contact: { topGap: 'wide', lineLast: true },
};
---
<Base
  title={t.metaTitle}
  description={t.metaDescription}
  schema="website"
  rail={true}
  line={true}
>
  {/* `rail` включает рельс-скроллспай (`Rail.astro`, рисует его сам
      `Base.astro` вне `<main>`) и переводит полосу прогресса в шапке в режим
      «только ниже 1324 px» (`Header.astro` → `ReadingProgress` `mobileOnly`).
      Состояние «ни рельса, ни полосы» невозможно ни при какой ширине: два
      элемента разведены общей точкой перелома 1324 px из `tokens.css`, а не
      двумя независимо подобранными числами. */}
  {/* Десять секций собираются из `lib/sections.ts` — единственного
      списка, который читают также шапка и рельс. Перечислять секции здесь
      руками нельзя: список путей в этом репозитории уже дважды расходился
      именно так.

      Все десять секций несут настоящий текст, утверждённый владельцем
      (`70-workshop/specs/site-v3/02-texts.md`) и свёрстанный своим
      компонентом (`components/home/*`, `HOME_COMPONENTS` выше). Заглушка
      ниже (`s.title`) остаётся только страховкой на случай, если якорь
      появится в `lib/sections.ts` раньше своего компонента. */}
  <Container>
    {HOME_SECTIONS.filter((s) => s.id === 'hero').map((s) => {
      const gap = GAP[s.id] ?? {};
      return (
        <HomeSection
          id={s.id} order={s.order} title={s.title}
          topGap={gap.topGap} bottomGap={gap.bottomGap} surface={gap.surface}
          label={gap.label} heading={gap.heading} lineLast={gap.lineLast}
          Content={HOME_COMPONENTS[s.id]}
        />
      );
    })}

    {/* Диапазон липкой мобильной CTA-панели (`MobileCtaBar.astro`, дизайн-
        ревью 2026-08-13, часть 1) — акты 2 и 3 главной, Pain → Faq,
        физически обёрнуты в один `<div>`: панель внутри него — липкий якорь
        нулевой высоты, чей «коридор» прилипания ограничен именно границами
        этого `<div>` (подробный разбор — в самом компоненте). Герой и
        Контакт — оба края диапазона, вне обёртки: герой — потому что панель
        не должна быть видна поверх первого экрана, контакт — потому что
        панель обязана исчезнуть до того, как поля формы окажутся на
        экране. */}
    <div class="mobile-cta-range">
      <MobileCtaBar />
      {HOME_SECTIONS.filter((s) => s.id !== 'hero' && s.id !== 'contact').map((s) => {
        const gap = GAP[s.id] ?? {};
        return (
          <HomeSection
            id={s.id} order={s.order} title={s.title}
            topGap={gap.topGap} bottomGap={gap.bottomGap} surface={gap.surface}
            label={gap.label} heading={gap.heading} lineLast={gap.lineLast}
            Content={HOME_COMPONENTS[s.id]}
          />
        );
      })}
    </div>

    {HOME_SECTIONS.filter((s) => s.id === 'contact').map((s) => {
      const gap = GAP[s.id] ?? {};
      return (
        <HomeSection
          id={s.id} order={s.order} title={s.title}
          topGap={gap.topGap} bottomGap={gap.bottomGap} surface={gap.surface}
          label={gap.label} heading={gap.heading} lineLast={gap.lineLast}
          Content={HOME_COMPONENTS[s.id]}
        />
      );
    })}
  </Container>
</Base>

<style>
  /* Система отсчёта для `.mobile-cta-clip` (`MobileCtaBar.astro`,
     `position: absolute; inset: 0`) — сам диапазон вне потока не выходит:
     `position: relative` без смещений не двигает ни сам диапазон, ни ритм
     секций внутри него ни на пиксель, он только даёт обрезающему слою верную
     точку отсчёта по высоте (высоту диапазону задают сами секции — Pain →
     Faq, обычные потоковые дети).

     `padding-bottom` — дефект дизайн-ревью (мобильные, часть 2): без него
     последняя строка «Частых вопросов» на выходе из диапазона оказывалась
     навсегда под непрозрачной панелью (`z-index: 70`) в момент, предшествующий
     её обрезке `overflow: clip`. Значение — `--mobile-cta-bar-h`, та же
     переменная, что держит высоту самой панели (`MobileCtaBar.astro`,
     глобальный блок): второй раз число здесь не подбирается, и обнуляется
     оно там же, с 900 px, где панели уже нет. */
  .mobile-cta-range {
    position: relative;
    padding-bottom: var(--mobile-cta-bar-h);
  }
</style>
