---
/* Секция 11 — контакт. Текст утверждён дословно
 * (`70-workshop/specs/site-v3/02-texts.md`, секция 11). Заголовок намеренно
 * совпадает со страницей `/contact` (`pages/contact.astro`) — два входа в
 * одно действие обязаны называться одинаково.
 *
 * `LeadForm` — тот же компонент, что на `/contact`, вторым экземпляром: на
 * каждой странице своя копия разметки, но код один (план `02-home-plan.md`,
 * задача 12). Оба адреса — из `lib/contacts.ts`, третьего места с ними
 * здесь не заводится.
 *
 * Две колонки — правка владельца 2026-08-13 («секция в одну колонку, форма
 * шириной 543 px внутри 980 — правые 45% последнего экрана пусты»). Слева
 * подводка, прямые контакты и строка про срок; справа форма, той же ширины,
 * что и раньше (34rem, `LeadForm.astro`), поэтому пустого поля справа от
 * неё больше нет — колонка под форму подогнана под ту же ширину.
 *
 * «Отвечу в течение дня.» вынесена из первого абзаца подводки отдельной
 * строкой в конец левой колонки. Слова не менялись ни на одну букву —
 * сдвинулась только граница между двумя предложениями абзаца, была точка
 * между ними и раньше («…не работает. Отвечу в течение дня.»). Порядок
 * «подводка → контакты → срок» — решение владельца: сначала способ связаться,
 * потом обещание про срок ответа.
 */
import Label from '../Label.astro';
import Prose from '../Prose.astro';
import LeadForm from '../LeadForm.astro';
import { TELEGRAM_URL, telegramHandle, emailLinkHtml } from '../../lib/contacts';
---
<Label>ПОСЛЕДНИЙ ШАГ</Label>
<h2 class="t-h2">Расскажите о задаче</h2>

<div class="layout">
  <div class="intro">
    <Prose>
      <p>Напишите пару строк: что нужно — или что сейчас не работает.</p>
      <p>
        Дальше несколько вопросов и вилка срока и цены. Ни к чему не обязывает:
        если задача окажется не моя, скажу сразу.
      </p>
    </Prose>

    <div class="channels">
      <p class="channels-label">Не любите формы — напишите сразу:</p>
      <ul>
        <li>
          <a href={TELEGRAM_URL} rel="me">
            <span class="link-label">Telegram · <strong>{telegramHandle()}</strong></span>
          </a>
        </li>
        <li set:html={emailLinkHtml('Почта')} />
      </ul>
    </div>

    <p class="reply">Отвечу в течение дня.</p>
  </div>

  <div class="form-col">
    <LeadForm />
  </div>
</div>

<style>
  /* Столбик на телефоне: подводка, контакты, срок ответа, форма — в порядке
     чтения. С 900 px (та же точка, на которой разворачивается навигация
     шапки, `tokens.css`) — две колонки: левая тянется, правая держит ширину
     формы и не отдаёт лишнего места пустотой рядом с полями. */
  .layout {
    display: grid;
    gap: 40px;
    margin-top: 24px;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 34rem);
      gap: 56px;
      align-items: start;
    }
  }

  .channels {
    margin-top: 32px;
  }
  .channels-label {
    margin: 0 0 12px;
    color: var(--text-muted);
  }
  .channels ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  /* `:global(a)` — не `a`: почтовая ссылка приходит через `set:html`
     (`emailLinkHtml`, `lib/contacts.ts`), а Astro метит атрибутом области
     видимости только элементы, отрисованные из собственного шаблона
     компонента — разметка, вставленная сырой строкой, атрибут не получает
     и под скоупленный селектор `.channels a` не попадает. Найдено дизайн-
     ревью (мобильные дефекты, часть 2): «Почта · …» измерялась 22 px —
     высотой голой строки без единого правила отсюда, включая `min-height`.
     Ссылка Telegram рядом (обычная разметка компонента) под тем же
     скоупленным селектором уже стояла на 44 px — потому в списке дефектов
     её и не было. */
  .channels :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent);
    text-decoration: none;
  }
  /* Два прямых канала — список, не проза: подчёркивание в покое здесь шум,
     та же правка дизайн-ревью 2026-08-19, что у `Footer.astro`. Черта —
     тот же приём (`.link-label::after`, `NavLinks.astro`), псевдоэлемент
     подписи, не `text-decoration` самой ссылки (та растёт до 44 px). Оба
     потомка `.channels :global(a .link-label)` — тем же селектором сразу
     для ссылки Telegram (обычная разметка) и ссылки почты (`set:html`,
     без атрибута скоупа): `:global()` матчит класс независимо от его
     происхождения, вторая пара правил не нужна. */
  .channels :global(a .link-label) {
    position: relative;
  }
  .channels :global(a .link-label)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: currentColor;
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .channels :global(a .link-label)::after {
      transition: transform var(--dur-micro) var(--ease);
    }
  }
  .channels :global(a:hover .link-label)::after,
  .channels :global(a:focus-visible .link-label)::after {
    transform: scaleX(1);
  }

  .reply {
    margin: 24px 0 0;
    color: var(--text-muted);
  }

  /* Форма держит свою собственную ширину (34rem, `LeadForm.astro`) — колонка
     здесь только даёт ей место и не растягивает её дальше. */
  .form-col :global(form) {
    margin-top: 0;
  }
</style>
