---
/* Секция 7 — как я работаю. Пять шагов, текст утверждён дословно
 * (`70-workshop/specs/site-v3/02-texts.md`, секция 7). Шаг 5 намеренно
 * короткий — полная формулировка гарантии живёт в секции 8
 * (`Guarantees.astro`), чтобы один факт не стоял дважды на расстоянии
 * экрана (02-texts.md, «Что здесь нельзя менять при правке»). Содержимое
 * читается из `data/process.ts`, второй ручной копии текста здесь нет.
 *
 * Раскрой брифом `70-workshop/specs/site-v3/04-sections-brief.md`, раздел 2
 * (D-044, D-038): узлы-квадраты на вертикальной оси остаются (номер шага
 * рисует узел, не текст заголовка — из П2-Б, `02-process-options.md`), но
 * заголовок пункта набирается `.t-body-lg` 22 px текстовым шрифтом, а не
 * `.t-h3` 28 px в Unbounded — десять таких заголовков в двух соседних
 * секциях перекричали бы единственную крупную цифру секции (брифа раздел
 * 0.2, восстановление намерения D-038, не отход от него). Горизонтальная
 * линейка-разделитель — заимствованный у образца приём — идёт только под
 * ВТОРОЙ колонкой (текстом), не пересекая колонку узлов: вертикаль
 * принадлежит оси, горизонтали — тексту, чтобы две системы линий не
 * спорили. У пятого шага собственной линейки нет — её роль исполняет
 * итоговая полоса ниже.
 *
 * Метка и заголовок секции стоят в `Section.astro` (правка владельца
 * 2026-08-18, пункт 11: заголовок секции — снаружи панели `.surface`, не
 * внутри неё). Константы ниже — единственный источник текста, читает их
 * `pages/index.astro`.
 */
import { PROCESS_STEPS, WARRANTY_DAYS } from '../../data/process';

if (PROCESS_STEPS.length !== 5) {
  throw new Error('home/Process.astro: секция 7 несёт ровно пять шагов.');
}

/** Метка и заголовок секции — передаются в `Section` (пропы
 *  `label`/`heading`), которая рисует их снаружи `.panel`. */
export const PROCESS_LABEL = 'КАК ЭТО БУДЕТ';
export const PROCESS_HEADING = 'Как я работаю';
---
<div class="process">
  {/* `<ol>` без CSS-счётчика: номер рисует узел (`.node`, реальный текст
      «01»…«05», не генерируемый контент) — сам узел помечен `aria-hidden`,
      чтобы скринридер не объявлял число дважды поверх порядка, который уже
      даёт семантика `<ol>`. */}
  <ol class="axis">
    {PROCESS_STEPS.map((step, i) => (
      <li class="step reveal">
        <span class="node" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <strong class="step-title">{step.title}</strong>
        <p class="step-text">{step.text}</p>
      </li>
    ))}
  </ol>

  {/* Итоговая полоса — единственная крупная цифра секции (D-038), и
      единственное число секции с источником (`data/process.ts`,
      `WARRANTY_DAYS`, `SERVICES.md:151`). Она же — закрывающая строка
      ведомости: линейка над ней (`.dimension-row`, `border-top`) единственная
      в секции, пересекающая колонку узлов, и потому читается как итог, а не
      как ещё один разделитель шага. */}
  <div class="dimension-row reveal">
    <div class="dimension">
      <span class="dimension-line" aria-hidden="true"></span>
      <span class="dimension-value">{WARRANTY_DAYS}&nbsp;дней</span>
    </div>
  </div>
</div>

<style>
  /* Отбивка заголовка до первого содержимого (32 px) — в `Section.astro`
     (`.section-heading`), не здесь. Здесь больше нет `<h2>`. */

  .axis {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Ось — 1 px `--border` по левому краю колонки узлов. Начало на середине
     первого узла (16px = половина 32px квадрата), конец — на нижнем крае
     оси (`bottom: 0`), там, где начинается итоговая линейка (раздел ниже):
     размер «обрывается» ровно там, где заканчивается ведомость, а не
     тянется в соседнюю секцию — с панелью-подложкой это было бы
     несовместимо (линия пересекла бы её границу). Это осознанная потеря,
     против прежнего поведения «ось уходит вниз в соседнюю секцию». */
  .axis::before {
    content: '';
    position: absolute;
    top: 16px;
    bottom: 0;
    left: 15px; /* центр 32px квадрата минус половина 1px линии */
    width: 1px;
    background: var(--border);
  }

  /* Ось прочерчивается по прокрутке (02-process-options.md, «Движение»
     варианта П2-Б). Базовое правило выше не объявляет ни `scale`, ни
     `animation-*` — конечное состояние остаётся состоянием по умолчанию:
     линия нарисована целиком без поддержки `animation-timeline` и при
     `prefers-reduced-motion: reduce`. Раздельные свойства, не шорткод
     `animation:` — сборка сводит его с `animation-timeline` в один CSS-
     шорткод, который собранный Chromium не разбирает и молча роняет
     анимацию целиком (комментарий `BackgroundLine.astro:124-129`, сторож
     `tests/css-no-animation-shorthand-with-timeline.test.ts`). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .axis::before {
        transform-origin: top;
        animation-name: process-axis-draw;
        animation-duration: 1ms; /* реальную длительность задаёт таймлайн */
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range-start: entry 0%;
        animation-range-end: entry 100%;
      }
    }
  }

  @keyframes process-axis-draw {
    from { scale: 1 0; }
    to { scale: 1 1; }
  }

  /* Грид ряда — общий на все ширины, меняются только зазор и вертикальное
     поле (брифа раздел 2.4): на телефоне зазор 16 px и поле 24 px, от 900 —
     24 px и 32 px. Колонка узла (32 px) и мера текста (24em/31em) не
     зависят от ширины — они реагируют на доступное место сами. */
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    column-gap: 16px;
    padding-block: 24px;
  }
  .step:first-child { padding-top: 0; }
  .step:last-child { padding-bottom: 0; }

  /* Линейка-разделитель — заимствованный приём, и она НЕ пересекает колонку
     узлов: псевдоэлемент самого `<li>`, явно поставленный во вторую колонку
     грида (`grid-column: 2`), автоматически уходит в свободную строку под
     заголовком и текстом (обе уже стоят явно в строках 1 и 2) — третья
     строка получает только высоту его же 1px-обвода. У последнего шага
     линейки нет: её роль исполняет `.dimension-row` ниже. */
  .step:not(:last-child)::after {
    content: '';
    grid-column: 2;
    border-bottom: 1px solid var(--border);
  }

  /* Узел — квадрат ровно в клетку сетки, сидит на оси и перекрывает линию
     своим фоном `--surface` (тот же цвет, что у панели секции) — это и даёт
     вид «ось проходит сквозь узел», без второго слоя разметки. */
  .node {
    grid-column: 1;
    grid-row: 1;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font: 500 0.6875rem/1 var(--font-mono);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Заголовок шага — `.t-body-lg` текстовым шрифтом, не `.t-h3` в Unbounded
     (раздел 0.2 брифа): элемент остаётся `<strong>`, не `<h3>`, поэтому
     общий селектор `h1,h2,h3,.t-h3` из `base.css` его не задевает — правило
     ниже не воюет ни с чем, декларации просто набирают нужный голос. */
  .step-title {
    grid-column: 2;
    grid-row: 1;
    display: block;
    font: 600 1.375rem/1.6 var(--font-text);
    color: var(--text);
    margin: 2px 0 4px;
    max-width: 24em;
  }
  .step-text {
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    font: 400 1.125rem/1.65 var(--font-text);
    color: var(--text-muted);
    max-width: 31em; /* ≈558px на 18px тексте — «текст уже полосы» */
  }

  /* Итоговая полоса — единственная линейка секции, пересекающая ОБЕ
     колонки: `border-top` стоит на самой обёртке (`.dimension-row`), а не
     на псевдоэлементе внутри грида, поэтому она идёт во всю ширину панели
     независимо от внутреннего отступа `.dimension`. */
  .dimension-row {
    border-top: 1px solid var(--border);
    padding-top: 32px;
  }

  /* Размерная линия — как размер на чертеже: линия с двумя выносными
     засечками сверху, число снизу. На телефоне начинается от левого края
     панели (полоса во всю ширину — «цифра под её левым концом»); от 900 px
     сдвигается на левый край колонки текста (x = 32 + 24 = 56), тем же
     `padding-left`, каким уже размечена колонка узла у шагов выше. */
  .dimension-line {
    display: block;
    height: 1px;
    background: var(--accent);
    position: relative;
  }
  .dimension-line::before,
  .dimension-line::after {
    content: '';
    position: absolute;
    top: -8px;
    width: 1px;
    height: 16px;
    background: var(--accent);
  }
  .dimension-line::before { left: 0; }
  .dimension-line::after { right: 0; }

  /* Единственная крупная цифра секции: ступень `.t-h1` (36→60px), кегль
     скопирован буквально, а не унаследован классом `.t-h1` — тот тянет за
     собой общий заголовочный набор (Manrope 800, трекинг), а выноске нужен
     моно 500 без трекинга. */
  .dimension-value {
    display: block;
    margin-top: 16px;
    font: 500 clamp(2.25rem, 5.6vw, 3.75rem)/1.1 var(--font-mono);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  /* Каскад — `.reveal` (`styles/base.css`): пять шагов приходят по очереди,
     итоговая полоса — последней фазой, после того как назван весь процесс. */
  .axis > :nth-child(2) { --reveal-i: 1; }
  .axis > :nth-child(3) { --reveal-i: 2; }
  .axis > :nth-child(4) { --reveal-i: 3; }
  .axis > :nth-child(5) { --reveal-i: 4; }
  .dimension-row { --reveal-i: 5; }

  @media (min-width: 900px) {
    .step {
      column-gap: 24px;
      padding-block: 32px;
    }
    .dimension-row { padding-left: 56px; }
  }
</style>
