---
/* Одна строка секции 5 — полноширинный блок вместо карточки (бриф
 * `70-workshop/specs/site-v3/04-cases-brief.md`, раздел 2): слева короткий
 * текст, справа — поле иллюстрации. Стороны чередуются: нечётный
 * `homeOrder` — обычная раскладка, чётный — зеркальная (`mirrored`,
 * вычисляется в `Cases.astro` формулой `homeOrder % 2 === 0`, раздел 2.1
 * брифа). Порядок в DOM у всех блоков одинаковый — текст, потом рисунок;
 * зеркалятся только колонки грида (раздел 2.3 брифа), не разметка.
 *
 * Переход — вариант В «Цель — весь блок» (D-047, бриф раздел 3.1): заголовок
 * становится ЕДИНСТВЕННОЙ ссылкой блока, растянутой на весь блок приёмом
 * `a::after { inset: 0 }`. Бывшая ссылка «Разобрать кейс →» стала меткой
 * `.mark`, `aria-hidden`: без атрибута у ссылки задвоилось бы доступное имя.
 *
 * Описание кейса не обрезается — не переписанным текстом, а полным
 * абзацем (`02-texts.md`, секция 5 / `data/cases.ts`): второй ручной копии
 * текста здесь не заводится, полный абзац остаётся в разметке для
 * программы чтения и для страницы кейса.
 */
import type { CaseCard as CaseCardData } from '../../data/cases';
import CaseIllustrationField from './CaseIllustrationField.astro';

interface Props {
  item: CaseCardData;
  /** Зеркальная раскладка — вторая и четвёртая строки (бриф, раздел 2.1). */
  mirrored?: boolean;
  /** Высота поля иллюстрации, кратная 32 (бриф, раздел 2.2). */
  illustrationHeight: number;
  /** Высота поля ниже 899 px, если отличается — см. `CaseIllustrationField`. */
  illustrationMobileHeight?: number;
  /** Строка «что переезжает» — только у четвёртой строки (бриф, раздел 6.4). */
  frame?: string;
}
const {
  item, mirrored = false, illustrationHeight, illustrationMobileHeight, frame,
} = Astro.props;
---
<div class:list={['row', { mirror: mirrored }]}>
  <div class="text">
    <h3 class="t-h3"><a href={`/cases/${item.slug}`}>{item.title}</a></h3>
    {item.description && <p class="description">{item.description}</p>}
    {frame && <p class="frame">{frame}</p>}
    {item.stack && <p class="stack"><code>{item.stack}</code></p>}
    <p class="mark" aria-hidden="true">Разобрать кейс <span>→</span></p>
  </div>
  <div class="illustration">
    <CaseIllustrationField height={illustrationHeight} mobileHeight={illustrationMobileHeight}>
      <slot />
    </CaseIllustrationField>
    <slot name="caption" />
  </div>
</div>

<style>
  .row {
    /* Точка отсчёта растянутой ссылки `a::after` (бриф, раздел 3.1). */
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px;
    padding: 48px 0;
    border-bottom: 1px solid var(--border);
    /* Грань слева — метит блок как ссылку, во всех четырёх строках,
       включая зеркальные (бриф, раздел 3.1: «грань слева во всех четырёх
       блоках — она метит блок, а не колонку»). Существует всегда,
       прозрачна в покое, чтобы наведение не двигало раскладку. Блок
       компенсирует свою ширину и отступ, чтобы текст остался выровнен по
       краю контейнера: 2 px грани + 16 px отступа = 18 px отрицательного
       поля. */
    border-left: 2px solid transparent;
    padding-left: 16px;
    margin-left: -18px;
    transition: border-left-color var(--dur-micro) var(--ease);
  }
  /* Колонка рисунка остаётся широкой (7fr) в обеих раскладках — зеркалится
     сторона, а не пропорция (бриф, раздел 2.3). `direction: rtl` и
     перестановка элементов в разметке запрещены — оба ломают порядок
     чтения или выравнивание знаков препинания. */
  .row.mirror { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .row.mirror .text { grid-column: 2; }
  .row.mirror .illustration { grid-column: 1; }

  @media (max-width: 899px) {
    /* Ниже 900 px зеркала не существует: одна колонка, сначала текст, потом
       рисунок — у всех строк одинаково (бриф, раздел 2.3). `grid-column`
       обязан сброситься явно: в одноколоночном гриде «2» создал бы лишнюю
       неявную колонку и сдвинул текст вбок. */
    .row, .row.mirror { grid-template-columns: 1fr; }
    .row.mirror .text, .row.mirror .illustration { grid-column: auto; }
  }

  .text { display: flex; flex-direction: column; gap: 8px; min-width: 0; }

  /* Заголовок — единственная ссылка блока. Цвет наследует `--text`
     (правило `.t-h3` своего цвета не задаёт), меняется на `--accent`
     только при наведении на ЛЮБУЮ точку блока (правило ниже). */
  .text h3 a {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease);
  }
  /* Растянутая ссылка — цель нажатия весь блок 1180×~380 (бриф, раздел
     3.1). Подложка не появляется: заливать блок акцентом слишком громко. */
  .text h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Обрезка `-webkit-line-clamp: 2` снята дизайн-ревью 2026-08-13: обрыв
     предложения посреди слова читался как битая вёрстка, хотя полный текст
     уже был в HTML. Описание переносится свободно — текст утверждён
     `02-texts.md` и подобран так, чтобы укладываться в одну-две строки при
     ширине текстовой колонки. */
  .description {
    margin: 0;
    color: var(--text-muted);
  }

  /* Строка «что переезжает» (только четвёртая строка, бриф раздел 6.4) —
     основной шрифт, не моно: две моно-строки подряд (каркас и стек)
     слились бы в серую кашу. */
  .frame {
    margin: 4px 0 0;
    color: var(--text-muted);
  }

  .stack {
    margin: 4px 0 0;
  }
  /* Кегль поднят с 0.6875rem (ступень `label`, 11px) до 1rem (ступень
     `small`, 16px) — правка 21 (03-redesign-2026-08-14.md). Мелкий кегль был
     формально в шкале, но моношрифт при равном кегле с наборным читается
     мельче (та же ступень уже применяется к другим моно-подписям стека,
     `CaseWeightIllustration.astro`, `CaseFactoryIllustration.astro`). */
  .stack code {
    font: 400 1rem/1.4 var(--font-mono);
    color: var(--text-muted);
    background: none;
    padding: 0;
  }

  /* Метка «Разобрать кейс →» — больше не ссылка (D-047): моно, капслок
     через CSS (в данных — обычный регистр, программа чтения не читает
     `aria-hidden`, но капслок в разметке пришлось бы менять при правке
     текста руками), `--text-muted` в покое, `--text` при наведении на блок.
     Стоит последней строкой текстовой колонки, выровненная по её началу —
     во всех четырёх блоках одинаково (бриф, раздел 3.1: у зеркальной
     раскладки правый нижний угол блока — это угол поля рисунка, метка
     оторвалась бы от слов). */
  .mark {
    margin: 8px 0 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color var(--dur-micro) var(--ease);
  }
  .mark span {
    display: inline-block;
    transition: translate var(--dur-micro) var(--ease);
  }

  /* Наведение — на любую точку блока, не на заголовок отдельно (вариант В).
     `hover: hover` обязателен: иначе на телефоне состояние залипает после
     касания (бриф, раздел 3.1). */
  @media (hover: hover) {
    .row:hover { border-left-color: var(--accent); }
    .row:hover .text h3 a { color: var(--accent); }
    .row:hover .mark { color: var(--text); }
    .row:hover .mark span { translate: 2px 0; }
  }
  /* 390 px — наведения нет вовсе; грань остаётся видимой в покое прозрачной
     и акцентной в `:focus-within` (клавиатурный эквивалент, бриф, раздел
     3.1, «390 px»). */
  .row:focus-within { border-left-color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    /* Сдвиг стрелки не применяется — движение снято. Перекраска грани,
       заголовка и метки остаётся: это не движение (бриф, раздел 3.1). */
    .mark span { transition: none; }
    .row:hover .mark span,
    .row:focus-within .mark span {
      translate: 0 0;
    }
  }

  .illustration { min-width: 0; }
  .illustration :global(.field) { width: 100%; }
</style>
