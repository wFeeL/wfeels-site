---
/* Одна строка секции 5 — полноширинный блок вместо карточки (бриф
 * `70-workshop/specs/site-v3/04-cases-brief.md`, раздел 2): слева короткий
 * текст, справа — поле иллюстрации. Стороны чередуются: нечётный
 * `homeOrder` — обычная раскладка, чётный — зеркальная (`mirrored`,
 * вычисляется в `Cases.astro` формулой `homeOrder % 2 === 0`, раздел 2.1
 * брифа). Порядок в DOM у всех блоков одинаковый — текст, потом рисунок;
 * зеркалятся только колонки грида (раздел 2.3 брифа), не разметка. Состав
 * блоков меняется данными; сама строка не знает их число.
 *
 * Ссылка в заголовке возвращена только после появления реальной страницы
 * `/cases/<slug>`. Весь блок ссылкой не растягивается: две строки содержат
 * собственные кнопки галерей, и перекрывать один интерактивный орган другим
 * нельзя. Подчёркивание оставлено видимым без наведения — ссылка не маскируется
 * под обычный заголовок.
 *
 * Описание кейса не обрезается — не переписанным текстом, а полным
 * абзацем (`02-texts.md`, секция 5 / `data/cases.ts`): второй ручной копии
 * текста здесь не заводится, полный абзац остаётся в разметке для
 * программы чтения и для страницы кейса.
 */
import type { CaseCard as CaseCardData } from '../../data/cases';
import CaseIllustrationField from './CaseIllustrationField.astro';

interface Props {
  item: CaseCardData;
  /** Зеркальная раскладка — вторая и четвёртая строки (бриф, раздел 2.1). */
  mirrored?: boolean;
  /** Высота поля иллюстрации, кратная 32 (бриф, раздел 2.2). */
  illustrationHeight: number;
  /** Высота поля ниже 899 px, если отличается — см. `CaseIllustrationField`. */
  illustrationMobileHeight?: number;
  /** Поле без паспарту — для реального скриншота, уже имеющего свою рамку. */
  illustrationBare?: boolean;
  /** Центрировать короткий текст по вертикали относительно высокой галереи. */
  centerCopy?: boolean;
  /** Реально построенная detail-страница. Без адреса заголовок остаётся текстом. */
  href?: string;
  /** Язык страницы назначения, если отличается от языка текущей страницы. */
  hreflang?: string;
}
const {
  item, mirrored = false, illustrationHeight, illustrationMobileHeight,
  illustrationBare = false, centerCopy = false, href, hreflang,
} = Astro.props;
---
<div class:list={['row', { mirror: mirrored, 'center-copy': centerCopy }]}>
  <div class="text">
    <h3 class="t-h3">
      {href
        ? <a class="case-title-link" href={href} hreflang={hreflang}>{item.title}</a>
        : item.title}
    </h3>
    {item.description && <p class="description">{item.description}</p>}
    {item.stack && <p class="stack"><code>{item.stack}</code></p>}
  </div>
  <div class="illustration">
    <CaseIllustrationField
      height={illustrationHeight}
      mobileHeight={illustrationMobileHeight}
      bare={illustrationBare}
    >
      <slot />
    </CaseIllustrationField>
    <slot name="caption" />
  </div>
</div>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px;
    padding: 48px 0;
    border-bottom: 1px solid var(--border);
    /* Грани слева нет: переход обозначает сама подчёркнутая ссылка в
       заголовке, а не декоративная граница всего блока. */
  }
  /* Колонка рисунка остаётся широкой (7fr) в обеих раскладках — зеркалится
     сторона, а не пропорция (бриф, раздел 2.3). `direction: rtl` и
     перестановка элементов в разметке запрещены — оба ломают порядок
     чтения или выравнивание знаков препинания. */
  .row.mirror { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  /* Оба элемента закреплены не только в колонках, но и в первой строке.
     Без `grid-row: 1` автоплейсмент читает DOM-порядок «текст → рисунок»:
     после занятой второй колонки переносит рисунок на следующую строку и
     превращает зеркальный desktop-блок в две строки высотой 810 px. */
  .row.mirror .text { grid-column: 2; grid-row: 1; }
  .row.mirror .illustration { grid-column: 1; grid-row: 1; }

  /* У высокого Telegram-скрина текст не прилипает к верхней кромке поля:
     его собственная высота центрируется по общей оси с галереей. Это
     частное правило строки, а не новое выравнивание всех кейсов. */
  .row.center-copy .text { align-self: center; }

  @media (max-width: 899px) {
    /* Ниже 900 px зеркала не существует: одна колонка, сначала текст, потом
       рисунок — у всех строк одинаково (бриф, раздел 2.3). `grid-column`
       обязан сброситься явно: в одноколоночном гриде «2» создал бы лишнюю
       неявную колонку и сдвинул текст вбок. */
    .row, .row.mirror { grid-template-columns: 1fr; }
    .row.mirror .text, .row.mirror .illustration {
      grid-column: auto;
      grid-row: auto;
    }
    /* На телефоне текст снова идёт обычным потоком над иллюстрацией. */
    .row.center-copy .text { align-self: stretch; }
  }

  .text { display: flex; flex-direction: column; gap: 8px; min-width: 0; }

  .case-title-link {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  .case-title-link:hover,
  .case-title-link:focus-visible { color: var(--accent); }

  /* Обрезка `-webkit-line-clamp: 2` снята дизайн-ревью 2026-08-13: обрыв
     предложения посреди слова читался как битая вёрстка, хотя полный текст
     уже был в HTML. Описание переносится свободно — текст утверждён
     `02-texts.md` и подобран так, чтобы укладываться в одну-две строки при
     ширине текстовой колонки. */
  .description {
    margin: 0;
    color: var(--text-muted);
  }

  .stack {
    margin: 4px 0 0;
  }
  /* Кегль поднят с 0.6875rem (ступень `label`, 11px) до 1rem (ступень
     `small`, 16px) — правка 21 (03-redesign-2026-08-14.md). Мелкий кегль был
     формально в шкале, но моношрифт при равном кегле с наборным читается
     мельче (та же ступень уже применяется к другим моно-подписям стека,
     `CaseWeightIllustration.astro`). */
  .stack code {
    font: 400 1rem/1.4 var(--font-mono);
    color: var(--text-muted);
    background: none;
    padding: 0;
  }

  .illustration { min-width: 0; }
  .illustration :global(.field) { width: 100%; }
</style>
