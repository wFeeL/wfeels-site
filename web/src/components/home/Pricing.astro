---
/* Секция 4 — цены.
 *
 * Правка владельца 2026-08-13 («Секция цен — десять правок владельца»,
 * части 1–5): три верхние карточки стали направлениями («Лендинг» /
 * «Корпоративный сайт» / «Telegram-бот»), а не тремя ступенями одной
 * лестницы «Сайты»; полка внизу стала шестью маленькими карточками. Прежняя
 * структура («три ступени группы «Сайты» + строки-ссылки полки») была
 * собрана по `70-workshop/specs/site-v3/02-redesign-options.md`, пункт 7 —
 * этот заход её не отменяет целиком, только состав и подачу верхней тройки
 * и полки, по прямому указанию владельца, которое приоритетнее спеки.
 *
 * Ни одна цена не хранится в этом файле — всё читается из
 * `data/pricingShowcase.ts`, который сам читает `data/pricing.ts`
 * (сгенерирован `70-workshop/tools/generate_pricing.py` из `10-offer/
 * PRICING.md`). Витринные имена карточек и маппинг на ступени прайса живут
 * там же, с собственным тестом (`data/pricingShowcase.test.ts`), который
 * падает, если ступень переименована или пропала.
 */
import Label from '../Label.astro';
import Card from '../Card.astro';
import Button from '../Button.astro';
import { PRICING } from '../../data/pricing';
import { TOP_CARDS, SHELF_CARDS } from '../../data/pricingShowcase';

/** Цена конкретной ступени по имени группы и записи — нужна только для
 *  сноски про раунды правок ниже: порог «работы от N ₽» обязан читаться из
 *  данных, а не быть вписан литералом. Падает явно, если ступень
 *  переименована или пропала в генераторе. */
function priceFor(groupName: string, entryName: string): string {
  const entry = PRICING.find((g) => g.name === groupName)?.entries.find((e) => e.name === entryName);
  if (!entry) {
    throw new Error(
      `home/Pricing.astro: в data/pricing.ts нет ступени «${entryName}» в группе ` +
      `«${groupName}» — сноска про раунды правок (02-texts.md, секция 4) ссылается на неё.`,
    );
  }
  return entry.price;
}

// Порог «три раунда правок — для работ от…» и порог «оплата по вехам —
// от…» (PRICING.md, строки 102–103) численно совпадают: оба указывают на
// верхнюю ступень «Сайты» (70 000 ₽). Ступень сама на главную не выходит
// отдельной карточкой, но её цена остаётся законным порогом внутри текста
// подводки и сноски ниже.
const EDITS_THRESHOLD_PRICE = priceFor('Сайты', 'Сайт до 10 страниц');
---
<Label>СКОЛЬКО ЭТО СТОИТ</Label>
<h2 class="t-h2">Цены</h2>

<p class="intro">
  «От» — потому что цена зависит от объёма. После разбора называю вилку, а в
  предложении фиксирую точную. Оплата — половина на старте и половина на
  сдаче; для работ от {EDITS_THRESHOLD_PRICE} разбиваю на вехи.
</p>

<div class="top-grid">
  {TOP_CARDS.map((card) => (
    <Card stack={true} accent={!!card.recommended}>
      <div class:list={['top-body', { 'top-body--recommended': !!card.recommended }]}>
        {card.recommended && (
          <span class="badge"><span class="badge-star" aria-hidden="true">★</span>{card.recommended.label}</span>
        )}
        <h3 class="t-h3">{card.showcaseName}</h3>
        <p class="price">
          <span class="from">от</span> <code>{card.price}</code>
          <span class="timeframe">{card.timeframe}</span>
        </p>
        <ul class="composition" role="list">
          {card.composition.map((item) => (
            <li>
              <svg class="check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M3 8.5 6.2 11.5 13 4.5" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <p class="cta">
        <Button href="#contact" variant={card.recommended ? 'primary' : 'secondary'}>{card.cta}</Button>
      </p>
    </Card>
  ))}
</div>

<div class="shelf">
  {SHELF_CARDS.map((item) => (
    <a class="shelf-card" href={item.href}>
      <span class="shelf-label">{item.label}</span>
      <span class="shelf-price"><span class="from">от</span> <code>{item.price}</code></span>
    </a>
  ))}
</div>

{/* `t-small` — сноска обязана читаться сноской, а не абзацем (правка
    владельца 2026-08-13, часть 5): кегль на ступень мельче основного текста
    карточек (16 px против 18 px `body`), из объявленной шкалы — сторож
    `dist-typography-scale.test.ts` валит сборку на размере вне неё.
    Приглушённый цвет уже был (`.footnote`, `color: var(--text-muted)`). */}
<p class="footnote t-small">
  Правки входят в цену: один раунд для лендинга, два для сайтов и Mini Apps,
  три для работ от {EDITS_THRESHOLD_PRICE}. Не входят: ваш контент и
  фотографии, домен и хостинг, расход на ИИ-модель.
</p>

<style>
  .intro {
    margin: 16px 0 0;
    max-width: 60ch;
    color: var(--text-muted);
  }

  /* Верхняя тройка «Сайты» — три карточки в ряд от планшета, столбиком на
     телефоне. `align-items: stretch` (умолчание grid) здесь и нужен: три
     карточки одной группы обязаны стоять вровень по высоте, в отличие от
     секции 3, где карточки разной длины (`Services.astro`, `align-items:
     start`). */
  .top-grid {
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 700px) {
    .top-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .top-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .top-body--recommended { position: relative; }

  /* Ярлык наезжает на верхнюю границу карточки, а не стоит внутри неё
     (правка владельца 2026-08-13, часть 2). Контейнер отсчёта — сам
     `.top-body`, который уже сдвинут на паддинг карточки (24 px, `Card.astro`
     `.card`); `top: -35px` — этот паддинг плюс половина высоты пилюли
     (≈22 px), чтобы центр ярлыка лёг ровно на линию границы, а не повис
     внутри отступа. `left: 0` — вровень с левым краем содержимого (h3 ниже),
     без отдельного магического числа. */
  .badge {
    position: absolute;
    top: -35px;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    padding: 4px 12px;
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-accent);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
  }
  /* Без своего font-size: наследует шорт `.badge` целиком (11 px — ступень
     `label` объявленной шкалы), только чуть уже строки для визуального
     баланса со звёздочкой рядом с текстом. */
  .badge-star { line-height: 1; }

  /* Заголовок карточки — фиксированная высота в две строки (правка владельца
     2026-08-13, часть 4): «Лендинг» умещается в одну строку, «Корпоративный
     сайт» — в две, и без брони высоты цена трёх карточек стояла бы на разной
     отметке. `min-height` — не `height`: короткий заголовок оставляет
     заметное пустое место СНИЗУ (текст блока по умолчанию прижат к верху),
     и именно это пустое место выравнивает цену, а не обрезает длинный
     заголовок, если он вдруг займёт три строки. `2.6em` — две строки при
     line-height `.t-h3` (1.3, `styles/base.css`), тем же приёмом вычисления
     через `em`, что и в `.check` ниже, а не подобранное на глаз число. */
  h3 { margin: 0 0 4px; min-height: 2.6em; }

  .price {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  /* «У цены везде предлог «от», набранный заметно мельче самого числа»
     (спека, пункт 7) — та же роль, что у меток `label` (11 px), а не
     ступень абзаца рядом. */
  .price .from {
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  /* Цена — не мелкий текст, она главная в своей строке: та же ступень, что
     у заголовка карточки (`h3`), тем же приёмом, что и раньше в этом файле
     и в `home/Hero.astro` (`.offer-price`). */
  .price code {
    font: 700 1.75rem/1.3 var(--font-head);
    color: var(--accent);
    background: none;
    padding: 0;
  }
  /* Срок — в той же строке, что цена (правка владельца 2026-08-13, часть 4:
     раньше стоял отдельным абзацем ниже), прижат к правому краю строки цены
     `margin-left: auto`, чтобы не спорить весом с самим числом. */
  .price .timeframe {
    margin-left: auto;
    font: 500 0.6875rem/1.3 var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .composition {
    list-style: none;
    margin: 16px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .composition li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 1.125rem;
  }
  /* Галочка встаёт по центру ПЕРВОЙ строки пункта, а не по верху блока
     (правка владельца 2026-08-13, часть 4). `align-items: flex-start` на
     `li` остаётся — многострочный пункт не должен тянуть иконку к своему
     общему центру, только к центру первой строки. Строка текста при 18 px
     и унаследованном line-height 1.65 (`body`, `styles/base.css`) высотой
     1.65em; иконка сама 14 px — отступ сверху равен половине разницы,
     вычислен через `calc` от собственного `em` иконки (наследует font-size
     пункта: `.check` — `<svg>`, у него нет своего `font-size`), а не
     подобран на глаз. */
  .composition .check { flex: none; margin-top: calc((1.65em - 14px) / 2); color: var(--accent); }

  /* Кнопка — второй прямой ребёнок `Card` (первый — `.top-body`), прижата к
     низу карточки тем же приёмом, что `.stack` в `home/ServiceCard.astro`:
     `margin-top: auto` в `.card--stack` (flex-колонка на всю высоту грида,
     `Card.astro`) тянет её вниз независимо от того, сколько строк занял
     заголовок или состав у соседней карточки. Залитая (`variant="primary"`)
     — только у рекомендуемой карточки: на странице уже три залитые
     акцентные кнопки (Header, Hero, LeadForm) — находка ревью №7 из
     `home/Services.astro` про «Все услуги», четвёртая спорила бы весом с
     «Отправить» в форме заявки. Обычные карточки несут `variant="secondary"`
     — тот же контурный вариант. */
  .cta { margin: auto 0 0; padding-top: 4px; }

  /* Полка — шесть маленьких карточек того же вида, что и верхняя тройка
     (правка владельца 2026-08-13, часть 1), а не строки-ссылки: два столбца
     на телефоне, три на планшете, шесть в ряд от 900 px. */
  .shelf {
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  @media (min-width: 560px) {
    .shelf { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 900px) {
    .shelf { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }

  .shelf-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    padding: 16px;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-micro) var(--ease),
                border-color var(--dur-micro) var(--ease);
  }
  .shelf-card:hover { background: var(--accent-soft); border-color: var(--accent); }

  /* `hyphens: auto` — узкая колонка на шести-в-ряд ломает длинное слово
     («Автоматизация») без переноса ровно посередине, читается как опечатка.
     Перенос по слогам (страница уже `lang="ru"`, `layouts/Base.astro`)
     решает это без уменьшения кегля. */
  .shelf-label { font-weight: 600; hyphens: auto; }
  .shelf-price { display: flex; align-items: baseline; gap: 6px; white-space: nowrap; }
  .shelf-price .from {
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .shelf-price code {
    font: 700 1.125rem/1.3 var(--font-head);
    color: var(--text);
    background: none;
    padding: 0;
  }

  .footnote {
    margin: 32px 0 0;
    max-width: 70ch;
    color: var(--text-muted);
  }
</style>
