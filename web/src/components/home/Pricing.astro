---
/* Секция 4 — цены.
 *
 * Правка владельца 2026-08-13 («Секция цен — десять правок владельца»,
 * части 1–5): три верхние карточки стали направлениями («Лендинг» /
 * «Корпоративный сайт» / «Telegram-бот»), а не тремя ступенями одной
 * лестницы «Сайты»; полка внизу стала шестью маленькими карточками. Прежняя
 * структура («три ступени группы «Сайты» + строки-ссылки полки») была
 * собрана по `70-workshop/specs/site-v3/02-redesign-options.md`, пункт 7 —
 * этот заход её не отменяет целиком, только состав и подачу верхней тройки
 * и полки, по прямому указанию владельца, которое приоритетнее спеки.
 *
 * Ни одна цена не хранится в этом файле — всё читается из
 * `data/pricingShowcase.ts`, который сам читает `data/pricing.ts`
 * (сгенерирован `70-workshop/tools/generate_pricing.py` из `10-offer/
 * PRICING.md`). Витринные имена карточек и маппинг на ступени прайса живут
 * там же, с собственным тестом (`data/pricingShowcase.test.ts`), который
 * падает, если ступень переименована или пропала.
 */
import Label from '../Label.astro';
import Card from '../Card.astro';
import Button from '../Button.astro';
import { topCards, shelfCards } from '../../data/pricingShowcase';
import { dict, localeFromPath } from '../../i18n/locales';

const locale = localeFromPath(Astro.url.pathname);
const t = dict(locale);
const TOP_CARDS = topCards(locale);
const SHELF_CARDS = shelfCards(locale);
---
<Label>{t.pricingLabel}</Label>
{/* Задача 22 (правка 2026-08-18): заголовок секции точнее — «Цены на
    разработку», не голое «Цены» (владелец, дословно из мастер-спеки правок
    2026-08-14, [[03-redesign-2026-08-14]], пункт 22). */}
<h2 class="t-h2">{t.pricingHeading}</h2>

<p class="intro">{t.pricingIntro}</p>

<div class="top-grid">
  {TOP_CARDS.map((card) => (
    <Card class={card.recommended ? 'recommended-card' : undefined} stack={true}>
      {card.recommended && <span class="recommendation-surface" aria-hidden="true"></span>}
      <div class:list={['top-body', { 'top-body--recommended': !!card.recommended }]}>
        {card.recommended && (
          <span class="badge"><span class="badge-star" aria-hidden="true">★</span>{card.recommended.label}</span>
        )}
        <h3 class="t-h3"><span>{card.showcaseName}</span></h3>
        <p class="price">
          <span class="from">{t.priceFrom}</span> <code>{card.price}</code>
          <span class="timeframe">{card.timeframe}</span>
        </p>
        <ul class="composition" role="list">
          {card.composition.map((item) => (
            <li>
              <svg class="check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M3 8.5 6.2 11.5 13 4.5" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <p class="cta">
        {card.recommended ? (
          <span class="recommendation-button-wrap">
            <Button href={card.href} variant="secondary">{card.cta}</Button>
            <span class="recommendation-button-fill" aria-hidden="true">
              <span class="recommendation-button-label">{card.cta}</span>
            </span>
          </span>
        ) : (
          <Button href={card.href} variant="secondary">{card.cta}</Button>
        )}
      </p>
    </Card>
  ))}
</div>

{/* Полка — `Card` без кнопки «Рассчитать» (правка владельца 2026-08-18,
    пункт 22 списка правок от той же даты): кнопка снята со всех шести
    маленьких карточек, вместо неё — подсветка при наведении и при фокусе
    с клавиатуры (см. `:global(.shelf > .card:hover…)` в стилях ниже).
    Единственная ссылка карточки — название (`.shelf-label`), и она снова
    ведёт на посадочную услуги (`item.href`). Решение владельца 2026-08-18
    (карточка временно ведёт к форме, D-052) действовало «до появления
    посадочных» — посадочные исполнены (спека 03), все адреса `/services/…`
    отвечают 200, условие временного решения наступило, правка 2026-08-26.
    Атрибут `data-service-href`, хранивший адрес про запас, снят — его
    единственным смыслом было пережить день, когда посадочных ещё не было;
    сам адрес теперь стоит в `href` открыто.
    `Card` без `href` рендерит `<div>` (см. `Card.astro`) — сама карточка не
    интерактивна как ссылка целиком, но реагирует на наведение (курсор в
    любой точке) и на фокус, попавший на название внутри неё
    (`:focus-within`). */}
<div class="shelf">
  {SHELF_CARDS.map((item) => (
    <Card stack={true}>
      <div class="shelf-body">
        <a class="shelf-label" href={item.href}>{item.label}</a>
        <p class="shelf-desc t-small">{item.description}</p>
        <span class="shelf-foot">
          <span class="shelf-price"><span class="from">{t.priceFrom}</span> <code>{item.price}</code></span>
          {item.timeframe && <span class="shelf-timeframe">{item.timeframe}</span>}
        </span>
      </div>
    </Card>
  ))}
</div>

{/* `t-small` сохраняет юридическую оговорку сноской, а не еще одним
    продающим абзацем: она относится ко всем карточкам секции сразу. */}
<p class="footnote t-small">{t.pricingFootnote}</p>

<style>
  /* Отбивка заголовка до первого содержимого — 32 px, одна величина на все
     десять секций главной (правка владельца 2026-08-13, «Три акта»): было
     16px, мельче, чем у большинства остальных секций. */
  .intro {
    margin: 32px 0 0;
    max-width: 60ch;
    color: var(--text-muted);
  }

  /* Верхняя тройка «Сайты» — три карточки в ряд от планшета, столбиком на
     телефоне. `align-items: stretch` (умолчание grid) здесь и нужен: три
     карточки одной группы обязаны стоять вровень по высоте, в отличие от
     секции 3, где карточки разной длины (`Services.astro`, `align-items:
     start`). */
  .top-grid {
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  @media (min-width: 700px) {
    .top-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    /* Ряд раскрывается от центра наружу, рекомендуемая (2-я, чётная) ведёт
       (02-card-motion.md, раздел 7) — ровно одно отличие, которое у неё
       есть; крайние получают --reveal-i:1, средняя остаётся на умолчании 0.
       Порядок движения расходится с порядком чтения намеренно: взгляд
       приводится туда, куда ведёт предложение. Переключение на «слева
       направо» — три явных :nth-child(1..3){--reveal-i:0/1/2} вместо этой
       строки. `:global` — вес: без него Astro дублирует атрибут скоупинга на
       обеих сторонах `>`, комбинатор почти вдвое дороже; класс `.top-grid`
       уникален для этой секции, второй охват не нужен. */
    :global(.top-grid > :nth-child(odd)) { --reveal-i: 1; }

  }

  .top-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .top-body--recommended { position: relative; z-index: 1; }

  /* В покое рекомендуемая карточка не отличается от соседей. Этот слой
     начинает проявляться в зафиксированном владельцем кадре входа карточек
     в активную область секции; отдельный слой не конфликтует с reveal-
     анимацией самой Card. */
  .recommendation-surface {
    position: absolute;
    inset: -1px;
    z-index: 0;
    pointer-events: none;
    border: 1px solid var(--accent);
    border-radius: inherit;
    background: linear-gradient(var(--accent-soft), var(--accent-soft)), var(--surface);
    opacity: 0;
  }

  /* Ярлык наезжает на верхнюю границу карточки, а не стоит внутри неё
     (правка владельца 2026-08-13, часть 2). Контейнер отсчёта — сам
     `.top-body`, который уже сдвинут на паддинг карточки (24 px, `Card.astro`
     `.card`); `top: -35px` — этот паддинг плюс половина высоты пилюли
     (≈22 px), чтобы центр ярлыка лёг ровно на линию границы, а не повис
     внутри отступа. `left: 0` — вровень с левым краем содержимого (h3 ниже),
     без отдельного магического числа. */
  .badge {
    position: absolute;
    top: -35px;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    padding: 4px 12px;
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-accent);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
    opacity: 0;
  }
  /* Без своего font-size: наследует шорт `.badge` целиком (11 px — ступень
     `label` объявленной шкалы), только чуть уже строки для визуального
     баланса со звёздочкой рядом с текстом. */
  .badge-star { line-height: 1; }

  /* Карточка объявляет именованный view timeline. Все три признака
     рекомендации — подложка, ярлык и залитая кнопка — начинают проявляться,
     когда голова линии проходит примерно 320 px от верхней кромки карточки,
     и синхронно набирают плотность на следующих 128 px прокрутки. Это
     соответствует кадру владельца 2048×1151: h2 около 385 px, карточки около
     670 px. До порога они совпадают с обычной карточкой. На узкой раскладке
     линии нет, поэтому нет и акцента. */
  :global(.recommended-card) {
    view-timeline-name: --pricing-recommended;
    view-timeline-axis: block;
  }
  .cta { position: relative; z-index: 1; }
  .recommendation-button-wrap {
    position: relative;
    display: inline-flex;
    overflow: clip;
    border-radius: var(--radius-pill);
  }
  .recommendation-button-fill {
    position: absolute;
    inset: 0;
    overflow: clip;
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    background: var(--accent);
    pointer-events: none;
    opacity: 0;
    translate: -100% 0;
  }
  .recommendation-button-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    color: var(--text-on-accent);
    font: 600 1.125rem/1 var(--font-text);
    white-space: nowrap;
    translate: 100% 0;
  }

  @media (min-width: 900px) {
    .recommendation-surface,
    .badge { opacity: 1; }
    .recommendation-button-fill { opacity: 1; translate: 0 0; }
    .recommendation-button-label { translate: 0 0; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      @media (min-width: 900px) {
        .recommendation-surface,
        .badge,
        .recommendation-button-fill,
        .recommendation-button-label {
          animation-duration: 1ms;
          animation-timing-function: cubic-bezier(.65, 0, .35, 1);
          animation-fill-mode: both;
          animation-timeline: --pricing-recommended;
          /* `cover calc(100vh - --line-head)` совпадает с проходом головы
             через верх карточки. Ещё 320 px дают кадр владельца; следующие
             128 px отвечают только за плавность проявления. */
          animation-range: cover calc(100vh - var(--line-head) + 320px)
                           cover calc(100vh - var(--line-head) + 448px);
        }
        .recommendation-surface,
        .badge { animation-name: recommendation-ignite; }
        .recommendation-button-fill {
          opacity: 1;
          animation-name: recommendation-button-ignite;
        }
        .recommendation-button-label { animation-name: recommendation-button-label-lock; }
      }
    }
  }
  @keyframes recommendation-ignite {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes recommendation-button-ignite {
    from { translate: -100% 0; }
    to { translate: 0 0; }
  }
  @keyframes recommendation-button-label-lock {
    from { translate: 100% 0; }
    to { translate: 0 0; }
  }
  /* Заголовок карточки — фиксированная высота в две строки (правка владельца
     2026-08-13, часть 4): «Лендинг» умещается в одну строку, «Корпоративный
     сайт» — в две, и без брони высоты цена трёх карточек стояла бы на разной
     отметке. `min-height` — не `height`: короткий заголовок мог бы обрезаться,
     если бы вдруг занял три строки, а бронь не обрезает. `2.6em` — две строки
     при line-height `.t-h3` (1.3, `styles/base.css`), тем же приёмом
     вычисления через `em`, что и в `.check` ниже, а не подобранное на глаз
     число.
     Правка владельца 2026-08-13, второй заход («слишком большой отступ
     между названием и ценой»): пустое место брони раньше вставало СНИЗУ
     текста (блок по умолчанию прижат к верху) — у однострочных заголовков
     («Лендинг», «Telegram-бот») между текстом и ценой оказывался почти целый
     лишний свободный line-height. `display: flex; align-items: flex-end`
     переносит это пустое место НАВЕРХ, под текст заголовка: сама бронь
     высоты (а с ней и высота цены на отметке, одинаковой у всех трёх карточек)
     не меняется, а видимый зазор между названием и ценой становится равен
     ровно `gap` родителя (`.top-body`, 4px — шаг шкалы) у всех трёх карточек,
     не только у двухстрочной. */
  /* `min-width: 0` на h3 (как flex-элементе `.top-body`) и на вложенном
     `span` (как flex-элементе самого h3) — без обоих автоматический
     `min-width: auto` флекс-элемента не даёт тексту сжаться ниже
     min-content (правка смены шрифта на Unbounded, заметно шире Manrope: у
     «Корпоративный сайт» слово «Корпоративный» одно перестало помещаться в
     колонку карточки на 320 px, и вместо переноса строки h3 раздувался вбок
     за пределы карточки — classic flexbox-ловушка). `span` — обязательная
     обёртка текста: `min-width: 0` на самом h3 убирает эту ловушку только
     на уровне ЕГО родителя, а не внутри собственного `display: flex` строки
     h3 — сам текстовый узел остаётся анонимным флекс-элементом без
     возможности адресовать его отдельным правилом; обёртка даёт такой
     адрес. Перенос слова внутри `span` при нехватке места берёт на себя уже
     существующий `overflow-wrap: break-word` типографики (`styles/
     base.css`), не отдельное правило здесь. */
  h3 { margin: 0; min-height: 2.6em; min-width: 0; display: flex; align-items: flex-end; }
  h3 span { min-width: 0; }

  .price {
    margin: 0;
    display: flex;
    /* `flex-wrap: wrap` добавлен вместе с `white-space: nowrap` на `.price
       code` ниже (та же правка, находка 1, «заодно»): без него запрет
       переноса ВНУТРИ цены оборачивался переносом карточки НАРУЖУ — на
       700–899px (три карточки в ряд, `.top-grid` уже узкий на этих
       шириных) `<code>` как ужимающийся flex-элемент не мог сжаться меньше
       своего nowrap-содержимого и вылезал за границу карточки, раздувая
       всю страницу горизонтальной прокруткой (сторож
       `background-line.spec.ts`, «768px: scrollWidth === clientWidth»,
       поймал лишние 15px). `flex-wrap: wrap` даёт вместо этого ряду
       возможность перенестись МЕЖДУ элементами (обычно — срок на вторую
       строку, `margin-left: auto` у `.timeframe` держит его прижатым к
       правому краю уже на своей строке), а не внутри числа. */
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
  }
  /* «У цены везде предлог «от», набранный заметно мельче самого числа»
     (спека, пункт 7) — та же роль, что у меток `label` (11 px), а не
     ступень абзаца рядом. */
  .price .from {
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  /* Цена — не мелкий текст, она главная в своей строке: та же ступень, что
     у заголовка карточки (`h3`), тем же приёмом, что и раньше в этом файле
     и в `home/Hero.astro` (`.offer-price`). */
  .price code {
    font: 700 1.75rem/1.3 var(--font-head);
    color: var(--accent);
    background: none;
    padding: 0;
    /* Находка дизайн-ревью 2026-08-22 (находка 1, «заодно»): `.shelf-price`
       (полка шести карточек ниже) уже несла `white-space: nowrap` на своём
       контейнере — здесь, у верхней тройки, этой защиты не было вовсе, и
       `<code>` как ужимающийся flex-элемент `.price` переносил цену внутри
       себя («70» / «000 ₽») на узких трёх-в-ряд ширинах (900–1180px). */
    white-space: nowrap;
  }
  /* Срок — в той же строке, что цена (правка владельца 2026-08-13, часть 4:
     раньше стоял отдельным абзацем ниже), прижат к правому краю строки цены
     `margin-left: auto`, чтобы не спорить весом с самим числом. */
  .price .timeframe {
    margin-left: auto;
    font: 500 0.6875rem/1.3 var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .composition {
    list-style: none;
    margin: 16px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .composition li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 1.125rem;
  }
  /* Галочка встаёт по центру ПЕРВОЙ строки пункта, а не по верху блока
     (правка владельца 2026-08-13, часть 4). `align-items: flex-start` на
     `li` остаётся — многострочный пункт не должен тянуть иконку к своему
     общему центру, только к центру первой строки. Строка текста при 18 px
     и унаследованном line-height 1.65 (`body`, `styles/base.css`) высотой
     1.65em; иконка сама 14 px — отступ сверху равен половине разницы,
     вычислен через `calc` от собственного `em` иконки (наследует font-size
     пункта: `.check` — `<svg>`, у него нет своего `font-size`), а не
     подобран на глаз. */
  .composition .check { flex: none; margin-top: calc((1.65em - 14px) / 2); color: var(--accent); }

  /* Кнопка — второй прямой ребёнок `Card` (первый — `.top-body`), прижата к
     низу карточки тем же приёмом, что `.stack` в `home/ServiceCard.astro`:
     `margin-top: auto` в `.card--stack` (flex-колонка на всю высоту грида,
     `Card.astro`) тянет её вниз независимо от того, сколько строк занял
     заголовок или состав у соседней карточки. Залитая (`variant="primary"`)
     — только у рекомендуемой карточки: на странице уже три залитые
     акцентные кнопки (Header, Hero, LeadForm) — находка ревью №7 из
     `home/Services.astro` про «Все услуги», четвёртая спорила бы весом с
     «Отправить» в форме заявки. Обычные карточки несут `variant="secondary"`
     — тот же контурный вариант. */
  .cta { margin: auto 0 0; padding-top: 4px; }

  /* Полка — шесть маленьких карточек того же вида, что и верхняя тройка
     (правка владельца 2026-08-13, часть 1): один столбец на телефоне, три в
     ряд (два ряда) от 700 px — тот же порог, что у `.top-grid` выше. Замер
     дизайн-ревью 2026-08-13 («полка малых карточек»): при шести-в-ряд и
     контейнере 1180 px колонка выходила 153 px, содержимое 121 px — три из
     шести заголовков («ИИ-консультант» 144,7 px, «Автоматизация» 138,6,
     «Бот-приёмщик» 132,0) шире собственной колонки и переносились посреди
     слова. Три-в-ряд при том же контейнере даёт содержимое 326,7 px — самый
     длинный заголовок («Автоматизация и интеграции», 263,1 px) встаёт в
     строку, и остаётся место на описание. */
  .shelf {
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  @media (min-width: 700px) {
    .shelf { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Каскад полки — сквозной счёт по всем шести карточкам (правка владельца
     2026-08-13, второй заход: «два ряда приходят вразнобой», см. также
     комментарий над `.shelf` выше про три-в-ряд). Первая редакция повторяла
     фазу 0,1,2 в каждом ряду (позиция по модулю 3, как в `.top-grid`) — это
     осознанно ломало диагональ: у полки, в отличие от тройки `.top-grid`,
     ряда физически два, и второй ряд входит во вьюпорт почти сразу за
     первым (карточка полки ниже — 154px против 558px карточки услуги, см.
     тот же комментарий), так что «своя» фаза второго ряда пересекалась по
     времени с хвостом фазы первого — карточки приходили внахлёст, а не
     одна за другой. Счёт 0..5 без повтора устраняет пересечение: каждая
     следующая карточка (включая первую карточку второго ряда) стартует
     позже предыдущей на тот же шаг 8vh, что и внутри одного ряда — оба ряда
     читаются одной диагональю сверху-слева вниз-направо. `:nth-child(1)` не
     объявлен: `var(--reveal-i, 0)` в `.reveal` (`styles/base.css`) уже даёт
     0 по умолчанию. `:global` — вес: без него Astro дублирует атрибут
     скоупинга на обеих сторонах `>`, комбинатор почти вдвое дороже; класс
     `.shelf` уникален для этой секции, второй охват не нужен. */
  @media (min-width: 700px) {
    :global(.shelf > :nth-child(2)) { --reveal-i: 1; }
    :global(.shelf > :nth-child(3)) { --reveal-i: 2; }
    :global(.shelf > :nth-child(4)) { --reveal-i: 3; }
    :global(.shelf > :nth-child(5)) { --reveal-i: 4; }
    :global(.shelf > :nth-child(6)) { --reveal-i: 5; }
  }

  /* Тело карточки — весь контент, кнопки больше нет (правка владельца
     2026-08-18, пункт 22: кнопка «Рассчитать» снята, см. комментарий у
     разметки полки выше). `Card` со `stack={true}` уже даёт карточке
     flex-колонку на всю высоту грида и обрамление (граница, подложка,
     паддинг — `Card.astro`); здесь остаётся только внутренняя раскладка
     контента, единственный прямой ребёнок `Card`. */
  .shelf-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Подсветка при наведении и при фокусе с клавиатуры — замена снятой кнопки
     «Рассчитать» (правка владельца 2026-08-18, пункт 22 списка правок).

     Правка владельца того же дня, вторая: подсветка сплошным `--accent`
     оказалась слишком яркой, а рост толщины рамки — неуклюжим. Второе было
     настоящим дефектом раскладки, а не придиркой к вкусу: `border-box`
     (глобальный сброс) держит ВНЕШНИЙ размер карточки, но рамка съедает её
     ВНУТРЕННЮЮ ширину — при рамке 1 px содержимому доставалось на 2 px
     больше, чем при 2 px. Строки описания перебирались заново, высота
     карточки менялась, и текст ниже полки дёргался при каждом наведении.

     Правка владельца, третья: `--accent-soft` (0.09/0.14 прозрачности) и
     кромка в полный акцент всё ещё читались как громкий акцент. Громкость
     давала прежде всего КРОМКА: заливка в 9% почти незаметна, а рамка в
     полный тон обводит карточку жирным синим контуром. Поэтому ослаблены
     оба: заливка — 4% акцента (вдвое тише токена `--accent-soft`), кромка —
     смесь акцента с обычной рамкой `--border` в отношении 40/60, то есть
     подкрашенная рамка, а не синяя. Внутренняя тень снята совсем: она была
     вторым, не цветовым признаком подсветки, но при наведении мышью такой
     признак не обязателен — обязателен он для ФОКУСА, а фокус несёт
     собственный контур ссылки (`styles/base.css`, `:focus-visible`,
     `outline: 2px solid var(--accent)`), который никуда не делся.

     Ни одно из этих свойств геометрию не трогает — сторож «наведение не
     двигает раскладку» продолжает это охранять.

     Переопределений цвета текста больше нет: на мягкой заливке верны обычные
     цвета, и приглушённые узлы (описание, предлог «от», срок) сохраняют свою
     ступень иерархии вместо того, чтобы выравниваться в один тон, как было
     на сплошной синей.

     `:hover` — курсор в любой точке карточки (`Card` без `href` — `<div>`,
     подсветка не требует, чтобы курсор стоял именно над ссылкой);
     `:focus-within` — тот же эффект с клавиатуры: единственный фокусируемый
     элемент внутри карточки — `.shelf-label`, и его собственный
     `:focus-visible` (глобальный контур, `styles/base.css`,
     `outline: 2px solid var(--accent)`) остаётся ВТОРЫМ, независимым от
     заливки признаком фокуса. `:global` — Card рендерит `<div class="card…">`
     внутри СВОЕГО файла (`Card.astro`), поэтому у него собственный атрибут
     astro-скоупинга; без `:global` селектор снаружи его не увидит. */
  :global(.shelf > .card) {
    /* Точка отсчёта растянутой ссылки `.shelf-label::after` — без неё
       псевдоэлемент считал бы `inset: 0` от ближайшего позиционированного
       предка выше по дереву и накрыл бы половину секции. */
    position: relative;
  }
  /* Плавный переход подсветки — только при отсутствии запроса на снижение
     движения (находка дизайн-ревью 2026-08-22, находка 2: раньше `transition`
     стоял без этого условия). Сама подсветка (цвет фона/кромки ниже) при
     `reduce` никуда не девается — меняется мгновенно, без анимации кадра. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.shelf > .card) {
      transition: background var(--dur-micro) var(--ease),
                  border-color var(--dur-micro) var(--ease),
                  box-shadow var(--dur-micro) var(--ease);
    }
  }
  :global(.shelf > .card:hover),
  :global(.shelf > .card:focus-within) {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  /* Цель нажатия — вся карточка, а не строка названия. Карточка и до этой
     правки подсвечивалась целиком при наведении (`.shelf > .card:hover`
     ниже), то есть обещала, что нажимается вся, — а нажималось только
     название высотой около 22 px, ниже минимума цели нажатия 44 px. Приём —
     растянутая псевдоэлементом ссылка: в разметке остаётся РОВНО одна
     ссылка (важно и для семантики, и для клавиатуры — второй цели табуляции
     не появляется), а её область нажатия покрывает карточку. Тот же приём и
     та же идиома, что принята для блоков кейсов вариантом В (D-047), —
     страница не заводит второй словарь на то же самое. */
  .shelf-label {
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }
  .shelf-label::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  /* Заголовок карточки — без подчёркивания в покое (правка владельца
     2026-08-18: своего правила не было, работало браузерное умолчание, и
     название читалось подчёркнутой ссылкой внутри карточки). Что карточка
     нажимается, сообщает она сама целиком: фон и кромка меняются при
     наведении и при фокусе (`:global(.shelf > .card:hover/:focus-within)`
     выше).

     Находка дизайн-ревью 2026-08-22 (находка 4) поправляет эту правку под
     D-055 (`DECISIONS.md`), записанное тем же 2026-08-18/19: ссылка внутри
     СПИСКА (а `.shelf` — список карточек-ссылок) держит подчёркивание не
     никогда, а именно ПРИ наведении и фокусе — симметрично `.links a` в
     `home/ServiceCard.astro` и `.nav-label` в `NavLinks.astro`. Подсветка
     карточки — самостоятельный, более заметный сигнал (её и не убирали), а
     черта на названии — второй, привычный по остальному сайту. */
  /* ПРАВКА ВЛАДЕЛЬЦА 2026-08-23: подчёркивания при наведении и фокусе
     здесь БОЛЬШЕ НЕТ — частная отмена D-055 для полки цен, парная снятию
     в `home/ServiceCard.astro`. Не возвращать «ради D-055».

     Отклик у карточки остаётся и он заметнее черты: фон и кромка меняются
     при наведении и при фокусе (`:global(.shelf > .card:hover)` и
     `:focus-within` выше) — проверено перед снятием. */
  .shelf-label { text-decoration: none; }

  /* Описание — в строку-две, приглушённого цвета (правка владельца
     2026-08-13, «полка малых карточек»): та же ступень шкалы и тот же цвет,
     что у сноски секции ниже (`.footnote`, `t-small` — 16 px против 18 px
     `body`). */
  .shelf-desc { margin: 0; color: var(--text-muted); }

  .shelf-foot {
    padding-top: 4px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  .shelf-price { display: flex; align-items: baseline; gap: 6px; white-space: nowrap; }
  .shelf-price .from {
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  /* Акцентная, как цена крупных карточек (правка владельца 2026-08-13, второй
     заход, часть 3): «цена не выделена акцентом на малых карточках, хотя на
     крупных выделена» — было `color: var(--text)`, приведено к одному
     правилу с `.price code` выше — цена главное число карточки в обоих
     размерах. Шрифт уже был заголовочным (`--font-head`) — сторож
     `src/tests/price-font.test.ts` уже держит этот селектор в списке, менять
     список не нужно. */
  .shelf-price code {
    font: 700 1.125rem/1.3 var(--font-head);
    color: var(--accent);
    background: none;
    padding: 0;
  }
  /* Срок — рядом с ценой, тем же приёмом, что `.price .timeframe` верхней
     тройки: мельче и приглушённее, чтобы не спорить весом с числом. У
     «Поддержки» срока нет (`item.timeframe` не задан) — тогда в строке
     остаётся одна цена, `justify-content: space-between` на пустом втором
     элементе ничего не сдвигает. */
  .shelf-timeframe {
    font: 500 0.6875rem/1.3 var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .footnote {
    margin: 32px 0 0;
    max-width: 70ch;
    color: var(--text-muted);
  }

  /* Обёртка вокруг цены внутри прозы (`.intro` выше и `.footnote` выше) —
     находка дизайн-ревью 2026-08-22 (находка 1). Число само не переписано:
     `.nowrap` только не даёт браузеру разорвать строку `{card.price}`
     («70 000 ₽») на собственном внутреннем пробеле, когда абзац сужается.
     Название нарочно не завязано на цену — тот же класс годится для любого
     другого неразрывного куска прозы этой секции, если он появится. */
  .nowrap {
    white-space: nowrap;
  }
</style>
