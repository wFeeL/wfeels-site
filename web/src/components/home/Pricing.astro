---
/* Секция 4 — цены. Текст утверждён дословно (`70-workshop/specs/site-v3/
 * 02-texts.md`, секция 4). Числа читаются целиком из `data/pricing.ts`
 * (сгенерирован `70-workshop/tools/generate_pricing.py` из `10-offer/
 * PRICING.md`, план `02-home-plan.md`, задача 8) — компонент не хранит ни
 * одной цены сам, второй ручной копии прайса здесь нет.
 *
 * Группировка — пять групп `data/pricing.ts`: те же четыре карточки секции 3
 * плюс «Поддержка», а не пять разделов PRICING.md (02-texts.md, «Что здесь
 * нельзя менять при правке»: две раскладки одного и того же на одном экране
 * прокрутки читаются как ошибка). Файл уже несёт правильную группировку —
 * секция её не пересобирает.
 */
import Label from '../Label.astro';
import Card from '../Card.astro';
import { PRICING, type PriceGroup } from '../../data/pricing';

/** Цена конкретной ступени по имени группы и записи — тем же приёмом, что
 *  `home/Hero.astro`. Нужна для строки про раунды правок ниже: порог «работы
 *  от N ₽» обязан читаться из данных, а не быть вписан литералом, иначе тест
 *  «в разметке секции нет ни одного числа» был бы бессмысленным. Падает явно,
 *  если ступень переименована или пропала в генераторе — молчаливое
 *  расхождение с ценой хуже упавшей сборки. */
function priceFor(groupName: string, entryName: string): string {
  const entry = PRICING.find((g) => g.name === groupName)?.entries.find((e) => e.name === entryName);
  if (!entry) {
    throw new Error(
      `home/Pricing.astro: в data/pricing.ts нет ступени «${entryName}» в группе ` +
      `«${groupName}» — строка про раунды правок (02-texts.md, секция 4) ссылается на неё.`,
    );
  }
  return entry.price;
}

// Порог «три раунда правок — для работ от…» — спека называет его через
// верхнюю ступень «Сайты», а не отдельным числом: если ступень когда-нибудь
// подорожает, строка обновится сама.
const EDITS_THRESHOLD_PRICE = priceFor('Сайты', 'Сайт до 10 страниц');

/** `note` показывается только у группы «Поддержка» — единственное место, где
 *  02-texts.md печатает пояснение рядом с ценой («10 000 ₽/мес: пять часов,
 *  приоритет…»). У остальных групп `note` в данных — служебная пометка для
 *  сверки с прайсом (например, у «Доработки чужого сайта» это формула
 *  коэффициента риска), не текст для читателя, и на страницу идти не должна. */
function showNote(group: PriceGroup): boolean {
  return group.name === 'Поддержка';
}
---
<Label>СКОЛЬКО ЭТО СТОИТ</Label>
<h2 class="t-h2">Цены</h2>

<p class="intro">
  «От» — потому что цена зависит от объёма. После разбора называю вилку, а в
  предложении фиксирую точную. Дальше она растёт только если задачу меняете
  вы — и тогда мы обсуждаем это до работы, а не после.
</p>

<div class="grid">
  {PRICING.map((group) => (
    <Card>
      <h3 class="t-h3">{group.name}</h3>
      <dl class="rows">
        {group.entries.map((entry) => (
          <div class="row">
            <dt>{entry.name}</dt>
            <dd>
              <code>{entry.price}</code>
              {showNote(group) && entry.note && (
                <span class="note">{entry.note}</span>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </Card>
  ))}
</div>

<p class="footnote">
  Правки входят в цену: один раунд для лендинга, два для сайтов и Mini Apps,
  три для работ от {EDITS_THRESHOLD_PRICE}. Не входят: ваш контент и
  фотографии, домен и хостинг, расход на ИИ-модель.
</p>

<style>
  .intro {
    margin: 16px 0 0;
    max-width: 60ch;
    color: var(--text-muted);
  }

  .grid {
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    /* Группы разной длины («Сайты» — семь ступеней, «ИИ» — две): без
       `align-items: start` grid растягивает карточку по высоте строки грида
       (умолчание `stretch`), и короткая карточка в паре с длинной несёт
       пустое поле снизу. `start` оставляет высоту каждой карточки собственной. */
    align-items: start;
    gap: 20px;
  }
  @media (min-width: 700px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  h3 { margin: 0 0 4px; }

  .rows {
    margin: 12px 0 0;
    display: flex;
    flex-direction: column;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 16px;
    row-gap: 2px;
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }
  .row:first-child { border-top: none; padding-top: 0; }
  .row:last-child { padding-bottom: 0; }

  dt {
    margin: 0;
    flex: 1 1 14ch;
    min-width: 0;
  }
  dd {
    margin: 0;
    flex: 0 1 auto;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }
  /* Было 15 px — самовольный кегль, вне шкалы. Цена — не мелкий текст, она
     главная в своей строке: не «ближайшая по величине» ступень (`small`,
     14 px), а `h3` (20 px) — та же ступень, что у заголовка карточки-группы
     чуть выше, потому что для взгляда, ищущего цену, число и есть заголовок
     строки. Правка 2026-08-13, свод к семи объявленным ([[02-redesign-
     options]], предусловие пункта 8; «цена — не мелкий текст», решение 8). */
  dd code {
    font: 500 1.25rem/1.3 var(--font-mono);
    color: var(--text);
    background: none;
    padding: 0;
  }
  /* Было 13 px — самовольный кегль, вне шкалы. Пояснение к цене — обычная
     приглушённая подпись, ступень `small` (14 px). */
  dd .note {
    font: 400 0.875rem/1.4 var(--font-text);
    color: var(--text-muted);
    max-width: 26ch;
  }

  .footnote {
    margin: 32px 0 0;
    max-width: 70ch;
    color: var(--text-muted);
  }
</style>
