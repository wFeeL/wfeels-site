---
/* Секция 4 — цены. Текст подводки/сноски утверждён дословно (`70-workshop/
 * specs/site-v3/02-texts.md`, секция 4). Структура таблицы переработана по
 * `70-workshop/specs/site-v3/02-redesign-options.md`, «Принято владельцем»,
 * пункт 7 (частная спека приоритетнее общей при расхождении): три верхние
 * карточки группы «Сайты» + компактная полка по остальным группам, вместо
 * пяти карточек-таблиц из восемнадцати строк.
 *
 * Ни одна цена не хранится в этом файле — всё читается из
 * `data/pricingShowcase.ts`, который сам читает `data/pricing.ts`
 * (сгенерирован `70-workshop/tools/generate_pricing.py` из `10-offer/
 * PRICING.md`). Витринные имена карточек и маппинг на ступени прайса живут
 * там же, с собственным тестом (`data/pricingShowcase.test.ts`), который
 * падает, если ступень переименована или пропала.
 */
import Label from '../Label.astro';
import Card from '../Card.astro';
import { PRICING } from '../../data/pricing';
import { TOP_CARDS, SHELF_ROWS, SUPPORT_AUDIT_ROW } from '../../data/pricingShowcase';

/** Цена конкретной ступени по имени группы и записи — нужна только для
 *  сноски про раунды правок ниже: порог «работы от N ₽» обязан читаться из
 *  данных, а не быть вписан литералом. Падает явно, если ступень
 *  переименована или пропала в генераторе. */
function priceFor(groupName: string, entryName: string): string {
  const entry = PRICING.find((g) => g.name === groupName)?.entries.find((e) => e.name === entryName);
  if (!entry) {
    throw new Error(
      `home/Pricing.astro: в data/pricing.ts нет ступени «${entryName}» в группе ` +
      `«${groupName}» — сноска про раунды правок (02-texts.md, секция 4) ссылается на неё.`,
    );
  }
  return entry.price;
}

// Порог «три раунда правок — для работ от…» — спека называет его через
// верхнюю ступень «Сайты» (70 000 ₽), а не отдельным числом: ступень сама на
// главную не выходит карточкой (пункт 7 спеки), но её цена остаётся законным
// порогом внутри уже утверждённого текста сноски.
const EDITS_THRESHOLD_PRICE = priceFor('Сайты', 'Сайт до 10 страниц');

// Строка «поддержка и аудит» — ровно две записи (спека, пункт 7), достаются
// по имени, а не по индексу в шаблоне: тест «ни одной цифры в разметке»
// строже любого индекса `[0]`/`[1]` в JSX-выражении, поэтому разбор пары
// сделан здесь, во фронтматтере.
const [SUPPORT_ROW, AUDIT_ROW] = SUPPORT_AUDIT_ROW;
if (!SUPPORT_ROW || !AUDIT_ROW) {
  throw new Error('home/Pricing.astro: строка «поддержка и аудит» ждёт ровно две записи из data/pricingShowcase.ts.');
}
---
<Label>СКОЛЬКО ЭТО СТОИТ</Label>
<h2 class="t-h2">Цены</h2>

<p class="intro">
  «От» — потому что цена зависит от объёма. После разбора называю вилку, а в
  предложении фиксирую точную. Дальше она растёт только если задачу меняете
  вы — и тогда мы обсуждаем это до работы, а не после.
</p>

<div class="top-grid">
  {TOP_CARDS.map((card) => (
    <Card stack={true}>
      <div class:list={['top-body', { 'top-body--recommended': !!card.recommended }]}>
        {card.recommended && (
          <span class="badge">{card.recommended.label}</span>
        )}
        <h3 class="t-h3">{card.showcaseName}</h3>
        <p class="price">
          <span class="from">от</span> <code>{card.price}</code>
        </p>
        {card.recommended && (
          <p class="reason">{card.recommended.reason}</p>
        )}
        <ul class="composition" role="list">
          {card.composition.map((item) => (
            <li>
              <svg class="check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M3 8.5 6.2 11.5 13 4.5" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </Card>
  ))}
</div>

<div class="shelf">
  <p class="shelf-heading">И ещё три направления — коротко</p>
  <ul class="shelf-list" role="list">
    {SHELF_ROWS.map((row) => (
      <li>
        <a class="shelf-row" href={row.href}>
          <span class="shelf-label">{row.label}</span>
          <span class="shelf-price"><span class="from">от</span> <code>{row.price}</code></span>
        </a>
      </li>
    ))}
    <li>
      <div class="shelf-row shelf-row--pair">
        <a class="shelf-pair-item" href={SUPPORT_ROW.href}>
          <span class="shelf-label">{SUPPORT_ROW.label}</span>
          <span class="shelf-price"><span class="from">от</span> <code>{SUPPORT_ROW.price}</code></span>
        </a>
        <span class="shelf-sep" aria-hidden="true"></span>
        <a class="shelf-pair-item" href={AUDIT_ROW.href}>
          <span class="shelf-label">{AUDIT_ROW.label}</span>
          <span class="shelf-price"><span class="from">от</span> <code>{AUDIT_ROW.price}</code></span>
        </a>
      </div>
    </li>
  </ul>
</div>

<p class="footnote">
  Правки входят в цену: один раунд для лендинга, два для сайтов и Mini Apps,
  три для работ от {EDITS_THRESHOLD_PRICE}. Не входят: ваш контент и
  фотографии, домен и хостинг, расход на ИИ-модель.
</p>

<style>
  .intro {
    margin: 16px 0 0;
    max-width: 60ch;
    color: var(--text-muted);
  }

  /* Верхняя тройка «Сайты» — три карточки в ряд от планшета, столбиком на
     телефоне. `align-items: stretch` (умолчание grid) здесь и нужен: три
     карточки одной группы обязаны стоять вровень по высоте, в отличие от
     секции 3, где карточки разной длины (`Services.astro`, `align-items:
     start`). */
  .top-grid {
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 700px) {
    .top-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .top-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .top-body--recommended { position: relative; }

  .badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    padding: 4px 12px;
    margin: 0 0 8px;
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h3 { margin: 0 0 4px; }

  .price {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  /* «У цены везде предлог «от», набранный заметно мельче самого числа»
     (спека, пункт 7) — та же роль, что у меток `label` (11 px), а не
     ступень абзаца рядом. */
  .price .from {
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  /* Цена — не мелкий текст, она главная в своей строке: та же ступень, что
     у заголовка карточки (`h3`), тем же приёмом, что и раньше в этом файле
     и в `home/Hero.astro` (`.offer-price`). */
  .price code {
    font: 700 1.75rem/1.3 var(--font-mono);
    color: var(--accent);
    background: none;
    padding: 0;
  }

  .reason {
    margin: 6px 0 0;
    color: var(--text-muted);
    max-width: 32ch;
  }

  .composition {
    list-style: none;
    margin: 16px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .composition li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 1.125rem;
  }
  .composition .check { flex: none; margin-top: 3px; color: var(--accent); }

  /* Полка — компактный список строк-ссылок, а не карточки: три направления
     плюс поддержка/аудит на одной строке, вместо трёх отдельных таблиц
     секции до правки (спека, пункт 7: «компактная полка из трёх строк»). */
  .shelf {
    margin: 32px 0 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    overflow: hidden;
  }
  .shelf-heading {
    margin: 0;
    padding: 16px 20px 0;
    color: var(--text-muted);
  }
  .shelf-list {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
  }
  .shelf-list > li + li { border-top: 1px solid var(--border); }

  .shelf-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 20px;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-micro) var(--ease);
  }
  a.shelf-row:hover, .shelf-pair-item:hover { background: var(--accent-soft); }

  .shelf-row--pair {
    padding: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
  }
  .shelf-pair-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 20px;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-micro) var(--ease);
  }
  .shelf-sep { border-left: 1px solid var(--border); }

  .shelf-label { font-weight: 600; }
  .shelf-price { display: flex; align-items: baseline; gap: 6px; white-space: nowrap; }
  .shelf-price .from {
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .shelf-price code {
    font: 700 1.125rem/1.3 var(--font-mono);
    color: var(--text);
    background: none;
    padding: 0;
  }

  @media (max-width: 479px) {
    .shelf-row--pair { grid-template-columns: 1fr; }
    .shelf-sep { border-left: none; border-top: 1px solid var(--border); }
  }

  .footnote {
    margin: 32px 0 0;
    max-width: 70ch;
    color: var(--text-muted);
  }
</style>
