---
/* Секция 4 — цены.
 *
 * Правка владельца 2026-08-13 («Секция цен — десять правок владельца»,
 * части 1–5): три верхние карточки стали направлениями («Лендинг» /
 * «Корпоративный сайт» / «Telegram-бот»), а не тремя ступенями одной
 * лестницы «Сайты»; полка внизу стала шестью маленькими карточками. Прежняя
 * структура («три ступени группы «Сайты» + строки-ссылки полки») была
 * собрана по `70-workshop/specs/site-v3/02-redesign-options.md`, пункт 7 —
 * этот заход её не отменяет целиком, только состав и подачу верхней тройки
 * и полки, по прямому указанию владельца, которое приоритетнее спеки.
 *
 * Ни одна цена не хранится в этом файле — всё читается из
 * `data/pricingShowcase.ts`, который сам читает `data/pricing.ts`
 * (сгенерирован `70-workshop/tools/generate_pricing.py` из `10-offer/
 * PRICING.md`). Витринные имена карточек и маппинг на ступени прайса живут
 * там же, с собственным тестом (`data/pricingShowcase.test.ts`), который
 * падает, если ступень переименована или пропала.
 */
import Label from '../Label.astro';
import Card from '../Card.astro';
import Button from '../Button.astro';
import { PRICING } from '../../data/pricing';
import { TOP_CARDS, SHELF_CARDS } from '../../data/pricingShowcase';

/** Цена конкретной ступени по имени группы и записи — нужна только для
 *  сноски про раунды правок ниже: порог «работы от N ₽» обязан читаться из
 *  данных, а не быть вписан литералом. Падает явно, если ступень
 *  переименована или пропала в генераторе. */
function priceFor(groupName: string, entryName: string): string {
  const entry = PRICING.find((g) => g.name === groupName)?.entries.find((e) => e.name === entryName);
  if (!entry) {
    throw new Error(
      `home/Pricing.astro: в data/pricing.ts нет ступени «${entryName}» в группе ` +
      `«${groupName}» — сноска про раунды правок (02-texts.md, секция 4) ссылается на неё.`,
    );
  }
  return entry.price;
}

// Порог «три раунда правок — для работ от…» и порог «оплата по вехам —
// от…» (PRICING.md, строки 102–103) численно совпадают: оба указывают на
// верхнюю ступень «Сайты» (70 000 ₽). Ступень сама на главную не выходит
// отдельной карточкой, но её цена остаётся законным порогом внутри текста
// подводки и сноски ниже.
const EDITS_THRESHOLD_PRICE = priceFor('Сайты', 'Сайт до 10 страниц');
---
<Label>СКОЛЬКО ЭТО СТОИТ</Label>
<h2 class="t-h2">Цены</h2>

<p class="intro">
  «От» — потому что цена зависит от объёма. После разбора называю вилку, а в
  предложении фиксирую точную. Оплата — половина на старте и половина на
  сдаче; для работ от {EDITS_THRESHOLD_PRICE} разбиваю на вехи.
</p>

<div class="top-grid">
  {TOP_CARDS.map((card) => (
    <Card stack={true} accent={!!card.recommended}>
      <div class:list={['top-body', { 'top-body--recommended': !!card.recommended }]}>
        {card.recommended && (
          <span class="badge"><span class="badge-star" aria-hidden="true">★</span>{card.recommended.label}</span>
        )}
        <h3 class="t-h3">{card.showcaseName}</h3>
        <p class="price">
          <span class="from">от</span> <code>{card.price}</code>
          <span class="timeframe">{card.timeframe}</span>
        </p>
        <ul class="composition" role="list">
          {card.composition.map((item) => (
            <li>
              <svg class="check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M3 8.5 6.2 11.5 13 4.5" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <p class="cta">
        <Button href="#contact" variant={card.recommended ? 'primary' : 'secondary'}>{card.cta}</Button>
      </p>
    </Card>
  ))}
</div>

{/* Полка — теперь `Card` (правка владельца 2026-08-13, второй заход, части
    4–5: «у малых карточек нет кнопок»), тем же компонентом, что и верхняя
    тройка, а не самодельный `<a>` на всю карточку. Раньше вся карточка была
    ссылкой на посадочную услуги (`item.href`) — но кнопка «Рассчитать» ведёт
    на форму (`#contact`), а вложить `<a>` в `<a>` нельзя, поэтому ссылка на
    посадочную переехала на само название (`.shelf-label`) — она остаётся
    РОВНО одной ссылкой с этим `href` (сторож `pricing.spec.ts`, «полка:
    ссылки ведут на ожидаемые посадочные»), просто на другом элементе.
    `Card` без `href` рендерит `<div>` (см. `Card.astro`) — сама карточка
    больше не интерактивна целиком, интерактивны название и кнопка. */}
<div class="shelf">
  {SHELF_CARDS.map((item) => (
    <Card stack={true}>
      <div class="shelf-body">
        <a class="shelf-label" href={item.href}>{item.label}</a>
        <p class="shelf-desc t-small">{item.description}</p>
        <span class="shelf-foot">
          <span class="shelf-price"><span class="from">от</span> <code>{item.price}</code></span>
          {item.timeframe && <span class="shelf-timeframe">{item.timeframe}</span>}
        </span>
      </div>
      {/* Глагол «Рассчитать» — один и тот же на всех шести (правка владельца
          2026-08-13, часть 5): в отличие от тройки выше, где глагол у каждой
          карточки свой («Обсудить лендинг/сайт/бота», под конкретный товар),
          здесь карточка — не отдельное направление, а быстрый вход в ту же
          форму заявки, и владелец просил именно это слово, без вариаций.
          Литерал, не поле данных: значение не варьируется, заводить под него
          отдельное поле в `pricingShowcase.ts` ради шести одинаковых строк
          незачем. Контурная (`variant="secondary"`) — на странице уже три
          залитые акцентные кнопки (Header, Hero, LeadForm) и одна на
          рекомендуемой карточке тройки выше; шесть залитых подряд стёрли бы
          разницу между «главным действием» и «быстрым переходом к форме». */}
      <p class="cta">
        <Button href="#contact" variant="secondary">Рассчитать</Button>
      </p>
    </Card>
  ))}
</div>

{/* `t-small` — сноска обязана читаться сноской, а не абзацем (правка
    владельца 2026-08-13, часть 5): кегль на ступень мельче основного текста
    карточек (16 px против 18 px `body`), из объявленной шкалы — сторож
    `dist-typography-scale.test.ts` валит сборку на размере вне неё.
    Приглушённый цвет уже был (`.footnote`, `color: var(--text-muted)`). */}
<p class="footnote t-small">
  Правки входят в цену: один раунд для лендинга, два для сайтов и Mini Apps,
  три для работ от {EDITS_THRESHOLD_PRICE}. Не входят: ваш контент и
  фотографии, домен и хостинг, расход на ИИ-модель.
</p>

<style>
  /* Отбивка заголовка до первого содержимого — 32 px, одна величина на все
     десять секций главной (правка владельца 2026-08-13, «Три акта»): было
     16px, мельче, чем у большинства остальных секций. */
  .intro {
    margin: 32px 0 0;
    max-width: 60ch;
    color: var(--text-muted);
  }

  /* Верхняя тройка «Сайты» — три карточки в ряд от планшета, столбиком на
     телефоне. `align-items: stretch` (умолчание grid) здесь и нужен: три
     карточки одной группы обязаны стоять вровень по высоте, в отличие от
     секции 3, где карточки разной длины (`Services.astro`, `align-items:
     start`). */
  .top-grid {
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 700px) {
    .top-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    /* Ряд раскрывается от центра наружу, рекомендуемая (2-я, чётная) ведёт
       (02-card-motion.md, раздел 7) — ровно одно отличие, которое у неё
       есть; крайние получают --reveal-i:1, средняя остаётся на умолчании 0.
       Порядок движения расходится с порядком чтения намеренно: взгляд
       приводится туда, куда ведёт предложение. Переключение на «слева
       направо» — три явных :nth-child(1..3){--reveal-i:0/1/2} вместо этой
       строки. `:global` — вес: без него Astro дублирует атрибут скоупинга на
       обеих сторонах `>`, комбинатор почти вдвое дороже; класс `.top-grid`
       уникален для этой секции, второй охват не нужен. */
    :global(.top-grid > :nth-child(odd)) { --reveal-i: 1; }

    /* Рекомендуемая карточка стоит чуть выше соседей (правка владельца
       2026-08-13, второй заход, часть 6; референс — `60-research/
       competitors/denis-bond/screenshots/root/05_Цены_на_разработку/01.png`).
       `transform`, не `margin`: сдвигает только отрисовку, не высоту грид-
       трека — соседние карточки (align-items: stretch) не сжимаются и не
       растягиваются от этого сдвига, только у самой карточки ниже неё
       остаётся зазор в 12px. Только от 700px, тем же приёмом, что и вся
       раскладка тройки в ряд выше: на телефоне карточки идут в столбец, и
       сдвиг там читался бы как разъехавшаяся вёрстка, а не как приподнятая
       карточка. 12px — шаг шкалы «Чертежа» (4·8·12·…): ярлык уже нависает
       на 11px над собственной верхней границей карточки (см. комментарий
       у `.badge` ниже: `top: -35px` минус 24px паддинга `.top-body`), плюс
       этот сдвиг — итоговый зазор до текста вводного абзаца выше остаётся
       положительным (замерено `boundingClientRect` в браузере, см. отчёт).
       Селектор — `card--accent` (модификатор `Card.astro`, приходит через
       проп `accent`), который сейчас несёт ровно одна карточка — та же
       самая, что рекомендуемая: отдельный маркер не заводится. `:global` —
       класс определён в `Card.astro`, а не в скоупе этого файла. */
    :global(.top-grid > .card--accent) { transform: translateY(-12px); }
  }

  .top-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .top-body--recommended { position: relative; }

  /* Ярлык наезжает на верхнюю границу карточки, а не стоит внутри неё
     (правка владельца 2026-08-13, часть 2). Контейнер отсчёта — сам
     `.top-body`, который уже сдвинут на паддинг карточки (24 px, `Card.astro`
     `.card`); `top: -35px` — этот паддинг плюс половина высоты пилюли
     (≈22 px), чтобы центр ярлыка лёг ровно на линию границы, а не повис
     внутри отступа. `left: 0` — вровень с левым краем содержимого (h3 ниже),
     без отдельного магического числа. */
  .badge {
    position: absolute;
    top: -35px;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    padding: 4px 12px;
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-accent);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
  }
  /* Без своего font-size: наследует шорт `.badge` целиком (11 px — ступень
     `label` объявленной шкалы), только чуть уже строки для визуального
     баланса со звёздочкой рядом с текстом. */
  .badge-star { line-height: 1; }

  /* Ярлык появляется на одну фазу позже своей карточки — единственная
     двухфазность на странице (02-card-motion.md, раздел 7): своя `view()`,
     не утилита `.reveal` — только `opacity`, без сдвига (ярлык наезжает на
     границу карточки, любой сдвиг читался бы как съехавшая вёрстка), и без
     `--reveal-i` (фаза фиксированная, не зависит от столбца). Тот же порядок
     вложения и те же длинные свойства, что у `.reveal`. Второй `@keyframes`
     не заводится: переиспользуется `reveal-card` из `styles/base.css`
     (`to{opacity:1;translate:0 0}`) — `.badge` не объявляет `translate`
     вовсе, браузер интерполирует его между умолчанием `none` и `0 0`, а это
     один и тот же нулевой сдвиг на любом кадре: движения нет, платить за
     вторую анимацию весом незачем. `animation-range` — сокращение только
     `-start`/`-end` в одно свойство, это НЕ шорткод `animation:` + `timeline`
     из ловушки 1 (раздел 3) — тот же приём, что и в `FactoryCore.astro`
     (`.core-draw,.core-fade`). `:global` — вес, класс `.badge` уникален. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(.badge) {
        opacity: 0;
        animation-name: reveal-card;
        animation-duration: 1ms;
        animation-timing-function: var(--ease);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 12% entry 48%;
      }
    }
  }

  /* Заголовок карточки — фиксированная высота в две строки (правка владельца
     2026-08-13, часть 4): «Лендинг» умещается в одну строку, «Корпоративный
     сайт» — в две, и без брони высоты цена трёх карточек стояла бы на разной
     отметке. `min-height` — не `height`: короткий заголовок мог бы обрезаться,
     если бы вдруг занял три строки, а бронь не обрезает. `2.6em` — две строки
     при line-height `.t-h3` (1.3, `styles/base.css`), тем же приёмом
     вычисления через `em`, что и в `.check` ниже, а не подобранное на глаз
     число.
     Правка владельца 2026-08-13, второй заход («слишком большой отступ
     между названием и ценой»): пустое место брони раньше вставало СНИЗУ
     текста (блок по умолчанию прижат к верху) — у однострочных заголовков
     («Лендинг», «Telegram-бот») между текстом и ценой оказывался почти целый
     лишний свободный line-height. `display: flex; align-items: flex-end`
     переносит это пустое место НАВЕРХ, под текст заголовка: сама бронь
     высоты (а с ней и высота цены на отметке, одинаковой у всех трёх карточек)
     не меняется, а видимый зазор между названием и ценой становится равен
     ровно `gap` родителя (`.top-body`, 4px — шаг шкалы) у всех трёх карточек,
     не только у двухстрочной. */
  h3 { margin: 0; min-height: 2.6em; display: flex; align-items: flex-end; }

  .price {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  /* «У цены везде предлог «от», набранный заметно мельче самого числа»
     (спека, пункт 7) — та же роль, что у меток `label` (11 px), а не
     ступень абзаца рядом. */
  .price .from {
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  /* Цена — не мелкий текст, она главная в своей строке: та же ступень, что
     у заголовка карточки (`h3`), тем же приёмом, что и раньше в этом файле
     и в `home/Hero.astro` (`.offer-price`). */
  .price code {
    font: 700 1.75rem/1.3 var(--font-head);
    color: var(--accent);
    background: none;
    padding: 0;
  }
  /* Срок — в той же строке, что цена (правка владельца 2026-08-13, часть 4:
     раньше стоял отдельным абзацем ниже), прижат к правому краю строки цены
     `margin-left: auto`, чтобы не спорить весом с самим числом. */
  .price .timeframe {
    margin-left: auto;
    font: 500 0.6875rem/1.3 var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .composition {
    list-style: none;
    margin: 16px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .composition li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 1.125rem;
  }
  /* Галочка встаёт по центру ПЕРВОЙ строки пункта, а не по верху блока
     (правка владельца 2026-08-13, часть 4). `align-items: flex-start` на
     `li` остаётся — многострочный пункт не должен тянуть иконку к своему
     общему центру, только к центру первой строки. Строка текста при 18 px
     и унаследованном line-height 1.65 (`body`, `styles/base.css`) высотой
     1.65em; иконка сама 14 px — отступ сверху равен половине разницы,
     вычислен через `calc` от собственного `em` иконки (наследует font-size
     пункта: `.check` — `<svg>`, у него нет своего `font-size`), а не
     подобран на глаз. */
  .composition .check { flex: none; margin-top: calc((1.65em - 14px) / 2); color: var(--accent); }

  /* Кнопка — второй прямой ребёнок `Card` (первый — `.top-body`), прижата к
     низу карточки тем же приёмом, что `.stack` в `home/ServiceCard.astro`:
     `margin-top: auto` в `.card--stack` (flex-колонка на всю высоту грида,
     `Card.astro`) тянет её вниз независимо от того, сколько строк занял
     заголовок или состав у соседней карточки. Залитая (`variant="primary"`)
     — только у рекомендуемой карточки: на странице уже три залитые
     акцентные кнопки (Header, Hero, LeadForm) — находка ревью №7 из
     `home/Services.astro` про «Все услуги», четвёртая спорила бы весом с
     «Отправить» в форме заявки. Обычные карточки несут `variant="secondary"`
     — тот же контурный вариант. */
  .cta { margin: auto 0 0; padding-top: 4px; }

  /* Полка — шесть маленьких карточек того же вида, что и верхняя тройка
     (правка владельца 2026-08-13, часть 1): один столбец на телефоне, три в
     ряд (два ряда) от 700 px — тот же порог, что у `.top-grid` выше. Замер
     дизайн-ревью 2026-08-13 («полка малых карточек»): при шести-в-ряд и
     контейнере 1180 px колонка выходила 153 px, содержимое 121 px — три из
     шести заголовков («ИИ-консультант» 144,7 px, «Автоматизация» 138,6,
     «Бот-приёмщик» 132,0) шире собственной колонки и переносились посреди
     слова. Три-в-ряд при том же контейнере даёт содержимое 326,7 px — самый
     длинный заголовок («Автоматизация и интеграции», 263,1 px) встаёт в
     строку, и остаётся место на описание. */
  .shelf {
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 700px) {
    .shelf { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Каскад полки — сквозной счёт по всем шести карточкам (правка владельца
     2026-08-13, второй заход: «два ряда приходят вразнобой», см. также
     комментарий над `.shelf` выше про три-в-ряд). Первая редакция повторяла
     фазу 0,1,2 в каждом ряду (позиция по модулю 3, как в `.top-grid`) — это
     осознанно ломало диагональ: у полки, в отличие от тройки `.top-grid`,
     ряда физически два, и второй ряд входит во вьюпорт почти сразу за
     первым (карточка полки ниже — 154px против 558px карточки услуги, см.
     тот же комментарий), так что «своя» фаза второго ряда пересекалась по
     времени с хвостом фазы первого — карточки приходили внахлёст, а не
     одна за другой. Счёт 0..5 без повтора устраняет пересечение: каждая
     следующая карточка (включая первую карточку второго ряда) стартует
     позже предыдущей на тот же шаг 8vh, что и внутри одного ряда — оба ряда
     читаются одной диагональю сверху-слева вниз-направо. `:nth-child(1)` не
     объявлен: `var(--reveal-i, 0)` в `.reveal` (`styles/base.css`) уже даёт
     0 по умолчанию. `:global` — вес: без него Astro дублирует атрибут
     скоупинга на обеих сторонах `>`, комбинатор почти вдвое дороже; класс
     `.shelf` уникален для этой секции, второй охват не нужен. */
  @media (min-width: 700px) {
    :global(.shelf > :nth-child(2)) { --reveal-i: 1; }
    :global(.shelf > :nth-child(3)) { --reveal-i: 2; }
    :global(.shelf > :nth-child(4)) { --reveal-i: 3; }
    :global(.shelf > :nth-child(5)) { --reveal-i: 4; }
    :global(.shelf > :nth-child(6)) { --reveal-i: 5; }
  }

  /* Тело карточки — всё, кроме кнопки (правка владельца 2026-08-13, второй
     заход): `Card` со `stack={true}` уже даёт карточке flex-колонку на всю
     высоту грида и обрамление (граница, подложка, паддинг — `Card.astro`);
     здесь остаётся только внутренняя раскладка контента. Кнопка `.cta` —
     второй прямой ребёнок `Card`, тем же приёмом (`margin-top: auto` в
     `.card--stack`), что и у тройки выше: прижата к низу карточки независимо
     от того, в одну или две строки легло описание соседней карточки. */
  .shelf-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Название теперь ссылка на посадочную услуги (было — вся карточка, см.
     комментарий у разметки полки выше): подчёркивание при наведении и фокусе
     — единственный сигнал интерактивности, раз фон всей карточки на ховере
     больше не меняется (та смена принадлежала карточке-ссылке целиком, а
     карточка ссылкой больше не является). */
  .shelf-label {
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }
  .shelf-label:hover, .shelf-label:focus-visible { text-decoration: underline; }

  /* Описание — в строку-две, приглушённого цвета (правка владельца
     2026-08-13, «полка малых карточек»): та же ступень шкалы и тот же цвет,
     что у сноски секции ниже (`.footnote`, `t-small` — 16 px против 18 px
     `body`). */
  .shelf-desc { margin: 0; color: var(--text-muted); }

  .shelf-foot {
    padding-top: 4px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
