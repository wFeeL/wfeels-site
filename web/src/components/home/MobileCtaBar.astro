---
/* Липкая нижняя панель на мобильном — блокер дизайн-ревью 2026-08-13
 * (часть 1): на 390 px кнопка «Обсудить задачу» в шапке скрыта
 * (`Header.astro`, `.cta-slot`, правка владельца 2026-08-13, пункт 4), а
 * секция «Контакт» начинается после девятнадцати экранов прокрутки —
 * читатель, решившийся на цене, физически не может нажать ничего.
 *
 * Диапазон появления — чистый CSS, без единого байта JavaScript (требование
 * ревью). Приём — «липкий якорь внутри обрезанного диапазона»:
 * `pages/index.astro` физически оборачивает все секции между «Как обычно
 * бывает» и «Контактом» (Pain → Faq, акты 2 и 3) в `<div class="mobile-cta-
 * range">`, и этот компонент — первый ребёнок того диапазона.
 *
 * Три вложенных слоя, и у каждого своя задача:
 *
 *   `.mobile-cta-clip`  — `position: absolute; inset: 0` внутри диапазона
 *                          (сам диапазон — `position: relative`, задаёт
 *                          систему отсчёта, но своей высоты не меняет: он
 *                          не в потоке). Высота слоя = высота диапазона,
 *                          `overflow: hidden` РЕЖЕТ панель ровно по его
 *                          верхней и нижней границе — это и есть настоящее
 *                          исчезновение, а не отдельный пункт объяснения.
 *   `.mobile-cta-anchor` — `position: sticky` пустой (`height: 0`) высоты:
 *                          её «коридор» прилипания ограничен границами
 *                          `.mobile-cta-clip` (containing block якоря —
 *                          ближайший позиционированный предок).
 *   `.mobile-cta-bar`    — реальная видимая панель, `position: absolute`
 *                          внутри якоря.
 *
 * Первая редакция этой панели обходилась без `.mobile-cta-clip` (якорь сразу
 * внутри диапазона) — и после чистого CSS-прилипания открылся дефект,
 * подтверждённый рендером: `position: sticky` останавливается на границе
 * своего диапазона, но НЕ исчезает — панель просто перестаёт следовать за
 * окном и остаётся лежать в документе ровно на границе диапазона (= верх
 * «Контакта»), и следующий экран прокрутки несёт её вместе с началом формы,
 * поверх метки «ПОСЛЕДНИЙ ШАГ». Обрезающий слой снимает именно это: как
 * только цель прилипания выходит за его границы, браузер обрезает
 * содержимое по месту, и панель пропадает, а не едет дальше вместе со
 * страницей.
 *
 * Держит панель именно `top`, а не `bottom`: `position: sticky` с заданным
 * только `bottom` включается при прокрутке ВВЕРХ (не даёт нижнему краю уйти
 * НИЖЕ линии, когда контент приближается СНИЗУ) — обратный сценарий тому,
 * что нужен здесь. `top`, наоборот, включается при прокрутке ВНИЗ (не даёт
 * верхнему краю уйти ВЫШЕ линии, когда контент уходит вверх и пропадает за
 * кадром) — «липнет, пока скроллишь дальше через диапазон». Чтобы визуально
 * панель всё равно стояла у НИЖНЕГО края окна, `top` считается не нулём, а
 * «высота окна минус высота самой панели» (`--bar-h`, посчитана из паддингов
 * и рамки `.mobile-cta-bar`, а не подобрана на глаз): верхний край видимой
 * панели встаёт ровно на нижней кромке экрана, а собственная высота панели
 * опускает её нижний край на саму кромку.
 *
 * Отрицательные поля `left`/`right` на `.mobile-cta-clip` компенсируют
 * паддинг `.container` (`Container.astro`) на тех же двух ширинах, на
 * которых панель вообще видна (16 px ниже 480 px, 24 px от 480 до 899 px —
 * сама панель скрыта с 900 px, третье значение контейнера, 40 px, ей не
 * нужно): без компенсации панель стояла бы двумя пустыми полосами
 * `--surface` уже, чем экран, а не во всю его ширину. Оба нижних слоя
 * наследуют уже готовую полную ширину — второй раз то же число здесь не
 * повторяется.
 */
import Button from '../Button.astro';
import { dict } from '../../i18n/locales';

const t = dict('ru');
---
<div class="mobile-cta-clip">
  <div class="mobile-cta-anchor">
    <div class="mobile-cta-bar">
      <Button href="#contact" variant="primary">{t.write}</Button>
    </div>
  </div>
</div>

<style>
  .mobile-cta-clip {
    position: absolute;
    inset: 0;
    left: -16px;
    right: -16px;
    overflow: hidden;
    overflow: clip;
    pointer-events: none;
    /* Выше обычного содержимого страницы (карточки, их собственные
       `position: absolute` — например бейдж рекомендуемой карточки цен —
       красятся раньше позиционированных элементов с явным `z-index` по
       правилам порядка отрисовки CSS 2.1), но ниже липкой шапки (100) и
       раскрывашки мобильного меню поверх неё. */
    z-index: 70;
  }
  @media (min-width: 480px) {
    .mobile-cta-clip { left: -24px; right: -24px; }
  }
  /* С 900 px кнопка «Обсудить задачу» снова есть в шапке (`Header.astro`,
     `.cta-slot`) — вторая, липкая внизу экрана, здесь бы её дублировала. */
  @media (min-width: 900px) {
    .mobile-cta-clip { display: none; }
  }

  .mobile-cta-anchor {
    /* Рамка (1) + паддинги (12 сверху, 12 снизу плюс безопасная зона iOS) +
       высота цели нажатия кнопки (44, общее правило `base.css`) — реальная
       высота `.mobile-cta-bar` ниже, посчитанная из тех же чисел, что и её
       собственные паддинги/рамка, а не продублированная вторым магическим
       числом. */
    --bar-h: calc(1px + 12px + 44px + 12px + env(safe-area-inset-bottom));
    position: sticky;
    top: calc(100dvh - var(--bar-h));
    height: 0;
  }

  .mobile-cta-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    display: flex;
    justify-content: center;
    /* `env(safe-area-inset-bottom)` — не перекрывает системную полосу жестов
       iOS (требование ревью); `12px` — тот же отступ, что и по бокам панели,
       на случай нулевой безопасной зоны (Android, десктопные браузеры). */
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    background: var(--surface);
    border-top: 1px solid var(--border);
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.08);
    pointer-events: auto;
  }
</style>
