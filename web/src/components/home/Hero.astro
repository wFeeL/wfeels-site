---
/* Секция 1 — первый экран. Текст утверждён дословно в
 * `70-workshop/specs/site-v3/02-texts.md`, секция 1 — кроме заголовка:
 * правка владельца 2026-08-13, пункт 5, заменила «Сайты и автоматизация —
 * дни там, где обычно недели» на «Сайты и автоматизация за дни, а не за
 * недели»; спека ещё несёт старую формулировку и разошлась с кодом.
 * Числа таблицы читаются из `data/pricing.ts` и `data/terms.ts` — ни цены,
 * ни срока в этом файле буквально не стоит (план, задача 5).
 */
import Prose from '../Prose.astro';
import Label from '../Label.astro';
import Button from '../Button.astro';
import { priceEntry } from '../../data/pricingLocalized';
import { heroTerms } from '../../data/terms';
import { serviceHref } from '../../lib/serviceHref';
import { dict, localeFromPath, type Locale } from '../../i18n/locales';

/* Язык — из адреса страницы. Секция приходит на страницу слотом
   (`HomeSection` → `Section` → `<Content />` без пропов), и передать сюда
   проп по цепочке нечем: `Content` рисуется без атрибутов. Вывод из адреса —
   тот же самый, которым `Base.astro` ставит `lang` на `<html>`, поэтому два
   источника языка на одной странице не заводятся. */
const locale = localeFromPath(Astro.url.pathname);
const t = dict(locale);

/** Достаёт цену «от» по имени группы и ступени из `pricing.ts`. Падает явно,
 *  а не молчит, если сгенерированный файл когда-нибудь потеряет одну из трёх
 *  ступеней, на которые опирается таблица первого экрана — лучше красная
 *  сборка, чем страница с пустой ячейкой. */
function priceFor(groupName: string, entryName: string): string {
  // Ступень ищется по РУССКОМУ имени на любом языке страницы: имя ступени —
  // её идентификатор в прайсе, а не текст для читателя (разбор — в
  // `data/pricingLocalized.ts`). Возвращается ступень нужного языка.
  const entry = priceEntry(locale, groupName, entryName);
  // Источник хранит голое число без слова «от»: это общее правило прайса
  // (PRICING.md, шапка), а не часть самого числа, и добавляется здесь при
  // отображении, а не хранится второй раз в данных. Само слово живёт в
  // словаре (`t.priceFrom`) — на английской странице это «from».
  if (!/^\d/.test(entry.price)) {
    throw new Error(
      `home/Hero.astro: цена «${entry.price}» ступени «${entryName}» не похожа на ` +
      'число — таблица первого экрана не рассчитана на словесную формулировку.',
    );
  }
  return `${t.priceFrom} ${entry.price}`;
}

const TERMS = heroTerms(locale);
if (TERMS.length !== 4) {
  throw new Error(
    'home/Hero.astro: таблица первого экрана ждёт ровно четыре срока в data/terms.ts, ' +
    `а их ${TERMS.length}.`,
  );
}

/* Четвёртая строка — аудит сайта (указание владельца 2026-08-26): «основной
 * вход в воронку» по SERVICES.md стоял только шестой карточкой полки цен и
 * отсутствовал на первом экране. Каждая строка ведёт на СВОЮ посадочную —
 * было общим `#services` у трёх верхних строк, что почти всегда приводило не
 * туда, куда обещал текст строки. */
const OFFER_ROWS = [
  {
    term: TERMS[0],
    price: priceFor('Сайты', 'Лендинг из шаблона'),
    href: serviceHref('sites', 'Сайт под ключ'),
  },
  {
    term: TERMS[1],
    price: priceFor('Автоматизация и интеграции', 'Одна интеграция'),
    href: serviceHref('automation', 'Прием заявок и интеграции'),
  },
  {
    term: TERMS[2],
    price: priceFor('ИИ', 'Консультант на готовых материалах'),
    href: serviceHref('ai', 'ИИ-консультант по материалам'),
  },
  {
    term: TERMS[3],
    price: priceFor('Сайты', 'Аудит сайта + план правок'),
    href: serviceHref('sites', 'Аудит сайта'),
  },
];

/** Строка регалий — ровно пять пунктов (спека, «Строка регалий»). Заведена
 *  списком, а не одной строкой текста: разделители-точки и раздельные
 *  `aria-hidden` рисует разметка ниже, а тест ширины меряет каждый пункт по
 *  отдельности. */
const REGALIA_BY_LOCALE: Record<Locale, readonly string[]> = {
  ru: [
    'Санкт-Петербург',
    'работаю удаленно',
    'отвечаю в течение дня',
    'пишу код сам, без подрядчиков',
    '3 года на Python',
  ],
  /* Те же пять фактов и ни одним больше. Строка стоит в одну линию при
     контейнере 1180 px (сторож `e2e/hero.spec.ts`), и запас у английской
     версии меньше русской — при правке слов пересчитывать её длину, а не
     дописывать шестой пункт. */
  en: [
    'Saint Petersburg',
    'working remotely',
    'I reply within a day',
    'I write the code myself, no subcontractors',
    '3 years with Python',
  ],
};
const REGALIA = REGALIA_BY_LOCALE[locale];
for (const [name, items] of Object.entries(REGALIA_BY_LOCALE)) {
  if (items.length !== 5) {
    throw new Error(
      `home/Hero.astro: строка регалий обязана нести ровно пять пунктов (${name}: ${items.length}).`,
    );
  }
}

---
<Label>{t.heroLabel}</Label>
<h1 class="t-display">{t.heroHeading}</h1>
<Prose>
  <p class="t-body-lg">{t.heroLead}</p>
</Prose>

<ul class="offer" role="list">
  {OFFER_ROWS.map((row) => (
    <li>
      <a class="offer-row" href={row.href}>
        <span class="offer-group">{row.term.label}</span>
        <span class="offer-term">{row.term.term}</span>
        <span class="offer-price">{row.price}</span>
      </a>
    </li>
  ))}
</ul>

<div class="cta">
  {/* Линия-рассказчик: кнопка серая до прихода линии, затем акцентная
      маска плавно открывается слева направо. `background-color`/`color`
      настоящей кнопки не анимируются —
      `background-color`/`color` не композитятся, и анимация напрямую на
      кнопке перекрашивала весь кадр 60 раз за прокрутку (диагноз: 880–1046
      событий `Paint` за 60 тиков колеса против 218 без неё, порог сторожа
      `about-photo-scroll-cost.spec.ts` — 320). Приём тот же, что несёт вся
      линия целиком (`.line-curtain`): не перекрашивать содержимое, а
      накрывать его композитным слоем. `.cta-primary-wrap` — точка отсчёта
      для абсолютно спозиционированного слоя; сама кнопка ВСЕГДА остаётся
      серой (`BackgroundLine.astro`, статическое правило, без анимации).
      Один полноразмерный слой въезжает слева через композитный `translate`;
      его подпись синхронно едет в обратную сторону и поэтому визуально
      остаётся на месте. Диапазон продлён ещё на 96 px после кромки кнопки,
      чтобы обычный шаг колеса не превращал проход в скачок. Заливка
      непрерывна, текст не масштабируется, а
      прокрутка не вызывает покадровый Paint. Слой декоративный:
      `aria-hidden` и `pointer-events:none` оставляют клик и фокус настоящей
      кнопке под ним. */}
  <span class="cta-primary-wrap">
    <Button href="#contact" variant="primary">{t.write}</Button>
    <span class="cta-ignite-fill" aria-hidden="true">
      <span class="cta-ignite-label">{t.write}</span>
    </span>
  </span>
  <Button href="#pricing" variant="secondary">{t.heroSecondary}</Button>
</div>

<p class="regalia" data-regalia>
  {REGALIA.map((item, i) => (
    <>
      <span class="item">{item}</span>
      {i < REGALIA.length - 1 && <span class="sep" aria-hidden="true"> · </span>}
    </>
  ))}
</p>

<style>
  /* Отбивка заголовка до первого содержимого — 32 px, одна величина на все
     десять секций главной (правка владельца 2026-08-13, «Три акта»): было
     20 px, вне объявленной шкалы отступов и мельче, чем у большинства
     остальных секций (`Services.astro`, `Cases.astro`, `Guarantees.astro`,
     `Faq.astro` уже стояли на 32). */
  /* Дизайн-ревью-блокер: на 390 px колонка 358 px, слово «автоматизация» в
     `.t-display` 40 px рендерится в ≈410 px (замер `canvas.measureText`) —
     перебор ≈52 px, и глобальный `overflow-wrap: break-word` (`base.css`,
     правило `body`) рубит его посередине без переноса («автоматизац/ия»).
     `hyphens: manual` тут бы ничего не дал — в тексте нет ни одного `&shy;`.
     Правка — `hyphens: auto` вместо ручных переносов: `<html lang="ru">`
     стоит по умолчанию (`layouts/Base.astro`), и словарь переносов для
     русского в Chromium (тот же движок, что гоняет `test:e2e`) подтверждён
     прямым замером перед правкой — слово «автоматизация» в изолированном
     блоке 100×40px переносится по слогам и укладывается в ширину без
     горизонтального переполнения. Кегль `.t-display` (шкала `base.css`,
     сторож `dist-typography-scale.test.ts`) не трогается: у образца слово
     переносится по словарю, а не обрезается по границе контейнера.
     `overflow-wrap: break-word` от `body` остаётся как запасной путь на
     случай, если для какого-то слова словарь не найдёт точку переноса —
     эта правка не снимает сетку безопасности, а лишь ставит перед ней более
     раннюю и опрятную попытку перенести слово.

     Дизайн-ревью 2026-08-21: на 1440 и 1920 px тот же `hyphens: auto`
     переносил «автоматиза-ция» ПРИ СВОБОДНОМ месте справа — с шириной
     колонки, которой на этих экранах достаточно для целого слова на своей
     строке, браузер всё равно предпочитал разбить его по словарю, а не
     перенести целиком (обычное поведение `hyphens: auto` — оно не смотрит,
     есть ли смысл переносить). На узкой колонке перенос необходим, на
     широкой — нет, поэтому правило не общее, а по ширине: включается только
     там, где без него слово ломается голым `overflow-wrap` (задача выше),
     и снято везде, где колонка и так вмещает слово целиком.

     Граница измерена прямым рендером без `hyphens` вовсе (playwright,
     ширины 320…1085 px, тот же словарь Chromium): «автоматизация» рвётся
     некрасиво на 320…440 px и укладывается на свою строку целиком без
     остатка начиная с 450 px. Порог ниже взят с запасом в те же 40 px, что
     уже разводят первые две ступени контейнера (`Container.astro`,
     `padding-inline` меняется на 480 px) — та же точка, а не третье
     самовольное число: `hyphens: auto` живёт строго ДО неё, а с 480 px и
     шире, где слово ложится без переноса на всех проверенных ширинах вплоть
     до 1920, — `hyphens: none`. */
  h1 {
    margin: 0 0 32px;
    max-width: 20ch;
    hyphens: none;
    -webkit-hyphens: none;
  }
  @media (max-width: 479px) {
    h1 {
      hyphens: auto;
      -webkit-hyphens: auto;
    }
  }

  .offer {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    max-width: 640px;
  }
  .offer li + li { border-top: 1px solid var(--border); }

  .offer-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 12px 20px;
    padding: 16px 20px;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-micro) var(--ease);
  }
  .offer-row:hover { background: var(--accent-soft); }

  .offer-group { font-weight: 600; }
  /* Было 13 px — самовольный кегль, вне шкалы. Срок — моно-пометка рядом с
     ценой, та же роль, что у меток `label` (11 px), правка 2026-08-13, свод к
     семи объявленным ([[02-redesign-options]], предусловие пункта 8). */
  .offer-term {
    font: 500 0.6875rem/1.3 var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
  }
  /* Было 15 px — самовольный кегль, вне шкалы. Цена — не мелкий текст, она
     главная в своей строке: ступень `h3` (20 px), не «ближайшая» `small`,
     той же логикой, что и цены секции 4 (`Pricing.astro`, `dd code`). Правка
     2026-08-13, свод к семи объявленным («цена — не мелкий текст», решение 8). */
  .offer-price {
    font: 700 1.125rem/1.3 var(--font-head);
    color: var(--accent);
    white-space: nowrap;
    text-align: right;
  }

  @media (max-width: 479px) {
    .offer-row { grid-template-columns: 1fr; gap: 4px; }
    .offer-price { text-align: left; }
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 32px 0 0;
  }

  /* Точка отсчёта непрерывной маски: обёртка схлопывается до настоящей
     кнопки, а декоративная копия не меняет её размер и не перехватывает
     клик. */
  .cta-primary-wrap {
    position: relative;
    display: inline-flex;
    overflow: clip;
    border-radius: var(--radius-pill);
  }

  /* Акцентный слой въезжает слева, а вложенная подпись тем же прогрессом
     сдвигается вправо. Их смещения взаимно уничтожаются, поэтому граница
     заливки движется, а белая копия текста остаётся совмещена с настоящей. */
  .cta-ignite-fill {
    position: absolute;
    inset: 0;
    overflow: clip;
    border-radius: var(--radius-pill);
    background: var(--accent);
    pointer-events: none;
    opacity: 0;
    translate: -100% 0;
  }

  .cta-ignite-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 20px;
    font: 600 1.125rem/1 var(--font-text);
    color: var(--text-on-accent);
    white-space: nowrap;
    translate: 100% 0;
  }

  /* Перенос фокусной рамки на обёртку: её `overflow: clip` обрезает рамку
     настоящей ссылки, а состояние клавиатуры должно остаться видимым. */
  .cta-primary-wrap:focus-within {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  /* Мельче и приглушённее, чем метка-эйбраузер над заголовком: та (`Label`,
     акцентный цвет) зовёт внимание, а регалии — факты для тех, кто уже читает
     дальше. Тот же типографский класс `label` из шкалы (моно, капслок,
     трекинг .16em), но приглушённый цвет вместо акцентного — иначе строка из
     пяти фактов конкурирует с самой меткой сверху. */
  .regalia {
    margin: 24px 0 0;
    font: 500 0.6875rem/1.6 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .regalia .sep { color: var(--text-faint); }
</style>
