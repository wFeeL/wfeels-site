---
/* Секция 1 — первый экран. Текст утверждён дословно в
 * `70-workshop/specs/site-v3/02-texts.md`, секция 1 — кроме заголовка:
 * правка владельца 2026-08-13, пункт 5, заменила «Сайты и автоматизация —
 * дни там, где обычно недели» на «Сайты и автоматизация за дни, а не за
 * недели»; спека ещё несёт старую формулировку и разошлась с кодом.
 * Числа таблицы читаются из `data/pricing.ts` и `data/terms.ts` — ни цены,
 * ни срока в этом файле буквально не стоит (план, задача 5).
 */
import Prose from '../Prose.astro';
import Label from '../Label.astro';
import Button from '../Button.astro';
import { PRICING } from '../../data/pricing';
import { HERO_TERMS } from '../../data/terms';

/** Достаёт цену «от» по имени группы и ступени из `pricing.ts`. Падает явно,
 *  а не молчит, если сгенерированный файл когда-нибудь потеряет одну из трёх
 *  ступеней, на которые опирается таблица первого экрана — лучше красная
 *  сборка, чем страница с пустой ячейкой. */
function priceFor(groupName: string, entryName: string): string {
  const group = PRICING.find((g) => g.name === groupName);
  const entry = group?.entries.find((e) => e.name === entryName);
  if (!entry) {
    throw new Error(
      `home/Hero.astro: в data/pricing.ts нет ступени «${entryName}» в группе ` +
      `«${groupName}» — таблица первого экрана ждёт её (спека 02-texts.md, секция 1).`,
    );
  }
  // Источник хранит голое число без слова «от»: это общее правило прайса
  // (PRICING.md, шапка), а не часть самого числа, и добавляется здесь при
  // отображении, а не хранится второй раз в данных.
  if (!/^\d/.test(entry.price)) {
    throw new Error(
      `home/Hero.astro: цена «${entry.price}» ступени «${entryName}» не похожа на ` +
      'число — таблица первого экрана не рассчитана на словесную формулировку.',
    );
  }
  return `от ${entry.price}`;
}

if (HERO_TERMS.length !== 3) {
  throw new Error(
    'home/Hero.astro: таблица первого экрана ждёт ровно три срока в data/terms.ts, ' +
    `а их ${HERO_TERMS.length}.`,
  );
}

const OFFER_ROWS = [
  { term: HERO_TERMS[0], price: priceFor('Сайты', 'Лендинг из шаблона') },
  { term: HERO_TERMS[1], price: priceFor('Автоматизация и интеграции', 'Одна интеграция') },
  { term: HERO_TERMS[2], price: priceFor('ИИ', 'Консультант на готовых материалах') },
];

/** Строка регалий — ровно пять пунктов (спека, «Строка регалий»). Заведена
 *  списком, а не одной строкой текста: разделители-точки и раздельные
 *  `aria-hidden` рисует разметка ниже, а тест ширины меряет каждый пункт по
 *  отдельности. */
const REGALIA = [
  'Санкт-Петербург',
  'работаю удаленно',
  'отвечаю в течение дня',
  'пишу код сам, без подрядчиков',
  '3 года на Python',
];
if (REGALIA.length !== 5) {
  throw new Error('home/Hero.astro: строка регалий обязана нести ровно пять пунктов.');
}
---
<Label>КОГДА КОНСТРУКТОРА УЖЕ НЕ ХВАТАЕТ</Label>
<h1 class="t-display">Сайты и автоматизация — дни вместо недель</h1>
<Prose>
  <p class="t-body-lg">
    Один разработчик вместо цепочки подрядчиков. Проектирую и проверяю сам, а
    ИИ ускоряет написание кода.
  </p>
</Prose>

<ul class="offer" role="list">
  {OFFER_ROWS.map((row) => (
    <li>
      <a class="offer-row" href="#services">
        <span class="offer-group">{row.term.label}</span>
        <span class="offer-term">{row.term.term}</span>
        <span class="offer-price">{row.price}</span>
      </a>
    </li>
  ))}
</ul>

<div class="cta">
  <Button href="#contact" variant="primary">Обсудить задачу</Button>
  <Button href="#pricing" variant="secondary">Смотреть цены</Button>
</div>

<p class="regalia" data-regalia>
  {REGALIA.map((item, i) => (
    <>
      <span class="item">{item}</span>
      {i < REGALIA.length - 1 && <span class="sep" aria-hidden="true"> · </span>}
    </>
  ))}
</p>

<style>
  /* Отбивка заголовка до первого содержимого — 32 px, одна величина на все
     десять секций главной (правка владельца 2026-08-13, «Три акта»): было
     20 px, вне объявленной шкалы отступов и мельче, чем у большинства
     остальных секций (`Services.astro`, `Cases.astro`, `Guarantees.astro`,
     `Faq.astro` уже стояли на 32). */
  /* Дизайн-ревью-блокер: на 390 px колонка 358 px, слово «автоматизация» в
     `.t-display` 40 px рендерится в ≈410 px (замер `canvas.measureText`) —
     перебор ≈52 px, и глобальный `overflow-wrap: break-word` (`base.css`,
     правило `body`) рубит его посередине без переноса («автоматизац/ия»).
     `hyphens: manual` тут бы ничего не дал — в тексте нет ни одного `&shy;`.
     Правка — `hyphens: auto` вместо ручных переносов: `<html lang="ru">`
     стоит по умолчанию (`layouts/Base.astro`), и словарь переносов для
     русского в Chromium (тот же движок, что гоняет `test:e2e`) подтверждён
     прямым замером перед правкой — слово «автоматизация» в изолированном
     блоке 100×40px переносится по слогам и укладывается в ширину без
     горизонтального переполнения. Кегль `.t-display` (шкала `base.css`,
     сторож `dist-typography-scale.test.ts`) не трогается: у образца слово
     переносится по словарю, а не обрезается по границе контейнера.
     `overflow-wrap: break-word` от `body` остаётся как запасной путь на
     случай, если для какого-то слова словарь не найдёт точку переноса —
     эта правка не снимает сетку безопасности, а лишь ставит перед ней более
     раннюю и опрятную попытку перенести слово. */
  h1 {
    margin: 0 0 32px;
    max-width: 20ch;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .offer {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    max-width: 640px;
  }
  .offer li + li { border-top: 1px solid var(--border); }

  .offer-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 12px 20px;
    padding: 16px 20px;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-micro) var(--ease);
  }
  .offer-row:hover { background: var(--accent-soft); }

  .offer-group { font-weight: 600; }
  /* Было 13 px — самовольный кегль, вне шкалы. Срок — моно-пометка рядом с
     ценой, та же роль, что у меток `label` (11 px), правка 2026-08-13, свод к
     семи объявленным ([[02-redesign-options]], предусловие пункта 8). */
  .offer-term {
    font: 500 0.6875rem/1.3 var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
  }
  /* Было 15 px — самовольный кегль, вне шкалы. Цена — не мелкий текст, она
     главная в своей строке: ступень `h3` (20 px), не «ближайшая» `small`,
     той же логикой, что и цены секции 4 (`Pricing.astro`, `dd code`). Правка
     2026-08-13, свод к семи объявленным («цена — не мелкий текст», решение 8). */
  .offer-price {
    font: 700 1.125rem/1.3 var(--font-head);
    color: var(--accent);
    white-space: nowrap;
    text-align: right;
  }

  @media (max-width: 479px) {
    .offer-row { grid-template-columns: 1fr; gap: 4px; }
    .offer-price { text-align: left; }
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 32px 0 0;
  }

  /* Мельче и приглушённее, чем метка-эйбраузер над заголовком: та (`Label`,
     акцентный цвет) зовёт внимание, а регалии — факты для тех, кто уже читает
     дальше. Тот же типографский класс `label` из шкалы (моно, капслок,
     трекинг .16em), но приглушённый цвет вместо акцентного — иначе строка из
     пяти фактов конкурирует с самой меткой сверху. */
  .regalia {
    margin: 24px 0 0;
    font: 500 0.6875rem/1.6 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .regalia .sep { color: var(--text-faint); }
</style>
