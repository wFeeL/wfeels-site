---
/* Секция 2 — как обычно бывает. Текст утверждён дословно в
 * `70-workshop/specs/site-v3/02-texts.md`, секция 2 — кроме метки: правка
 * владельца 2026-08-13, пункт 5, заменила «ЗНАКОМАЯ КАРТИНА» на «ЗНАКОМАЯ
 * БОЛЬ»; спека ещё несёт старую метку и разошлась с кодом.
 *
 * Раскрой — брифом `70-workshop/specs/site-v3/04-sections-brief.md`, раздел 1
 * (D-044: устройство раскладки берётся у denis-bond.ru, не палитра и не
 * текст). Полка-выноска варианта «Б2-А» (пункты, дотянутые до карточки
 * горизонтальной чертой) СНЯТА этим брифом целиком (раздел 1.3) — вместе с
 * ней ушли `li::after`, `justify-content: space-between` и `align-items:
 * stretch`, которые существовали только чтобы дотянуть список до высоты
 * карточки под полки. Вместо неё — ведомость из образца: каждый пункт несёт
 * номер в фиксированной колонке слева и волосяную линию `--border` под
 * собой (в том числе под последним пунктом — она закрывает ведомость), а
 * карточка-ответ стоит рядом самостоятельно, без графической связки, кроме
 * соседства и собственной акцентной грани слева. Развилка оформления,
 * которую D-037 оставлял открытой (Б2-А · Б2-Б · Б2-В), закрыта раскладкой
 * образца; если владелец захочет вернуть полку — правится только этот файл.
 *
 * Карточка называет ПРИНЦИП и заканчивается указателем вниз; числа,
 * названные обязательства («исходники», «доступы», «инструкция», «раунды
 * правок», «вехи») и шаги процесса ей запрещены — это доказывают секции 7
 * и 8, и здесь их задваивать нельзя (02-pain-options.md, раздел 4).
 *
 * Порядок пунктов не переставлять: первым самое узнаваемое, последним самое
 * дорогое по последствиям (02-texts.md, «Что здесь нельзя менять при
 * правке»). Пунктов ровно четыре — сторож ниже падает при другом числе.
 *
 * Метка и заголовок секции стоят в `Section.astro` (правка владельца
 * 2026-08-18, пункт 11: заголовок секции — снаружи панели `.surface`, не
 * внутри неё). Текст остаётся здесь единственным источником — константы
 * ниже читает `pages/index.astro`, второй копии текста не заводится.
 */
import Label from '../Label.astro';

/** Метка и заголовок секции — читает `pages/index.astro`, передаёт их в
 *  `Section` (пропы `label`/`heading`), которая рисует их снаружи `.panel`. */
export const PAIN_LABEL = 'ЗНАКОМАЯ БОЛЬ';
export const PAIN_HEADING = 'Как обычно бывает';

const PAIN_POINTS = [
  'Смета растёт по ходу, и узнаёте вы об этом к сдаче',
  'Пишете вы одному, отвечает другой',
  'Исполнитель пропадает, а доступов у вас нет',
  'Готовое некому подхватить — проще переписать заново',
];
if (PAIN_POINTS.length !== 4) {
  throw new Error('home/Pain.astro: секция 2 несёт ровно четыре пункта боли.');
}
---
<div class="pain-body">
  {/* Номер рисует ::before списка (`counter(pain, …)`) — не второй ручной
      счёт: `<ol>` уже озвучивает позицию пункта скринридеру, генерируемый
      CSS-текст в дерево доступности по умолчанию не входит, второй счёт был
      бы дублем (00-overview, раздел 4, «--text-muted», не «--text-faint» —
      номер несёт информацию). Текст пункта — в собственном `<span>`, а не
      прямо в `<li>`: только так `max-width` на нём (раздел 1.2 брифа) не
      цепляет и колонку номера тоже. */}
  <ol class="pain-list">
    {PAIN_POINTS.map((text) => (
      <li class="reveal"><span class="pain-text">{text}</span></li>
    ))}
  </ol>

  <div class="answer-card reveal">
    {/* Метка называет РОЛЬ карточки, а не повторяет её заголовок. */}
    <Label>РЕШЕНИЕ</Label>
    <h3 class="t-h3">Со мной иначе</h3>
    <p>
      Договорённость фиксируется до начала работы, а не по ходу. Всё
      сделанное остаётся у вас на руках — и после сдачи ничего не держится
      «на моей стороне».
    </p>
    <a class="answer-link" href="#process">
      {/* Стрелка вниз, а не вправо: ссылка ведёт к секциям, которые стоят
          НИЖЕ на этой же странице. */}
      <span aria-hidden="true">↓</span> Чем это подтверждается — процесс и гарантии ниже
    </a>
  </div>
</div>

<style>
  /* Отбивка заголовка до первого содержимого (32 px) — в `Section.astro`
     (`.section-heading`), не здесь. Здесь больше нет `<h2>`. */

  /* Список и карточка — одна колонка, list идёт первым, карточка снизу
     (`row-gap: 32px` между ними и есть отступ, отдельного `margin-top` на
     карточке не заводится). От 900 px (`@media` в конце файла) раскрой
     становится двухколоночным: список слева держит свою естественную
     высоту, карточка — своей колонкой справа, `align-self: start` — обе
     части не тянутся друг под друга. Единственная точка перелома этой
     секции — 900 px, та же, что у навигации и у линии на фоне (D-026,
     раздел 0.1 брифа). */
  .pain-body {
    display: grid;
    row-gap: 32px;
  }

  /* Грид пункта и волосяная линия под ним — общее правило на ВСЕ ширины
     (брифом раздел 1.5: на 390 те же `32px minmax(0,1fr)` и та же линия,
     только текст мельче и колонка ýже — см. `.pain-text` ниже). На
     телефоне это и есть весь ритм секции: полке там вести некуда, а линия
     под каждым пунктом делает то же самое, что раньше делала одна общая
     вертикаль слева. */
  .pain-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: pain;
  }
  .pain-list li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    column-gap: 16px;
    padding-block: 24px;
    border-bottom: 1px solid var(--border);
  }
  .pain-list li:first-child { padding-top: 0; }

  /* Номер `01…04` — моно, приглушённый, садится на базовую линию первой
     строки текста (`padding-top: 6px` при тексте 18/22px по 1.6–1.65 —
     подобрано и не совпадает случайно с шагом сетки). */
  .pain-list li::before {
    content: counter(pain, decimal-leading-zero);
    counter-increment: pain;
    align-self: start;
    padding-top: 6px;
    font: 500 0.6875rem/1 var(--font-mono);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Базовый (телефон/планшет) кегль — 18 px, та же ступень, что `.t-body`:
     в колонке 262 px (390 - поля панели 24×2 - маркер 32 - зазор 16) даёт
     три строки на самый длинный пункт, читаемо. От 900 px кегль растёт до
     22 px (`.t-body-lg`) и появляется мера `24em` — «полоса шире текста»,
     заимствованный приём брифа: колонка списка на столе — 664 px, текст
     останавливается на ≈528 px, разница читается воздухом справа. */
  .pain-text {
    display: block;
    font: 500 1.125rem/1.65 var(--font-text);
    color: var(--text);
  }

  .answer-card {
    background: var(--accent-soft);
    /* Левые углы ПРЯМЫЕ, правые скруглены — скругление по всем четырём
       углам откусывает у акцентной грани верх и низ, и она перестаёт
       читаться линией (проверено на отрисованной странице до этого
       брифа). Толщина 2 px — грань, а не волосяная линия: единственный
       графический след связки «боль → ответ», которая раньше держалась
       ещё и полкой. */
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: 24px;
  }
  .answer-card h3 { margin: 0 0 8px; }
  .answer-card p { margin: 0; color: var(--text-muted); }

  .answer-link {
    display: inline-block;
    margin-top: 16px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .answer-link:hover, .answer-link:focus-visible { text-decoration: underline; }

  /* Каскад — та же утилита, что у карточек услуг и гарантий (`styles/
     base.css`, `.reveal`): секции сами задают только `--reveal-i` через
     `:nth-child`. Четыре строки приходят по очереди, карточка-ответ —
     последней (пятая фаза): ответ приходит после того, как названа вся
     боль. */
  .pain-list > :nth-child(2) { --reveal-i: 1; }
  .pain-list > :nth-child(3) { --reveal-i: 2; }
  .pain-list > :nth-child(4) { --reveal-i: 3; }
  .answer-card { --reveal-i: 4; }

  @media (min-width: 900px) {
    .pain-body {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
      column-gap: 32px;
      align-items: start;
    }
    .answer-card { align-self: start; }
    .pain-text {
      font: 500 1.375rem/1.6 var(--font-text);
      max-width: 24em;
    }
  }
</style>
