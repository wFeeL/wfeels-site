---
/* Секция 2 — как обычно бывает. Текст утверждён дословно в
 * `70-workshop/specs/site-v3/02-texts.md`, секция 2 — кроме метки: правка
 * владельца 2026-08-13, пункт 5, заменила «ЗНАКОМАЯ КАРТИНА» на «ЗНАКОМАЯ
 * БОЛЬ»; спека ещё несёт старую метку и разошлась с кодом. Один список боли,
 * без второй колонки «а со мной иначе» — ответы дают секции 7 и 8, не эта.
 * Порядок пунктов не переставлять: первым самое узнаваемое, последним самое
 * дорогое по последствиям (02-texts.md, «Что здесь нельзя менять при правке»).
 */
import Prose from '../Prose.astro';
import Label from '../Label.astro';

const PAIN_POINTS = [
  {
    lead: 'Десятки откликов, и все одинаковые.',
    text:
      'Публикуете задачу — приходят десятки предложений. У всех «быстро, ' +
      'качественно, недорого», у всех портфолио из похожих лендингов. ' +
      'Выбирать не из чего: отличить того, кто сделает, от того, кто ' +
      'пропадёт, по такой анкете нельзя.',
  },
  {
    lead: 'Смета растёт по ходу.',
    text:
      'Договорились на одну сумму, к сдаче она другая. Каждая мелочь ' +
      'оказывается «не входит», и обсуждать это приходится тогда, когда ' +
      'отказаться уже дороже, чем доплатить.',
  },
  {
    lead: 'Пишет один, отвечает другой.',
    text:
      'Вопрос уходит менеджеру, менеджер — разработчику, ответ ' +
      'возвращается через два дня и не про то. Между вами и человеком, ' +
      'который делает вашу задачу, три пересадки.',
  },
  {
    lead: 'Исполнитель пропадает.',
    text:
      'Не отвечает неделю, потом «был занят». Или не отвечает совсем — и ' +
      'остаётся сайт с недоделанной формой и доступами, которых у вас нет.',
  },
  {
    lead: 'Готовое некому подхватить.',
    text:
      'Разработчик ушёл, а следующий говорит, что проще переписать заново. ' +
      'Кода никто не видел, документации нет, пароли в переписке. Вы ' +
      'платите второй раз за то же самое.',
  },
];
if (PAIN_POINTS.length !== 5) {
  throw new Error('home/Pain.astro: секция 2 несёт ровно пять пунктов боли.');
}
---
<Label>ЗНАКОМАЯ БОЛЬ</Label>
<h2 class="t-h2">Как обычно бывает</h2>
<Prose>
  <ol class="pain-list">
    {PAIN_POINTS.map((p) => (
      <li><strong>{p.lead}</strong> {p.text}</li>
    ))}
  </ol>
</Prose>

<style>
  .pain-list {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    counter-reset: pain;
  }
  .pain-list li {
    counter-increment: pain;
    position: relative;
    padding-left: 44px;
    margin-bottom: 20px;
  }
  .pain-list li::before {
    content: counter(pain, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.1em;
    /* Было 13 px — самовольный кегль, вне шкалы. Нумерация — та же роль, что
       у меток `label` (11 px), правка 2026-08-13, свод к семи объявленным
       ([[02-redesign-options]], предусловие пункта 8). Токен `--text-faint`
       здесь остаётся неверным долгом (00-overview, раздел 4, «Уточнение,
       добавлено 2026-08-13») — правка цвета вне мандата этого захода. */
    font: 500 0.75rem/1.65 var(--font-mono);
    color: var(--text-faint);
  }
  .pain-list strong { display: block; margin-bottom: 2px; }
</style>
