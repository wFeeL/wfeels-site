---
/* Секция 2 — как обычно бывает. Текст утверждён дословно в
 * `70-workshop/specs/site-v3/02-texts.md`, секция 2 — кроме метки: правка
 * владельца 2026-08-13, пункт 5, заменила «ЗНАКОМАЯ КАРТИНА» на «ЗНАКОМАЯ
 * БОЛЬ»; спека ещё несёт старую метку и разошлась с кодом.
 *
 * Запрет второй колонки «а со мной иначе» (был здесь раньше этой правки)
 * СНЯТ решением владельца 2026-08-13 (`70-workshop/specs/site-v3/
 * 02-pain-options.md`, раздел 1–2: выбран вариант «Б2-А Выноска» — четыре
 * короткие строки боли слева, карточка-ответ справа, полки-выноски сводят
 * их в одну вертикальную линию `--accent`, которая и есть левый край
 * карточки). На его месте — более узкое правило (та же спека, раздел 4):
 * карточка называет ПРИНЦИП и заканчивается указателем вниз; числа,
 * названные обязательства («исходники», «доступы», «инструкция», «раунды
 * правок», «вехи») и шаги процесса ей запрещены — это доказывают секции 7
 * и 8, и здесь их задваивать нельзя.
 *
 * Порядок пунктов не переставлять: первым самое узнаваемое, последним самое
 * дорогое по последствиям (02-texts.md, «Что здесь нельзя менять при
 * правке»). Пунктов теперь четыре, не пять — «Десятки откликов, и все
 * одинаковые» снята решением владельца 2026-08-13, абзацы-пояснения
 * убраны целиком: пункт — одна строка.
 */
import Label from '../Label.astro';

const PAIN_POINTS = [
  'Смета растёт по ходу, и узнаёте вы об этом к сдаче',
  'Пишете вы одному, отвечает другой',
  'Исполнитель пропадает, а доступов у вас нет',
  'Готовое некому подхватить — проще переписать заново',
];
if (PAIN_POINTS.length !== 4) {
  throw new Error('home/Pain.astro: секция 2 несёт ровно четыре пункта боли.');
}
---
<Label>ЗНАКОМАЯ БОЛЬ</Label>
<h2 class="t-h2">Как обычно бывает</h2>

<div class="pain-body">
  <ol class="pain-list">
    {PAIN_POINTS.map((text) => <li class="reveal">{text}</li>)}
  </ol>

  <div class="answer-card reveal">
    {/* Метка называет РОЛЬ карточки, а не повторяет её заголовок. В первой
        редакции здесь стояло «СО МНОЙ ИНАЧЕ» прямо над заголовком «Со мной
        иначе» — одни и те же три слова дважды подряд, капслоком и обычным
        начертанием. Метка в этой системе всегда отвечает на вопрос «что это
        за блок», а не «как он называется». */}
    <Label>РЕШЕНИЕ</Label>
    <h3 class="t-h3">Со мной иначе</h3>
    <p>
      Договорённость фиксируется до начала работы, а не по ходу. Всё
      сделанное остаётся у вас на руках — и после сдачи ничего не держится
      «на моей стороне».
    </p>
    <a class="answer-link" href="#process">
      {/* Стрелка вниз, а не вправо: ссылка ведёт к секциям, которые стоят
          НИЖЕ на этой же странице, и правая стрелка спорила бы со словом
          «ниже» в собственном тексте ссылки. */}
      <span aria-hidden="true">↓</span> Чем это подтверждается — процесс и гарантии ниже
    </a>
  </div>
</div>

<style>
  /* Отбивка заголовка до первого содержимого — 32 px, одна величина на все
     десять секций главной (правка владельца 2026-08-13, «Три акта»). */
  h2 { margin: 0 0 32px; }

  /* Мобильная раскладка по умолчанию (ниже 900 px, весь блок этого стиля до
     `@media` в конце файла): одна колонка, список несёт свою вертикальную
     линию `--accent` слева (полкам вести некуда — карточка стоит НИЖЕ, не
     справа), номер и полка не рисуются вовсе. Карточка садится на конец
     этой линии тем же `border-left`, продолжая её — тот же приём, что и на
     столе, только линия уже не справа, а слева. От 900 px (единственная
     точка перелома здесь — та же, что у навигации и у линии на фоне,
     D-026) всё меняется ОДНИМ блоком `@media` ниже: список ложится в две
     колонки грида с карточкой, линия списка гасится, у каждой строки
     появляются номер слева и полка справа, дотягивающая строку до границы
     второй колонки — там, где `border-left` карточки. */
  .pain-body {
    display: grid;
    row-gap: 32px;
  }

  .pain-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    border-left: 1px solid var(--accent);
    counter-reset: pain;
  }

  /* Номер и полка — псевдоэлементы самой строки, не отдельная разметка:
     `::before`/`::after` встают в ту же flex-строку, что и текст пункта
     (`li` — сам flex-контейнер), первым и последним элементом по порядку в
     DOM, без `order`. Оба объявлены ТОЛЬКО внутри `@media (min-width:
     900px)` ниже — без `content` там псевдоэлемент не генерирует бокс
     вовсе, отдельное `display: none` для скрытия на телефоне не нужно.
     Номер несёт информацию (00-overview, раздел 4, «--text-muted», не
     `--text-faint»), но `<ol>` уже озвучивает позицию пункта списку —
     второй счёт для незрячего читателя был бы дублем, а генерируемый CSS-
     текст в accessibility-дерево по умолчанию и так не входит. */
  .pain-list li {
    font-weight: 500;
    display: flex;
    flex-direction: column;
    gap: 4px;
    counter-increment: pain;
  }

  /* Карточка-ответ — плоскость `--accent-soft`, а не вторая карточка
     `--surface`: панель секции уже этого цвета (`index.astro`, GAP.pain),
     карточка `--surface` внутри неё либо растворилась бы, либо стала
     карточкой в карточке. `border-left` — та самая вертикальная линия
     `--accent`: на столе на неё садятся засечки полок, на телефоне её
     продолжает `border-left` списка выше — один приём на обеих ширинах. */
  .answer-card {
    background: var(--accent-soft);
    border-left: 1px solid var(--accent);
    border-radius: var(--radius-md);
    padding: 24px;
  }
  .answer-card h3 { margin: 0 0 8px; }
  .answer-card p { margin: 0; color: var(--text-muted); }

  .answer-link {
    display: inline-block;
    margin-top: 16px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .answer-link:hover, .answer-link:focus-visible { text-decoration: underline; }

  /* Каскад — тот же приём, что у карточек услуг и гарантий (`styles/
     base.css`, `.reveal`): секции сами задают только `--reveal-i` через
     `:nth-child`, сама карточка ничего не объявляет. Четыре строки приходят
     по очереди, карточка-ответ — последней (пятая фаза): ответ приходит
     после того, как названа вся боль. Общая утилита, не новая механика — ни
     `@keyframes`, ни риска со сторожем `animation:` + `animation-timeline`
     (`css-no-animation-shorthand-with-timeline.test.ts`). */
  .pain-list > :nth-child(2) { --reveal-i: 1; }
  .pain-list > :nth-child(3) { --reveal-i: 2; }
  .pain-list > :nth-child(4) { --reveal-i: 3; }
  .answer-card { --reveal-i: 4; }

  /* Единственная точка перелома этой секции — 900 px, один блок вместо
     нескольких: сборка не сливает повторные `@media` с одинаковым условием
     сама, а секция и так добавляет вес странице (раздел 8 спеки,
     `02-pain-options.md`) — плодить обёртку незачем.

     Полка (`li::after`) нарисована ОДНИМ элементом двумя гранями рамки
     вместо линии плюс отдельной засечки: нижняя грань — горизонтальный
     1 px (сама полка, «прижата к базовой линии»), правая — вертикальный
     1 px во всю высоту бокса (засечка 8 px вверх на конце полки, вплотную к
     `border-left` карточки — `column-gap: 0` у `.pain-body` не оставляет
     между ними зазора). `min-width` — нижняя граница длины полки: короче
     неё она не рисуется вовсе, чтобы на 900–1180 px не читаться обрывком
     (риск, названный в спеке явно). */
  @media (min-width: 900px) {
    .pain-body {
      grid-template-columns: 1fr minmax(240px, 320px);
      column-gap: 0;
      align-items: start;
    }
    .pain-list {
      border-left: none;
      padding-left: 0;
      gap: 24px;
    }
    .pain-list li {
      flex-direction: row;
      align-items: baseline;
      gap: 12px;
    }
    .pain-list li::before {
      content: counter(pain, decimal-leading-zero);
      flex: none;
      width: 32px;
      font: 500 0.6875rem/1.65 var(--font-mono);
      color: var(--text-muted);
    }
    .pain-list li::after {
      content: '';
      flex: 1 1 auto;
      min-width: 32px;
      align-self: flex-end;
      height: 8px;
      border-bottom: 1px solid var(--border);
      border-right: 1px solid var(--border);
    }
  }
</style>
