---
/* Секция 8 — что я гарантирую. Пять гарантий, текст утверждён дословно
 * (`70-workshop/specs/site-v3/02-texts.md`, секция 8) — кроме метки: правка
 * владельца 2026-08-13, пункт 5, заменила «ЧТО Я БЕРУ НА СЕБЯ» на
 * «ГАРАНТИИ»; спека ещё несёт старую метку и разошлась с кодом. Числа
 * оплаты — «50%» и «70 000 ₽» — читаются из `data/process.ts`, а не вписаны
 * в разметку: правка PRICING.md обязана менять текст этой секции сама, а не
 * расходиться с ним молча (план `02-home-plan.md`, задача 11). Гарантии
 * срока деньгами нет; договор не упоминается — его не существует (D-019).
 *
 * Пятая гарантия «Сколько это занимает» — перенос из снятой секции 6
 * (D-030, `02-case-illustrations.md`); её второй абзац рисуется отдельным
 * `<p>`, а не склеивается с первым в одну строку — это два предложения
 * разного веса (утверждение и его пояснение), как было в исходной секции 6.
 */
import Label from '../Label.astro';
import Card from '../Card.astro';
import { GUARANTEES } from '../../data/process';

if (GUARANTEES.length !== 5) {
  throw new Error('home/Guarantees.astro: секция 8 несёт ровно пять гарантий.');
}
---
<Label>ГАРАНТИИ</Label>
<h2 class="t-h2">Что я гарантирую</h2>

<div class="grid">
  {GUARANTEES.map((g) => (
    <Card>
      <h3 class="t-h3">{g.title}</h3>
      <p>{g.text}</p>
      {g.note && <p class="note">{g.note}</p>}
    </Card>
  ))}
</div>

<style>
  .grid {
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 700px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* Каскад — та же диагональ, что и у услуг в начале страницы (02-card-
     motion.md, раздел 5, «Чем это красиво»): секция, закрывающая страх
     «пропадёт», движется так же, как секция, с которой всё началось.
     Правило одно на обе секции — `.grid > :nth-child(2n)` в `styles/
     base.css`, не копия здесь: класс `.grid` уникален для этих двух
     секций, второе правило платило бы весом за то же самое значение. */
  .grid h3 { margin: 0 0 8px; }
  .grid p { margin: 0; color: var(--text-muted); }
  .grid .note { margin-top: 8px; }
</style>
