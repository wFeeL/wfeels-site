---
/* Секция 8 — что я гарантирую. Четыре гарантии; формулировки о договоре,
 * ТЗ и приемке синхронизированы с юридическим комплектом 2026-08-25 — он
 * переехал 2026-08-26 в базу знаний, `20-sales/legal/` (D-110, D-113). Метку правка
 * владельца 2026-08-13, пункт 5, заменила «ЧТО Я БЕРУ НА СЕБЯ» на
 * «ГАРАНТИИ»; спека еще несёт старую метку и разошлась с кодом. Гарантии срока
 * деньгами по-прежнему нет: договор фиксирует срок и порядок его изменения, а не
 * автоматическую неустойку.
 *
 * Раскрой брифом `70-workshop/specs/site-v3/04-sections-brief.md`, раздел 3
 * (D-044): у образца гарантии — не карточки. Пять карточек `--surface` в
 * сетке 2×3 сняты целиком (та самая форма «герой и три одинаковых
 * карточки», к которой сводится половина сайтов, и пятая карточка с
 * дополнительным абзацем в ней ломала ряд). Заголовок секции занимает левую
 * колонку, список с галочками — правую; между пунктами нет линеек, только
 * воздух — иначе секция стала бы третьей ведомостью подряд («Как обычно
 * бывает» — линейка под пунктом, «Как я работаю» — линейка над рядом) и три
 * соседние секции слились бы в одну форму.
 *
 * У этой секции сознательно нет панели `--surface` (пункт 11 называет ровно
 * три секции с внешним заголовком — `pain`, `process`, `faq`; в `pages/
 * index.astro` `GAP.guarantees` панель и не запрашивает): соседняя `#process`
 * уже панель, а правило «три подложки, не подряд» запрещает две встык.
 * Заголовок поэтому остаётся ЧАСТЬЮ раскроя, рисуется здесь же, как у
 * образца, а не уходит наружу вслед за тремя панельными секциями.
 *
 * Пятой гарантией «Сколько это занимает» здесь до 2026-08-20 стоял перенос
 * из снятой секции 6 (D-030). Владелец снял её правкой 2026-08-20, и вместе
 * с ней ушла разметка второго абзаца (`g.note` и правило `.note`): второй
 * абзац был только у неё, а разметка без данных — мёртвый код.
 */
import Label from '../Label.astro';
import { guarantees } from '../../data/process';
import { dict, localeFromPath } from '../../i18n/locales';

const locale = localeFromPath(Astro.url.pathname);
const t = dict(locale);
const GUARANTEES = guarantees(locale);

if (GUARANTEES.length !== 4) {
  throw new Error('home/Guarantees.astro: секция 8 несёт ровно четыре гарантии.');
}
---
<div class="layout">
  <div class="heading">
    <Label>{t.guaranteesLabel}</Label>
    <h2 class="t-h2">{t.guaranteesHeading}</h2>
  </div>

  <ul class="list">
    {GUARANTEES.map((g) => (
      <li class="reveal">
        {/* Галочка нарисована рамкой — ни SVG, ни шрифтового глифа: ноль
            байт ассетов, ноль зависимости от начертания шрифта. */}
        <span class="check" aria-hidden="true"></span>
        <div>
          <h3 class="title">{g.title}</h3>
          <p>{g.text}</p>
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Отбивка заголовка секции сама (нет панели, нет `Section.astro`) — та же
     32 px, что и у остальных секций главной, но здесь она между заголовком
     и списком, а не между заголовком и панелью. */
  .layout {
    display: grid;
    row-gap: 32px;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    column-gap: 16px;
  }
  /* Шаг 32 px между гарантиями — ряд «ростом» в собственный текст и
     крупный вертикальный воздух вместо линейки (раздел 0.1 брифа: строка
     1–2 строки текста и большой вертикальный шаг). */
  .list li + li { margin-top: 32px; }

  /* Знак-галочка — квадрат 24×24 на мягкой акцентной подложке (форма
     заимствована у образца, краска — наш единственный акцент). Сама
     галочка — угол рамки, повёрнутый на 45°. */
  .check {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    display: grid;
    place-items: center;
  }
  .check::before {
    content: '';
    width: 5px;
    height: 10px;
    border-right: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    rotate: 45deg;
    margin-top: -2px;
  }

  /* Заголовок гарантии — элемент `<h3>` остаётся ради семантики оглавления,
     но набор — `.t-body-lg` текстовым шрифтом, не `.t-h3` в Unbounded
     (раздел 0.2 брифа, «ловушка вёрстки»): общий селектор `h1,h2,h3,.t-h3`
     из `base.css` вешает заголовочный шрифт и трекинг на ЭЛЕМЕНТ `h3`, а не
     только на класс, поэтому все три свойства объявлены здесь явно —
     одного класса `.t-body-lg` для их отмены недостаточно. */
  .title {
    font-family: var(--font-text);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.6;
    letter-spacing: normal;
    color: var(--text);
    margin: 0 0 8px;
  }
  .list p {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 34em; /* ≈612px на 18px тексте */
  }

  @media (min-width: 900px) {
    .layout {
      /* Нижняя граница колонки заголовка выведена из СОДЕРЖИМОГО, а не
         назначена числом. Прежние 280…340 px были подобраны на глаз, и слово
         «гарантирую» в Unbounded 48 px рендерится в 379 px — глобальный
         `overflow-wrap: break-word` рубил его посередине: «гарантиру/ю».
         Дефект жил на всех ширинах от ~1067 px, то есть на всём десктопе, и
         именно он породил жалобу владельца «текст не помещается рядом с
         заголовком» — не помещался сам заголовок.

         `min-content` для колонки грида — это ширина самого длинного слова.
         Верхняя граница оставлена прежней: колонка не должна съедать
         содержимое, если заголовок вдруг окажется длинным. */
      grid-template-columns: minmax(min-content, 340px) minmax(0, 1fr);
      column-gap: 48px;
      row-gap: 0;
      align-items: start;
    }
  }
</style>
