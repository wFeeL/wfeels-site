---
/* Секция 10 — частые вопросы. Текст утверждён дословно
 * (`70-workshop/specs/site-v3/02-texts.md`, секция 10), читается из
 * `data/faq.ts`. Разметка — нативные `<details>/<summary>`: раскрывается без
 * единого байта JavaScript, и текст всех ответов присутствует в
 * `dist/index.html` независимо от состояния (план, «Статика прежде всего»).
 *
 * Раскрой брифом `70-workshop/specs/site-v3/04-sections-brief.md`, раздел 5
 * (пункт 16, D-044). У образца заголовок стоит в левой колонке, список
 * вопросов — в узкой правой: приём работает именно здесь, вопрос — одна
 * строка, и на полной ширине панели знак «+» уехал бы от текста почти на
 * метр. Метка и заголовок формально остаются СНАРУЖИ панели (требование
 * пункта 11 выполнено — DOM-дерево то же самое, что рисует `Section.astro`
 * для `pain`/`process`), но раскладка от 900 px кладёт их РЯДОМ с панелью, а
 * не НАД ней — единственный такой случай на странице, оплаченный функцией
 * (короткая строка вопроса против гигантского зазора «+»). Это делает CSS
 * этого файла через `:global(#faq)`, нацеленный на разметку, которую уже
 * рисует `Section.astro` (`.t-label`, `.section-heading`, `.panel`) — саму
 * эту разметку и её пропы (`GAP.faq` в `pages/index.astro`) трогать не
 * пришлось: секция получает те же `surface`/`label`/`heading`, что и до
 * этого брифа, меняется только раскладка их общего родителя.
 *
 * Метка и заголовок секции — константы ниже, единственный источник текста;
 * читает их `pages/index.astro`.
 */
import { faqItems } from '../../data/faq';
import { localeFromPath } from '../../i18n/locales';

const locale = localeFromPath(Astro.url.pathname);
const FAQ_ITEMS = faqItems(locale);

if (FAQ_ITEMS.length !== 5) {
  throw new Error('home/Faq.astro: секция 10 несёт ровно пять вопросов.');
}

/** Метка и заголовок секции — передаются в `Section` (пропы
 *  `label`/`heading`), которая рисует их снаружи `.panel`. */
/* Метка и заголовок секции — в словаре (`i18n/ru.ts`, `i18n/en.ts`); рисует
   их снаружи `Section.astro` по пропам из `home/HomePage.astro`. Прежние
   константы `FAQ_LABEL` / `FAQ_HEADING` отсюда сняты вместе с переводом
   секции. */

/** Разбирает `**слово**` на текстовые и полужирные куски — единственное
 *  место, где спека кладёт разметку внутрь текста данных (`data/faq.ts`).
 *  Даёт массив, а не HTML-строку: `set:html` на пользовательский текст открыл
 *  бы инъекцию, а здесь она и не нужна — Astro безопасно рендерит массив
 *  фрагментов текст/`<strong>`. */
function parts(text: string): Array<{ bold: boolean; value: string }> {
  return text.split(/\*\*(.+?)\*\*/g).map((value, i) => ({ bold: i % 2 === 1, value }));
}

---
<div class="list">
  {FAQ_ITEMS.map((item) => (
    <details class="item">
      <summary>
        <span class="question">{item.question}</span>
        <span class="chevron" aria-hidden="true"></span>
      </summary>
      <div class="answer">
        <p>
          {parts(item.answer).map((p) => (p.bold ? <strong>{p.value}</strong> : p.value))}
        </p>
      </div>
    </details>
  ))}
</div>

<style>
  /* Раскладка «заголовок слева — панель справа» от 900 px — нацелена на
     разметку `Section.astro` через `:global()`, не переопределяет её:
     `#faq` уже несёт `.t-label`, `.section-heading` и `.panel` как прямых
     детей секции (в этом порядке в DOM), эта секция лишь раскладывает их по
     двум колонкам грида вместо вертикального потока. Ниже 900 px секция не
     тронута этим правилом вовсе — обычный поток `Section.astro` (метка,
     заголовок, отбивка 32, панель). */
  @media (min-width: 900px) {
    :global(#faq) {
      display: grid;
      /* Нижняя граница колонки заголовка — из содержимого, а не число:
         слово «спрашивают» в Unbounded 48 px шире прежних 280 px, и заголовок
         рвался посередине («спрашива/ют»). Та же правка, что в секции
         гарантий, и по той же причине. */
      grid-template-columns: minmax(min-content, 360px) minmax(0, 1fr);
      /* Строки задаются ЯВНО, и это не украшение. Панель занимает обе строки
         (`grid-row: 1 / span 2` ниже), она заметно выше метки с заголовком, и
         при неявных строках браузер раздаёт её избыток высоты между двумя
         строками ПОРОВНУ. Метка остаётся приклеенной к верху раздутой первой
         строки, а заголовок уезжает в середину секции: замер 2026-08-20 на
         1440 px дал разрыв 183 px между низом метки и верхом заголовка —
         метка читалась как повисшая отдельно от всего. `auto 1fr` отдаёт
         весь избыток ВТОРОЙ строке, и заголовок при `align-items: start`
         встаёт вплотную под меткой, как во всех остальных секциях. */
      grid-template-rows: auto 1fr;
      column-gap: 48px;
      align-items: start;
      padding-right: var(--ink-lane);
    }
    :global(#faq > .t-label) { grid-column: 1; grid-row: 1; }
    :global(#faq > .section-heading) { grid-column: 1; grid-row: 2; margin: 0; }
    :global(#faq > .panel) { grid-column: 2; grid-row: 1 / span 2; }
  }

  /* Черты НАД первым вопросом нет — правка владельца 2026-08-20 по снимку
     («над „Мне хватит конструктора вроде Tilda?“ стоит линейка, снять»). Она
     была парой к снятой ниже черте под последним пунктом и закрывала список
     сверху, а закрывать его нечем и незачем: у панели уже есть собственный
     обвод, и две линии в 32 px друг от друга читались как одна двойная —
     тот же дефект, что дизайн-ревью 2026-08-18 нашло у нижнего края (см.
     `.item:last-child` ниже). Разделители МЕЖДУ вопросами остаются: они
     разделяют, а не закрывают.

     Отбивки взамен не заводится: первый вопрос и без черты стоит в 52 px от
     верха панели на столе (32 px её собственного поля плюс 20 px
     `padding-block` самого `summary`) и в 44 px на телефоне (24 + 20) — к
     краю он не прилипает ни на одной ширине, второе число здесь было бы
     лишним. */
  .list {
    margin: 0;
  }
  /* Находка 3 дизайн-ревью: до правки владельца 2026-08-18 (пункт 11,
     заголовок секции вынесен из `.panel`) низ панели совпадал с низом
     секции, и `border-bottom` последнего пункта отделяли от края панели
     полные 96px нижнего поля секции — черта читалась одна. Теперь у `.panel`
     собственное поле по всему периметру (`Section.astro`, 24/32px), и на
     1440px между `border-bottom` последнего `.item` и обводом самой `.panel`
     остаётся только это поле (32px) — недостаточно, чтобы прочесть две черты
     как разное, они читаются как одна двойная линия (измерено: зазор 33px,
     `getBoundingClientRect()` на 1440px). У последнего пункта черта снимается
     — обвод панели уже закрывает эту роль, второй чертой снизу список не
     заканчивается нигде, кроме самого последнего элемента. */
  .item { border-bottom: 1px solid var(--border); }
  .item:last-child { border-bottom: none; }

  /* Ф-9.7: открытый пункт отмечен внутренней акцентной линейкой. */
  .item {
    box-shadow: inset 2px 0 0 0 transparent;
    transition: box-shadow var(--dur-micro) var(--ease),
                padding-left var(--dur-micro) var(--ease);
  }
  .item[open] {
    box-shadow: inset 2px 0 0 0 var(--accent);
    padding-left: 16px;
  }
  .item[open] .question { font-weight: 600; }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
    cursor: pointer;
    list-style: none;
    /* Цель нажатия на всю ширину строки, а не только на слова заголовка. */
    min-height: 44px;
  }
  summary::-webkit-details-marker { display: none; }

  /* Мобильная база — 18 px (`.t-body`); от 900 px растёт до 22 px
     (`.t-body-lg`, раздел 5.1 брифа) — тот же приём, что и у остальных
     секций (раздел 0.2). */
  .question {
    font-weight: 500;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--text);
  }
  @media (prefers-reduced-motion: no-preference) {
    .question { transition: color var(--dur-micro) var(--ease); }
  }
  @media (min-width: 900px) {
    .question { font-size: 1.375rem; line-height: 1.6; }
  }
  /* Находка дизайн-ревью 2026-08-22 (находка 3): `<summary>` — кликабельный
     заголовок без единого отклика на наведение (замер: цвет, фон и знак
     «+» одинаковы до и после). Отклик — тем же словарём, что и у ссылок
     рядом (`.links a:hover` в `ServiceCard.astro`): текст и знак красятся
     акцентом, никакой новой заливки или тени карточка не получает.
     `:focus-visible` тем же селектором — с клавиатуры вопрос не имеет права
     выглядеть беднее, чем под курсором (тот же принцип, что и в
     `NavLinks.astro`). */
  summary:hover .question,
  summary:focus-visible .question {
    color: var(--accent);
  }
  summary:hover .chevron::before,
  summary:hover .chevron::after,
  summary:focus-visible .chevron::before,
  summary:focus-visible .chevron::after {
    background: var(--accent);
  }

  /* Плюс/минус вместо треугольника: два штриха рисуют сам знак, а не
     псевдоэлемент с текстом символа — устойчивее к шрифтам без глифа «−». */
  .chevron {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }
  .chevron::before, .chevron::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--text-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .chevron::before, .chevron::after {
      transition: transform var(--dur-micro) var(--ease),
                  background var(--dur-micro) var(--ease);
    }
  }
  .chevron::before { width: 12px; height: 2px; }
  .chevron::after { width: 2px; height: 12px; }
  details[open] .chevron::after { transform: scaleY(0); }

  .answer p {
    margin: 0 0 20px;
    max-width: 50ch;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .answer strong { color: var(--text); }

  /* Плавное раскрытие — раздел 5.2 брифа. Базовое (оно же конечное, оно же
     запасной путь) состояние: раскрытие мгновенное, как у нативного
     `<details>`, — ничего не объявлено, значит нечего ронять. Улучшение
     целиком внутри двойного условия ниже: `interpolate-size` на панели, не
     на `:root` (то свойство наследуется — на `:root` оно изменило бы
     поведение любых чужих `height: auto`-переходов на всей странице). */
  @supports (interpolate-size: allow-keywords) and (selector(::details-content)) {
    @media (prefers-reduced-motion: no-preference) {
      .list {
        interpolate-size: allow-keywords;
      }
      /* `overflow: hidden` здесь допустим — он стоит на `::details-content`,
         не на предке секции: ViewTimeline в этой секции нет, а фокусное
         кольцо `<summary>` лежит вне `::details-content` и обрезано быть не
         может. На саму панель и на любого её предка `overflow: hidden` не
         вешать — только `overflow: clip`, если обрезка когда-нибудь
         понадобится. */
      .list details::details-content {
        block-size: 0;
        overflow: hidden;
        /* Раздельные свойства transition — не шорткод, но и в шорткоде
           `animation:`+`animation-timeline` здесь риска нет: в этой секции
           нет ни одного `animation-timeline`, сторож
           `css-no-animation-shorthand-with-timeline.test.ts` эту секцию не
           задевает вовсе. `content-visibility` переходит дискретно
           (`allow-discrete`) — иначе текст исчезал бы мгновенно в конце
           закрытия и «моргал». */
        transition:
          block-size var(--dur-reveal) var(--ease),
          content-visibility var(--dur-reveal) allow-discrete;
      }
      .list details[open]::details-content {
        block-size: auto;
      }
    }
  }

  /* `transition` у `.chevron::before/::after` и у `.question` объявлен только
     внутри `@media (prefers-reduced-motion: no-preference)` выше (находка
     дизайн-ревью 2026-08-22, находка 3) — при `reduce` его нет вовсе, гасить
     отдельным правилом уже нечего. */
</style>
