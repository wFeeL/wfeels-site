---
/* Секция 10 — частые вопросы. Текст утверждён дословно
 * (`70-workshop/specs/site-v3/02-texts.md`, секция 10), читается из
 * `data/faq.ts`. Разметка — нативные `<details>/<summary>`: раскрывается без
 * единого байта JavaScript, и текст всех ответов присутствует в
 * `dist/index.html` независимо от состояния (план, «Статика прежде всего»).
 *
 * Разметка `FAQPage` в `ld+json` строится из того же массива
 * (`lib/schema.ts` → `faqPageSchema`), ровно один раз на странице: второй
 * `FAQPage` здесь не появится, даже если секцию скопируют — компонент один.
 *
 * Метка и заголовок секции ушли отсюда в `Section.astro` (правка владельца
 * 2026-08-18, пункт 11: заголовок секции — снаружи панели `.surface`, не
 * внутри неё). Константы ниже — единственный источник текста, читает их
 * `pages/index.astro`.
 */
import { FAQ_ITEMS } from '../../data/faq';
import { faqPageSchema, serializeSchema } from '../../lib/schema';

if (FAQ_ITEMS.length !== 5) {
  throw new Error('home/Faq.astro: секция 10 несёт ровно пять вопросов.');
}

/** Метка и заголовок секции — передаются в `Section` (пропы
 *  `label`/`heading`), которая рисует их снаружи `.panel`. */
export const FAQ_LABEL = 'ЧАСТЫЕ ВОПРОСЫ';
export const FAQ_HEADING = 'Что обычно спрашивают';

/** Разбирает `**слово**` на текстовые и полужирные куски — единственное
 *  место, где спека кладёт разметку внутрь текста данных (`data/faq.ts`).
 *  Даёт массив, а не HTML-строку: `set:html` на пользовательский текст открыл
 *  бы инъекцию, а здесь она и не нужна — Astro безопасно рендерит массив
 *  фрагментов текст/`<strong>`. */
function parts(text: string): Array<{ bold: boolean; value: string }> {
  return text.split(/\*\*(.+?)\*\*/g).map((value, i) => ({ bold: i % 2 === 1, value }));
}

const structured = serializeSchema(faqPageSchema(FAQ_ITEMS));
---
<div class="list">
  {FAQ_ITEMS.map((item) => (
    <details class="item">
      <summary>
        <span class="question">{item.question}</span>
        <span class="chevron" aria-hidden="true"></span>
      </summary>
      <div class="answer">
        <p>
          {parts(item.answer).map((p) => (p.bold ? <strong>{p.value}</strong> : p.value))}
        </p>
      </div>
    </details>
  ))}
</div>

<script type="application/ld+json" is:inline set:html={structured} />

<style>
  /* Раньше `.list` несла собственную отбивку от заголовка (`margin: 32px 0 0`)
     — заголовок и список делили одну подложку. Теперь заголовок стоит
     снаружи `.panel` (правка владельца 2026-08-18, пункт 11) и отбивается от
     неё своим собственным полем (`Section.astro`, `.section-heading`), а
     `.panel` несёт единое поле по всему периметру — второе поле здесь
     оказалось бы третьим случайным числом, складывающимся с полем панели. */
  .list {
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .item { border-bottom: 1px solid var(--border); }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
    cursor: pointer;
    list-style: none;
    /* Цель нажатия на всю ширину строки, а не только на слова заголовка. */
    min-height: 44px;
  }
  summary::-webkit-details-marker { display: none; }

  .question { font-weight: 700; }

  /* Плюс/минус вместо треугольника: тот же приём, что и раскрывашка меню
     шапки, но здесь два штриха рисуют сам знак, а не псевдоэлемент с текстом
     символа — устойчивее к шрифтам без глифа «−». */
  .chevron {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }
  .chevron::before, .chevron::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--text-muted);
    transition: transform var(--dur-micro) var(--ease);
  }
  .chevron::before { width: 12px; height: 2px; }
  .chevron::after { width: 2px; height: 12px; }
  details[open] .chevron::after { transform: scaleY(0); }

  /* 50ch — та же узкая колонка прозы, что и `Prose.astro` (часть 3 задания
     «Контейнер обратно к 1180», замер ревью 2026-08-13): 68ch на 18px тексте
     давал ≈60 высот прописной в строке, вдвое больше цели 42–45. */
  .answer p {
    margin: 0 0 20px;
    max-width: 50ch;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .answer strong { color: var(--text); }

  @media (prefers-reduced-motion: reduce) {
    .chevron::before, .chevron::after { transition: none; }
  }
</style>
