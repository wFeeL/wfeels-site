---
/* Один разворот страницы кейса — `70-workshop/specs/site-v3/
 * 12-case-pages-brief.md`, раздел 2 (правило разворота) и раздел 3
 * (раскладка по трём ширинам). Содержимое приходит из `data/case-spreads.ts`
 * — ни один путь к кадру и ни одна подпись не написаны здесь строкой.
 *
 * `[data-spread-frame]` — якорь сторожа заполнения панели
 * (`tests/e2e/case-spread-fill.spec.ts`, раздел 10.1 брифа): атрибут, а не
 * класс, потому что имя класса у Astro хешируется (`50-code/CLAUDE.md`,
 * ловушка 9 — общее имя ловит чужое глобальное правило).
 *
 * Схема (`CaseFlowIllustration.astro`) ставится СЮДА В ОДНОЙ КОПИИ — брифом
 * запрещены две копии разметки под разные ширины (раздел 2, П-3): компонент
 * сам решает раскрой А/Б через `@media` внутри одного `<svg>`-дерева,
 * поэтому здесь достаточно вызвать его один раз.
 */
import CaseFlowIllustration from '../home/CaseFlowIllustration.astro';
import type { CaseSpread as CaseSpreadData } from '../../data/case-spreads';

interface Props {
  spread: CaseSpreadData;
  /** Порядковый номер (с нуля) — определяет чередование сторон
   *  (`index % 2 === 1` даёт зеркало, раздел 3.1: «первый разворот всегда
   *  кадром слева», формула та же, что уже несёт `CaseRow.astro`). */
  index: number;
}
const { spread, index } = Astro.props;
const mirror = index % 2 === 1;
const isTrio = spread.kind === 'photo-trio';
const images = spread.images ?? [];
---
<div class="spread" data-case-spread class:list={{ mirror }}>
  <div class="frame" data-spread-frame>
    {spread.kind === 'schema' ? (
      <CaseFlowIllustration single="b" />
    ) : (
      <div
        class="shots"
        class:list={{ trio: isTrio }}
        role={isTrio ? 'group' : undefined}
        aria-label={isTrio ? spread.heading : undefined}
        tabindex={isTrio ? 0 : undefined}
      >
        {images.map((img, i) => (
          <img
            class:list={{ big: isTrio && i === 0 }}
            src={img.src}
            alt={img.alt}
            width="1586"
            height="992"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    )}
  </div>
  <div class="caption">
    <p class="spread-label">{spread.label}</p>
    <h3 class="t-h3">{spread.heading}</h3>
    <p class="spread-body t-body">{spread.body}</p>
  </div>
</div>

<style>
  .spread {
    display: grid;
    grid-template-columns: 62% 1fr;
    gap: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .spread + .spread { margin-top: 96px; }
  .spread.mirror { grid-template-columns: 1fr 62%; }
  .spread.mirror .frame { order: 2; }
  .spread.mirror .caption { order: 1; }

  /* Поле НИКОГДА не несёт фиксированную высоту (сторож 10.1.3, П-3): высота
     панели = высота содержимого. Ни `height`, ни `min-height` здесь нет. */
  .frame { min-width: 0; }
  .caption { min-width: 0; align-self: start; max-width: 36em; }

  .spread-label {
    margin: 0 0 12px;
    color: var(--accent);
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .caption h3 { margin: 0 0 12px; }
  .spread-body { margin: 0; color: var(--text-muted); }

  /* У снимка нет внутреннего отступа (раздел 2, П-3): кадр — это и есть
     панель, изображение на 100% ширины, паспарту не заводится. */
  .frame img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .shots.trio {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "big big" "s1 s2";
    gap: 24px;
  }
  .shots.trio img:nth-of-type(1) { grid-area: big; }
  .shots.trio img:nth-of-type(2) { grid-area: s1; }
  .shots.trio img:nth-of-type(3) { grid-area: s2; }

  @media (max-width: 899px) {
    .spread, .spread.mirror { grid-template-columns: 1fr; }
    .spread.mirror .frame, .spread.mirror .caption { order: initial; }
    .spread + .spread { margin-top: 64px; }
    .caption { max-width: none; }
  }

  @media (max-width: 599px) {
    .spread + .spread { margin-top: 48px; }
    /* Раздел 3.3: многокадровый разворот на ≤599px становится горизонтальной
       полосой с привязкой — следующий кадр выглядывает краем, прокрутка
       видна без подсказки. `role="group"`/`aria-label`/`tabindex` — выше,
       в разметке (не зависят от ширины экрана, ставятся всегда для трио). */
    .shots.trio {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
    }
    .shots.trio img {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }
  }

  /* Появление разворота при прокрутке — раздел 9 брифа: opacity 0 → 1,
     translateY(12px) → 0, 320 мс, один раз (не каждый раз при пересечении
     границы).
     Было — `animation-timeline: view()`: измерено на этом же файле, что
     решение НЕ подходит для «одного раза» — это ПРИВЯЗКА к позиции
     прокрутки, а не разовый триггер: при возврате прокрутки вверх мимо
     диапазона `entry`/`cover` анимация СЪЕЗЖАЕТ назад к 0%, и уже показанный
     разворот гаснет заново (замер: все четыре `.spread` держали
     `opacity: 0` в застывшем виде после прокрутки вниз и обратно вверх —
     `getComputedStyle` подтвердил `animation-timeline: view(); playState:
     running`, а не «однократно сыграно»). Раздел 9 требует «один раз», и
     держится это только явным одноразовым триггером — `IntersectionObserver`
     с `unobserve` после первого пересечения, тот же приём, что уже несёт
     затвор `CaseFlowIllustration.astro`. Запасное состояние — видимое: без
     JavaScript и без поддержки набора`IntersectionObserver`разворот просто
     стоит открытым (`<noscript>` ниже и ветка `else` в скрипте). */
  .spread { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    [data-case-spread] {
      opacity: 0;
      transform: translateY(12px);
      transition: opacity var(--dur-reveal) var(--ease), transform var(--dur-reveal) var(--ease);
    }
    [data-case-spread].is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<noscript>
  <style>[data-case-spread] { opacity: 1 !important; transform: none !important; }</style>
</noscript>

{/* Один скрипт на все развороты страницы: Astro дедуплицирует одинаковый
    неинлайновый `<script>` при повторном использовании компонента, поэтому
    четыре вызова `CaseSpread` дают один блок в собранном JS, а не четыре
    независимых наблюдателя. Обычный (не `is:inline`) `<script>` здесь
    безопасен — компонент рендерится в дереве страницы напрямую, а не через
    слот `CaseIllustrationField` (ловушка 1, `50-code/CLAUDE.md`: там
    поднимаемый `<script>` до сборки не доезжает; здесь этого пути нет). */}
<script>
  (function () {
    if (window.__caseSpreadRevealInit) return;
    window.__caseSpreadRevealInit = true;

    var els = document.querySelectorAll('[data-case-spread]');
    if (!('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>
