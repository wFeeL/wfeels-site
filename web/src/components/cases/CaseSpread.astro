---
/* Один разворот страницы кейса — `70-workshop/specs/site-v3/
 * 12-case-pages-brief.md`, раздел 2 (правило разворота) и раздел 3
 * (раскладка по трём ширинам). Содержимое приходит из `data/case-spreads.ts`
 * — ни один путь к кадру и ни одна подпись не написаны здесь строкой.
 *
 * `[data-spread-frame]` — якорь сторожа заполнения панели
 * (`tests/e2e/case-spread-fill.spec.ts`, раздел 10.1 брифа): атрибут, а не
 * класс, потому что имя класса у Astro хешируется (`50-code/CLAUDE.md`,
 * ловушка 9 — общее имя ловит чужое глобальное правило).
 *
 * Схема (`CaseFlowIllustration.astro`) ставится СЮДА В ОДНОЙ КОПИИ — брифом
 * запрещены две копии разметки под разные ширины (раздел 2, П-3): компонент
 * сам решает раскрой А/Б через `@media` внутри одного `<svg>`-дерева,
 * поэтому здесь достаточно вызвать его один раз.
 *
 * `kind: 'weight'` (кейс `site-v3`, раздел 4.5 брифа) ставит сюда вторую и
 * последнюю законную схему брифа — `CaseWeightIllustration.astro`, проп
 * `host="case-site-v3"` (решение D-122): без него компонент печатал бы числа
 * ГЛАВНОЙ страницы под заголовком, который называет страницу кейса. Прежний
 * контейнер этого рисунка — `CaseIllustrationField` с фиксированной высотой
 * 384px — обрезал заполнение до 52% (раздел 10.1.5 брифа, находка, не
 * изъян сторожа); здесь высота панели по содержимому (П-3), и рисунок
 * получает то же обязательное `is:inline` у своего счётчика (ловушка 1,
 * `50-code/CLAUDE.md`) — CaseSpread рендерится в дереве страницы напрямую,
 * не через тот слот, где обычный `<script>` терялся.
 *
 * `kind: 'checklist'` (тот же кейс, второй разворот «Проверка на месте») —
 * не кадр и не схема: три строки-проверки со ссылками на маршруты, которые
 * их подтверждают (раздел 4.5 брифа).
 */
import CaseFlowIllustration from '../home/CaseFlowIllustration.astro';
import CaseWeightIllustration from '../home/CaseWeightIllustration.astro';
import type { CaseSpread as CaseSpreadData } from '../../data/case-spreads';

interface Props {
  spread: CaseSpreadData;
  /** Порядковый номер (с нуля) — определяет чередование сторон
   *  (`index % 2 === 1` даёт зеркало, раздел 3.1: «первый разворот всегда
   *  кадром слева», формула та же, что уже несёт `CaseRow.astro`). */
  index: number;
}
const { spread, index } = Astro.props;
const mirror = index % 2 === 1;
/* `isTrio` покрывает ОБА многокадровых раскроя (`photo-trio` — крупный +
 * два подкадра, `photo-row-3` — три равных кадра в ряд, раздел 4.1 брифа):
 * оба несут одну и ту же трио-ленту на ≤ 599 px (раздел 3.3), и класс
 * `.trio` — тот самый маркер, по которому сторож 10.1.3 опознаёт исключение
 * («вычисленный `display` равен `flex`»), общий для обоих раскроев. Раскрой
 * (2×2-грид vs 3-в-ряд) на ≥ 600 px различает отдельный модификатор
 * `.row3`. */
const isTrio = spread.kind === 'photo-trio' || spread.kind === 'photo-row-3';
const isRow3 = spread.kind === 'photo-row-3';
const images = spread.images ?? [];
const checks = spread.checks ?? [];
const frameWidth = String(spread.frameWidth ?? 1586);
const frameHeight = String(spread.frameHeight ?? 992);
/* Раздел 3.5 брифа: одиночный портретный кадр (виджет консультанта,
 * 1000×1250) берёт не полосу кадра (62%), а 40% содержимого — иначе панель
 * 702px высотой 878px не помещается в окно ноутбука вместе с шапкой.
 * Правило общее для любого будущего одиночного `photo` с портретной
 * пропорцией (высота больше ширины), не только для `ai-consultant`: раскрой
 * читается из формы кадра, а не из имени кейса. */
const isPortraitSingle =
  spread.kind === 'photo' && images.length === 1 && Number(frameHeight) > Number(frameWidth);
/* Панель без кадра у КЕЙСА `site-v3` («Замер», «Проверка на месте») несёт
 * внутренний отступ (П-3: «внутренний отступ панели 32 px на 1440 и 768,
 * 16 px на 390») — панель с настоящим кадром отступа не несёт (кадр — это и
 * есть панель). Схема `zayavka-hub` (`kind: 'schema'`) сюда НЕ входит: эта
 * задача переносит только `site-v3` (границы задачи), а её раскладка уже
 * сдана и не трогается — `isInset` ограничен новыми двумя видами. */
const isInset = spread.kind === 'weight' || spread.kind === 'checklist';
---
<div class="spread" data-case-spread class:list={{ mirror, portrait: isPortraitSingle }}>
  <div class="frame" data-spread-frame class:list={{ inset: isInset }}>
    {spread.kind === 'schema' ? (
      <CaseFlowIllustration single="b" />
    ) : spread.kind === 'weight' ? (
      <CaseWeightIllustration host="case-site-v3" />
    ) : spread.kind === 'checklist' ? (
      <ul class="checks">
        {checks.map((check) => (
          <li class="check t-body">
            {check.lead} <a href={check.href}>{check.linkText}</a>
          </li>
        ))}
      </ul>
    ) : (
      <div
        class="shots"
        class:list={{ trio: isTrio, row3: isRow3 }}
        role={isTrio ? 'group' : undefined}
        aria-label={isTrio ? spread.heading : undefined}
        tabindex={isTrio ? 0 : undefined}
      >
        {images.map((img, i) => {
          /* Раздел 8/10.2 брифа, очередь `70-workshop/plans/site-v3/
             04-queue-2026-08-26.md`, пункт 5 — переписано с манифеста на
             штатную отложенную загрузку браузера: КАЖДЫЙ кадр несёт
             настоящий `src` в разметке (без JavaScript и без выполнения
             манифеста поисковик и читатель видят все кадры, не только
             первый), а откладывает загрузку сам браузер через
             `loading="lazy"` — родной атрибут, а не ручной наблюдатель
             поверх `/case-galleries.json`. Единственный кадр без атрибута —
             самый первый на странице (`index === 0 && i === 0`): у него нет
             `loading="lazy"`, чтобы браузер не откладывал элемент, который и
             так на первом экране (LCP).

             Гейт веса (`check-budget.mjs`) по-прежнему не даёт девяти кадрам
             по ~100…120 КБ литералом раздуть первую загрузку (замер до
             починки — 1151,8 КБ против предела 500): `data-defer-weight`
             говорит гейту, что байты этого кадра браузер не скачивает при
             первой загрузке, и они не входят в предел — то же самое
             утверждение, которое раньше делало отсутствие атрибута `src`,
             перенесённое на атрибут, который сборка теперь не убирает. */
          const eager = index === 0 && i === 0;
          const frameImg = (
            <img
              class:list={{ big: spread.kind === 'photo-trio' && i === 0 }}
              src={img.src}
              alt={img.alt}
              width={frameWidth}
              height={frameHeight}
              loading={eager ? undefined : 'lazy'}
              decoding="async"
              data-defer-weight={eager ? undefined : 'true'}
            />
          );
          /* Пункт 6 очереди (`70-workshop/plans/site-v3/`): подпись под
             кадром — «имя источника + шаг» — распространена с
             `photo-row-3` (`storefront`, где приём уже жил) на `photo` и
             `photo-trio` (`websites`, `zayavka-hub`, `ai-consultant`):
             картинка без подписи — иллюстрация, с подписью — экспонат.
             Кадр без `img.caption` в данных (пока такого нет ни у одного
             кейса) остаётся голым `<img>` — подпись не рисуется пустой. */
          return img.caption ? (
            <figure class="shot">
              {frameImg}
              <figcaption class="shot-caption t-small">{img.caption}</figcaption>
            </figure>
          ) : frameImg;
        })}
      </div>
    )}
  </div>
  <div class="caption">
    <p class="spread-label">{spread.label}</p>
    <h3 class="t-h3">{spread.heading}</h3>
    <p class="spread-body t-body">{spread.body}</p>
  </div>
</div>

<style>
  .spread {
    display: grid;
    grid-template-columns: 62% 1fr;
    gap: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  /* `~`, не `+`: у каждого разворота свой `<noscript>` (ниже в разметке),
     он встаёт МЕЖДУ соседними `.spread` в DOM и рвёт смежность — `+`
     никогда не совпадал, ритм молчал (32px padding-top каждого разворота
     оставался единственным зазором на всех трёх ширинах). Общий комбинатор
     не зависит от того, что стоит между разворотами. */
  .spread ~ .spread { margin-top: 96px; }
  .spread.mirror { grid-template-columns: 1fr 62%; }
  .spread.mirror .frame { order: 2; }
  .spread.mirror .caption { order: 1; }

  /* Раздел 3.5 брифа: одиночный портретный кадр (виджет консультанта)
     берёт 40% содержимого, не 62% полосы кадра — иначе панель получается
     выше окна ноутбука вместе с шапкой и разворот перестаёт читаться одним
     взглядом. Ограничено `min-width: 900px` (а не общим `.spread`),
     потому что на ≤899px `.spread` и так падает в одну колонку ниже — без
     этого условия правило 40%/1fr победило бы там мобильный раскрой по
     специфичности (два класса против одного) независимо от порядка.

     Пункт 6 очереди (`70-workshop/plans/site-v3/04-queue-2026-08-26.md`):
     на самом пороге 900px `.container` одновременно прибавляет паддинг
     (24px → 40px, `Container.astro`) — процент 40% берётся от УЖЕ урезанного
     поля (900 − 2×40 − 48 зазор = 812; 40% = 324,8, замер дал 328px с округл.
     чисел браузера), и это меньше, чем кадр получает на 390px (358px, поле
     во всю ширину). Читатель на ноутбуке видел бы кадр УЖЕ, чем на телефоне.
     `minmax(358px, 40%)` держит пол ровно в этом же числе (раздел 3.5,
     таблица «390»: «один портретный кадр 1000×1250 … 358»): трек не может
     стать у́же 358px ни на одной ширине ≥ 900px, а начиная с той ширины, где
     40% САМИ превышают 358px (≈ окно 975px), процент снова решает — 40% на
     1440 (замер до правки не менялся, там 40% давало 420,8px) остаётся
     нетронутым. */
  @media (min-width: 900px) {
    .spread.portrait { grid-template-columns: minmax(358px, 40%) 1fr; }
    .spread.portrait.mirror { grid-template-columns: 1fr minmax(358px, 40%); }
  }

  /* Поле НИКОГДА не несёт фиксированную высоту (сторож 10.1.3, П-3): высота
     панели = высота содержимого. Ни `height`, ни `min-height` здесь нет. */
  .frame { min-width: 0; }
  .caption { min-width: 0; align-self: start; max-width: 36em; }

  /* Панель без настоящего кадра — схема (`CaseFlowIllustration`,
     `CaseWeightIllustration`) или список проверок (раздел 2/4.5 брифа,
     П-3): внутренний отступ 32px на 1440/768, 16px на ≤599, паспарту и
     рамка — тот же язык, что уже несёт `CaseIllustrationField.astro` на
     главной. `display: flex; flex-direction: column` даёт схемам
     (`.flow`/`.weight`, `flex: 1; min-height: 0`) рабочий флекс-родитель —
     без него это объявление ничего не значит вне контейнера-флекса. */
  .frame.inset {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: clip;
  }
  @media (max-width: 599px) {
    .frame.inset { padding: 16px; }
  }

  /* «Проверка на месте» (раздел 4.5 брифа) — три строки `.t-body` с
     разделителями 1px, без маркеров списка. Ссылка внутри — прозаическая,
     подчёркнута всегда (D-055/D-098), тот же приём, что у `.action-link a`
     страницы кейса. */
  .checks {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .check {
    margin: 0;
    padding: 16px 0;
    color: var(--text-muted);
  }
  .check + .check { border-top: 1px solid var(--border); }
  .checks .check:first-child { padding-top: 0; }
  .checks .check:last-child { padding-bottom: 0; }
  .check a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .spread-label {
    margin: 0 0 12px;
    color: var(--accent);
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .caption h3 { margin: 0 0 12px; }
  .spread-body { margin: 0; color: var(--text-muted); }

  /* У снимка нет внутреннего отступа (раздел 2, П-3): кадр — это и есть
     панель, изображение на 100% ширины, паспарту не заводится. */
  .frame img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  /* Подпись под кадром (`.shot`/`.shot-caption`, пункт 6 очереди) — общая
     для одиночного `photo`, `photo-trio` (крупный + два подкадра) и
     `photo-row-3` (три равных): убирает браузерный отступ `<figure>` и
     снимает автоматический минимум флекс-элемента на ленте (ловушка 25,
     `50-code/CLAUDE.md`), без чего кадр в ленте не сжимается до 78%. */
  .shot { margin: 0; min-width: 0; }
  .shot-caption {
    margin: 8px 0 0;
    color: var(--text-muted);
  }

  .shots.trio {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "big big" "s1 s2";
    gap: 24px;
  }
  /* Область грида назначается узлу, который ДЕЙСТВИТЕЛЬНО стоит прямым
     потомком `.shots.trio` — с подписью это `<figure class="shot">`, без
     неё (кадр без `img.caption`, сегодня таких нет) — сам `<img>`; оба
     случая покрыты общим селектором `:is()`. Ограничено `:not(.row3)`:
     у раскроя «три в ряд» `grid-template-areas: none` (ниже), и присвоение
     `grid-area: big/s1/s2` РЕАЛЬНОМУ грид-элементу (`.shot`, а не только
     вложенному в него `<img>`, как было до подписей под кадром) без
     совпадающей именованной области трактуется браузером как имя линии,
     плодит четыре лишних неявных колонки (замер:
     `grid-template-columns: 0px 0px 0px 0px 586px`) и даёт каждому кадру
     ряда ~100% ширины панели вместо трети — сумма кадров+зазоров ряда
     264.8% вместо ожидаемых ~100%. До подписей это не проявлялось: правило
     било по вложенному `<img>`, который не был грид-элементом, и потому
     ничего не значило. */
  .shots.trio:not(.row3) :is(img, .shot):nth-of-type(1) { grid-area: big; }
  .shots.trio:not(.row3) :is(img, .shot):nth-of-type(2) { grid-area: s1; }
  .shots.trio:not(.row3) :is(img, .shot):nth-of-type(3) { grid-area: s2; }

  /* `photo-row-3` (раздел 4.1 брифа, «три витрины в Telegram»): три РАВНЫХ
     кадра в ряд — не крупный + два подкадра. Named-area раскрой выше рассчитан
     на 2 колонки/2 ряда; здесь колонок три и области не именованы, поэтому
     они явно сняты (`grid-template-areas: none`), а сама плашка `big`
     (строка выше) на этот раскрой не навешивается вовсе (см. `.astro`:
     `spread.kind === 'photo-trio'`). Панель 702px даёт `(702 − 2×24) / 3 =
     218px` на кадр (раздел 4.1) — заведомо ниже правила «≥95% ширины
     панели» из 10.1.3, и это не дефект: сумма трёх кадров и двух зазоров
     равна ширине панели, что и проверяет отдельный геометрический сторож
     (раздел 10.1.3, «оговорка на будущее» + `case-spread-fill.spec.ts`). */
  .shots.trio.row3 {
    grid-template-columns: repeat(3, 1fr);
    grid-template-areas: none;
  }
  .shots.trio.row3 .shot-caption {
    text-align: center;
  }

  @media (max-width: 899px) {
    .spread, .spread.mirror { grid-template-columns: 1fr; }
    .spread.mirror .frame, .spread.mirror .caption { order: initial; }
    .spread ~ .spread { margin-top: 64px; }
    .caption { max-width: none; }
  }

  @media (max-width: 599px) {
    .spread ~ .spread { margin-top: 48px; }
    /* Раздел 3.3: многокадровый разворот на ≤599px становится горизонтальной
       полосой с привязкой — следующий кадр выглядывает краем, прокрутка
       видна без подсказки. `role="group"`/`aria-label`/`tabindex` — выше,
       в разметке (не зависят от ширины экрана, ставятся всегда для трио). */
    .shots.trio {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
    }
    /* Флекс-элемент ленты — `<figure class="shot">`, когда кадр несёт
       подпись (сегодня это все трио/ряды — `storefront`, `websites`,
       `zayavka-hub`), и сам `<img>`, когда нет (`:is()`, тот же приём, что
       у грид-областей выше): правило нацелено на узел, который
       ДЕЙСТВИТЕЛЬНО является флекс-элементом, а не на вложенный в него
       `<img>`. */
    .shots.trio > :is(img, .shot) {
      flex: 0 0 78%;
      /* Без этого `min-width: auto` (спецификация п. 4.5) берёт за
         «специфицированный» размер `width: 100%` из общего правила
         `.frame img` (выше) и вычисляет автоматический минимум как 100%
         контейнера — тот перебивает `flex-basis: 78%`, потому что
         является ПОЛОМ итогового размера, а `flex-shrink: 0` сам по себе
         этого пола не снимает. Замер `getBoundingClientRect()` до правки:
         `<img>` — 358px при контейнере 358px (100%, а не 78% = 279px).
         Явный `min-width: 0` выключает автоматический минимум. */
      min-width: 0;
      scroll-snap-align: start;
    }
  }

  /* Появление разворота при прокрутке — раздел 9 брифа: opacity 0 → 1,
     translateY(12px) → 0, 320 мс, один раз (не каждый раз при пересечении
     границы).
     Было — `animation-timeline: view()`: измерено на этом же файле, что
     решение НЕ подходит для «одного раза» — это ПРИВЯЗКА к позиции
     прокрутки, а не разовый триггер: при возврате прокрутки вверх мимо
     диапазона `entry`/`cover` анимация СЪЕЗЖАЕТ назад к 0%, и уже показанный
     разворот гаснет заново (замер: все четыре `.spread` держали
     `opacity: 0` в застывшем виде после прокрутки вниз и обратно вверх —
     `getComputedStyle` подтвердил `animation-timeline: view(); playState:
     running`, а не «однократно сыграно»). Раздел 9 требует «один раз», и
     держится это только явным одноразовым триггером — `IntersectionObserver`
     с `unobserve` после первого пересечения, тот же приём, что уже несёт
     затвор `CaseFlowIllustration.astro`. Запасное состояние — видимое: без
     JavaScript и без поддержки набора`IntersectionObserver`разворот просто
     стоит открытым (`<noscript>` ниже и ветка `else` в скрипте). */
  .spread { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    [data-case-spread] {
      opacity: 0;
      transform: translateY(12px);
      transition: opacity var(--dur-reveal) var(--ease), transform var(--dur-reveal) var(--ease);
    }
    [data-case-spread].is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<noscript>
  <style>[data-case-spread] { opacity: 1 !important; transform: none !important; }</style>
</noscript>

{/* Один скрипт на все развороты страницы: Astro дедуплицирует одинаковый
    неинлайновый `<script>` при повторном использовании компонента, поэтому
    четыре вызова `CaseSpread` дают один блок в собранном JS, а не четыре
    независимых наблюдателя. Обычный (не `is:inline`) `<script>` здесь
    безопасен — компонент рендерится в дереве страницы напрямую, а не через
    слот `CaseIllustrationField` (ловушка 1, `50-code/CLAUDE.md`: там
    поднимаемый `<script>` до сборки не доезжает; здесь этого пути нет). */}
<script>
  (function () {
    if (window.__caseSpreadRevealInit) return;
    window.__caseSpreadRevealInit = true;

    /* Подстановка кадров из манифеста `/case-galleries.json` снята отсюда
       очередью `70-workshop/plans/site-v3/04-queue-2026-08-26.md`, пункт 5:
       каждый `<img>` уже несёт настоящий `src` и грузится сам браузером
       (`loading="lazy"`), скрипту здесь остаётся только появление разворота
       при прокрутке (раздел 9 брифа). */
    var els = document.querySelectorAll('[data-case-spread]');
    if (!('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>
