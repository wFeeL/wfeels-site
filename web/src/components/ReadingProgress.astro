---
interface Props {
  /** На главной ≥1244 px эту работу забирает рельс (`Rail.astro`) — план,
   *  задача 4, «рельс или полоса, а не ничего»; порог опущен с 1600 px
   *  владельцем 2026-08-13 вместе с самим рельсом (кружки шириной 48 px
   *  вместо подписанных точек 200 px) — см. `tokens.css`, там же расчёт и
   *  измерение. Полоса в этом режиме рисуется только ниже 1244 px; на любой
   *  другой странице (`mobileOnly` не передан) она видна при любой ширине,
   *  как и раньше. Точка перелома — общий список в `tokens.css`. */
  mobileOnly?: boolean;
}
const { mobileOnly = false } = Astro.props;
---
<div id="reading-progress" class:list={{ 'mobile-only': mobileOnly }} aria-hidden="true"><i></i></div>

<style>
  /* Полоса ЛЕЖИТ на кромке шапки, а не стоит под ней последним потомком. Пока
     она была обычным блоком в потоке, её 2 px шли в высоту шапки: 65 px на
     страницах без полосы против 67 с полосой, и при каждом уходе с главной всё
     содержимое опускалось на два пикселя. Абсолютное позиционирование считает
     от шапки — она `position: sticky`, а значит уже задаёт систему координат
     для потомков. `bottom: -1px` кладёт полосу поверх собственной рамки шапки:
     линия оказывается ровно на кромке, ничего не отодвигая. */
  #reading-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: transparent;
  }
  @media (min-width: 1244px) {
    #reading-progress.mobile-only { display: none; }
  }
  #reading-progress > i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('#reading-progress > i');
  if (bar) {
    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? window.scrollY / max : 0;
      bar.style.width = `${Math.min(1, Math.max(0, ratio)) * 100}%`;
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
