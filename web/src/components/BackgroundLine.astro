---
/* Линия на фоне главной — бриф `70-workshop/specs/site-v3/
 * 02-background-line.md`, переписан целиком 2026-08-18 (исполнение D-043 и
 * ответ на пункт 2 списка правок владельца). Разметку (оба `<svg>`,
 * `data-line-side`, `data-line-turn`) несёт `Section.astro` (раздел 7.2) —
 * этот файл подключается один раз (`Base.astro`, проп `line`) и несёт
 * ТОЛЬКО глобальные правила: своей видимой разметки он не рендерит.
 *
 * ЗАМЕР ПЕРЕД ВЁРСТКОЙ (раздел 3.2-бис, риск композиции) — сделан первым,
 * до этого файла: `vector-effect: non-scaling-stroke` вместе с
 * `pathLength="1"` и `stroke-dasharray: 1 1` в целевом Chromium ДЕРЖИТСЯ —
 * штрих остаётся сплошным (не превращается в пунктир `1px 1px`), несмотря
 * на то что `getComputedStyle(path).strokeDasharray` вводит в заблуждение
 * («1px, 1px» — это сериализация CSSOM, не то, как путь красится).
 * Проверено рендером (скриншот и построчный замер закрашенных пикселей),
 * не только вычисленным стилем — см. отчёт исполнителя. Значит используется
 * ОСНОВНОЙ приём раздела 3.2-бис, а не запасной (компенсированный
 * `stroke-width`).
 *
 * Раздел 7.3 «Синхронность»: ОДНО правило диапазона на все элементы —
 * `animation-range: cover var(--line-lead) cover calc(100% - var(--line-trail))`,
 * `--line-lead: 33vh`, `--line-trail: 67vh` (сумма ровно 100vh). Конец
 * рисования стоит на 67% высоты окна на любом элементе, на любой высоте
 * страницы, при любом составе секций — арифметическое следствие, не
 * подобранное число (раздел 7.3 брифа разбирает вывод). Последний элемент
 * (хвост подвала, `[data-line-last]`) — исключение: `exit 0%` вместо
 * `cover calc(100% - var(--line-trail))`, иначе последние 0.33 высоты окна
 * рисунка недостижимы (раздел 7.3).
 *
 * Три детали реализации, каждая обязательна (раздел 2 и 7.3):
 *   - animation-fill-mode: both — без него элементы вне своего окна
 *     показали бы базовое состояние (линия нарисована целиком), то есть
 *     ровно тот дефект, который чинится;
 *   - animation-timing-function: linear — иначе конец отвязывается от
 *     постоянной высоты экрана;
 *   - РАЗДЕЛЬНЫЕ longhand-свойства, не сокращение animation: — сборка
 *     сводит animation + animation-timeline в один шорткод, и собранный
 *     Chromium этой формы не понимает: animationName молча уходит в none.
 *     Тест: `css-no-animation-shorthand-with-timeline.test.ts`.
 *
 * Раздел 7.4 «Загрузка» (пункт 2б): `#hero .line-run path` дополнительно
 * несёт `line-load` — однократное вычерчивание при монтировании, от
 * `stroke-dashoffset: 1` БЕЗ кадра `to` (конечным берётся подлежащее —
 * фактическое положение конца от `view()`, раздел 7.4 объясняет, почему
 * дописывать `to` нельзя: линия дочертится до низа `hero` и скачком
 * вернётся назад).
 *
 * Раздел 7.5 «Состояния»: запасное — линия нарисована ЦЕЛИКОМ уже в базовом
 * правиле (`stroke-dashoffset: 0` вне `@supports`/`@media`), анимация
 * навешивается СВЕРХУ внутри `@supports (animation-timeline: view()) и
 * @media (prefers-reduced-motion: no-preference)`, никогда наоборот. Это
 * закрывает и `prefers-reduced-motion: reduce`, и браузер без
 * `animation-timeline`, и безголовый Chromium (который сам просит `reduce`)
 * одним и тем же состоянием по умолчанию.
 */
---
<style is:global>
  /* ── Токены геометрии (раздел 3.4, 3.3) ────────────────────────────── */
  :root {
    --line-amp: 4px;
    --line-x: 16px;
    --line-x-right: 16px;
    /* Раздел 7.3 — сумма ровно 100vh, вторая половина правила диапазона. */
    --line-lead: 33vh;
    --line-trail: 67vh;
  }
  @media (min-width: 900px) {
    :root {
      --line-amp: 8px;
      /* Порог появления рельса читается из Rail.astro (@media 1324px), не
         назначается здесь. Число 97 — раздел 3.4: «Правое поле делится с
         рельсом» (72 px полоса рельса + просвет 12 + A + stroke/2 = 97). */
      --line-x: clamp(21px, calc((100vw - var(--container)) / 4 + 20px), 120px);
      --line-x-right: var(--line-x);
    }
  }
  @media (min-width: 1324px) {
    :root { --line-x-right: max(var(--line-x), 97px); }
  }

  /* Высота перехода — равна ИЗМЕРЕННОЙ полосе пустоты нижней секции
     (раздел 3.3): совпадает буквально с числами `Section.astro`
     (`data-top-gap`), второй шкалы не заводится. Задана на каждой секции с
     данными линии (не только на владеющих переходом — дешевле не ветвить),
     читают её только `.line-turn`/сдвинутый `.line-run` секций-владельцев. */
  [data-line-side] { --line-gap: 48px; }
  @media (min-width: 480px) { [data-line-side] { --line-gap: 64px; } }
  @media (min-width: 900px) { [data-line-side] { --line-gap: 96px; } }
  [data-line-side][data-top-gap="stitch"] { --line-gap: 64px; }
  @media (min-width: 480px) {
    [data-line-side][data-top-gap="stitch"] { --line-gap: 96px; }
  }
  @media (min-width: 900px) {
    [data-line-side][data-top-gap="stitch"] { --line-gap: 128px; }
  }

  /* ── Горизонтальный вынос (раздел 3.4) ─────────────────────────────── */
  /* `--container-pad` — тот же `padding-inline`, что и у `Container.astro`
     (16/24/40), задан там переменной и наследуется вниз до секции.
     `--line-out`/`--line-out-right` — расстояние от кромки СЕКЦИИ (=кромки
     содержимого контейнера, где начинается текст) до дока прогона наружу:
     `поле_до_текста − line-x`, где поле_до_текста = отступ контейнера +
     половина разницы окна и контейнера (0, пока окно уже контейнера). */
  [data-line-side] {
    position: relative;
    --line-out: calc(
      var(--container-pad) + max(0px, (100vw - var(--container)) / 2) - var(--line-x)
    );
    --line-out-right: calc(
      var(--container-pad) + max(0px, (100vw - var(--container)) / 2) - var(--line-x-right)
    );
  }

  /* ── Видимость: порог 480 px (раздел 6, D-026 отменён) ─────────────── */
  .line-run, .line-turn {
    display: none;
    position: absolute;
    overflow: visible;
    z-index: -1;
    pointer-events: none;
  }
  @media (min-width: 480px) {
    .line-run, .line-turn { display: block; }
  }
  @media print, (forced-colors: active) {
    .line-run, .line-turn { display: none; }
  }

  /* ── Прогон: мощение по умолчанию inset-block:0 (раздел 3.5) ───────── */
  .line-run {
    top: 0;
    bottom: 0;
    width: var(--line-amp);
  }
  /* Секция, владеющая переходом, отдаёт ему свой верх целиком — прогон
     начинается НИЖЕ бокса перехода (раздел 3.5, «два бокса: переход и
     прогон»). */
  [data-line-turn="lr"] .line-run,
  [data-line-turn="rl"] .line-run {
    top: var(--line-gap);
  }
  [data-line-side="left"] .line-run {
    left: calc(-1 * (var(--line-out) + var(--line-amp)));
  }
  [data-line-side="right"] .line-run {
    right: calc(-1 * (var(--line-out-right) + var(--line-amp)));
  }

  /* ── Переход: во всю ширину, бокс высотой в измеренную полосу (3.5) ── */
  .line-turn {
    top: 0;
    height: var(--line-gap);
    left: calc(-1 * var(--line-out));
    right: calc(-1 * var(--line-out-right));
  }

  /* ── Штрих (раздел 5, 3.2-бис) ──────────────────────────────────────
     `vector-effect: non-scaling-stroke` — штрих рисуется в пикселях
     экрана и не тянется вместе с неравномерным масштабом
     `preserveAspectRatio="none"` (ловушка 2, раздел 3.2-бис). Замер
     композиции с `pathLength="1"` + `stroke-dasharray` — во фронтматтере
     выше: держится, запасной путь не используется. */
  .line-run path, .line-turn path {
    fill: none;
    stroke: var(--accent);
    stroke-opacity: var(--line-opacity);
    stroke-width: var(--stroke-bg-line);
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0; /* ПО УМОЛЧАНИЮ — нарисовано целиком (раздел 7.5) */
  }

  /* ── Рисование (раздел 7.3, 7.4) ────────────────────────────────────── */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .line-run path, .line-turn path {
        stroke-dashoffset: 1;
        animation-name: line-draw;
        animation-duration: 1ms;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover var(--line-lead) cover calc(100% - var(--line-trail));
      }
      /* Последний элемент мощения (хвост подвала, `Footer.astro`) —
         исключение раздела 7.3: без него последние 0.33 высоты окна
         рисунка недостижимы, потому что прокрутка упирается раньше, чем
         окно элемента успевает закрыться. */
      [data-line-last] .line-run path {
        animation-range: cover var(--line-lead) exit 0%;
      }
      /* Пункт 2б: первый экран ВЫЧЕРЧИВАЕТСЯ при загрузке, а не появляется
         готовым. Кадра `to` у `line-load` нет и не должно быть — см.
         фронтматтер. */
      #hero .line-run path {
        animation-name: line-draw, line-load;
        animation-timeline: view(), auto;
        animation-duration: 1ms, 1400ms;
        animation-timing-function: linear, cubic-bezier(.2, .6, .2, 1);
        animation-fill-mode: both, none;
      }
    }
  }
  @keyframes line-draw { to { stroke-dashoffset: 0; } }
  @keyframes line-load { from { stroke-dashoffset: 1; } }
</style>
