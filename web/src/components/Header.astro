---
import Container from './Container.astro';
import ThemeToggle from './ThemeToggle.astro';
import Button from './Button.astro';
import NavLinks from './NavLinks.astro';
import ReadingProgress from './ReadingProgress.astro';
import { dict, hasTranslation } from '../i18n/locales';
import { HEADER_CTA_HREF, showHeaderCta } from '../lib/nav';

interface Props { lang: 'ru' | 'en'; progress?: boolean }
const { lang, progress = true } = Astro.props;
const t = dict(lang);

/* Кнопка не рисуется там, где вела бы в никуда: правило и список страниц
   живут в `lib/nav.ts`, страницы про кнопку ничего не знают. */
const cta = showHeaderCta(Astro.url.pathname);

/* Кнопка ведёт на русскую страницу контактов: английской ещё нет. Молча
   уводить англоязычного посетителя на русскую форму нельзя, поэтому ссылка
   помечена языком цели и поясняющей подписью. Условие само истечёт: как только
   `/kontakt` появится в `BILINGUAL_PATHS`, пометка исчезнет. */
const ctaForeign = lang === 'en' && !hasTranslation(HEADER_CTA_HREF);

const NAV: { href: string; text: string }[] = {
  ru: [
    { href: '/uslugi', text: 'Услуги' },
    { href: '/keysy', text: 'Кейсы' },
    { href: '/tseny', text: 'Цены' },
    { href: '/kontakt', text: 'Контакты' },
    { href: '/o-mne', text: 'Обо мне' },
  ],
  /* Английских разделов не существует: их приносит спека 02 вместе с
     английским ядром. До правки здесь стояли пять пунктов на `/en/#services` и
     подобные — на странице таких мест нет, и нажатие не делало ничего: ни
     перехода, ни прокрутки, ни честной 404. Пункт, который ничего не делает,
     обманывает сильнее отсутствующего: посетитель считает раздел
     существующим и решает, что сломан сайт. Навигация вернётся сюда вместе с
     разделами, на которые ей вести. */
  en: [],
}[lang];
---
<header>
  <Container>
    <div class="bar">
      <a class="brand" href={lang === 'ru' ? '/' : '/en'}>wfeels</a>

      {NAV.length > 0 && (
        <nav class="nav-wide" aria-label={t.nav}>
          <NavLinks items={NAV} />
        </nav>
      )}

      <div class="tools">
        <slot name="lang" />
        <ThemeToggle />
        {/* Место кнопки занято всегда, даже когда самой кнопки нет. Шапка
            липкая: без резерва переключатели темы и языка проезжали 123 px —
            треть узкого экрана — при каждом переходе на `/kontakt` и
            `/spasibo`. Заполнитель рисуется тем же компонентом и тем же
            текстом, поэтому ширина совпадает точно, а не подобрана числом. */}
        {cta ? (
          <Button
            href={HEADER_CTA_HREF}
            variant="primary"
            hreflang={ctaForeign ? 'ru' : undefined}
            title={ctaForeign ? t.ctaLangNote : undefined}
          >
            {t.write}
          </Button>
        ) : (
          <Button variant="primary" placeholder={true}>{t.write}</Button>
        )}
      </div>
    </div>

    {NAV.length > 0 && (
      <details class="nav-narrow">
        <summary>{t.menu}</summary>
        <nav aria-label={t.nav}>
          <NavLinks items={NAV} stacked={true} />
        </nav>
      </details>
    )}
  </Container>
  {progress && <ReadingProgress />}
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 24px; height: 64px; }
  .brand { font: 800 1.0625rem/1 var(--font-head); color: var(--text); text-decoration: none; }

  /* Здесь только раскладка навигации. Вид самих ссылок описан в
     NavLinks.astro — тот компонент их и рисует, а стиль, написанный про чужую
     разметку, Astro скоупит в никуда. Так уже было: четыре правила `nav a`
     стояли в этом файле и не применялись ни разу. */
  nav { display: flex; gap: 20px; }

  .tools { margin-left: auto; display: flex; align-items: center; gap: 10px; }

  .nav-narrow { display: none; }
  .nav-narrow summary {
    cursor: pointer;
    padding: 10px 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
    list-style: none;
  }
  .nav-narrow summary::-webkit-details-marker { display: none; }
  .nav-narrow summary::after { content: ' ▾'; }
  .nav-narrow[open] summary::after { content: ' ▴'; }
  .nav-narrow nav {
    flex-direction: column;
    gap: 0;
    padding-bottom: 12px;
  }

  @media (max-width: 899px) {
    .nav-wide { display: none; }
    .nav-narrow { display: block; border-top: 1px solid var(--border); }
  }
</style>
