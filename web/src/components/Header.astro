---
import Container from './Container.astro';
import ThemeToggle from './ThemeToggle.astro';
import Button from './Button.astro';
import NavLinks from './NavLinks.astro';
import ReadingProgress from './ReadingProgress.astro';
import { dict } from '../i18n/locales';
import { HEADER_CTA_HREF, showHeaderCta } from '../lib/nav';

interface Props { lang: 'ru' | 'en'; progress?: boolean }
const { lang, progress = true } = Astro.props;
const t = dict(lang);

/* Кнопка не рисуется там, где вела бы в никуда: правило и список страниц
   живут в `lib/nav.ts`, страницы про кнопку ничего не знают. */
const cta = showHeaderCta(Astro.url.pathname);

const NAV = {
  ru: [
    { href: '/uslugi', text: 'Услуги' },
    { href: '/keysy', text: 'Кейсы' },
    { href: '/tseny', text: 'Цены' },
    { href: '/kontakt', text: 'Контакты' },
    { href: '/o-mne', text: 'Обо мне' },
  ],
  en: [
    { href: '/en/#services', text: 'Services' },
    { href: '/en/#cases', text: 'Cases' },
    { href: '/en/#pricing', text: 'Pricing' },
    { href: '/en/#contact', text: 'Contact' },
    { href: '/en/#about', text: 'About' },
  ],
}[lang];
---
<header>
  <Container>
    <div class="bar">
      <a class="brand" href={lang === 'ru' ? '/' : '/en'}>wfeels</a>

      <nav class="nav-wide" aria-label={t.nav}>
        <NavLinks items={NAV} />
      </nav>

      <div class="tools">
        <slot name="lang" />
        <ThemeToggle />
        {cta && (
          <Button href={HEADER_CTA_HREF} variant="primary">
            {t.write}
          </Button>
        )}
      </div>
    </div>

    <details class="nav-narrow">
      <summary>{t.menu}</summary>
      <nav aria-label={t.nav}>
        <NavLinks items={NAV} />
      </nav>
    </details>
  </Container>
  {progress && <ReadingProgress />}
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 24px; height: 64px; }
  .brand { font: 800 1.0625rem/1 var(--font-head); color: var(--text); text-decoration: none; }

  nav { display: flex; gap: 20px; }
  nav a { color: var(--text-muted); text-decoration: none; font-size: 0.9375rem; }
  nav a:hover { color: var(--text); }
  /* Отметка текущей страницы видна и глазу, не только программе. */
  nav a[aria-current="page"] { color: var(--text); font-weight: 500; }

  .tools { margin-left: auto; display: flex; align-items: center; gap: 10px; }

  .nav-narrow { display: none; }
  .nav-narrow summary {
    cursor: pointer;
    padding: 10px 0;
    font-size: 0.9375rem;
    color: var(--text-muted);
    list-style: none;
  }
  .nav-narrow summary::-webkit-details-marker { display: none; }
  .nav-narrow summary::after { content: ' ▾'; }
  .nav-narrow[open] summary::after { content: ' ▴'; }
  .nav-narrow nav {
    flex-direction: column;
    gap: 0;
    padding-bottom: 12px;
  }
  .nav-narrow nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 899px) {
    .nav-wide { display: none; }
    .nav-narrow { display: block; border-top: 1px solid var(--border); }
  }
</style>
