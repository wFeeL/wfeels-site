---
import Container from './Container.astro';
import ThemeToggle from './ThemeToggle.astro';
import Button from './Button.astro';
import NavLinks from './NavLinks.astro';
import ReadingProgress from './ReadingProgress.astro';
import TelegramMark from './TelegramMark.astro';
import LangSwitch from './LangSwitch.astro';
import { dict, hasTranslation, localeHome, type Locale } from '../i18n/locales';
import { headerCtaHref, sections, showHeaderCta } from '../lib/nav';
import { TELEGRAM_URL } from '../lib/contacts';

interface Props {
  /** Язык шапки. Приходит из `Base.astro`, который выводит его из адреса
   *  страницы, — своего вывода у шапки нет, чтобы двух источников языка на
   *  одной странице не существовало. */
  lang: Locale;
  progress?: boolean;
  /** Страница несёт рельс (`Rail.astro`, рисует его `Base.astro` вне шапки).
   *  При `true` полоса прогресса становится напарником рельса, а не заменой:
   *  видна только ниже 1324 px, где рельса ещё нет (план, задача 4, «рельс
   *  или полоса, а не ничего»; порог опущен с 1600 px владельцем 2026-08-13,
   *  рельс стал кружками шириной 48 px вместо подписанных точек 200 px, потом
   *  пересчитан в тот же день после возврата контейнера 1060 → 1180 px —
   *  расчёт и измерение в `tokens.css`/`Rail.astro`). Сегодня это только
   *  главная. */
  rail?: boolean;
}
const { lang, progress = true, rail = false } = Astro.props;
const t = dict(lang);

/* Кнопка не рисуется там, где вела бы в никуда: правило и список страниц
   живут в `lib/nav.ts`, страницы про кнопку ничего не знают. */
const cta = showHeaderCta(Astro.url.pathname);

/* Адрес кнопки зависит от страницы: на главной — якорь этой же страницы, а не
   `/contact`. Правило и оба адреса живут в `lib/nav.ts`, рядом с
   `showHeaderCta` — сюда попадает уже готовое значение. */
const ctaHref = headerCtaHref(Astro.url.pathname);

/* Кнопка ведёт на русскую страницу контактов, если английской нет. Молча
   уводить англоязычного посетителя на русскую форму нельзя, поэтому ссылка
   помечается языком цели и поясняющей подписью. Условие само истечёт: как
   только `/contact` появится в `BILINGUAL_PATHS`, пометка исчезнет.
   Якорь (`#contact`) в эту проверку не попадает: это переход внутри той же
   страницы, а не уход на другой язык, — и на английской главной кнопка ведёт
   именно якорем (`headerCtaHref`, `stripLocale`). */
const ctaForeign = lang === 'en' && !ctaHref.startsWith('#') && !hasTranslation(ctaHref);

/* Перечень разделов приходит из `lib/nav.ts` — оттуда же его берёт подвал.
   Своего списка у шапки нет намеренно: второй ручной перечень тех же путей
   расходится с первым молча. */
const NAV = sections(lang);

/* Знак бренда (владелец, дословно: «при наведении на wfeels буквы могут
   плавно подскакивать»). Буквы разбиты на `<span>` ради покадровой задержки
   между соседними — иначе подскакивать нечему кроме слова целиком. Разметка
   слова остаётся одним словом для читалки: `aria-label` на самой ссылке
   несёт «wfeels», а каждая буква помечена `aria-hidden`, значит имя ссылки
   вычисляется из атрибута и до букв не доходит вовсе (проверено правилом
   вычисления доступного имени: `aria-label` перекрывает содержимое, буквы —
   не единственный источник, а вообще не источник). */
const BRAND = 'wfeels';
---
<header>
  <Container>
    <div class="bar">
      <a class="brand" href={localeHome(lang)} aria-label={BRAND}>
        {BRAND.split('').map((ch, i) => (
          <span class="brand-letter" style={`--i:${i}`} aria-hidden="true">{ch}</span>
        ))}
      </a>

      {NAV.length > 0 && (
        <nav class="nav-wide" aria-label={t.nav}>
          <NavLinks items={NAV} />
        </nav>
      )}

      {/* Раскрывашка — обычный flex-элемент этой же строки, а не отдельный
          блок со своим позиционированием (было — см. историю дефекта у
          стилей `.nav-narrow` ниже). Она стоит МЕЖДУ знаком и переключателями
          в разметке и во flex-раскладке синхронно: место между ними не
          вычисляется числом под конкретный шрифт, его считает браузер. */}
      {NAV.length > 0 && (
        <details class="nav-narrow">
          <summary>{t.menu}</summary>
          <nav aria-label={t.nav}>
            <NavLinks items={NAV} stacked={true} />
          </nav>
        </details>
      )}

      <div class="tools">
        {/* Переключатель языка рисует сама шапка, а не слот со страницы
            (так было до снятия 2026-08-21). Слот означал бы, что каждая новая
            страница обязана про переключатель ПОМНИТЬ, а забытый слот — это
            страница без выхода на второй язык, и провал молчаливый. Честность
            цели считает сам компонент (`LangSwitch.astro`). */}
        <LangSwitch />
        <ThemeToggle lang={lang} />
        {/* Прямой канал рядом с переключателями, доступен с любой страницы и
            никуда не уводит безвозвратно: посетитель посадочной страницы,
            которого пункт меню увёл на главную (см. `lib/nav.ts`), получает
            здесь запасной путь, не открывающий вкладку. Адрес один на весь
            сайт — `lib/contacts.ts`, второго места с ним не заводим.
            `rel="me"` заявляет, что профиль принадлежит тому же человеку, чей
            это сайт; `target="_blank"` не ставится по той же причине, что и в
            подвале (`Footer.astro`): на телефоне ссылку перехватывает
            приложение, а на десктопе возврат — одна кнопка «назад». */}
        <a class="telegram" href={TELEGRAM_URL} rel="me" aria-label={t.footerTelegram}>
          <TelegramMark size={20} />
        </a>
        {/* Место кнопки занято всегда, даже когда самой кнопки нет (на
            десктопе). Шапка липкая: без резерва переключатели темы, языка и
            Telegram проезжали через треть узкого экрана при каждом переходе
            на `/contact` и `/thanks`. Заполнитель рисуется тем же
            компонентом и тем же текстом, поэтому ширина совпадает точно, а
            не подобрана числом.

            На мобильной ширине (<900 px, порог `.nav-wide`/`.nav-narrow`
            ниже) весь блок скрыт правкой владельца 2026-08-13, пункт 4:
            кнопка дублировала точно такую же кнопку первого экрана в двухстах
            пикселях ниже, а с пятым пунктом навигации шапка занимала
            заметную часть экрана. `showHeaderCta`/`headerCtaHref`
            (`lib/nav.ts`) и `CTA_HIDDEN_ON` не тронуты: класс скрывает уже
            готовый результат их решения, а не подменяет его — на страницах,
            где кнопки в шапке и так нет (плейсхолдер), скрывать нечего
            дополнительно, а десктоп (>=900 px) эта раскладка не задевает. */}
        <span class="cta-slot">
          {cta ? (
            <Button
              href={ctaHref}
              variant="primary"
              hreflang={ctaForeign ? 'ru' : undefined}
              title={ctaForeign ? t.ctaLangNote : undefined}
            >
              {t.write}
            </Button>
          ) : (
            <Button variant="primary" placeholder={true}>{t.write}</Button>
          )}
        </span>
      </div>
    </div>
  </Container>
  {progress && <ReadingProgress mobileOnly={rail} />}
</header>

{NAV.length > 0 && (
  <script>
    /* Дефект дизайн-ревью 2026-08-14 (САМОЕ ВАЖНОЕ): раскрывашка «Меню»
     * (`details.nav-narrow`) закрывалась только повторным тапом по
     * заголовку. На 390 px панель едет вместе с липкой шапкой поверх
     * содержимого — на экране формы закрывала подпись и поле «Как вас
     * зовут», а под ней всплывала нативная подсказка валидации. Читатель,
     * заглянувший в меню и вернувшийся к форме, заполнял её из-под панели.
     *
     * Разметка остаётся `<details>` и без единой строки этого скрипта
     * продолжает открываться/закрываться тапом по своему заголовку — три
     * закрытия ниже ДОБАВЛЕНЫ поверх нативного поведения, а не заменяют его:
     * `Escape`, клик/тап вне панели, переход по своей же ссылке (пункты
     * шапки — якоря главной, `lib/nav.ts`, страница не перезагружается, и
     * без явного закрытия панель осталась бы висеть поверх контента после
     * прокрутки к якорю).
     *
     * Фокус после закрытия по `Escape` возвращается на кнопку «Меню» —
     * иначе человек с клавиатуры теряет место на странице. После клика/тапа
     * вне панели фокус не переносится: сам клик уже указал, куда он идёт. */
    const menus = Array.from(
      document.querySelectorAll<HTMLDetailsElement>('details.nav-narrow'),
    );

    function closeMenu(menu: HTMLDetailsElement, opts: { refocus?: boolean } = {}) {
      if (!menu.open) return;
      menu.open = false;
      if (opts.refocus) menu.querySelector('summary')?.focus();
    }

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      for (const menu of menus) {
        if (menu.open) {
          e.preventDefault();
          closeMenu(menu, { refocus: true });
        }
      }
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      for (const menu of menus) {
        if (menu.open && !menu.contains(target)) closeMenu(menu);
      }
    });

    for (const menu of menus) {
      menu.querySelectorAll('nav a').forEach((a) => {
        a.addEventListener('click', () => closeMenu(menu));
      });
    }
  </script>
)}

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 16px 24px; min-height: 64px; }

  /* Коробка знака бренда — 44 px (общее правило целей нажатия в base.css), а
     строка в ней — ступень `body-lg` объявленной шкалы, 24 px после
     укрупнения (правка 2026-08-13, [[02-redesign-options]], пункт 8: было
     18 px до укрупнения, а до свода самовольных кеглей — 17 px, размера,
     которого шкала не знала). Знак остаётся крупнее навигации (17 px) и
     мельче цены и заголовков карточек (30 px) — вес 800 и есть его отличие,
     а не собственный кегль. Без центрирования строка вставала по верху
     коробки — оно решено `align-items: center`, а не размером. */
  .brand {
    display: inline-flex;
    align-items: center;
    font: 800 1.375rem/1 var(--font-head);
    color: var(--text);
    text-decoration: none;
  }

  /* Буква — свой блок, иначе `translate` не имеет коробки, к которой
     применяться (строчный узел текста transform игнорирует). Внутри
     `inline-flex` (`.brand`) это в любом случае блокифицируется браузером —
     `display: inline-block` тут для ясности чтения, не для эффекта. */
  .brand-letter {
    display: inline-block;
  }

  /* Буквы подскакивают по очереди — задержка растёт с позицией буквы
     (`--i`, прописан в разметке). Один запуск на заход курсора/фокуса, не
     цикл: `:hover`/`:focus-visible` включают анимацию заново при каждом
     новом входе, а не крутят её, пока курсор стоит на месте. `var(--ease)` —
     тот же кубический безье, что и у остальной микро-анимации сайта, не
     новая кривая: у него пологий выход что вверх, что при возврате, поэтому
     подскок не обрывается резко (владелец, дословно: «мягко, без резкого
     возврата»). `var(--dur-reveal)` — тот же токен, что у появления карточек:
     второй смысловой копии той же длительности не заводим.
     Целиком внутри `no-preference`: при `reduce` `animation-name` не
     назначается вовсе — буквы не двигаются НИ НА ПИКСЕЛЬ, а не просто
     быстро (в отличие от `!important`-переопределения длительности в
     `base.css`, которое сжало бы анимацию до почти нуля, но не убрало её). */
  @media (prefers-reduced-motion: no-preference) {
    .brand:hover .brand-letter,
    .brand:focus-visible .brand-letter {
      animation-name: brand-hop;
      animation-duration: var(--dur-reveal);
      animation-timing-function: var(--ease);
      animation-fill-mode: both;
      animation-delay: calc(var(--i) * 90ms);
    }
  }
  @keyframes brand-hop {
    0%, 100% { translate: 0 0; }
    35% { translate: 0px -4px; }
  }

  /* Здесь только раскладка навигации. Вид самих ссылок описан в
     NavLinks.astro — тот компонент их и рисует, а стиль, написанный про чужую
     разметку, Astro скоупит в никуда. Так уже было: четыре правила `nav a`
     стояли в этом файле и не применялись ни разу. */
  nav { display: flex; gap: 20px; }

  .tools { margin-left: auto; display: flex; align-items: center; gap: 10px; }

  /* Слот кнопки «Обсудить задачу» (реальной или заполнителя — см. разметку
     выше). `display: contents` по умолчанию: сам `<span>` не создаёт
     собственной коробки, кнопка стоит во flex-раскладке `.tools` так, как
     стояла бы без обёртки. Ниже 900 px (порог `.nav-wide`/`.nav-narrow`)
     обёртка скрывается целиком — правка владельца 2026-08-13, пункт 4:
     мобильная шапка держала кнопку в двухстах пикселях от точно такой же
     кнопки первого экрана. На десктопе (>=900 px) это правило не действует —
     кнопка остаётся, как и была. */
  .cta-slot { display: contents; }
  @media (max-width: 899px) {
    .cta-slot { display: none; }
  }

  /* До правки владельца 2026-08-13 (пункт 4, `.cta-slot` выше) ниже 480 px
     четыре органа управления — язык, тема, Telegram и кнопка «Обсудить
     задачу» — не помещались в одну строку без сжатия целей нажатия ниже
     44 px, а сжимать их нельзя (WCAG 2.5.8), поэтому `.bar`/`.tools` ниже
     переносят лишнее на вторую строку вместо сжатия. Кнопка теперь скрыта на
     этой ширине отдельным правилом (`.cta-slot`), но перенос оставлен как
     есть: он страхует оставшиеся органы (языку, теме, Telegram теснее
     всего именно здесь) и ничего не ломает, если состав `.tools` снова
     вырастет. Высота шапки при переносе растёт вместе с ним (`min-height`,
     а не `height`) — на остальных страницах ровно то же самое содержимое,
     поэтому высота шапки на любой конкретной ширине по-прежнему одинакова
     везде. */
  /* Дефект дизайн-ревью: липкая шапка занимала три ряда (знак · инструменты с
     кнопкой · «Меню») — измерено на 390×844: 170 px, пятая часть экрана
     телефона, занятая постоянно. Правка владельца 2026-08-13 (пункт 4,
     `.cta-slot`) убрала кнопку из этого ряда на мобильной ширине.

     Первая попытка чинить это (не оставлена в коде) вынимала раскрывашку из
     потока: `.nav-narrow` вставала `position: absolute` РЯДОМ с `.bar`
     (сосед по `Container`, не её ребёнок), а `left` считался вручную —
     сумма паддинга контейнера и измеренной ширины знака бренда. Число
     протухло один раз молча при смене `--font-head` на Unbounded (знак
     раздался с 71,27 до 95,6328125px, старый `left` встал левее нового
     правого края знака — «s» печаталась поверх «М» слова «Меню», разбор —
     история коммитов `Header.astro`) и протухло бы снова при следующей
     смене шрифта или начертания: константа, посчитанная под один шрифт,
     не знает о следующем.

     Рабочее решение — не считать число, а отдать раскладку flex-box: сама
     раскрывашка (`<details class="nav-narrow">`) переехала в разметке
     ВНУТРЬ `.bar`, между знаком и `.tools`, — обычный элемент той же
     flex-строки, соседствующий со знаком через `gap` этой строки, а не
     через посчитанный `left`. Свободное поле между ними считает браузер
     сам на любой ширине и при любом шрифте. Слово «Меню» остаётся видимым
     текстом (`<summary>{t.menu}</summary>`, без sr-only трюка) на ВСЕХ
     ширинах — предыдущая правка прятала подпись ≤479px, вставая поперёк
     закреплённого решения о подписанной цели нажатия (тест
     «текст органов управления стоит по центру и там, где шапка узкая»,
     `shell.spec.ts`); теснит место не подпись, а знак.

     Место находится переносом строки, а не сжатием. `.bar` ниже 900px
     переносит содержимое (`flex-wrap: wrap`): знак и раскрывашка — первая
     строка (их суммарная ширина на 320px — не больше ~185px, кратный запас
     от 288px свободного поля контейнера), `.tools` — вторая, когда первой
     не хватает места (без вычисления порога: `.tools` просто не помещается
     рядом со знаком и раскрывашкой и переносится сам, как любой flex-item,
     которому не хватило места на строке). DOM-порядок — знак, раскрывашка,
     переключатели — совпадает с порядком чтения и обхода табом НА ЛЮБОЙ
     ширине: визуальный перенос строк не переставляет элементы (`order` не
     используется нигде в этом блоке), поэтому здесь нет риска разойтись
     видимый/табовый порядок, какой был бы при использовании `order`.
     Измерено `getBoundingClientRect()` на 320 · 360 · 390 · 430 · 479px —
     `header-brand-menu.spec.ts`. */
  /* Пункты меню — без подчёркивания (правка владельца 2026-08-18). Своего
     правила у ссылок шапки не было вовсе, поэтому работало браузерное
     умолчание `text-decoration: underline`: пять синих подчёркнутых слов в
     ряд читались как список ссылок в тексте, а не как навигация. Пункт меню
     опознаётся местом и цветом; подчёркивание здесь — шум, который спорит с
     подчёркиванием НАВЕДЕНИЯ, единственным, что тут должно появляться. */
  .nav-wide a, .nav-narrow nav a { text-decoration: none; }

  @media (max-width: 899px) {
    .nav-wide { display: none; }
    .bar { flex-wrap: wrap; }
  }

  /* Тот же ящик, что у переключателя темы: 44×44 px, круглая рамка того же
     цвета. Одинаковый вид у соседних органов управления читается как один
     ряд инструментов, а не как три случайных элемента подряд. */
  .telegram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    transition: color var(--dur-micro) var(--ease),
                border-color var(--dur-micro) var(--ease);
  }
  .telegram:hover { color: var(--text); border-color: var(--text-faint); }

  /* `position: relative` — containing block для раскрытого списка ссылок
     (правило `.nav-narrow nav` ниже): список плавает НАД содержимым узкой
     формулой `top: 100%`, а не раздвигает соседей в потоке. Раньше это
     давал `header` (единственный позиционированный предок), и от него
     список считал координаты через тот же самый посчитанный-под-шрифт
     `left` — тот же порок, что и у самой раскрывашки (см. блок выше).
     Теперь контекст свой, локальный: `top`/`left` считаются от границ
     самой раскрывашки, а не от знака бренда или края вьюпорта. */
  .nav-narrow { display: none; position: relative; }
  /* Парное правило к `.nav-wide { display: none }` выше: широкое меню
     уходит — раскрывашка появляется. При переносе `.nav-narrow` внутрь
     `.bar` (2026-08-18) правило потерялось, и ниже 900 px не оставалось
     навигации вообще: `.nav-wide` уже скрыт, `.nav-narrow` ещё скрыт.
     Стоит ИМЕННО здесь, а не в общем медиа-блоке выше: специфичность у
     обоих правил одинаковая, побеждает последнее по порядку — в блоке выше
     оно проигрывало бы базовому `display: none` этой же строки. Сборка и
     юнит-тесты этого не видели, поймал e2e. */
  @media (max-width: 899px) { .nav-narrow { display: block; } }
  /* `display: flex` вместо строчного потока — по той же причине, что у знака
     бренда: `min-height: 44px` из base.css растит коробку, а слово «Меню»
     оставалось прижатым к её верху. Треугольник при этом становится вторым
     элементом строки, поэтому пробел из `content` заменён на `gap`: пробел в
     начале содержимого схлопнулся бы. */
  .nav-narrow summary {
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    /* «Меню» ведёт себя как пункт навигации, поэтому взяло ступень `small`,
       17 px после укрупнения — ту же, что и `NavLinks.astro` (правка
       2026-08-13, [[02-redesign-options]], пункт 8; было 15 px, самовольный
       кегль вне шкалы, до свода). */
    font-size: 1rem;
    color: var(--text-muted);
    list-style: none;
    white-space: nowrap;
  }
  .nav-narrow summary::-webkit-details-marker { display: none; }
  .nav-narrow summary::after { content: '▾'; }
  .nav-narrow[open] summary::after { content: '▴'; }

  /* Список ссылок — плавающая панель, а не строка потока: `position:
     absolute` относительно `.nav-narrow` (правило выше). Открытие меню не
     меняет высоту `.bar`/`header` ни на одной ширине — не только ≤479px,
     как было раньше, а везде, где раскрывашка вообще показана (≤899px):
     поведение одно и то же на всём диапазоне, а не два разных решения на
     двух порогах. */
  .nav-narrow nav {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    flex-direction: column;
    gap: 0;
    min-width: 200px;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  @media (max-width: 479px) {
    .bar { padding-block: 10px; }
    .tools { flex-wrap: wrap; justify-content: flex-end; row-gap: 8px; column-gap: 4px; }
