---
import Field from './Field.astro';
import Button from './Button.astro';
import { TELEGRAM_URL } from '../lib/contacts';
import { serviceGroups } from '../data/services';
import { dict, localeFromPath } from '../i18n/locales';

/* Язык формы — язык страницы, на которой она стоит. Проп сюда не приходит:
   форму зовут и главная (`home/Contact.astro`), и страница `/contact`, и
   витрина компонентов, и каждому пришлось бы про язык помнить. */
const locale = localeFromPath(Astro.url.pathname);
const t = dict(locale);
const groups = serviceGroups(locale);

interface Props {
  /** Код услуги S1…S9, который надо предвыбрать в списке «Что нужно
   *  сделать» (спека `70-workshop/specs/site-v3/08-service-pages.md`,
   *  раздел 10.2 — форма посадочной приходит с уже выбранной услугой).
   *  Значение проверяется по `serviceGroups(locale)`: неизвестный код — ошибка
   *  сборки, а не молча непредвыбранный список. Без пропа разметка не
   *  меняется ни на байт — главная и `/contact` остаются как были. */
  service?: string;
}
const { service } = Astro.props;

const KNOWN_CODES = groups.flatMap((g) => g.links.map((l) => l.code));
if (service !== undefined && !KNOWN_CODES.includes(service)) {
  throw new Error(
    `LeadForm.astro: код услуги «${service}» не найден среди serviceGroups ` +
    '(data/services.ts) — второй список кодов здесь не заводится.',
  );
}

const API_BASE = import.meta.env.PUBLIC_API_BASE ?? '';
const SENDING = t.formSending;
const LEGAL_VERSION = '1.3-2026-08-25';
---
<form id="lead-form" method="post" action={`${API_BASE}/api/lead`}
      data-sending-label={SENDING}>
  <Field name="name" label={t.formName} required={true} autocomplete="name"
         placeholder={t.formNamePlaceholder} />
  {/* `autocomplete` здесь намеренно НЕ задан. Атрибут объявляет браузеру, чем
       поле ЯВЛЯЕТСЯ, а это поле принимает два разных вида значения, и половина
       людей вводит `@handle`. Значения «почта или ник» в списке autofill нет:
       `email` объявил бы почту там, где её нет, и браузер подставлял бы адрес
       человеку, который собирался написать ник, — молча и правдоподобно.
       `off` тоже не выход: он выключает и подстановку тем, кто вводит почту.
       Без атрибута поле наследует `on` и получает историю ввода самого браузера
       — то есть ровно то, что человек писал сюда в прошлый раз, ник или почту. */}
  <Field name="contact" label={t.formContact} required={true}
         placeholder={t.formContactPlaceholder} />

  {/* Задача 18 (правка 2026-08-19): было текстовым полем «Что нужно
      сделать» — стало выпадающим списком с тем же лейблом, поле обязательное
      (бэкенд, `api/app/schemas.py`, отвергает код вне каталога, но не пустую
      строку — старые открытые вкладки без этого поля не теряют заявку; сама
      форма делает поле обязательным для НОВЫХ отправок). Список — не второй
      перечень услуг: группы, подписи и коды читаются из `SERVICE_GROUPS`
      (`data/services.ts`), откуда их уже берёт секция 3 «Что я делаю» —
      второй ручной список здесь расходился бы молча (закреплено
      `services.test.ts`, «коды услуг — ровно S1…S9»). */}
  <Field name="service" label={t.formService} select={true} required={true}>
    <option value="" disabled selected={!service} hidden>{t.formServicePlaceholder}</option>
    {groups.map((group) => (
      <optgroup label={group.title}>
        {group.links.map((link) => (
          <option value={link.code} selected={link.code === service}>{link.text}</option>
        ))}
      </optgroup>
    ))}
  </Field>

  <Field name="message" label={t.formMessage} textarea={true}
         hint={t.formMessageHint} autocomplete="off"
         placeholder={t.formMessagePlaceholder} />

  <p class="consent">
    {/* Задача 19 (правка 2026-08-18): плавная анимация галочки согласия.
        Нативный чекбокс красится браузером (`accent-color`, `base.css`) и
        рисует галочку сам — у CSS нет доступа к этой отрисовке, значит
        анимировать её напрямую нельзя. `input` остаётся настоящим чекбоксом
        (фокус, клавиатура, `required`, отправка формы — всё как было),
        только его СОБСТВЕННАЯ визуальная заливка снята (`appearance: none`
        ниже), а квадрат и галочку рисует пара соседних узлов, управляемых
        его же состоянием `:checked` через `~`. Порядок в разметке важен:
        `~`/`+` видят только СЛЕДУЮЩИХ соседей, поэтому `input` стоит первым. */}
    <span class="checkbox">
      <input id="f-consent" name="consent" type="checkbox" required />
      {/* Задача 9 (дизайн-ревью 2026-08-22): цель нажатия чекбокса — 24×24 px
          при минимуме 44. Первая попытка (пустой `label[for]` поверх поля)
          укрупняла область нажатия, но заодно перехватывала указатель у
          самого `input` — `page.check()` в шести сторожах `lead-form.spec.ts`
          переставал находить кликабельный элемент («intercepts pointer
          events»), то есть тот же дефект задел бы и часть настоящих
          пользователей (drag-select, автозаполнение по двойному клику).
          Вместо оверлея увеличен ХИТБОКС САМОГО `input` (ниже, смещение -10px
          при 24×24 квадрате-обёртке даёт 44×44) — элемент, получающий клик,
          остаётся один и тот же, Playwright и реальный указатель видят
          одно и то же. Видимый квадрат при этом рисует не сам input (его
          собственная заливка/рамка сняты), а отдельный неинтерактивный узел
          `.checkbox-box` — та же техника, что уже несёт галочка `.checkbox-mark`
          ниже, тем же состоянием `:checked` через `~`. */}
      <span class="checkbox-box" aria-hidden="true"></span>
      <svg class="checkbox-mark" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M3 8.5 6.2 11.5 13 4.5" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    {/* Документ согласия существует только по-русски — это юридический текст,
        и его перевод был бы не переводом, а вторым документом (`i18n/en.ts`,
        комментарий у `legalPolicy`). Поэтому подпись переведена, а ссылка
        помечена языком цели: `hreflang="ru"` объявляет, что за ней русский
        текст, вместо того чтобы умолчать об этом. */}
    {/* Визуально это один компактный блок, как в референсе Дениса. Юридически
        действия разделены: `label` подтверждает только отдельное согласие,
        а Политика рядом остаётся информационной ссылкой и не становится
        вторым волеизъявлением того же чекбокса. */}
    <span class="consent-copy">
      <label for="f-consent">
        {t.formConsentBefore}<a
          href="/consent"
          hreflang={locale === 'ru' ? undefined : 'ru'}
        >{t.formConsentLink}</a>{t.formConsentAfter}<span class="req" aria-hidden="true"> *</span>
      </label>{' '}
      <span class="privacy-note">
        {t.formPrivacyBefore}<a
          href="/privacy"
          hreflang={locale === 'ru' ? undefined : 'ru'}
        >{t.formPrivacyLink}</a>.
      </span>
    </span>
  </p>

  <input type="hidden" name="consent_version" value={LEGAL_VERSION} />
  <input type="hidden" name="privacy_version" value={LEGAL_VERSION} />
  <input type="hidden" name="consent_locale" value={locale} />
  <input type="hidden" name="page" value="" data-page />
  {/* Ноль означает «JavaScript выключен»: сервер тогда пропускает проверку на
       скорость заполнения. Скрипт подставляет сюда прошедшее время в момент
       отправки. Абсолютной отметки времени здесь нет намеренно — часы посетителя
       и часы сервера ничем не связаны, и на их расхождении заявка терялась бы
       молча. */}
  <input type="hidden" name="elapsed_seconds" value="0" data-elapsed />
  <input class="hp" name="website" type="text" tabindex="-1" aria-hidden="true"
         autocomplete="off" />

  <Button type="submit" variant="primary">{t.formSubmit}</Button>

  {/* Роли живой области объявляют результат незрячему, `tabindex="-1"` даёт
       перенести на него фокус. Одного показа блока мало: он появляется ниже
       кнопки, за краем экрана, и до правки не было ни прокрутки, ни объявления —
       нажатие оставалось без ответа для всех. */}
  <div class="status ok" data-form-status="success" role="status" tabindex="-1" hidden>
    <p class="t-label">{t.formOkTitle}</p>
    <p>{t.formOkText}</p>
  </div>
  <div class="status fail" data-form-status="error" role="alert" tabindex="-1" hidden>
    <p class="t-label">{t.formFailTitle}</p>
    <p>{t.formFailText}<a href={TELEGRAM_URL}>Telegram</a></p>
  </div>
</form>

<style>
  /* Отступ сверху — не украшение: без него подпись первого поля прилипает к
     заголовку страницы вплотную, у обоих `margin: 0`. */
  form { max-width: 34rem; margin-top: 32px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  /* Preflight снимает с ссылок и цвет, и подчёркивание, поэтому «Telegram» в
     сообщении об ошибке и «обработку персональных данных» в согласии выглядели
     обычным текстом. Ссылка на Telegram — единственный запасной путь заявки,
     когда бэкенд недоступен: она обязана читаться как ссылка. */
  .consent a, .status a {
    color: var(--accent);
    text-decoration-line: underline;
  }
  /* Звёздочка обязательного поля — тот же приём и тот же служебный цвет, что
     у `.req` в `Field.astro` (`--danger`, `aria-hidden`, читалке уже говорит
     «обязательное» атрибут `required`). Своё правило, а не общее с `Field`:
     стили Astro скоуплены на компонент, и `.req` соседнего файла сюда не
     достаёт. Чекбокс — четвёртое обязательное поле формы, и до этой правки
     был единственным без звёздочки среди четырёх. */
  .req { color: var(--danger); }

  /* Чекбокс здесь сосед подписи, а не её потомок, и это намеренно: внутри
     подписи стоит ссылка на страницу согласия, а вложенная в label ссылка
     одновременно переходит и переключает чекбокс. Значит общее правило
     `label:has(> input[type="checkbox"])` из base.css сюда не достаёт —
     цель нажатия набирает сама строка. */
  .consent {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    min-height: 44px;
    font-size: 1rem;
    margin-bottom: 24px;
  }
  .consent-copy { display: block; padding-block: 12px; }
  .privacy-note {
    display: inline;
  }
  .consent label { display: inline; }
  /* Квадрат опускается на середину ПЕРВОЙ строки подписи, а не прижимается к
     её верхнему краю: подпись на узком экране переносится на две строки, и при
     `align-items: center` чекбокс уехал бы в середину блока. */
  .consent .checkbox { margin-block: 12px 0; }

  /* Обёртка держит квадрат и галочку в одной координатной системе — галочка
     стоит `position: absolute` внутри неё, а не внутри `input`, потому что
     позиционировать что-либо ВНУТРИ чекбокса CSS не даёт. Размер тот же
     24×24 px, что нёс голый `input[type="checkbox"]` в `base.css` (нижняя
     граница WCAG 2.5.8 для цели без обёртки-исключения, замер дизайн-ревью
     2026-08-13, «Три акта») — обёртка ничего не укрупняет и не мельчит. */
  .checkbox {
    position: relative;
    display: inline-flex;
    width: 24px;
    height: 24px;
    flex: none;
  }
  /* `appearance: none` снимает ТОЛЬКО отрисовку — фокус, клавиатуру,
     `required` и участие в отправке формы система не теряет, чекбокс
     остаётся настоящим. Заливку и рамку теперь несёт `.checkbox-box` ниже,
     не сам `input` — задача 9 (дизайн-ревью 2026-08-22): хитбокс `input`
     увеличен до 44×44 (смещение -10px от квадрата-обёртки 24×24 —
     24 + 10×2 = 44, WCAG 2.5.8), а видимый квадрат должен остаться 24×24
     («Три акта», 2026-08-13). Раздельные узлы: растянутый бордер/заливка
     на самом `input` раздули бы видимый квадрат вместе с хитбоксом. */
  .checkbox input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    position: absolute;
    /* `top`/`left` явно, а не `inset: -10px`: у чекбокса в UA-стиле браузера
       собственная фиксированная intrinsic-ширина/высота (не `auto`), и при
       заданных СРАЗУ inset со всех четырёх сторон спецификация отбрасывает
       противоположные (`right`/`bottom`) в пользу intrinsic-размера —
       хитбокс тогда остаётся 24×24, просто сдвинутым (проверено замером
       `getBoundingClientRect()`). Явные `width`/`height` снимают
       неоднозначность целиком. */
    top: -10px;
    left: -10px;
    width: 44px;
    height: 44px;
    margin: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 1;
  }
  /* Видимый квадрат — 24×24, той же геометрии, что нёс голый
     `input[type="checkbox"]` до задачи 9. `pointer-events: none`: узел
     декоративный, клики принимает исключительно `input` (он теперь и
     физически сверху — явный `z-index`, при том что стоит первым в
     разметке ради комбинатора `~`, см. комментарий выше). */
  .checkbox-box {
    position: absolute;
    inset: 0;
    width: 24px;
    height: 24px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    pointer-events: none;
    transition: background-color var(--dur-micro) var(--ease),
                border-color var(--dur-micro) var(--ease);
  }
  .checkbox input[type="checkbox"]:checked ~ .checkbox-box {
    background: var(--accent);
    border-color: var(--accent);
  }
  /* Кольцо фокуса — тоже на `.checkbox-box`, не на самом `input`: у `input`
     теперь хитбокс 44×44, и обвод по его границе выглядел бы оторванным от
     видимого квадрата. */
  .checkbox input[type="checkbox"]:focus-visible ~ .checkbox-box {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Галочка красится тем же токеном, что несёт текст/значки НА акценте
     (`--text-on-accent`) — контраст против залитого `--accent`-квадрата
     посчитан один раз для этого токена (`tokens.css`), второй раз считать
     не нужно. */
  .checkbox-mark {
    position: absolute;
    inset: 0;
    margin: auto;
    color: var(--text-on-accent);
    pointer-events: none;
  }
  /* Галочка «рисуется» тем же приёмом, что и линия на фоне «Чертежа» —
     штрих проявляется вдоль своего пути, а не всплывает целиком. Длина
     контура у пути «M3 8.5 6.2 11.5 13 4.5» ≈14,14 (посчитано геометрией
     двух отрезков), 15 — небольшой запас, а не подгонка на глаз: при
     запасе меньше фактической длины последний миллиметр штриха обрубался
     бы, при заметно большем — старт держал бы паузу перед видимым
     движением. В покое (не отмечен) сдвиг штриха на всю его длину — галочки
     не видно ни на пиксель. */
  .checkbox-mark path {
    stroke-dasharray: 15;
    stroke-dashoffset: 15;
  }
  /* Переход — только внутри `no-preference`, тем же приёмом, что уже стоит у
     подчёркивания меню (`NavLinks.astro`) и волны смены темы
     (`ThemeToggle.astro`): при `reduce` свойство `transition` не объявляется
     вовсе, и переключение `:checked` меняет `stroke-dashoffset` СКАЧКОМ, без
     кадра анимации — отмеченное состояние становится состоянием по
     умолчанию для этого чекбокса, а не промежуточным кадром недоигравшего
     перехода. */
  @media (prefers-reduced-motion: no-preference) {
    .checkbox-mark path {
      transition: stroke-dashoffset var(--dur-reveal) var(--ease);
    }
  }
  .checkbox input[type="checkbox"]:checked ~ .checkbox-mark path {
    stroke-dashoffset: 0;
  }

  /* Результат — панель, а не абзац. Обычный текст был легче подвала, а успех,
     окрашенный в акцент, читался как ещё одна ссылка, а не как подтверждение. */
  .status {
    margin-top: 24px;
    padding: 16px;
    border: 1px solid;
    border-radius: var(--radius-md);
    /* Было 15 px — самовольный кегль, вне шкалы. Это итог формы (успех или
       отказ) — главный текст своей панели, ступень `body` (16 px), правка
       2026-08-13, свод к семи объявленным. */
    font-size: 1.125rem;
  }
  .status p { margin: 0; }
  .status .t-label { margin-bottom: 8px; }
  /* Задача 3 (дизайн-ревью 2026-08-22): скрипт переносит фокус на панель
     программно (`el.focus({ preventScroll: true })`) сразу после отправки —
     `:focus-visible` рисовал поверх и без того плотной рамки панели ещё и
     акцентное кольцо 2 px с отступом 2 px, двойной обвод, в котором цвет
     бренда доставался именно неудаче. Правка снимает кольцо ТОЛЬКО у этой
     живой области: правило скоуплено Astro на разметку `LeadForm.astro` и не
     трогает фокус нигде на сайте, включая клавиатурный обход самой формы —
     сама панель и так появляется в поле зрения (`scrollIntoView`) и
     объявляется ролью `status`/`alert`, второй сигнал ей не нужен. */
  .status:focus-visible { outline: none; }
  /* Задача 2 и 6 (дизайн-ревью 2026-08-22). Было: рамка и засечка обеих
     панелей красились ЦВЕТОМ-СМЫСЛОМ (`--accent` у успеха, `--text` у
     отказа) — из-за этого 1) засечка отказа, тот же приём, что у успеха,
     совпадала цветом с рамкой у успеха и потому не читалась вовсе, а у
     отказа читалась (сплошная белая подложка вместо тонированной даёт
     засечке контраст, которого у успеха нет — один приём, два разных
     результата), и 2) панель отказа (рамка+засечка `--text`, метка 18,17:1)
     оказывалась темнее и тяжелее самой кнопки «Отправить» (5,17:1) — ровно
     тогда, когда требуется нажать её ещё раз. Заодно панель отказа —
     почти буквальный близнец `.draft` в `Prose.astro` (та же рамка `--accent`
     + подложка `--accent-soft`, отличие на 4 px радиуса) при противоположном
     смысле «черновик»/«готово» — со своей стороны это тоже снимается, когда
     рамка успеха перестаёт быть сплошной `--accent`.
     Рамка обеих панелей теперь общий нейтральный `--border` (тот же токен,
     что у полей формы) — цвет-смысл несёт ТОЛЬКО засечка и подложка,
     этого одного места достаточно, чтобы 3 px засечки не сливались с
     рамкой ни в одной из панелей. Перекрашивать отказ в `--danger` нельзя —
     решение о втором сигнальном цвете для отказа не принято владельцем;
     после снятия веса панель по-прежнему различает успех/отказ только
     подложкой (тонированная/белая) и засечкой (`--accent`/`--text-muted`),
     а не читается как «ошибка» с первого взгляда — это тот самый
     нерешённый вопрос, а не упущение правки. */
  .ok {
    background: var(--accent-soft);
    border-color: var(--border);
    box-shadow: inset 3px 0 0 0 var(--accent);
  }
  /* Метка «Отправлено» текстом наследовала глобальный `.t-label` (`base.css`,
     цвет `--accent`) — на подложке `--accent-soft` это 4,22:1, ниже AA 4,5
     для кегля 11 px (задача 4). `--text-muted` — тот же токен, что уже даёт
     AA на подсказке под полем (`Field.astro`) — 4,76:1 на этой подложке в
     светлой теме, 5,81:1 в тёмной; заодно это и есть остаток веса, который
     различает панели без рамки-цвета: засечка + метка отказа на тон темнее
     засечки + метки успеха. Второго цвета не заводится. */
  .ok .t-label { color: var(--text-muted); }
  .fail {
    background: var(--surface);
    border-color: var(--border);
    box-shadow: inset 3px 0 0 0 var(--text-muted);
  }
  .fail .t-label { color: var(--text-muted); }
</style>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  if (form) {
    const page = form.querySelector<HTMLInputElement>('[data-page]')!;
    const elapsed = form.querySelector<HTMLInputElement>('[data-elapsed]')!;
    const ok = form.querySelector<HTMLElement>('[data-form-status="success"]')!;
    const err = form.querySelector<HTMLElement>('[data-form-status="error"]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    // Спокойное состояние кнопки запоминается УЗЛАМИ, а не строкой. Присваивание
    // `textContent` заменяет все дочерние узлы разом: сегодня в кнопке только
    // текст, и подмена строкой незаметна, но в день, когда в слот положат иконку,
    // она исчезнет после первой же отправки и обратно не вернётся — молча, без
    // ошибки. Снятые со страницы узлы остаются живыми, пока на них ссылается этот
    // массив, поэтому возвращаются ровно теми же, вместе с иконкой.
    const idleNodes = Array.from(submit.childNodes);
    const sendingLabel = form.dataset.sendingLabel ?? submit.textContent ?? '';

    // Показать результат мало: блок стоит ниже кнопки и на обычном экране не
    // помещается. Прокрутка ставит его в середину окна, фокус переносит на него
    // читалку и клавиатуру. `preventScroll` — чтобы focus() не подкрутил окно
    // по-своему и не отменил центрирование.
    const announce = (el: HTMLElement) => {
      el.hidden = false;
      el.focus({ preventScroll: true });
      el.scrollIntoView({ block: 'center' });
    };

    // Засечка берётся один раз при показе формы. Наружу уходит РАЗНОСТЬ двух
    // показаний одних и тех же часов, а не сама отметка времени: разность от
    // расхождения часов посетителя и сервера не зависит вовсе.
    let shownAt = Date.now();
    page.value = location.pathname;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      ok.hidden = true;
      err.hidden = true;

      // Между нажатием и ответом на медленной сети была полная тишина, а второе
      // нажатие уходило вторым запросом и второй заявкой.
      submit.disabled = true;
      submit.textContent = sendingLabel;

      elapsed.value = String((Date.now() - shownAt) / 1000);
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...data, elapsed_seconds: Number(elapsed.value) }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        page.value = location.pathname;
        shownAt = Date.now();
        elapsed.value = '0';
        announce(ok);
      } catch {
        announce(err);
      } finally {
        submit.disabled = false;
        submit.replaceChildren(...idleNodes);
      }
    });
  }
</script>
