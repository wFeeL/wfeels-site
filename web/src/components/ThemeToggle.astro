<button
  id="theme-toggle"
  type="button"
  aria-label="Тема оформления: системная"
  data-state="system"
>
  <span aria-hidden="true" data-icon>◐</span>
</button>

<script>
  import { THEME_COLOR } from '../lib/theme';

  const ORDER = ['system', 'light', 'dark'] as const;
  const ICON = { system: '◐', light: '☀', dark: '☾' } as const;
  const NAME = { system: 'системная', light: 'светлая', dark: 'тёмная' } as const;
  type State = (typeof ORDER)[number];

  const btn = document.getElementById('theme-toggle');
  if (btn) {
    const icon = btn.querySelector('[data-icon]')!;
    const themeColors =
      document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');

    /* Полоса браузера над страницей. В разметке лежат две записи с `media` по
       системной схеме — это ответ тому, кто ничего не выбирал. Выбор человека
       системную схему перекрывает, значит обе записи обязаны нести один и тот
       же цвет; возврат к системной теме возвращает каждой записи её
       собственный. Иначе выбравший тёмную тему на светлой системе видел бы
       тёмную страницу в светлой рамке браузера. */
    const paint = (state: State) => {
      themeColors.forEach((meta) => {
        const own = (meta.getAttribute('media') ?? '').includes('dark')
          ? THEME_COLOR.dark
          : THEME_COLOR.light;
        meta.setAttribute('content', state === 'system' ? own : THEME_COLOR[state]);
      });
    };

    const read = (): State => {
      try {
        const v = localStorage.getItem('theme');
        return v === 'light' || v === 'dark' ? v : 'system';
      } catch {
        return 'system';
      }
    };

    const apply = (state: State) => {
      if (state === 'system') {
        delete document.documentElement.dataset.theme;
      } else {
        document.documentElement.dataset.theme = state;
      }
      paint(state);
      // Видимое состояние обновляется всегда, даже если хранилище недоступно.
      btn.dataset.state = state;
      btn.setAttribute('aria-label', `Тема оформления: ${NAME[state]}`);
      icon.textContent = ICON[state];

      try {
        if (state === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', state);
      } catch {
        // Приватный режим или заблокированное хранилище: тема работает
        // до перезагрузки, выбор просто не запоминается.
      }
    };

    // Текущее состояние держим в памяти, а не перечитываем из хранилища на
    // каждый клик: при заблокированном хранилище read() всегда вернул бы
    // 'system', и кнопка ходила бы по кругу 'system' → 'light' → 'system'.
    let current: State = read();
    apply(current);

    btn.addEventListener('click', () => {
      current = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
      apply(current);
    });
  }
</script>

<style>
  #theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1;
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease),
                border-color var(--dur-micro) var(--ease);
  }
  #theme-toggle:hover {
    color: var(--text);
    border-color: var(--text-faint);
  }
</style>
