<button id="theme-toggle" type="button" aria-label="Тема оформления">
  {/* Значок рисует CSS, а не скрипт, и оба варианта лежат в разметке.
      Причина: до правки в разметке стоял третий значок «системная», и человек,
      у которого система тёмная, первым кадром видел не тот знак — а потом
      скрипт его подменял. Теперь ветка выбирается ровно теми же условиями, что
      и сама палитра в `tokens.css`, то есть до первого кадра и без скрипта. */}
  <span class="icon light" aria-hidden="true">☀</span>
  <span class="icon dark" aria-hidden="true">☾</span>
</button>

{/* Волна смены темы (владелец, дословно: «переключатель тем работает не
    резко, а волной проходит из центра страницы до правой и левой стороны»).
    Накладка кроет экран цветом УХОДЯЩЕЙ темы двумя половинами и раздвигает их
    от центра к краям — палитра под накладкой к этому моменту уже настоящая
    (новая), она просто скрыта, пока волна не отступит. Ни один канал не
    завязан на JS: цвет читает и класс ставит обработчик клика ниже, вся
    остальная работа — чистый CSS (`transform: scaleX`, без `animation:`
    рядом с `animation-timeline` тут нет — эта анимация не привязана к
    прокрутке, ловушка шортинка её не касается). `position: fixed` не зависит
    от места в разметке — накладка позиционируется от вьюпорта, а не от
    `.tools`, где физически лежит. */}
<span class="theme-wave" aria-hidden="true">
  <span class="theme-wave__half theme-wave__half--left"></span>
  <span class="theme-wave__half theme-wave__half--right"></span>
</span>

<script>
  import { THEME_COLOR } from '../lib/theme';

  const NAME = { light: 'светлая', dark: 'тёмная' } as const;
  type State = keyof typeof NAME;

  const btn = document.getElementById('theme-toggle');
  if (btn) {
    const themeColors =
      document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const wave = document.querySelector<HTMLElement>('.theme-wave');
    // Волна доигрывает и сама возвращает себя в состояние покоя: без этого
    // класс `is-active` остался бы в разметке и следующий клик, случившийся
    // раньше, чем истёк `animation-fill-mode: both`, не перезапустил бы
    // анимацию (см. `void wave.offsetWidth` ниже — там же почему).
    wave?.addEventListener('animationend', () => wave.classList.remove('is-active'));

    /** Что человек выбрал сам. `null` — не выбирал ничего. */
    const stored = (): State | null => {
      try {
        const v = localStorage.getItem('theme');
        return v === 'light' || v === 'dark' ? v : null;
      } catch {
        return null;
      }
    };

    /** Тема, которая сейчас НА ЭКРАНЕ. Читается оттуда же, откуда её берут
     *  стили: `data-theme` на документе, иначе схема системы. Спрашивать
     *  хранилище здесь нельзя — при заблокированном хранилище оно всегда
     *  отвечает «выбора нет», и кнопка ходила бы по кругу из одного шага. */
    const effective = (): State => {
      const applied = document.documentElement.dataset.theme;
      if (applied === 'light' || applied === 'dark') return applied;
      return media.matches ? 'dark' : 'light';
    };

    /* Подпись — единственное, что скрипт обязан обновлять всегда: значок
       рисуется стилями, а читалка стилей не видит. */
    const label = (state: State) => {
      btn.setAttribute('aria-label', `Тема оформления: ${NAME[state]}`);
    };

    /* Полоса браузера над страницей. В разметке лежат две записи с `media` по
       системной схеме — это ответ тому, кто ничего не выбирал, и трогать их до
       первого нажатия нельзя: иначе смена схемы в системе перестала бы
       доезжать до полосы. Выбор человека системную схему перекрывает, значит
       обе записи обязаны нести один и тот же цвет. */
    const paint = (state: State) => {
      themeColors.forEach((meta) => meta.setAttribute('content', THEME_COLOR[state]));
    };

    /* Состояний ровно два: светлая и тёмная. Третьего, «системного», у кнопки
       нет — владелец снял его осознанно. Системная настройка при этом никуда
       не делась: она остаётся НАЧАЛЬНЫМ значением для того, кто ничего не
       выбирал. Пока выбора нет, `data-theme` на документе не появляется вовсе,
       и страница продолжает следовать за системой вживую — в том числе если
       систему переключат при открытой вкладке. */
    const choice = stored();
    if (choice === null) {
      label(effective());
      // Систему могут переключить при открытой вкладке: палитра поедет за ней
      // сама, а подпись кнопки — только отсюда.
      media.addEventListener('change', () => {
        if (stored() === null) label(effective());
      });
    } else {
      // `data-theme` к этому моменту уже стоит: его ставит инлайновый скрипт в
      // <head>, до первого кадра. Присваивание здесь — не подстраховка «на
      // всякий случай», а единственная строка, которая не даст теме пропасть,
      // если разметку когда-нибудь поменяют, а этот модуль забудут.
      document.documentElement.dataset.theme = choice;
      paint(choice);
      label(choice);
    }

    btn.addEventListener('click', () => {
      const next: State = effective() === 'dark' ? 'light' : 'dark';

      // Волна кроет экран цветом ТЕКУЩЕЙ, ещё не сменившейся темы — значит
      // читать `--bg` нужно ДО присвоения `data-theme` ниже, иначе переменная
      // уже отдаст новый цвет и накладке нечего будет прятать. При
      // `prefers-reduced-motion: reduce` CSS ниже не даёт `animation-name`
      // классу `is-active` вовсе — накладка остаётся невидимой, и эти строки
      // просто ничего не рисуют.
      if (wave) {
        const outgoing = getComputedStyle(document.documentElement)
          .getPropertyValue('--bg').trim();
        wave.style.setProperty('--wave-bg', outgoing);
        // Сброс класса + принудительный reflow: повторный клик во время ещё не
        // отыгравшей волны иначе не перезапускает CSS-анимацию — браузер не
        // считает добавление уже стоящего класса изменением.
        wave.classList.remove('is-active');
        void wave.offsetWidth;
        wave.classList.add('is-active');
      }

      document.documentElement.dataset.theme = next;
      paint(next);
      // Видимое состояние обновляется всегда, даже если хранилище недоступно.
      label(next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Приватный режим или заблокированное хранилище: тема работает
        // до перезагрузки, выбор просто не запоминается. Следующее нажатие
        // всё равно попадёт куда надо: `effective()` смотрит на `data-theme`
        // через ту же ветку, что и стили.
      }
    });
  }
</script>

<style>
  #theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    /* Было 15 px — самовольный кегль, вне шкалы. Значок читается content-
       текстом того же масштаба, что и обычный контент — ступень `body`
       (16 px), правка 2026-08-13, свод к семи объявленным. */
    font-size: 1.125rem;
    line-height: 1;
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease),
                border-color var(--dur-micro) var(--ease);
  }
  #theme-toggle:hover {
    color: var(--text);
    border-color: var(--text-faint);
  }

  /* Ветки те же, что у палитры в `tokens.css`, и в том же порядке: светлая по
     умолчанию, тёмная по системе (пока человек не выбрал светлую), тёмная по
     выбору. Знак всегда показывает тему, которая сейчас на экране. */
  .icon.dark { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon.light { display: none; }
    :global(:root:not([data-theme='light'])) .icon.dark { display: inline; }
  }
  :global(:root[data-theme='dark']) .icon.light { display: none; }
  :global(:root[data-theme='dark']) .icon.dark { display: inline; }

  /* Волна смены темы. `position: fixed` — от вьюпорта, не от `.tools`, где
     физически стоит кнопка: это оверлей на весь экран, а не декорация рядом
     с переключателем. `pointer-events: none` — накладка ничего не должна
     перехватывать, даже пока анимация не доиграла. `z-index` выше шапки
     (100) — волна обязана перекрыть и её. */
  .theme-wave {
    position: fixed;
    inset: 0;
    z-index: 300;
    pointer-events: none;
  }

  /* Каждая половина в покое не кроет ничего (`scaleX(0)`) — до первого клика
     и между кликами накладка не рисует ни пикселя, значит и клипать текст
     под собой ей нечем. `background` — цвет уходящей темы кладёт клик
     (`--wave-bg`), сама переменная тут не объявлена: без клика она пуста, и
     непрозрачный слой в самый первый рендер станет прозрачным, а не чёрным. */
  .theme-wave__half {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background: var(--wave-bg, transparent);
    transform: scaleX(0);
  }
  /* Обе половины стартуют `scaleX(1)` — полностью кроют свою сторону — и
     отступают К СВОЕМУ краю (`transform-origin` у каждой на внешней стороне),
     а не от него: значит подвижная граница у обеих в начале анимации стоит у
     ЦЕНТРА экрана и уезжает к краю по мере схлопывания. Ровно то, что просил
     владелец — волна расходится из центра к обеим сторонам, а не наоборот.
     Сама подвижная граница (у левой половины — правый край, у правой —
     левый) мягкая, не бритвенный срез: последние 12% ширины гаснут
     градиентом, а не обрываются. */
  .theme-wave__half--left {
    left: 0;
    transform-origin: left center;
    background: linear-gradient(to right, var(--wave-bg, transparent) 88%, transparent 100%);
  }
  .theme-wave__half--right {
    right: 0;
    transform-origin: right center;
    background: linear-gradient(to left, var(--wave-bg, transparent) 88%, transparent 100%);
  }

  /* Анимация целиком внутри `no-preference`: при `reduce` класс `is-active`
     не получает `animation-name` вовсе, половины остаются на `scaleX(0)` из
     базового правила выше — волны нет ни на кадр, тема просто меняется
     мгновенно (страница уже перекрашена CSS-переменными до этого момента,
     накладке нечего было бы показывать всё равно). Раздельные свойства, не
     шорткод `animation:` — рядом с этим он не стоит, но правило общее для
     всего репозитория, и лучше держать привычку. */
  @media (prefers-reduced-motion: no-preference) {
    .theme-wave.is-active .theme-wave__half {
      animation-name: theme-wave-recede;
      animation-duration: var(--dur-reveal);
      animation-timing-function: var(--ease);
      animation-fill-mode: both;
    }
  }
  @keyframes theme-wave-recede {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
  }
</style>
