---
/* Метка-надпись мелким капсом — по умолчанию `<p>` (декоративная подпись
 * секции: сам заголовок рисует сосед, `Section.astro`, `h2.section-heading`).
 *
 * `as="h2"` — дефект W6, design-ревью каталога `/services`: девять плиток
 * шли `<h3>` сразу после `<h1>` без единого `<h2>` между ними — у групп
 * («Сайты», «Автоматизация и интеграции», …) не было заголовка своего
 * уровня вовсе, они были размечены только этой меткой. Проп переключает ТЕГ
 * на `<h2>`, сохраняя тот же визуальный стиль `.t-label` — владелец просил
 * заголовок группы, а не смену вида (`70-workshop/specs/site-v3/
 * 00-overview.md`: разметка следует иерархии документа независимо от
 * визуального размера). */
interface Props {
  as?: 'p' | 'h2';
}
const { as = 'p' } = Astro.props;
const Tag = as;
---
<Tag class="t-label"><slot /></Tag>
<style> p, h2 { margin: 0 0 12px; } </style>
