---
/* Фирменный знак Telegram — залитый бумажный самолётик в круге, тот самый
 * контур, что мгновенно узнаётся как значок приложения. Путь дословно взят
 * из `simple-icons` (`icons/telegram.svg`, лицензия CC0-1.0,
 * https://github.com/simple-icons/simple-icons/blob/develop/LICENSE.md) —
 * один `<path>`, `viewBox="0 0 24 24"`, вырез самолётика внутри круга держится
 * на направлении обхода контура (правило заливки `nonzero` по умолчанию,
 * `fill-rule` не нужен).
 *
 * Один компонент на весь сайт: и шапка (`Header.astro`), и карточка услуги
 * «Telegram» (`home/ServiceIcon.astro`) рисуют именно его, а не свою копию
 * пути — просьба владельца 2026-08-13, «знак должен быть един со знаком в
 * хэдере». Второй копии этой строки в репозитории нет: разошлась бы молча
 * при следующей правке одной из двух.
 *
 * Форма не перерисовывается «в линейном стиле» соседних значков раздела
 * услуг (`materialiconsoutlined`, обводка): фирменный знак площадки —
 * единственное исключение из линейного языка «Чертежа». У знака своя форма,
 * и перерисовка её в чужом стиле ломает узнаваемость — это уже случилось
 * (прежний контурный «самолётик» читался как сломанная стрелка) и вызвало
 * жалобу владельца.
 */
interface Props {
  /** Сторона квадратного значка в px. По умолчанию — размер прежнего знака
   *  шапки: тот же ряд, что `EN` и переключатель темы (оба в коробке
   *  44×44 px), знак не должен читаться крупнее или тяжелее соседей. */
  size?: number;
}
const { size = 20 } = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
>
  <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
