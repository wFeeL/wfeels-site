---
/* Первый экран посадочной услуги — спека
 * `70-workshop/specs/site-v3/08-service-pages.md`, раздел 4.1.
 *
 * Одна кнопка, ведёт к форме внизу той же страницы (`#s-zayavka`) — это
 * ЕДИНСТВЕННАЯ конверсионная цель посадочной (раздел 1). Кнопка шапки
 * (`showHeaderCta`) остаётся и ведёт на `/contact` отдельно, весом с этой не
 * спорит — оформлена мельче самим `Header.astro`.
 *
 * Цена и срок мета-строки не набраны руками: цена — `priceEntry()`
 * (`lib/priceLookup.ts`) по `heroTier`, срок — поле `term` записи. Приставка
 * «от» рисуется только когда `heroPricePrefix === 'от'` (раздел 4.1: у S2
 * цена — не голая сумма, «от» перед ней не ставится). */
import Label from '../Label.astro';
import Button from '../Button.astro';
import { priceEntry } from '../../lib/priceLookup';
import type { ServicePage } from '../../data/servicePages';

interface Props {
  page: ServicePage;
  /** Название группы услуги (`SERVICE_GROUPS[].title`), дословно. */
  groupTitle: string;
}
const { page, groupTitle } = Astro.props;

const heroPrice = priceEntry(page.heroTier.group, page.heroTier.entry).price;
---
<div class="hero" data-slug={page.slug}>
  <Label>{groupTitle}</Label>
  <h1 class="t-h1">{page.h1}</h1>
  <p class="lead t-body-lg">{page.lead}</p>
  <p class="meta">
    {page.heroPricePrefix && <span class="prefix">{page.heroPricePrefix}</span>}
    <code>{heroPrice}</code>
    <span class="sep" aria-hidden="true">·</span>
    <span>{page.term}</span>
  </p>
  <p class="audience t-small">{page.audience}</p>
  <p class="cta">
    <Button href="#s-zayavka" variant="primary">Обсудить задачу</Button>
  </p>
</div>

<style>
  .hero { max-width: 720px; }
  /* Было `max-width: 50ch` — `ch` меряется «0» ТЕКУЩЕГО активного начертания
   * (`fonts.css`, комментарий у `Onest Fallback`, тот же приём для `.caption`
   * `About.astro`). На запасном Onest 50ch давало 630 px, на настоящем —
   * ≥720 px (упиралось в `.hero`, сам `ch` реального шрифта шире падающего
   * следом системного «0»): абзац терял строку при подмене шрифта, скачок
   * высоты — ровно одна строка `t-body-lg` (35,19 px, `line-height: 1.6` ×
   * 22px), сторож `font-fallback-metrics.spec.ts`. Фиксированные 620 px не
   * зависят от того, какое начертание сейчас на экране — на глазах разница
   * с прежними 630 px фалбэка отсутствует, а перенос строк одинаков что до,
   * что после подмены шрифта (проверено на всех девяти услугах, 390/768/
   * 1440 px). Правка `fonts.css` под этот один абзац не рассматривалась —
   * калибровка там подобрана под главную и трогать её ради посадочной
   * означало бы рисковать нулевым скачком, который уже есть на главной. */
  .lead { max-width: 620px; margin: 0 0 24px; color: var(--text-muted); }

  /* `h1` S6 («Панель обращений и админка») — точечная, не общая для всех
   * девяти услуг правка (в отличие от `.lead` выше): у ЭТОГО заголовка
   * запасное начертание на кегле-плато `t-h1` (60px, ширина viewport
   * ≥1067 px) укладывает фразу в контейнер `.hero` (720px) в ДВЕ строки, а
   * настоящий Unbounded — в ТРИ (натуральная ширина без переноса — 1120,58
   * px на фолбэке против 1183,05 px на настоящем шрифте; 720×2=1440 px
   * вмещает первое число и не вмещает второе). Скачок — ровно одна строка
   * `t-h1` (66px, `line-height: 1.1` × 60px), сторож `font-fallback-
   * metrics.spec.ts`, только на широких ширинах (плато кегля начинается с
   * viewport 1067 px, снизу разрыв обеих начертаний совпадает без правки).
   *
   * Общий `max-width` на `.hero h1` здесь не годится — перебор на всех
   * девяти услугах (`.tmp`, временный скрипт калибровки, не входит в
   * комплект) показал: то же самое число, которое стабилизирует ЭТУ фразу
   * (10em — с запасом ниже натуральной ширины обоих начертаний, если делить
   * на две строки), на «ИИ-консультант по вашим материалам» (S4) СОЗДАЁТ
   * новую границу переноса на седьмой части полосы ширин (480…1920 px) —
   * там фраза длиннее и раньше не задевала эту границу вовсе. Единого
   * числа, которое одновременно стабилизирует обе фразы, без второй
   * калибровки под каждую нет — значит правка адресная, по `data-slug`
   * (проставлен на `.hero` выше), а не по тегу `h1` целиком. */
  .hero[data-slug="admin-panel"] h1 { max-width: 10em; }

  .meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 16px;
    font: 500 1rem/1.4 var(--font-mono);
    color: var(--text-muted);
  }
  .prefix { font-size: 0.6875rem; }
  .meta code {
    font: 700 1.125rem/1.3 var(--font-mono);
    color: var(--accent);
    background: none;
    padding: 0;
  }
  .sep { color: var(--text-faint); }

  .audience { margin: 0 0 32px; color: var(--text-muted); }
  .cta { margin: 0; }
</style>
