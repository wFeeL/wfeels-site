---
import { samePath } from '../lib/nav';

interface Props {
  items: { href: string; text: string }[];
  /** Пункты идут столбцом в раскрывашке, а не строкой в шапке. */
  stacked?: boolean;
}
const { items, stacked = false } = Astro.props;

/* Отметку ставит сам компонент по адресу страницы: страницам не приходится
   передавать сюда «где я», а значит и забыть это нечего. */
const here = Astro.url.pathname;
---
{items.map((i) => (
  <a
    class:list={['nav-link', { stacked }]}
    href={i.href}
    aria-current={samePath(i.href, here) ? 'page' : undefined}
  >
    {i.text}
  </a>
))}

<style>
  /* Вид ссылки описан ЗДЕСЬ, а не в шапке, и это не вкусовщина.

     Astro скоупит стили по компоненту: правило `nav a`, написанное в
     Header.astro, компилируется в селектор с атрибутом скоупа шапки на КАЖДОМ
     звене, а сам <a> рисует этот компонент и носит свой атрибут. Селектор не
     совпадал ни с чем — четыре правила молчали целиком. Замер: цвет пункта до
     и после наведения одинаковый (rgb(15,22,32)), высота пункта в мобильном
     меню 26 px при норме 44, текущая страница отличалась только атрибутом
     `aria-current`, то есть была видна читалке и не видна глазу.

     Пока <a> живёт в этом файле, его стили живут здесь же: тогда правило не
     может разойтись с разметкой молча. */
  .nav-link {
    /* Общее правило целей нажатия из base.css растит коробку до 44 px, а текст
       в блоке ложится по её верху: замер до правки — строка 24,75 px в коробке
       44 px, прижата к верхнему краю. У столбца в раскрывашке центрирование
       было, у строки в шапке — нет, поэтому пункты меню стояли выше середины
       шапки. */
    display: inline-flex;
    align-items: center;
    color: var(--text-muted);
    text-decoration: none;
    /* Было 15 px — самовольный кегль, вне шкалы. Пункт навигации второстепенен
       по отношению к содержимому страницы — ступень `small` (14 px), правка
       2026-08-13, свод к семи объявленным ([[02-redesign-options]],
       предусловие пункта 8). */
    font-size: 1.0625rem;
    transition: color var(--dur-micro) var(--ease);
  }

  /* Наведение подчёркивает так же, как отметка текущей страницы: одинаковая
     черта — одинаковый смысл «этот пункт сейчас в деле». Цвет от наведения
     тоже меняется, но одного цвета мало: он теряется и в тёмной теме, и у
     тех, кто различает не все оттенки. */
  .nav-link:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  /* Отметка текущей страницы обязана остаться отличимой от наведения, а черта
     теперь есть у обоих. Поэтому текущий пункт набран САМИМ акцентом: спека
     отводит `--accent` под «активное состояние», второго цвета это не заводит,
     а разница «синее слово с чертой» против «тёмное слово с чертой» видна на
     расстоянии. Насыщенность 600 — третий различитель, для случая, когда цвет
     не читается. Контраст акцента как текста: 5,17:1 на светлой, 5,08:1 на
     тёмной — обе выше AA.
     Правило стоит ПОСЛЕ `:hover` намеренно: специфичность у них одинаковая, и
     при обратном порядке наведение на текущий пункт гасило бы его отметку. */
  .nav-link[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  /* В раскрывашке пункты стоят столбцом, и цель нажатия набирается высотой
     строки: 44 px — нижняя граница и по WCAG 2.5.8, и по рекомендациям Apple.
     То же число заведено общим правилом в base.css, но оно достаёт до ссылок
     с классом-оформлением, а не до любой ссылки. */
  .nav-link.stacked {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
</style>
