---
import { samePath } from '../lib/nav';

interface Props {
  items: { href: string; text: string }[];
  /** Пункты идут столбцом в раскрывашке, а не строкой в шапке. */
  stacked?: boolean;
}
const { items, stacked = false } = Astro.props;

/* Отметку ставит сам компонент по адресу страницы: страницам не приходится
   передавать сюда «где я», а значит и забыть это нечего. */
const here = Astro.url.pathname;
---
{items.map((i) => (
  <a
    class:list={['nav-link', { stacked }]}
    href={i.href}
    aria-current={samePath(i.href, here) ? 'page' : undefined}
  >
    {/* Обёртка вокруг текста — не разметочный шум: `.nav-link` сам
        `display: inline-flex` (центрирует 44-пиксельную цель нажатия, см.
        комментарий ниже), а Chromium физически не рисует `text-decoration` на
        flex-контейнере — свойство остаётся в computed style («underline» там
        есть), но на экране черты нет ни пикселя. Обнаружено ЭТИМ заходом при
        попытке анимировать черту: e2e-тест ниже проверял `textDecorationLine`
        компьютед-стиля самой ссылки, а не отрисовку, и зелёный прогон об этом
        молчал — тот же класс дефекта, что уже был у этого компонента
        (комментарий про «четыре правила `nav a`» ниже). Черту красит спан —
        обычный inline-элемент, до которого flex-контекст не достаёт. */}
    <span class="nav-label">{i.text}</span>
  </a>
))}

<style>
  /* Вид ссылки описан ЗДЕСЬ, а не в шапке, и это не вкусовщина.

     Astro скоупит стили по компоненту: правило `nav a`, написанное в
     Header.astro, компилируется в селектор с атрибутом скоупа шапки на КАЖДОМ
     звене, а сам <a> рисует этот компонент и носит свой атрибут. Селектор не
     совпадал ни с чем — четыре правила молчали целиком. Замер: цвет пункта до
     и после наведения одинаковый (rgb(15,22,32)), высота пункта в мобильном
     меню 26 px при норме 44, текущая страница отличалась только атрибутом
     `aria-current`, то есть была видна читалке и не видна глазу.

     Пока <a> живёт в этом файле, его стили живут здесь же: тогда правило не
     может разойтись с разметкой молча. */
  .nav-link {
    /* Общее правило целей нажатия из base.css растит коробку до 44 px, а текст
       в блоке ложится по её верху: замер до правки — строка 24,75 px в коробке
       44 px, прижата к верхнему краю. У столбца в раскрывашке центрирование
       было, у строки в шапке — нет, поэтому пункты меню стояли выше середины
       шапки. */
    display: inline-flex;
    align-items: center;
    /* Точка отсчёта для маски-«ластика» ниже: она стоит абсолютно и мерит
       себя от коробки самой ссылки, а не от шапки. */
    position: relative;
    color: var(--text-muted);
    text-decoration: none;
    /* Было 15 px — самовольный кегль, вне шкалы. Пункт навигации второстепенен
       по отношению к содержимому страницы — ступень `small` (14 px), правка
       2026-08-13, свод к семи объявленным ([[02-redesign-options]],
       предусловие пункта 8). */
    font-size: 1rem;
    transition: color var(--dur-micro) var(--ease);
  }

  /* Наведение подчёркивает так же, как отметка текущей страницы: одинаковая
     черта — одинаковый смысл «этот пункт сейчас в деле». Цвет от наведения
     тоже меняется, но одного цвета мало: он теряется и в тёмной теме, и у
     тех, кто различает не все оттенки. `:focus-visible` — то же правило, тем
     же селектором целиком: с клавиатуры навигация не имеет права выглядеть
     беднее, чем под курсором (владелец, дословно про черту ниже: «то же
     поведение на :focus-visible»). */
  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--text);
  }

  /* Черта под пунктом меню — правка владельца 2026-08-18: в покое её нет.
     Прежнее устройство рисовало `text-decoration` ПОСТОЯННО и прятало её
     плашкой цвета подложки; плашка промахивалась мимо черты на 1–2 px, и на
     экране у всех пунктов всегда стояло синее подчёркивание. Промах был не
     случайностью: плашка отсчитывалась от коробки ССЫЛКИ высотой 44 px
     (`min-height` целей нажатия), а черта рисуется от базовой линии ТЕКСТА,
     и связи между этими двумя величинами нет никакой.

     Теперь черту рисует псевдоэлемент самой подписи — он привязан к тексту,
     а не к цели нажатия, поэтому расходиться больше нечему. В покое
     `scaleX(0)`, при наведении и фокусе `scaleX(1)`.

     `transform-origin: left center` один на оба направления — это и есть
     требование пункта 3 «убирается тем же движением, каким появилось, только
     назад»: черта прорастает слева направо, как чтение, и уходит справа
     налево тем же путём. Смена якоря между направлениями превратила бы
     реверс во вторую, другую анимацию. */
  .nav-label {
    position: relative;
  }
  .nav-label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--accent);
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left center;
  }


  @media (prefers-reduced-motion: no-preference) {
    .nav-label::after {
      /* 150–250 мс по заданию; 550ms — уже действовавшая до этой правки
         длительность той же анимации, второй константы того же смысла не
         заводим. Переход общий на оба направления: и раскрытие, и закрытие
         играют одним и тем же `transition`, поэтому они физически не могут
         разойтись по длительности или кривой. */
      transition: transform 550ms var(--ease);
    }
  }
  .nav-link:hover .nav-label::after,
  .nav-link:focus-visible .nav-label::after,
  .nav-link[aria-current='page'] .nav-label::after {
    transform: scaleX(1);
  }

  /* Отметка текущей страницы обязана остаться отличимой от наведения, а черта
     теперь есть у обоих. Поэтому текущий пункт набран САМИМ акцентом: спека
     отводит `--accent` под «активное состояние», второго цвета это не заводит,
     а разница «синее слово с чертой» против «тёмное слово с чертой» видна на
     расстоянии. Насыщенность 600 — третий различитель, для случая, когда цвет
     не читается. Контраст акцента как текста: 5,17:1 на светлой, 5,08:1 на
     тёмной — обе выше AA.
     Правило стоит ПОСЛЕ `:hover` намеренно: специфичность у них одинаковая, и
     при обратном порядке наведение на текущий пункт гасило бы его отметку. */
  .nav-link[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
  }

  /* Активная секция при прокрутке (находка 4 дизайн-ревью 2026-08-22,
     скрипт — `Header.astro`, зеркалит уже готовое решение рельса,
     `Rail.astro`). Значение атрибута — `"true"`, не `"page"`: страница не
     меняется, меняется только текущее место читателя на ней, и смешивать
     это с реальным сравнением URL (правило выше) значило бы включить
     отклонённый механизм заново (`samePath`, `lib/nav.ts`; сторож —
     `shell.spec.ts`, «в шапке нет отметки текущей страницы»).

     Оформление — скромное, из уже существующего словаря, не новый приём:
     `--text` против `--text-muted` у остальных пунктов — тот же контраст,
     что несёт `aria-current="page"` в подвале (`Footer.astro`, находка 3
     того же ревью), без акцента и без дополнительной черты. Правило стоит
     ПОСЛЕ `:hover`/`:focus-visible` по той же причине, что и правило выше:
     специфичность одинаковая, обратный порядок гасил бы отметку под
     курсором. */
  .nav-link[aria-current='true'] {
    color: var(--text);
    font-weight: 600;
  }

  /* В раскрывашке пункты стоят столбцом, и цель нажатия набирается высотой
     строки: 44 px — нижняя граница и по WCAG 2.5.8, и по рекомендациям Apple.
     То же число заведено общим правилом в base.css, но оно достаёт до ссылок
     с классом-оформлением, а не до любой ссылки. */
  .nav-link.stacked {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
</style>
