---
import Container from './Container.astro';
import TelegramMark from './TelegramMark.astro';
import { dict } from '../i18n/locales';
import { TELEGRAM_URL, emailIconLinkHtml } from '../lib/contacts';
import { samePath, sections } from '../lib/nav';
import { footerLineData } from '../lib/backgroundLine';
import { LINE_PATHS } from '../lib/linePaths';

interface Props {
  lang: 'ru' | 'en';
  /** Хвост линии на фоне (бриф `02-background-line.md`, раздел 3.1/7.2) —
   *  подвал несёт его только на странице, где линия вообще есть (сегодня —
   *  главная, `Base.astro` пробрасывает свой проп `line` сюда без правки).
   *  Без гейта подвал рисовал бы неоформленный `<svg>` на КАЖДОЙ странице:
   *  разметку и атрибуты несёт этот файл, а `stroke`/`vector-effect`/
   *  анимацию — `BackgroundLine.astro`, который подключается только при
   *  `line: true`. */
  line?: boolean;
}
const { lang, line = false } = Astro.props;
const t = dict(lang);
/* `footerLineData()` безопасно вызывать только когда `line` включён:
   функция не смотрит на `line`, но вне главной её сторона не нужна
   (страница без линии эти данные никак не использует), поэтому вызов ниже
   стоит внутри условной ветки разметки, не здесь. */
const year = 2026;

/* Разделы приходят ровно оттуда же, откуда их берёт шапка. Своего списка у
   подвала нет: два ручных перечня одних и тех же путей расходятся молча, и в
   этом репозитории так уже случалось. */
const SECTIONS = sections(lang);
const here = Astro.url.pathname;

/* Группа «Юридические документы» (`LEGAL`, заголовок `t.legal`) здесь БОЛЬШЕ
   НЕТ. Правка владельца 2026-08-21: «убираем раздел с Юридическим
   документами. заполним его позже» — из подвала уходит только НАВИГАЦИЯ.
   Сами страницы `/privacy`, `/terms`, `/consent` остаются построенными:
   ссылка на `/consent` в `LeadForm.astro` несёт обязательный чекбокс
   согласия — правовое основание обработки данных, снимать которое нельзя. */

/* Три обязательства, снимающие главный страх аудитории: «пропадёт и не
   ответит». Сами формулировки — в словаре, вместе с объяснением, почему они
   такие. */
const FACTS = [t.footerReply, t.footerCity, t.footerHours];

const tail = line ? footerLineData() : null;
const tailPath = line ? LINE_PATHS.footer : undefined;
---
<footer data-line-side={tail?.side} data-line-last={tail ? '' : undefined}>
  {tail && tailPath && (
    <svg
      class="line"
      viewBox={`0 0 1000 ${tailPath.vbH}`}
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path d={tailPath.wide} pathLength="1" />
    </svg>
  )}
  <Container>
    <div class="groups">
      <div class="brand-group">
        <p class="wordmark">wfeels</p>
        <p class="tagline">{t.footerTagline}</p>

        {/* Задача 17 (правка 2026-08-18): было кнопкой «Написать в Telegram»
            — стало парой значков (Telegram и почта), решение владельца.
            Прямой выход — по-прежнему единственное действие подвала, просто
            без подписи: обе ссылки несут доступное имя через `aria-label`
            (`t.footerTelegram`/`t.footerEmail`), а не текст внутри.

            Новую вкладку ссылка на Telegram НЕ открывает, и это разобрано, а
            не забыто. `https://t.me/…` — универсальная ссылка: на телефоне
            её перехватывает приложение Telegram, и страница в браузере
            вообще никуда не уходит; с `target="_blank"` рядом оставалась бы
            пустая вкладка. На десктопе уход честный, а возврат — одна кнопка
            «назад», с сохранением места прокрутки. Навязанное новое окно к
            тому же нарушает WCAG 3.2.5 и ломает жест «назад» на телефоне.
            Ссылка на почту (`mailto:`) новую вкладку не открывает по той же
            логике — почтовый клиент тоже перехватывает переход сам.

            `rel="me"` — заявление, что канал по ссылке принадлежит тому же
            человеку, чей это сайт (registered link type «me»); на этом
            держится проверка личности во внешних сервисах. `noopener`/
            `noreferrer` не ставятся намеренно: без `target="_blank"`
            окна-открывателя не возникает, защищать нечего, а `noreferrer`
            только спрятал бы от нас же источник перехода.

            Почтовая ссылка собрана целиком строкой (`emailIconLinkHtml`,
            `lib/contacts.ts`) и выведена через `set:html` — та же причина,
            что у `emailLinkHtml` в секции «Расскажите о задаче»
            (`home/Contact.astro`): обычная интерполяция Astro дважды
            экранировала бы числовые ссылки внутри `href` и ломала защиту
            адреса от сборщиков. */}
        <div class="icon-links">
          <a class="icon-link" href={TELEGRAM_URL} rel="me" aria-label={t.footerTelegram}>
            <TelegramMark size={20} />
          </a>
          <Fragment set:html={emailIconLinkHtml(t.footerEmail, 'icon-link')} />
        </div>

        <ul class="facts">
          {FACTS.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>

      {SECTIONS.length > 0 && (
        <nav class="group" aria-labelledby="footer-sections">
          <h2 class="group-title" id="footer-sections">{t.footerSections}</h2>
          <ul class="links">
            {SECTIONS.map((i) => (
              <li>
                <a
                  href={i.href}
                  aria-current={samePath(i.href, here) ? 'page' : undefined}
                ><span class="link-label">{i.text}</span></a>
              </li>
            ))}
          </ul>
        </nav>
      )}

    </div>

    <div class="bottom">
      <p class="ai">{t.footerAi}</p>
      <p class="year">© {year} wfeels</p>
    </div>
  </Container>
</footer>

<style>
  /* Задача 17 (правка 2026-08-18): фон подвала темнее фона страницы.
     НАХОДКА, не решение вкусом: `tokens.css` не несёт отдельного токена
     «затемнённая поверхность» — есть `--surface` (карточки, светлее `--bg` в
     обеих темах) и сама `--bg`, но темнее `--bg` в палитре ничего нет. Ниже
     — не седьмой литеральный серый (правило пользователя), а формула ИЗ уже
     объявленного `--bg`, тем же приёмом, что уже стоит в `BackgroundLine.astro`
     (`color-mix(in srgb, var(--accent) …)`).

     Процент подобран РАЗНЫМ на двух ветках не на глаз, а посчитан по WCAG
     2.1, формула 1.4.3 (та же, что в `tokens.test.ts`): ссылки подвала
     (`.links a`) набраны `--accent`, 16 px обычным текстом, порог AA 4,5:1.
     В светлой теме у акцента и так мало запаса над исходным `--bg`
     (4,78:1) — уже на 97 % смеси к чёрному запас падает до 4,49:1 (ниже
     порога), на 98 % — 4,57:1 (проходит с небольшим, но настоящим
     запасом), поэтому светлая ветка темнеет едва заметно. В тёмной теме
     `--bg` и так близок к чёрному, и запас огромный (5,43:1 у акцента на
     исходном фоне); даже при 80 % смеси к чёрному контраст акцента
     РАСТЁТ (до 5,61:1), поэтому там темнее можно позволить куда заметнее
     без риска для AA. */
  footer {
    border-top: 1px solid var(--border);
    padding-block: 48px 32px;
    color: var(--text-muted);
    font-size: 1rem;
    --footer-bg-mix: 98%;
    background: color-mix(in srgb, var(--bg) var(--footer-bg-mix), black);
    /* Хвост линии на фоне (`05-line.md`, раздел 10 шаг 2): бокс хвоста
       центрируется на ОКНЕ через `--line-canvas` (`BackgroundLine.astro`),
       не от кромок `<footer>` — общее правило одно на все боксы линии,
       собственного переопределения `<footer>` больше не несёт (раньше
       нёс, бриф `02-background-line.md`, раздел 3.5 — снято вместе со
       старой геометрией «бокс = амплитуда»). `position: relative` остаётся:
       даёт хвосту (`position: absolute; inset-block: 0`) точку отсчёта по
       ВЕРТИКАЛИ, покрывающую полную высоту подвала, включая его собственный
       `padding-block` — иначе мощение (раздел 3.5 брифа `02-background-line`)
       оставило бы дыру между концом прогона `contact` и началом хвоста. */
    position: relative;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) footer { --footer-bg-mix: 80%; }
  }
  :global(:root[data-theme='dark']) footer { --footer-bg-mix: 80%; }

  /* Столбик на телефоне; с 480 px две колонки, и бренд занимает свою строку
     целиком — иначе кнопка и три обязательства ужимаются вдвое ради двух
     коротких списков. С 900 px (та же точка, на которой разворачивается
     навигация шапки) три группы встают в ряд, и брендовой отдана бо́льшая
     доля: в ней кнопка и самая длинная строка. */
  .groups { display: grid; gap: 32px; }
  @media (min-width: 480px) {
    .groups { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 40px; }
    .brand-group { grid-column: 1 / -1; }
  }
  @media (min-width: 900px) {
    .groups {
      grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(0, 1fr));
      gap: 48px;
    }
    .brand-group { grid-column: auto; }
  }

  /* Тот же знак, что в шапке (`Header.astro`, `.brand`) — 18 px, ступень
     `body-lg`. Было 17 px, самовольный кегль вне шкалы (правка 2026-08-13,
     свод к семи объявленным, [[02-redesign-options]], предусловие пункта 8). */
  .wordmark {
    margin: 0;
    font: 800 1.375rem/1 var(--font-head);
    letter-spacing: -0.02em;
    color: var(--text);
  }
  /* Мера строки: без неё описание тянется во всю ширину колонки на десктопе. */
  .tagline { margin: 8px 0 0; max-width: 34ch; }

  /* Ряд значков вместо прежней кнопки. Тот же ящик 44×44 px и та же круглая
     рамка, что у Telegram-значка шапки (`Header.astro`, `.telegram`) —
     одинаковый вид у соседних органов управления читается как один язык
     значков, а не как две разные вёрстки одного и того же приёма. */
  .icon-links { display: flex; gap: 12px; margin: 24px 0 0; }
  /* `:global` на самом значке — не небрежность, а единственный рабочий путь.
     Почтовая ссылка выводится через `set:html` (`emailIconLinkHtml`,
     `lib/contacts.ts`), потому что обычная интерполяция сломала бы защиту
     адреса числовыми ссылками. Вставленной строке Astro НЕ проставляет
     атрибут изоляции `data-astro-cid-…`, поэтому изолированное правило
     `.icon-link` доставалось только ссылке Telegram: почтовый значок
     оставался голой строчной ссылкой без коробки 44×44, без обвода и без
     видимого фокуса. Дефект нашло e2e-ожидание цели нажатия 2026-08-18;
     сборка и юнит-тесты его не видели. Область видимости несёт родитель
     `.icon-links` — он свой атрибут получает, — а сам значок сопоставляется
     глобально. */
  .icon-links :global(.icon-link) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    transition: color var(--dur-micro) var(--ease),
                border-color var(--dur-micro) var(--ease);
  }
  .icon-links :global(.icon-link:hover),
  .icon-links :global(.icon-link:focus-visible) {
    color: var(--text);
    border-color: var(--text-faint);
  }

  /* Обязательства набраны основным цветом, а не приглушённым: это не подпись к
     кнопке, а то, ради чего человек её нажмёт. Чертёжная засечка слева заменяет
     маркер списка — список фактов остаётся текстовым и без своих значков даже
     после задачи 17 (значки появились только у прямых ссылок выше, `.icon-
     link`, а не здесь), а голый столбик строк читался бы как продолжение
     описания. */
  .facts { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 8px; }
  .facts li { position: relative; padding-left: 20px; color: var(--text); }
  /* Засечка 2 px, а не 1: строки списка стоят с шагом 31,1 px, поэтому линия в
     один пиксель попадает между пикселями экрана и размывается — на снимке
     первые две засечки синие, а третья выходила серой. Два пикселя ложатся
     ровно при любом сдвиге. */
  .facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 10px;
    height: 2px;
    background: var(--accent);
  }

  /* Заголовок группы — моно-метка «Чертежа», но основным цветом, а не акцентом:
     акцент в подвале уже занят ссылками, и одинаковый цвет у заголовка и у
     пунктов под ним стирает между ними границу. Различают их ещё и капслок с
     трекингом, и отсутствие подчёркивания. */
  .group-title {
    margin: 0 0 4px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text);
  }

  .links { list-style: none; margin: 0; padding: 0; }

  /* Preflight снимает с ссылок цвет и подчёркивание, и ссылки подвала выходили
     неотличимы от текста рядом: тот же приглушённый цвет, тот же вес, без
     подчёркивания. Оформление то же самое, что у ссылок формы и страницы
     «спасибо»: акцент. Высота 44 px — цель нажатия пальцем, `inline-flex`
     ставит строку по центру этой цели, а не по её верху.

     Подчёркивания в покое здесь больше нет — правка дизайн-ревью 2026-08-19.
     Пять ссылок группы «РАЗДЕЛЫ» — то же меню, что в шапке (`NavLinks.astro`),
     просто вынесенное вниз страницы; три юридические ссылки опознаются тем же
     способом — местом в списке, не абзацем прозы. Ссылка в списке/меню не
     нуждается в постоянной черте: её роль читается позицией, а `underline` с
     умолчательным `text-underline-offset: 2px` резал выносные элементы букв
     «Услуги», «Гарантии», «Пользовательское соглашение». Постоянное
     подчёркивание остаётся только у ссылки ВНУТРИ прозы (`.consent a` в
     `LeadForm.astro`, «обработку персональных данных») — там подчёркивание и
     есть единственный небуквенный отличитель ссылки от текста абзаца. */
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    /* Поля, а не только `min-height`. Пока высота набиралась одним минимумом,
       ссылка в одну строку получала 21 px воздуха, а ссылка в две — ноль:
       на ширинах 900…1030 px «Политика конфиденциальности» переносится, и три
       юридические ссылки слипались в шесть строк подряд, между которыми не
       было видно границы. Поля дают перенесённому пункту тот же воздух, что
       и обычному, и держат его при любой длине заголовка. */
    padding-block: 10px;
    color: var(--accent);
    text-decoration: none;
  }
  /* Черта под пунктом — тот же приём, что в шапке (`NavLinks.astro`,
     `.nav-label::after`): псевдоэлемент подписи, не `text-decoration` самой
     ссылки (та растёт до 44 px `inline-flex`-коробки, и черта, отсчитанная от
     края ЭТОЙ коробки, легла бы далеко под текстом, а не встык под ним).
     `background: currentColor` — черта наследует цвет ссылки (`--accent` в
     покое, тот же `--accent` под курсором/фокусом — цвет здесь не меняется,
     меняется только видимость черты), второй константой не задаётся. */
  .link-label {
    position: relative;
  }
  .link-label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: currentColor;
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .link-label::after {
      transition: transform var(--dur-micro) var(--ease);
    }
  }
  .links a:hover .link-label::after,
  .links a:focus-visible .link-label::after {
    transform: scaleX(1);
  }
  /* Отметка текущей страницы обязана быть видна глазу, а не только читалке.
     Различитель — насыщенность: черта теперь есть только под курсором и
     фокусом у всех ссылок одинаково, второго постоянного состояния не
     заводится. */
  .links a[aria-current='page'] { font-weight: 600; }

  /* Нижняя строка отбита чертой: строка про ИИ и копирайт относятся ко всему
     подвалу, а не к третьей группе, под которой они стоят на телефоне. */
  .bottom {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .bottom { grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: end; }
  }
  .ai { margin: 0; max-width: 62ch; }
  /* Было 12 px — самовольный кегль, вне шкалы. Год — служебная моно-пометка,
     та же роль, что у меток `label` (11 px), поэтому взял их ступень (правка
     2026-08-13, свод к семи объявленным). */
  .year { margin: 0; font-family: var(--font-mono); font-size: 0.6875rem; }
</style>
