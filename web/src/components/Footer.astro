---
import Container from './Container.astro';
import { dict } from '../i18n/locales';
interface Props { lang: 'ru' | 'en' }
const { lang } = Astro.props;
const t = dict(lang);
const year = 2026;

/* Документы русские на обеих версиях сайта, а их заголовки — на языке
   страницы. `hreflang` объявляет язык цели там, где он отличается от языка
   ссылки: англоязычный посетитель узнаёт об этом до нажатия, а не после. */
const foreign = lang === 'en';
const LEGAL = [
  { href: '/privacy', text: t.legalPolicy },
  { href: '/terms', text: t.legalTerms },
  { href: '/consent', text: t.legalConsent },
];
---
<footer>
  <Container>
    <p class="ai">
      {lang === 'ru'
        ? 'Код и часть дизайна пишу вместе с ИИ. Архитектуру, безопасность, дизайн-решения и палитру определяю сам и проверяю всё, что получается.'
        : 'I write code and part of the design together with AI. Architecture, security, design decisions and the palette are mine, and I review everything that comes out.'}
    </p>
    <nav aria-label={t.legal}>
      {LEGAL.map((l) => (
        <a href={l.href} hreflang={foreign ? 'ru' : undefined}>{l.text}</a>
      ))}
    </nav>
    <p class="year">© {year} wfeels</p>
  </Container>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding-block: 48px;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .ai { max-width: 62ch; margin: 0 0 24px; }
  nav { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-bottom: 16px; }

  /* Preflight снимает с ссылок цвет и подчёркивание, и ссылки подвала выходили
     неотличимы от текста рядом: тот же приглушённый цвет, тот же вес, без
     подчёркивания. Ровно это уже чинили в форме — правка сюда не доехала.
     Оформление то же самое, что у ссылок формы и страницы «спасибо»: акцент и
     подчёркивание. Высота — цель нажатия пальцем. */
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .year { margin: 0; font-family: var(--font-mono); font-size: 0.75rem; }
</style>
