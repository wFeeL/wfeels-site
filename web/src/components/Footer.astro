---
import Container from './Container.astro';
import Button from './Button.astro';
import TelegramMark from './TelegramMark.astro';
import { dict, type Locale } from '../i18n/locales';
import { TELEGRAM_URL, emailIconLinkHtml } from '../lib/contacts';
import { samePath, headerCtaHref } from '../lib/nav';
import { footerLineData } from '../lib/backgroundLine';
import { LINE_PATHS } from '../lib/linePaths';

interface Props {
  /** Язык подвала. Приходит из `Base.astro` — своего вывода у подвала нет. */
  lang: Locale;
  /** Хвост линии на фоне. ПРАВКА `2026-08-27` (`70-workshop/specs/site-v3/
   *  11-line-narrator-brief.md`, раздел 12.1, В-4): подвал ПЕРЕСТАВАЛ
   *  рисовать `.line`/`.line-curtain` — уход держал `contact`.
   *
   *  ПРАВКА `2026-08-27`, тем же днём, позже (`70-workshop/specs/site-v3/
   *  16-line-digits-and-finale-brief.md`, раздел 3.3, вариант Б «Разгон»,
   *  выбран владельцем): В-4 ПЕРЕОТКРЫТА. Подвал СНОВА рисует `.line`
   *  (`LINE_PATHS.footer`, `lib/linePaths.ts`) — уход переехал сюда с
   *  `contact` тем же боковым ходом (25,9%). Своей ГЛОБАЛЬНОЙ шторки
   *  (`.line-curtain`) подвал по-прежнему не несёт — она одна на всю
   *  страницу (`BackgroundLine.astro`, `position: fixed`); подвал несёт
   *  СВОЮ, МЕСТНУЮ шторку (`.line-curtain-local`) — она красит фон подвала
   *  ПОВЕРХ ещё не пройденной краски, потому что фон подвала
   *  (`footer::before`) стоит НИЖЕ краски линии (`z-index: -2` против `-1`
   *  у `.line`/`.line-curtain-local` внутри подвала — см. CSS ниже) и не
   *  может прятать её сам.
   *
   *  `data-line-side` остаётся на `<footer>` метаданными — сторона акта
   *  «выход» (раздел 7.2), которую читает `footerLineData()` и её
   *  собственный сторож (`backgroundLine.test.ts`); той же стороной
   *  рисуется `LINE_PATHS.footer` (`DOCK_LEFT` у обеих). `data-line-last`
   *  подвал не несёт — атрибут остаётся на `#contact` (`Section.astro`),
   *  он размечает конец РАССКАЗА линии (раздел 12.1 брифа `11-…`), а не
   *  конец её геометрии; подвал довершает геометрию, не рассказ. */
  line?: boolean;
  /** Полоса действия подвала (`.footer-cta`) — спека `09-footer-brief.md`,
   *  раздел 3.1. `Base.astro` вычисляет значение из адреса страницы
   *  (`showFooterCta` в `lib/nav.ts`) и пробрасывает его сюда тем же
   *  способом, что уже пробрасывает `line`; страница сама этот проп не
   *  задаёт. Проп у `Footer.astro` остаётся опциональным и служит
   *  перекрытием на случай, когда адрес и содержание страницы разойдутся
   *  намеренно — не умолчанием, которое страницы выставляют по одной. */
  cta?: boolean;
}
const { lang, line = false, cta = false } = Astro.props;
const t = dict(lang);
/* `footerLineData()` безопасно вызывать только когда `line` включён:
   функция не смотрит на `line`, но вне главной её сторона не нужна
   (страница без линии эти данные никак не использует), поэтому вызов ниже
   стоит внутри условной ветки разметки, не здесь. */
const year = 2026;

/* Юридический ряд — три ссылки, ведущие на СВОЮ языковую версию (правки от
   2026-08-21/26 сохранены без изменений). `hreflang` не нужен: он
   предупреждал именно о переходе на чужой язык, а его тут больше нет. */
const legalPrefix = lang === 'en' ? '/en' : '';
const LEGAL = [
  { href: `${legalPrefix}/privacy`, text: t.legalPolicy },
  { href: `${legalPrefix}/terms`, text: t.legalTerms },
  { href: `${legalPrefix}/consent`, text: t.legalConsent },
];

/* Обязательства «город» и «оформление сделки» объединены в одну строку
   реквизитов (спека `09-footer-brief.md`, раздел 2: «Реквизиты» этой строкой
   заменяют прежний список `.facts` с четырьмя пунктами). Слова каждого
   обязательства не изменены — только склейка через ` · `. */
const CITY_AND_CONTRACT = `${t.footerCity} · ${t.footerContract}`;
const LEGAL_EMAIL = 'i@dsaburov.ru';

/* Адрес кнопки полосы действия — задача Б-2 (2026-08-26): раньше здесь стояла
 * константа `HEADER_CTA_HREF` напрямую, без учёта языка страницы, и кнопка
 * подвала на английских страницах вела на русский `/contact`, пока соседняя
 * ссылка тела той же страницы (`/en#contact`) вела верно. `headerCtaHref` —
 * та же функция, что уже читает `Header.astro`: правило «куда ведёт кнопка
 * связи» одно на шапку и подвал, а не два похожих числа в двух файлах. */
const ctaHref = headerCtaHref(Astro.url.pathname);

const tail = line ? footerLineData() : null;
/* Путь подвала — `LINE_PATHS.footer` (`lib/linePaths.ts`, раздел 3.3 брифа
   `16-line-digits-and-finale-brief.md`). Тот же приём, что `Section.astro`:
   реестр — единственный источник геометрии, `Footer.astro` его не считает
   и не пересказывает. */
const linePath = line ? LINE_PATHS.footer : undefined;
---
<footer data-line-side={tail?.side}>
  {linePath && (
    <>
      {/* Прямой потомок `<footer>` — тот же порядок разметки, что несёт
          `Section.astro` для секций главной (`background-line-registry-
          sync.spec.ts` ищет `[data-line-side] > svg.line > path`). */}
      <svg
        class="line"
        viewBox={`0 0 1000 ${linePath.vbH}`}
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d={linePath.wide} />
      </svg>
      {/* Местная шторка подвала (раздел 3.3 брифа `16-…`) — красит
          НЕПРОШЕДШУЮ ещё краску линии тем же цветом, что несёт фон подвала
          (`footer::before`), и едет по СВОЕЙ `view()`-шторке (`entry 20% →
          100%`), синхронно с разгоном головы (см. CSS ниже). ДОЛЖНА стоять
          ПОСЛЕ `.line` в DOM: оба узла на одном `z-index: -1`, и при равном
          `z-index` порядок в DOM решает, кто красится поверх — шторка
          обязана лечь НАД ещё не открытой краской. */}
      <div class="line-curtain-local" aria-hidden="true"></div>
      {/* Мобильная нитка подвала (`.line-narrow`) СНЯТА целиком правкой
          `2026-08-30` — прямое указание владельца, вариант А: «ниже 900 px
          линии нет вовсе» (см. `BackgroundLine.astro`). */}
    </>
  )}
  <Container>
    {cta && (
      <>
        {/* Полоса действия — спека `09-footer-brief.md`, раздел 4. Решение З-2
            (раздел 15.2) понизило кнопку полосы до `variant="secondary"`:
            акцент в подвале не встречается вовсе — акцент принадлежит шапке и
            формам (D-057, ноль, а не один). Метка несёт начертание ступени
            `label` (`base.css`, `.t-label`), но НЕ её цвет: взятая как есть,
            `.t-label` красит текст в `--accent`, а в подвале акцента больше
            нет ни у одного узла (раздел 5 брифа, «ловушка ступени `label`»). */}
        <div class="footer-cta">
          <div class="cta-copy">
            <p class="cta-label">{t.footerCtaLabel}</p>
            <p class="cta-title">{t.footerCtaTitle}</p>
            <p class="cta-sub">{t.footerReplyMode}</p>
          </div>
          <div class="cta-act">
            <Button href={ctaHref} variant="secondary">{t.write}</Button>
            <div class="icon-links">
              <a class="icon-link" href={TELEGRAM_URL} rel="me" aria-label={t.footerTelegram}>
                <TelegramMark size={20} />
              </a>
              <Fragment set:html={emailIconLinkHtml(t.footerEmail, 'icon-link')} />
            </div>
          </div>
        </div>
        <hr class="footer-divider" />
      </>
    )}

    {/* Служебная полоса — на всех собранных страницах, с полосой действия или
        без неё (раздел 4 брифа). Строка режима ответа выводится здесь ровно
        тогда, когда полосы нет: иначе она повторилась бы дважды на одной
        странице (раздел 4, «строка режима ответа выводится ровно один раз»).
        Значки — здесь же, вторичным действием, там, где нет полосы (раздел 2:
        «Д-4: они перестают быть единственным действием»). */}
    <div class="footer-meta">
      {/* Решение З-4 (`09-footer-brief.md`, раздел 15.4): обёртка `.meta-top`
          ставит реквизиты и правую ячейку рядом — без неё правая ячейка не
          несла бы места и держала пустое поле справа от `.requisites`
          (мера `65ch` упирается раньше контейнера). Своей точки перелома
          нет: перенос делает содержимое (раздел 4.5), тем же приёмом уже
          живёт `.legal-row`. */}
      <div class="meta-top">
        <div class="requisites">
          <p>{t.footerLegalName}</p>
          <p>{t.footerLegalStatus}</p>
          <p>{CITY_AND_CONTRACT}</p>
          <p>
            {t.footerLegalContact}:{' '}
            <a href={`mailto:${LEGAL_EMAIL}`}>{LEGAL_EMAIL}</a>
          </p>
        </div>

        {!cta && (
          <div class="meta-aside">
            <p class="reply">{t.footerReplyMode}</p>
            <div class="icon-links">
              <a class="icon-link" href={TELEGRAM_URL} rel="me" aria-label={t.footerTelegram}>
                <TelegramMark size={20} />
              </a>
              <Fragment set:html={emailIconLinkHtml(t.footerEmail, 'icon-link')} />
            </div>
          </div>
        )}
      </div>

      {/* Доступное имя навигации несёт атрибут `aria-label`, а не спрятанный
          узел с `id` (раздел 6, пункт 5 брифа): видимой подписи у ряда больше
          нет — три ссылки называют себя сами. */}
      <nav class="legal-row" aria-label={t.legal}>
        <ul class="links">
          {LEGAL.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={samePath(item.href, Astro.url.pathname) ? 'page' : undefined}
              ><span class="link-label">{item.text}</span></a>
            </li>
          ))}
        </ul>
        {/* Знак `wfeels` в копирайте: разворот умолчания брифа (раздел 14,
            вопрос 4) — владелец 2026-08-26 ответил «знак оставляем». Точечная
            правка текста строки, без пересмотра остальной разметки Ф-Б.
            Решение З-5 (раздел 15.5): узел перестал быть годом и стал
            подписью автора — `.year` переименован в `.sign`, начертание
            снято со ступени `label` (моноширинный капслок читался как
            `WFEELS`, второй знак рядом с фирменным строчным `wfeels` шапки,
            хотя строка в DOM была верной дословно). */}
        <p class="sign">© {year} wfeels</p>
      </nav>
    </div>
  </Container>
</footer>

<style>
  /* Задача 17 (правка 2026-08-18): фон подвала темнее фона страницы.
     НАХОДКА, не решение вкусом: `tokens.css` не несёт отдельного токена
     «затемнённая поверхность» — есть `--surface` (карточки, светлее `--bg` в
     обеих темах) и сама `--bg`, но темнее `--bg` в палитре ничего нет. Ниже
     — не седьмой литеральный серый (правило пользователя), а формула ИЗ уже
     объявленного `--bg`, тем же приёмом, что уже стоит в `BackgroundLine.astro`
     (`color-mix(in srgb, var(--accent) …)`).

     Процент подобран РАЗНЫМ на двух ветках не на глаз, а посчитан по WCAG
     2.1, формула 1.4.3 (та же, что в `tokens.test.ts`): ссылки подвала
     (`.legal-row a`) набраны `--text-muted`/`--text`, а не акцентом — акцент в
     подвале несёт только кнопка полосы. В светлой теме у акцента и так мало
     запаса над исходным `--bg` (4,78:1) — уже на 97 % смеси к чёрному запас
     падает до 4,49:1 (ниже порога), на 98 % — 4,57:1 (проходит с небольшим,
     но настоящим запасом), поэтому светлая ветка темнеет едва заметно. В
     тёмной теме `--bg` и так близок к чёрному, и запас огромный (5,43:1 у
     акцента на исходном фоне); даже при 80 % смеси к чёрному контраст акцента
     РАСТЁТ (до 5,61:1), поэтому там темнее можно позволить куда заметнее без
     риска для AA. */
  footer {
    border-top: 1px solid var(--border);
    padding-block: 48px 32px;
    color: var(--text-muted);
    /* У-1 (раздел 4.0 брифа): подвал ОБЪЯВЛЯЕТ интерлиньяж, а не наследует
       его. Без этой строки `footer` берёт `body { line-height: 1.65 }`
       (`base.css:33`), и `.requisites p` реально занимает 26,4 px вместо 24 —
       все числа раздела 4 занижены на 10 %. Это ступень `small`
       (`base.css:292`) целиком, взятая полностью, а не восьмая ступень и не
       свободное значение. */
    font-size: 1rem;
    line-height: 1.5;
    --footer-bg-mix: 98%;
    /* Фон подвала — на псевдоэлементе (`footer::before`), не здесь: линия
       на фоне (`data-line-side`/`.line`, `z-index: -3`, `BackgroundLine.astro`)
       красится в общем стеке `body`, а прежний непрозрачный `background`
       прямо на `footer` красился между линией и текстом — линия обрывалась
       видимым срезом на стыке `contact → подвал` (бриф `11-line-narrator-
       brief.md`, раздел 1.3, п.1: «единственное место страницы, где линия
       видимо кончается в никуда»). `transparent` — не отсутствие фона, а
       явная отмена: без него правило ниже (`footer::before`) не давало бы
       заметной разницы только случайно, если бы кто-то не заметил, что два
       фона наложены друг на друга. */
    background: transparent;
    /* Хвост линии на фоне (`05-line.md`, раздел 10 шаг 2): бокс хвоста
       центрируется на ОКНЕ через `--line-canvas` (`BackgroundLine.astro`),
       не от кромок `<footer>` — общее правило одно на все боксы линии,
       собственного переопределения `<footer>` больше не несёт. `position:
       relative` остаётся: даёт хвосту (`position: absolute; inset-block: 0`)
       точку отсчёта по ВЕРТИКАЛИ, покрывающую полную высоту подвала, включая
       его собственный `padding-block`. `footer` НЕ несёт `z-index` —
       собственного стекового контекста не создаёт, и `footer::before` (ниже,
       `z-index: -2`) разбирается в ОБЩЕМ корневом стеке вместе с линией
       (`z-index: -3`) и сортируется по числу — если бы `footer` завёл здесь
       `z-index`, `-2` оказался бы внутри чужого локального стека и уже не
       спорил бы с `-3` снаружи. */
    position: relative;
    /* ПРАВКА `2026-08-27` (регрессия финала линии, вариант Б «Разгон»):
       местная шторка (`.line-curtain-local` ниже) на упоре `entry 100%`
       несёт `translate: 0 100%` — сдвигает СЕБЯ, коробку `inset: 0`
       ростом с сам подвал, на всю СВОЮ высоту вниз, то есть под нижнюю
       кромку `<footer>`. `translate` меняет только КРАСКУ, не разметку, но
       вносит вклад в overflow-регион подвала — а тот, не будучи обрублен
       нигде выше по дереву до самого `<html>`, доезжает до
       `document.documentElement.scrollHeight` и удлиняет её на высоту
       подвала (замер `2026-08-27`: 289px против «мёртвой полосы» 288px).

       ПРАВКА `2026-08-28` (регрессия ОТ ЭТОЙ ЖЕ строки): `overflow: hidden`
       резало излишек, но той же строкой делало `<footer>` СКРОЛЛ-
       КОНТЕЙНЕРОМ — безымянная `view()` у `.line-curtain-local` ниже стала
       считаться от скроллпорта подвала (высотой `footer.clientHeight`), а
       не от документа: шторка замерла на `playState: finished,
       currentTime: 40%` на КАЖДОЙ позиции прокрутки и перестала прикрывать
       непройденную краску — зазор ровно на шве с подвалом.

       Рассмотрены оба направления брифа `2026-08-28`, оба отвергнуты
       ИЗМЕРЕНИЕМ, не на глаз (пробник вне репозитория, Playwright,
       изолированная страница с тем же переносом коробки):
       — «снять `overflow: hidden`, обрубить `.line-curtain-local`
         СОБСТВЕННЫМ `clip-path`, как уже сделано у `footer .line` ниже» —
         `clip-path` вычисляется в ЛОКАЛЬНЫХ координатах бокса ДО
         transform, и `translate` двигает уже вырезанную форму ЦЕЛИКОМ:
         самоклип не может отрезать часть себя же, в которую сам и
         переехал. Пробник подтвердил дословно: `clip-path: inset(0)` на
         переносимом узле — тот же прирост `scrollHeight` (+300 из 300),
         что и вовсе без клипа; `clip-path` на самом `footer` — тот же
         результат. Хуже того: `clip-path` (в отличие от `overflow`) сам
         заводит новый стековый контекст (список MDN) — то самое, от чего
         предупреждает комментарий выше про `-2`/`-3`, — то есть решение
         ломало бы ИМЕННО тот инвариант, который эта правка обязана
         беречь. Отвергнуто дважды: не работает и опасно.
       — «увести `.line-curtain-local` на именованный таймлайн от
         корневого скроллера (`scroll(root block)`), как уже сделано у
         `line-finish` в `BackgroundLine.astro`» — там формула работает,
         потому что оперирует ФИКСИРОВАННОЙ константой недостижимой полосы
         (`347px`), не измеряет высоту подвала. Диапазон `entry 20% → 100%`
         этой шторки — доля от ЖИВОЙ высоты подвала (289 на одной ширине,
         до 925 с полосой действия на другой, `footer-height.spec.ts`), а
         CSS не умеет прочесть высоту чужого бокса в `calc()` без JS
         (D-024). Ноль JavaScript исключает точный перевод «entry 20%» в
         пиксели корневого скролла на каждой ширине — П-Ф-Б4 (≤4px) на
         разбросе высот подвала 289…925 не удержать константой. Отвергнуто
         по неисполнимости без JS, не по вкусу.

       ПРИНЯТО: `overflow: clip` вместо `overflow: hidden`. Тот же CSS
       Overflow Module Level 3 определяет `clip` как НЕ создающий скролл-
       контейнер (в отличие от `hidden`/`scroll`/`auto`) — ровно то
       расхождение, которого не хватало. Пробником подтверждено на той же
       изолированной странице: `overflow: clip` на родителе даёт тот же
       `scrollHeight` (без прироста), что и `overflow: hidden`, но
       `currentTime` шторки внутри повторяет узор БЕЗ overflow вовсе (20%
       что при `visible`, что при `clip`, и другое число — 40% — только
       при `hidden`) — то есть `view()` внутри снова считается от
       документа, не от подвала. Не заводит стековый контекст (в списке
       триггеров MDN `overflow` сам по себе не значится, только `overflow`
       + `z-index` при позиционировании — здесь `z-index` на `footer` нет,
       см. комментарий про `-2`/`-3`). Не клипует `.line-curtain`
       (глобальная, `position: fixed`): её содержащий блок — окно, а не
       `<footer>`, DOM-вложенности внутрь подвала у неё нет (узел стоит в
       `BackgroundLine.astro`, рядом с `<footer>`, не внутри). Путь `.line`
       подвала уже клипуется СВОИМ собственным `clip-path` (правило
       `footer .line` в `BackgroundLine.astro`) — не дублируется. */
    overflow: clip;
  }
  /* Фон подвала — ПРАВКА `2026-08-27` (`70-workshop/specs/site-v3/
     15-line-through-scale-brief.md`, раздел 2.4, новое решение): переезд с
     `z-index: -4` на `z-index: -2` — то есть ВЫШЕ линии (`-3` у `.line`/
     `.line-curtain`), не ниже. Было наоборот (`11-line-narrator-brief.md`,
     раздел 3, П1): `-4` держали НИЖЕ линии, чтобы посекционная шторка,
     раскрывающая путь ПОВЕРХ фона подвала, доходила видимой до самой нижней
     кромки страницы. Основание отпало вместе с решением В-4 (подвал линии
     не несёт вовсе) — а сквозная шторка (раздел 2 брифа `15-…`) занимает
     весь экран от `--line-head` до низа окна и на последнем экране
     прокрутки перекрывает собой область подвала: без переезда она красила
     бы светлый прямоугольник `--bg` ПОВЕРХ тёмной подложки подвала. `-2`
     выше `-3` — footer::before побеждает шторку независимо от порядка в
     DOM, и подвал остаётся видимым поверх неё. `-2` по-прежнему ниже всего
     содержимого (в корневом стеке отрицательный `z-index` красится под
     потоком), текст и ссылки подвала не задеты. Хрупкость та же, что и
     раньше: любой будущий `transform`, `filter`, `opacity < 1`, `isolation`,
     `will-change` или `contain: paint` на самом `footer` завёл бы ему
     собственный стековый контекст и увёл бы `-2` из общего — проверяет
     П-14/П-Ф3 приёмки. */
  footer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: color-mix(in srgb, var(--bg) var(--footer-bg-mix), black);
    pointer-events: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) footer { --footer-bg-mix: 80%; }
  }
  :global(:root[data-theme='dark']) footer { --footer-bg-mix: 80%; }

  /* ── Линия в подвале (раздел 3.3 брифа `16-line-digits-and-finale-
     brief.md`, вариант Б «Разгон», ВОЗВРАЩЕНА решением владельца поверх
     В-4) ──────────────────────────────────────────────────────────────
     Общее правило `.line { z-index: -3 }` (`BackgroundLine.astro`) годится
     для всех секций главной — там фон страницы плоский, между линией и
     содержимым ничего нет. В подвале есть промежуточный слой
     (`footer::before`, `z-index: -2`, комментарий выше) — линия ОБЯЗАНА
     стоять ВЫШЕ него, иначе фон подвала закрасит её собой. `-1` — тот же
     уровень, что и местная шторка ниже (порядок между ними решает DOM, не
     число). */
  footer .line { z-index: -1; }

  /* Местная шторка подвала — красит НЕПРОШЕДШУЮ ещё краску тем же цветом,
     что несёт фон подвала (единственный способ спрятать её: сам фон
     подвала лежит НИЖЕ линии, «-2» ниже «-1», а не наоборот — обратный
     порядок дал бы ползущую кромку, отвергнуто разделом 3.5 брифа, пункт
     2). Запасное состояние — снята вовсе (`display: none`), тот же приём,
     что несёт сквозная `.line-curtain` (`BackgroundLine.astro`): П-Ф-О4
     приёмки — в `reduce`/без поддержки/на печати краска подвала видна
     ЦЕЛИКОМ, шторки нет. */
  .line-curtain-local { display: none; }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      @media (min-width: 480px) {
        .line-curtain-local {
          display: block;
          position: absolute;
          inset: 0;
          z-index: -1;
          pointer-events: none;
          background: color-mix(in srgb, var(--bg) var(--footer-bg-mix), black);
          /* `entry 20% → entry 100%` — выведено из `R = 4Δ`
             (`BackgroundLine.astro`, `line-finish`), не подобрано: голова
             входит в подвал ровно тогда, когда до упора прокрутки остаётся
             `0,8 · высота подвала`, то есть на `entry 20%` местной
             `view()`-шторки ЭТОГО `<footer>` (безымянный таймлайн — раздел
             диапазон отсчитывается от коробки самого подвала, не секции).
             Приёмка — П-Ф-Б4 брифа `16-…»: расхождение «глубина головы в
             подвале» / «сдвиг местной шторки» ≤ 4px на четырёх точках
             `entry` (замерено автором брифа: ≤ 0,9px). */
          animation-name: footer-finish;
          animation-duration: 1ms;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: view();
          animation-range: entry 20% entry 100%;
        }
      }
    }
  }
  @keyframes footer-finish {
    to { translate: 0 100%; }
  }

  /* ── Полоса действия ─────────────────────────────────────────────────── */
  /* Столбиком до 900 px, дальше — грид с прижатой к низу правой ячейкой
     (раздел 4.1: «кнопка собственной высоты полосе не добавляет»). */
  .footer-cta {
    display: grid;
  }
  @media (min-width: 900px) {
    .footer-cta {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 32px;
    }
  }

  /* Ступень `label` (`base.css`, `.t-label`), но со своим цветом: см.
     комментарий в разметке выше про ловушку акцента. */
  .cta-label {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  /* Ступень `h3` (28×1.3), набрана тегом `<p>` — раздел 4: «ни одного
     заголовка в подвале», подпись не имеет права стоять в оглавлении
     страницы. */
  .cta-title {
    margin: 0 0 8px;
    font: 700 1.75rem/1.3 var(--font-head);
    letter-spacing: -0.02em;
    color: var(--text);
  }
  /* У-2 (раздел 4.0): ступень `body`, а не `small` — единственный ответ на
     страх «получится дорого» не мельчает до колофонного текста. */
  .cta-sub {
    margin: 0;
    max-width: 65ch;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .cta-act {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 24px;
  }
  @media (min-width: 480px) {
    .cta-act { flex-direction: row; align-items: center; }
  }
  @media (min-width: 900px) {
    /* На ≥900 правая ячейка — сосед левой по гриду, а не блок под ней. */
    .cta-act { margin-top: 0; }
  }
  /* Кнопка во всю ширину контейнера ниже 480 px (раздел 4.3). */
  .cta-act :global(.btn) {
    width: 100%;
    justify-content: center;
  }
  @media (min-width: 480px) {
    .cta-act :global(.btn) { width: auto; }
  }

  .footer-divider {
    margin: 24px 0;
    height: 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  /* ── Служебная полоса ────────────────────────────────────────────────── */
  /* Решение З-4 (раздел 15.4 брифа): `.footer-meta` теперь несёт РОВНО двух
     прямых потомков — `.meta-top` (реквизиты + правая ячейка) и
     `.legal-row`. Единственный `gap: 32px` между ними — та же цена, что
     раньше складывалась из `gap: 16px` контейнера и `margin-bottom: 16px`
     `.requisites` (Д-1, раздел 4.0 брифа, ошибка 2): протрузия почтовой
     ссылки на 12,5 px вниз (комментарий у `.requisites a`) требует зазора
     ≥ 16 px ПОСЛЕ вычета протрузии, 32 − 12,5 = 19,5 px даёт запас. Число
     не выросло — просто больше не расщеплено на два объявления в двух
     разных узлах. */
  /* Верхнего отступа у `.footer-meta` самого по себе нет: без полосы действия
     зазор от верхнего края подвала уже даёт `padding-top` `<footer>` (48),
     с полосой — верхний зазор в 24 несёт `margin` черты `.footer-divider`
     (раздел 4.1: 24 после полосы, 1 черта, 24 до служебной полосы). */
  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Обёртка З-4: реквизиты и правая ячейка — соседи по одному ряду, пока
     содержимое помещается (раздел 4.4/4.5 брифа, перенос делает содержимое,
     а не объявленная ширина окна). `justify-content: space-between`
     разводит их к разным краям контейнера — именно так пустое поле справа
     от `.requisites` (Д-2, раздел 15.4) занимает правая ячейка, а не остаётся
     дырой. */
  .meta-top {
    display: flex;
    flex-wrap: wrap;
    column-gap: 48px;
    row-gap: 32px;
    align-items: flex-start;
    justify-content: space-between;
  }

  /* Раздел 4.4 брифа (продолжение Д-1, комментарий у `.requisites a` ниже):
     `padding-block: 14px` растит цель нажатия последней ссылки (почта по
     договорам) вверх и вниз, не растя высоту строки — измерением найдено,
     что бокс `.requisites` заканчивается на той же координате, где кончается
     строка, а сама ссылка выступает на 12 px ниже. Зазор до следующей цели
     нажатия несёт `gap` родителя (`.footer-meta`/`.meta-top`), а не поле
     самой ссылки (14 в `padding-block` не трогать — см. комментарий у
     `.requisites a`) и не собственный `margin-bottom` здесь — расщеплённое
     на два узла число (Д-1) теперь сведено в один `gap: 32px` выше. */
  .requisites { max-width: 65ch; }
  .requisites p { margin: 0; }
  .requisites p + p { margin-top: 4px; }

  /* Правая ячейка З-4: строка режима ответа и два значка, напротив
     реквизитов. `flex: 0 1 auto` — ячейка не растягивается на свободное
     место `.meta-top`, только сжимается при нехватке ширины; `max-width:
     30ch` — та же мера, которой сама строка режима ответа ограничена в
     `.cta-sub` (там 65ch, здесь ýже: ячейка вторична и не должна
     соперничать шириной со столбцом реквизитов). */
  .meta-aside {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 0 1 auto;
    max-width: 30ch;
  }

  .reply {
    margin: 0;
  }

  /* Раздел 10, пункт 2 (Д-1): поля, а не `min-height` внутри абзаца.
     `inline-flex`-коробка участвовала в строчном ритме и добавляла строке
     лишние 44 px (`display: inline-flex; min-height: 44px` — снятое
     оформление). `display: inline` не растит строчный бокс, но
     `padding-block: 14px` растит коробку цели нажатия — оба фрагмента
     переноса получают её одинаково (`box-decoration-break: clone`).
     14, а не 12: высоту строчной коробки задаёт метрика шрифта (~21 px при
     16 px кегля), и 12 + 21 + 12 = 45 px оставляет запас в один пиксель над
     сторожем 44 px — его съедает любая смена начертания. 14 + 21 + 14 = 49 px,
     запас пять пикселей. Число вне шкалы отступов раздела 5 намеренно: это
     поправка цели нажатия, посчитанная из метрики шрифта, а не отбивка
     макета. */
  .requisites a {
    display: inline;
    padding-block: 14px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    color: var(--text-muted);
    text-decoration-line: underline;
    text-underline-offset: 2px;
  }
  .requisites a:hover,
  .requisites a:focus-visible { color: var(--text); }

  /* Ряд значков вторичного действия — тот же ящик 44×44 px, что у Telegram-
     значка шапки (`Header.astro`, `.telegram`). Класс один и тот же в обоих
     положениях (в `.cta-act` и здесь): область видимости для
     `:global(.icon-link)` несёт именно родитель `.icon-links`, и второе имя
     сломало бы почтовый значок, собираемый через `set:html` (комментарий у
     разметки выше). */
  .icon-links { display: flex; gap: 12px; margin: 0; }
  /* Решение З-6 (раздел 15.6 брифа): контраст обводки к фону подвала был
     1,33/1,45 (светлая/тёмная, `--border`) при пороге интерфейсных границ
     3:1 — значок с невидимой обводкой не значок, а иконка в воздухе. Замена
     на `--text-muted` в покое даёт 5,15/7,19, на `--text` в наведении и
     фокусе — 16,06/14,74 (WCAG 2.1 1.4.3, тот же расчёт, что `tokens.test.ts`,
     фон подвала — `#EFF1F4`/`#0B101A`): обе строки проходят с запасом, и
     наведение остаётся контрастнее покоя (прежнее правило на `--text-faint`
     делало наоборот — глушило обводку под курсором). */
  .icon-links :global(.icon-link) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--text-muted);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    transition: color var(--dur-micro) var(--ease),
                border-color var(--dur-micro) var(--ease);
  }
  .icon-links :global(.icon-link:hover),
  .icon-links :global(.icon-link:focus-visible) {
    color: var(--text);
    border-color: var(--text);
  }

  /* То же правило обводки — на secondary-кнопку полосы действия (З-2 понизил
     её с primary): обведённая кнопка с невидимой обводкой хуже залитой.
     Правило объявлено ЛОКАЛЬНО здесь, а не в `Button.astro`: у secondary-
     кнопок вне подвала другой фон страницы и другой расчёт контраста. */
  .cta-act :global(.btn.secondary) {
    border-color: var(--text-muted);
  }
  .cta-act :global(.btn.secondary:hover),
  .cta-act :global(.btn.secondary:focus-visible) {
    border-color: var(--text);
  }

  /* Юридический ряд: столбиком по 44 px до 900 px (раздел 4.5 — своя точка
     перелома не заводится, действует уже объявленная), в ряд — с 900 px.
     `flex-wrap`/`row-gap` — запас на случай, если у другого начертания
     подписи станут шире (раздел 4.5, «798 px против контейнера 820, запас
     22 px»): ряд переносится по 44 px, а не разъезжается.
     Решение З-5 (раздел 15.5): `row-gap: 24px` вместо 8 — одно объявление
     закрывает обе ситуации, где подпись оказывается своей строкой (столбик
     ниже 900 px и полоса переноса 900…~950 px): медиазапрос ниже больше не
     переопределяет `row-gap`, значение наследуется отсюда каскадом. */
  .legal-row {
    display: flex;
    flex-direction: column;
    row-gap: 24px;
  }
  @media (min-width: 900px) {
    .legal-row {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      column-gap: 24px;
    }
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 900px) {
    .links { flex-direction: row; flex-wrap: wrap; column-gap: 12px; row-gap: 8px; }
  }

  /* Правка дизайн-ревью 2026-08-22 (находка 3): подвал и шапка несут ссылки
     на одном языке — `--text-muted` в покое, `--text` под курсором/фокусом,
     переход только по `color` на токене `--dur-micro`, тем же тремя
     строками, что и `.nav-link` в шапке. Акцент подвала занят кнопкой
     полосы, второго и третьего акцента (заголовок группы, ссылки) быть не
     должно (раздел 5 брифа). */
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    /* Поля, а не только `min-height`: ссылка в одну строку и перенесённая в
       две получают одинаковый воздух (находка 2026-08-19). */
    padding-block: 10px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease);
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--text);
  }
  /* Черта под пунктом — тот же приём, что в шапке (`NavLinks.astro`,
     `.nav-label::after`): псевдоэлемент подписи, не `text-decoration` самой
     ссылки. `background: currentColor` — черта наследует цвет ссылки. */
  .link-label {
    position: relative;
  }
  .link-label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: currentColor;
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .link-label::after {
      transition: transform var(--dur-micro) var(--ease);
    }
  }
  .links a:hover .link-label::after,
  .links a:focus-visible .link-label::after {
    transform: scaleX(1);
  }
  /* Отметка текущей страницы обязана быть видна глазу, а не только читалке.
     Правило стоит ПОСЛЕ `:hover`/`:focus-visible` намеренно: специфичность у
     атрибутного и псевдоклассового селектора одинаковая, и при обратном
     порядке наведение на текущий пункт гасило бы его отметку. */
  .links a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
  }

  /* Подпись автора, не служебная моно-пометка (решение З-5, раздел 15.5):
     узел набирал `© 2026 wfeels` ступенью `label` — моноширинный капслок с
     трекингом .16em — и на экране читался как «WFEELS», второй знак рядом
     с фирменным строчным `wfeels` шапки, хотя строка в DOM была верной
     дословно. Ступень `small` в `--font-head` (`Unbounded Variable`, вес
     берётся из уже загруженного диапазона 200–900, новый файл не
     появляется), без трекинга и капслока. */
  .sign {
    margin: 0;
    font: 800 1rem/1.5 var(--font-head);
    letter-spacing: normal;
    text-transform: none;
    color: var(--text-muted);
  }
</style>
