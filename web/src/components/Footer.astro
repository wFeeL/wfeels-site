---
import Container from './Container.astro';
import Button from './Button.astro';
import TelegramMark from './TelegramMark.astro';
import { dict, type Locale } from '../i18n/locales';
import { TELEGRAM_URL, emailIconLinkHtml } from '../lib/contacts';
import { samePath, headerCtaHref } from '../lib/nav';
import { footerLineData } from '../lib/backgroundLine';
import { LINE_PATHS } from '../lib/linePaths';

interface Props {
  /** Язык подвала. Приходит из `Base.astro` — своего вывода у подвала нет. */
  lang: Locale;
  /** Хвост линии на фоне (бриф `02-background-line.md`, раздел 3.1/7.2) —
   *  подвал несёт его только на странице, где линия вообще есть (сегодня —
   *  главная, `Base.astro` пробрасывает свой проп `line` сюда без правки).
   *  Без гейта подвал рисовал бы неоформленный `<svg>` на КАЖДОЙ странице:
   *  разметку и атрибуты несёт этот файл, а `stroke`/`vector-effect`/
   *  анимацию — `BackgroundLine.astro`, который подключается только при
   *  `line: true`. */
  line?: boolean;
  /** Полоса действия подвала (`.footer-cta`) — спека `09-footer-brief.md`,
   *  раздел 3.1. `Base.astro` вычисляет значение из адреса страницы
   *  (`showFooterCta` в `lib/nav.ts`) и пробрасывает его сюда тем же
   *  способом, что уже пробрасывает `line`; страница сама этот проп не
   *  задаёт. Проп у `Footer.astro` остаётся опциональным и служит
   *  перекрытием на случай, когда адрес и содержание страницы разойдутся
   *  намеренно — не умолчанием, которое страницы выставляют по одной. */
  cta?: boolean;
}
const { lang, line = false, cta = false } = Astro.props;
const t = dict(lang);
/* `footerLineData()` безопасно вызывать только когда `line` включён:
   функция не смотрит на `line`, но вне главной её сторона не нужна
   (страница без линии эти данные никак не использует), поэтому вызов ниже
   стоит внутри условной ветки разметки, не здесь. */
const year = 2026;

/* Юридический ряд — три ссылки, ведущие на СВОЮ языковую версию (правки от
   2026-08-21/26 сохранены без изменений). `hreflang` не нужен: он
   предупреждал именно о переходе на чужой язык, а его тут больше нет. */
const legalPrefix = lang === 'en' ? '/en' : '';
const LEGAL = [
  { href: `${legalPrefix}/privacy`, text: t.legalPolicy },
  { href: `${legalPrefix}/terms`, text: t.legalTerms },
  { href: `${legalPrefix}/consent`, text: t.legalConsent },
];

/* Обязательства «город» и «оформление сделки» объединены в одну строку
   реквизитов (спека `09-footer-brief.md`, раздел 2: «Реквизиты» этой строкой
   заменяют прежний список `.facts` с четырьмя пунктами). Слова каждого
   обязательства не изменены — только склейка через ` · `. */
const CITY_AND_CONTRACT = `${t.footerCity} · ${t.footerContract}`;
const LEGAL_EMAIL = 'i@dsaburov.ru';

/* Адрес кнопки полосы действия — задача Б-2 (2026-08-26): раньше здесь стояла
 * константа `HEADER_CTA_HREF` напрямую, без учёта языка страницы, и кнопка
 * подвала на английских страницах вела на русский `/contact`, пока соседняя
 * ссылка тела той же страницы (`/en#contact`) вела верно. `headerCtaHref` —
 * та же функция, что уже читает `Header.astro`: правило «куда ведёт кнопка
 * связи» одно на шапку и подвал, а не два похожих числа в двух файлах. */
const ctaHref = headerCtaHref(Astro.url.pathname);

const tail = line ? footerLineData() : null;
const tailPath = line ? LINE_PATHS.footer : undefined;
---
<footer data-line-side={tail?.side} data-line-last={tail ? '' : undefined}>
  {tail && tailPath && (
    <>
      <svg
        class="line"
        viewBox={`0 0 1000 ${tailPath.vbH}`}
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d={tailPath.wide} />
      </svg>
      {/* Шторка — та же механика, что в `Section.astro` (D-080, задача
          «пролагивает при листании»); подробности — `BackgroundLine.astro`. */}
      <div
        class="line-curtain"
        style={`--line-overhang-pct:${tailPath.overhangPercent}%`}
        aria-hidden="true"
      ></div>
    </>
  )}
  <Container>
    {cta && (
      <>
        {/* Полоса действия — спека `09-footer-brief.md`, раздел 4. Решение З-2
            (раздел 15.2) понизило кнопку полосы до `variant="secondary"`:
            акцент в подвале не встречается вовсе — акцент принадлежит шапке и
            формам (D-057, ноль, а не один). Метка несёт начертание ступени
            `label` (`base.css`, `.t-label`), но НЕ её цвет: взятая как есть,
            `.t-label` красит текст в `--accent`, а в подвале акцента больше
            нет ни у одного узла (раздел 5 брифа, «ловушка ступени `label`»). */}
        <div class="footer-cta">
          <div class="cta-copy">
            <p class="cta-label">{t.footerCtaLabel}</p>
            <p class="cta-title">{t.footerCtaTitle}</p>
            <p class="cta-sub">{t.footerReplyMode}</p>
          </div>
          <div class="cta-act">
            <Button href={ctaHref} variant="secondary">{t.write}</Button>
            <div class="icon-links">
              <a class="icon-link" href={TELEGRAM_URL} rel="me" aria-label={t.footerTelegram}>
                <TelegramMark size={20} />
              </a>
              <Fragment set:html={emailIconLinkHtml(t.footerEmail, 'icon-link')} />
            </div>
          </div>
        </div>
        <hr class="footer-divider" />
      </>
    )}

    {/* Служебная полоса — на всех собранных страницах, с полосой действия или
        без неё (раздел 4 брифа). Строка режима ответа выводится здесь ровно
        тогда, когда полосы нет: иначе она повторилась бы дважды на одной
        странице (раздел 4, «строка режима ответа выводится ровно один раз»).
        Значки — здесь же, вторичным действием, там, где нет полосы (раздел 2:
        «Д-4: они перестают быть единственным действием»). */}
    <div class="footer-meta">
      {!cta && <p class="reply">{t.footerReplyMode}</p>}

      <div class="requisites">
        <p>{t.footerLegalName}</p>
        <p>{t.footerLegalStatus}</p>
        <p>{CITY_AND_CONTRACT}</p>
        <p>
          {t.footerLegalContact}:{' '}
          <a href={`mailto:${LEGAL_EMAIL}`}>{LEGAL_EMAIL}</a>
        </p>
      </div>

      {!cta && (
        <div class="icon-links">
          <a class="icon-link" href={TELEGRAM_URL} rel="me" aria-label={t.footerTelegram}>
            <TelegramMark size={20} />
          </a>
          <Fragment set:html={emailIconLinkHtml(t.footerEmail, 'icon-link')} />
        </div>
      )}

      {/* Доступное имя навигации несёт атрибут `aria-label`, а не спрятанный
          узел с `id` (раздел 6, пункт 5 брифа): видимой подписи у ряда больше
          нет — три ссылки называют себя сами. */}
      <nav class="legal-row" aria-label={t.legal}>
        <ul class="links">
          {LEGAL.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={samePath(item.href, Astro.url.pathname) ? 'page' : undefined}
              ><span class="link-label">{item.text}</span></a>
            </li>
          ))}
        </ul>
        {/* Знак `wfeels` в копирайте: разворот умолчания брифа (раздел 14,
            вопрос 4) — владелец 2026-08-26 ответил «знак оставляем». Точечная
            правка текста строки, без пересмотра остальной разметки Ф-Б. */}
        <p class="year">© {year} wfeels</p>
      </nav>
    </div>
  </Container>
</footer>

<style>
  /* Задача 17 (правка 2026-08-18): фон подвала темнее фона страницы.
     НАХОДКА, не решение вкусом: `tokens.css` не несёт отдельного токена
     «затемнённая поверхность» — есть `--surface` (карточки, светлее `--bg` в
     обеих темах) и сама `--bg`, но темнее `--bg` в палитре ничего нет. Ниже
     — не седьмой литеральный серый (правило пользователя), а формула ИЗ уже
     объявленного `--bg`, тем же приёмом, что уже стоит в `BackgroundLine.astro`
     (`color-mix(in srgb, var(--accent) …)`).

     Процент подобран РАЗНЫМ на двух ветках не на глаз, а посчитан по WCAG
     2.1, формула 1.4.3 (та же, что в `tokens.test.ts`): ссылки подвала
     (`.legal-row a`) набраны `--text-muted`/`--text`, а не акцентом — акцент в
     подвале несёт только кнопка полосы. В светлой теме у акцента и так мало
     запаса над исходным `--bg` (4,78:1) — уже на 97 % смеси к чёрному запас
     падает до 4,49:1 (ниже порога), на 98 % — 4,57:1 (проходит с небольшим,
     но настоящим запасом), поэтому светлая ветка темнеет едва заметно. В
     тёмной теме `--bg` и так близок к чёрному, и запас огромный (5,43:1 у
     акцента на исходном фоне); даже при 80 % смеси к чёрному контраст акцента
     РАСТЁТ (до 5,61:1), поэтому там темнее можно позволить куда заметнее без
     риска для AA. */
  footer {
    border-top: 1px solid var(--border);
    padding-block: 48px 32px;
    color: var(--text-muted);
    /* У-1 (раздел 4.0 брифа): подвал ОБЪЯВЛЯЕТ интерлиньяж, а не наследует
       его. Без этой строки `footer` берёт `body { line-height: 1.65 }`
       (`base.css:33`), и `.requisites p` реально занимает 26,4 px вместо 24 —
       все числа раздела 4 занижены на 10 %. Это ступень `small`
       (`base.css:292`) целиком, взятая полностью, а не восьмая ступень и не
       свободное значение. */
    font-size: 1rem;
    line-height: 1.5;
    --footer-bg-mix: 98%;
    background: color-mix(in srgb, var(--bg) var(--footer-bg-mix), black);
    /* Хвост линии на фоне (`05-line.md`, раздел 10 шаг 2): бокс хвоста
       центрируется на ОКНЕ через `--line-canvas` (`BackgroundLine.astro`),
       не от кромок `<footer>` — общее правило одно на все боксы линии,
       собственного переопределения `<footer>` больше не несёт. `position:
       relative` остаётся: даёт хвосту (`position: absolute; inset-block: 0`)
       точку отсчёта по ВЕРТИКАЛИ, покрывающую полную высоту подвала, включая
       его собственный `padding-block`. */
    position: relative;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) footer { --footer-bg-mix: 80%; }
  }
  :global(:root[data-theme='dark']) footer { --footer-bg-mix: 80%; }

  /* ── Полоса действия ─────────────────────────────────────────────────── */
  /* Столбиком до 900 px, дальше — грид с прижатой к низу правой ячейкой
     (раздел 4.1: «кнопка собственной высоты полосе не добавляет»). */
  .footer-cta {
    display: grid;
  }
  @media (min-width: 900px) {
    .footer-cta {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 32px;
    }
  }

  /* Ступень `label` (`base.css`, `.t-label`), но со своим цветом: см.
     комментарий в разметке выше про ловушку акцента. */
  .cta-label {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  /* Ступень `h3` (28×1.3), набрана тегом `<p>` — раздел 4: «ни одного
     заголовка в подвале», подпись не имеет права стоять в оглавлении
     страницы. */
  .cta-title {
    margin: 0 0 8px;
    font: 700 1.75rem/1.3 var(--font-head);
    letter-spacing: -0.02em;
    color: var(--text);
  }
  /* У-2 (раздел 4.0): ступень `body`, а не `small` — единственный ответ на
     страх «получится дорого» не мельчает до колофонного текста. */
  .cta-sub {
    margin: 0;
    max-width: 65ch;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .cta-act {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 24px;
  }
  @media (min-width: 480px) {
    .cta-act { flex-direction: row; align-items: center; }
  }
  @media (min-width: 900px) {
    /* На ≥900 правая ячейка — сосед левой по гриду, а не блок под ней. */
    .cta-act { margin-top: 0; }
  }
  /* Кнопка во всю ширину контейнера ниже 480 px (раздел 4.3). */
  .cta-act :global(.btn) {
    width: 100%;
    justify-content: center;
  }
  @media (min-width: 480px) {
    .cta-act :global(.btn) { width: auto; }
  }

  .footer-divider {
    margin: 24px 0;
    height: 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  /* ── Служебная полоса ────────────────────────────────────────────────── */
  /* `gap: 16px` на прямых потомках даёт РОВНО те зазоры, которые требует
     раздел 4.4 («оба шестнадцатипиксельных зазора обязательны»): между
     `p.reply` и `.requisites`, между `.requisites` и `.icon-links` (когда
     полосы нет) и между тем, что выше, и `.legal-row` — единое число во всех
     трёх местах, поэтому единственное правило `gap` покрывает их разом, а не
     три отдельных `margin-top`. */
  /* Верхнего отступа у `.footer-meta` самого по себе нет: без полосы действия
     зазор от верхнего края подвала уже даёт `padding-top` `<footer>` (48),
     с полосой — верхний зазор в 24 несёт `margin` черты `.footer-divider`
     (раздел 4.1: 24 после полосы, 1 черта, 24 до служебной полосы). */
  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .reply {
    margin: 0;
    max-width: 65ch;
  }

  /* Раздел 4.4 брифа (продолжение Д-1, комментарий у `.requisites a` ниже):
     `padding-block: 14px` растит цель нажатия последней ссылки (почта по
     договорам) вверх и вниз, не растя высоту строки — `gap: 16px` у
     `.footer-meta` считает зазор от «сухой» строки и не видит протрузии.
     Измерено (`boundingBox()`, 390/768/1440): бокс `.requisites`
     заканчивается на той же координате, где кончается строка, а сама
     ссылка выступает на 12 px ниже — зазор до следующей цели нажатия
     (`.icon-links`/`.legal-row`) садится с номинальных 16 до 4 px. Чинится
     здесь, а не в поле ссылки (14 в `padding-block` не трогать — см.
     комментарий у `.requisites a`): `margin-bottom` добавляется К `gap`
     контейнера (flex не схлопывает свой `gap` с чужим `margin`), 16 — то же
     число шкалы отступов раздела 5, что и сам `gap`, даёт зазор 4 + 16 =
     20 px, с запасом над требуемыми ≥16. */
  .requisites { max-width: 65ch; margin-bottom: 16px; }
  .requisites p { margin: 0; }
  .requisites p + p { margin-top: 4px; }
  /* Раздел 10, пункт 2 (Д-1): поля, а не `min-height` внутри абзаца.
     `inline-flex`-коробка участвовала в строчном ритме и добавляла строке
     лишние 44 px (`display: inline-flex; min-height: 44px` — снятое
     оформление). `display: inline` не растит строчный бокс, но
     `padding-block: 14px` растит коробку цели нажатия — оба фрагмента
     переноса получают её одинаково (`box-decoration-break: clone`).
     14, а не 12: высоту строчной коробки задаёт метрика шрифта (~21 px при
     16 px кегля), и 12 + 21 + 12 = 45 px оставляет запас в один пиксель над
     сторожем 44 px — его съедает любая смена начертания. 14 + 21 + 14 = 49 px,
     запас пять пикселей. Число вне шкалы отступов раздела 5 намеренно: это
     поправка цели нажатия, посчитанная из метрики шрифта, а не отбивка
     макета. */
  .requisites a {
    display: inline;
    padding-block: 14px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    color: var(--text-muted);
    text-decoration-line: underline;
    text-underline-offset: 2px;
  }
  .requisites a:hover,
  .requisites a:focus-visible { color: var(--text); }

  /* Ряд значков вторичного действия — тот же ящик 44×44 px, что у Telegram-
     значка шапки (`Header.astro`, `.telegram`). Класс один и тот же в обоих
     положениях (в `.cta-act` и здесь): область видимости для
     `:global(.icon-link)` несёт именно родитель `.icon-links`, и второе имя
     сломало бы почтовый значок, собираемый через `set:html` (комментарий у
     разметки выше). */
  .icon-links { display: flex; gap: 12px; margin: 0; }
  .icon-links :global(.icon-link) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    transition: color var(--dur-micro) var(--ease),
                border-color var(--dur-micro) var(--ease);
  }
  .icon-links :global(.icon-link:hover),
  .icon-links :global(.icon-link:focus-visible) {
    color: var(--text);
    border-color: var(--text-faint);
  }

  /* Юридический ряд: столбиком по 44 px до 900 px (раздел 4.5 — своя точка
     перелома не заводится, действует уже объявленная), в ряд — с 900 px.
     `flex-wrap`/`row-gap` — запас на случай, если у другого начертания
     подписи станут шире (раздел 4.5, «798 px против контейнера 820, запас
     22 px»): ряд переносится по 44 px, а не разъезжается. */
  .legal-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  @media (min-width: 900px) {
    .legal-row {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      row-gap: 8px;
      column-gap: 24px;
    }
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 900px) {
    .links { flex-direction: row; flex-wrap: wrap; column-gap: 12px; row-gap: 8px; }
  }

  /* Правка дизайн-ревью 2026-08-22 (находка 3): подвал и шапка несут ссылки
     на одном языке — `--text-muted` в покое, `--text` под курсором/фокусом,
     переход только по `color` на токене `--dur-micro`, тем же тремя
     строками, что и `.nav-link` в шапке. Акцент подвала занят кнопкой
     полосы, второго и третьего акцента (заголовок группы, ссылки) быть не
     должно (раздел 5 брифа). */
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    /* Поля, а не только `min-height`: ссылка в одну строку и перенесённая в
       две получают одинаковый воздух (находка 2026-08-19). */
    padding-block: 10px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease);
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--text);
  }
  /* Черта под пунктом — тот же приём, что в шапке (`NavLinks.astro`,
     `.nav-label::after`): псевдоэлемент подписи, не `text-decoration` самой
