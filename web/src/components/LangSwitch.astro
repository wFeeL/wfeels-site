---
/* Переключатель языка страницы. Возвращён 2026-08-22 вместе с английской
 * главной; снят был правкой владельца 2026-08-21 (D-078) ровно потому, что
 * переключать было не на что.
 *
 * Честность переключателя — не украшение, а требование спеки
 * (`70-workshop/specs/site-v3/01-foundation.md`, раздел 7): молча вести на
 * 404 запрещено. Поэтому цель считает `altLocaleUrl`, а не разметка: если у
 * страницы нет пары на другом языке (`BILINGUAL_PATHS`), ссылка ведёт на
 * главную того языка и `title` говорит об этом прямо.
 *
 * Подпись — код ЦЕЛЕВОГО языка («EN» на русской странице), а не текущего:
 * кнопка называет, куда она ведёт, а не где читатель стоит. Атрибуты `lang`
 * и `hreflang` объявляют язык цели — без них скринридер прочтёт «EN» русскими
 * правилами чтения.
 *
 * Подсказка — наоборот, на языке ТЕКУЩЕЙ страницы: её читает тот, кто сейчас
 * здесь (разбор — у пары ключей в `i18n/ru.ts`).
 *
 * `aria-label` дублирует подсказку и добавлен 2026-08-22 по дизайн-ревью:
 * до него единственным доступным именем органа были две буквы «RU», а всё
 * остальное висело на `title` — атрибуте, который скринридеры отдают
 * ненадёжно, а на телефоне не показывают вовсе. Две буквы без пояснения не
 * говорят незрячему, что это переключатель языка.
 */
import { altLocaleUrl, dict, hasTranslation, localeFromPath } from '../i18n/locales';

const path = Astro.url.pathname.replace(/(.)\/$/, '$1') || '/';
const current = localeFromPath(path);
const target = current === 'ru' ? 'en' : 'ru';
const t = dict(current);
const href = altLocaleUrl(path, target);
const missing = !hasTranslation(path);
const label = missing ? t.langSwitchNoPage : t.langSwitch;
---
<a
  class="lang"
  href={href}
  hreflang={target}
  lang={target}
  title={label}
  aria-label={label}
>
  {/* Сама подпись — вне доступного имени: `aria-label` выше её перекрывает,
      и две буквы не читаются вслух второй раз. Для глаз они остаются. */}
  <span aria-hidden="true">{target.toUpperCase()}</span>
</a>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
    padding: 0 12px;
    font: 500 0.6875rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease),
                border-color var(--dur-micro) var(--ease);
  }
  .lang:hover { color: var(--text); }
</style>
