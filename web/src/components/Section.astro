---
import { lineDataFor } from '../lib/backgroundLine';
import { LINE_PATHS } from '../lib/linePaths';
import Label from './Label.astro';

interface Props {
  id?: string;
  label?: string;
  /** Заголовок секции (`<h2 class="t-h2">`), рисуется здесь, а не в самой
   *  секции — правило владельца 2026-08-18 (пункт 11 захода 03-redesign):
   *  заголовок секции всегда СНАРУЖИ панели `.surface`, панель несёт только
   *  содержимое. До этой правки три секции (`pain`, `process`, `faq`) рисовали
   *  свои `<Label>`+`<h2>` сами, внутри собственного тела — тело было ЖЕ
   *  секцией с классом `.surface`, поэтому заголовок оказывался внутри
   *  подложки. Теперь заголовок — забота `Section.astro` (через `label` и
   *  `heading`), а `.surface` оборачивает только `<slot />`; секции без
   *  `surface` эти пропы не используют и продолжают рисовать свой заголовок
   *  сами, как раньше (правило действует только там, где есть панель). */
  heading?: string;
  /** Верхний зазор до секции — ОДИН на все стыки главной (правка владельца
   *  2026-08-20). `undefined` — старое симметричное поведение 48/64/96,
   *  которым по-прежнему живут страницы вне главной. `'wide'` — следующая
   *  ступень шкалы отступов на каждой точке перелома (64/96/128): владелец
   *  выбрал настольные 128 px и потребовал одинакового зазора на всех стыках.
   *
   *  Двух значений здесь больше нет. До этой правки их было два — `'stitch'`
   *  (128) на стыке «актов» и `'interior'` (96) внутри акта, и деление на
   *  акты выводила функция `isActStitch`; правка владельца отменила само
   *  различие («мне нравится размер отступов между „Как обычно бывает“ и
   *  „Что я делаю“» — то есть бывший стык), поэтому вместе с ним снята и
   *  функция, и её тесты: две ветки с разными именами и одинаковым числом
   *  читались бы как работающее различие.
   *
   *  Секции сами отдают весь зазор своему верху: `bottomGap` ниже гасится в
   *  ноль, чтобы число не складывалось с соседом и не превращалось в 256 px,
   *  которых в решении нет. */
  topGap?: 'wide';
  /** Нижний зазор. `undefined` — старое симметричное поведение. `'none'` —
   *  секция ничего не добавляет снизу, весь зазор до следующей секции несёт
   *  её собственный `topGap`. */
  bottomGap?: 'none';
  /** Подложка `--surface` вместо прозрачного фона — акты читаются
   *  поверхностью, а не только воздухом между ними (правка владельца
   *  2026-08-13). Секции, где уже стоят карточки на `--surface`
   *  (услуги/цены/кейсы/гарантии), этот проп не получают — карточка
   *  растворилась бы в подложке того же цвета.
   *
   *  Оборачивает только `<slot />` — правкой 2026-08-18 (пункт 11) панель
   *  перестала быть самой секцией: заголовок (`label`/`heading` выше) стоит
   *  над `.panel`, не внутри неё. `.panel` — та же замкнутая поверхность, что
   *  и раньше (поля, обвод, скругление, приём карточек и тизера фабрики),
   *  просто теперь это отдельный узел разметки, а не сама секция. */
  surface?: boolean;
  /** Последняя секция, реально несущая линию (раздел 12.1 брифа
   *  `11-line-narrator-brief.md`, В-4) — `contact` на главной, подвал линию
   *  не рисует. ПРАВКА `2026-08-27` (`70-workshop/specs/site-v3/
   *  15-line-through-scale-brief.md`, раздел 2.3): CSS-правило, читавшее
   *  этот атрибут (`[data-line-last] .line-curtain{animation-range:cover 0%
   *  contain 0%}`), СНЯТО вместе с посекционными окнами раскрытия — сквозной
   *  шторке понятие «последней секции» не нужно вовсе (раздел 2.1: «событий
   *  «стык секций» не существует»). Атрибут `data-line-last` остаётся в
   *  разметке как метаданные (маркер «эта секция — конец рассказа линии»,
   *  читаемый структурными сторожами, `selected-deco.spec.ts`), но CSS
   *  больше его не потребляет. */
  lineLast?: boolean;
}
const { id, label, heading, topGap, bottomGap, surface = false, lineLast = false } = Astro.props;

/* Линия на фоне — бриф `70-workshop/specs/site-v3/05-line.md`, раздел 10
 * шаг 6 («Подключить реестр путей к странице») поверх раздела 7.1 (коробка
 * и разметка). `lineDataFor` даёт только МЕТАДАННЫЕ Ч-4 (сторона/переход,
 * атрибуты `data-line-side`/`data-line-turn`) и возвращает `null` для
 * любого `id`, которого нет в `lib/sections.ts` (контакт-страница, 404,
 * согласие, английская — все страницы вне главной, которые тоже собираются
 * этим компонентом). Сам ПУТЬ (`d`, `viewBox`) читается напрямую из
 * `LINE_PATHS` (`lib/linePaths.ts`) — единственного источника геометрии;
 * `backgroundLine.ts` её больше не считает (раздел 10 шаг 6: «Реестр —
 * единственный источник геометрии; вторых функций порождения не остаётся»).
 *
 * Элемента `.line-turn` больше нет (раздел 7.1 брифа: «траверс — часть
 * пути секции, отдельного бокса ему не нужно»): один `<svg class="line">`
 * на секцию, во всю её высоту, несёт ОДИН нарисованный путь — прогон,
 * траверс и событие (там, где они есть) уже слиты в один `d` реестра.
 *
 * `<svg>` — инлайновый в DOM (раздел 3.1 брифа `02-background-line`: «без
 * элемента в DOM нет линии — она не рисуется, а проявляется»). `viewBox` —
 * `0 0 1000 vbH`, `vbH` в единицах, не пикселях (раздел 4.1 брифа `05-line`,
 * `LINE_PATHS[id].vbH`). `preserveAspectRatio` пишется здесь же, в
 * разметке (геометрия SVG), а `stroke`, `stroke-width` — оформление, в
 * `BackgroundLine.astro`; `vector-effect` там не ставится вовсе (раздел 7.2
 * брифа `05-line`, раздел 1.1 — он и ломал чернила при старой механике).
 *
 * ПРАВКА 2026-08-21 (D-080, «пролагивает при листании»): путь больше не
 * несёт `pathLength`/`stroke-dasharray`/`stroke-dashoffset` — он рисуется
 * ЦЕЛИКОМ и статически.
 *
 * ПРАВКА `2026-08-27` (`70-workshop/specs/site-v3/15-line-through-scale-
 * brief.md`, раздел 2): поштучная `<div class="line-curtain">` этой секции
 * СНЯТА — раскрытие несёт ОДНА сквозная шторка на всю страницу
 * (`BackgroundLine.astro`, `position: fixed`), а не одиннадцать поштучных.
 * Секция рисует только сам путь (`<svg class="line">`), она больше не несёт
 * узла раскрытия вовсе. */
const line = lineDataFor(id);
const linePath = id ? LINE_PATHS[id] : undefined;
---
<section
  id={id}
  data-top-gap={topGap}
  data-bottom-gap={bottomGap}
  data-line-side={line?.side}
  data-line-turn={line?.turn}
  data-line-last={lineLast ? '' : undefined}
>
  {linePath && (
    <>
      <svg
        class="line"
        viewBox={`0 0 1000 ${linePath.vbH}`}
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d={linePath.wide} />
        {/* Ветвь (раздел 3 П4 брифа `11-line-narrator-brief.md`, решение
            D-125) — второй путь В ТОЙ ЖЕ коробке, раскрывается той же
            шторкой выше (шторка кроет содержимое коробки целиком, второй
            путь дорисовывается синхронно, второй механики не заводится).
            Видимость от 900 px — правило в `BackgroundLine.astro`. */}
        {linePath.branch && <path class="line-branch" d={linePath.branch} />}
        {/* Клин первого экрана (раздел 12.4 брифа `11-line-narrator-brief.
            md`) — третий путь В ТОЙ ЖЕ коробке, той же природы, что и
            `branch` выше: статическая заливка (не обводка), раскрывается
            той же шторкой, второй анимации не заводится. Заполнено только у
            `hero`. Рисуется ПОСЛЕ обводки, чтобы клин лежал НАД её штрихом
            (перекрытие, не стыковка встык, — раздел 12.4: «зазора нет
            нигде по построению»). */}
        {linePath.head && <path class="line-head" d={linePath.head} />}
      </svg>
    </>
  )}
  {label && <Label>{label}</Label>}
  {heading && <h2 class="t-h2 section-heading">{heading}</h2>}
  {surface ? <div class="panel"><slot /></div> : <slot />}
</section>

<style>
  /* `flow-root` — не косметика: без своего блочного форматирующего контекста
     нижний внешний отступ последнего потомка (какой бы компонент им ни
     оказался — список, грид карточек, абзац) схлопывается СКВОЗЬ секцию с
     `padding-bottom: 0` и утекает в зазор до следующей секции. Так семь
     секций с формально одинаковым «весь зазор несёт верх соседа» на деле
     давали семь разных чисел (замер дизайн-ревью 2026-08-13, часть 1) —
     каждая добавляла зазору маржин своего собственного последнего элемента,
     которую здесь никто не назначал и не видел. `flow-root` держит эту
     маржу ВНУТРИ рамки секции (секция становится на её высоту выше, а не
     соседний зазор — на столько же больше), и `padding-bottom: 0` наконец
     означает буквально ноль, а не «ноль плюс что найдётся». */
  section { padding-block: 48px; display: flow-root; }
  @media (min-width: 480px) { section { padding-block: 64px; } }
  @media (min-width: 900px) { section { padding-block: 96px; } }

  /* Зазор между секциями главной — та же тройка точек перелома, что и у
     умолчания выше, сдвинутая на одну ступень шкалы отступов (4·8·12·16·24·
     32·48·64·96·128): 64 ниже 480, 96 от 480, 128 от 900. Одно правило на
     ВСЕ стыки главной — второго числа, которое пришлось бы кому-то выдать,
     здесь больше нет. */
  section[data-top-gap="wide"] { padding-top: 64px; }
  @media (min-width: 480px) { section[data-top-gap="wide"] { padding-top: 96px; } }
  @media (min-width: 900px) { section[data-top-gap="wide"] { padding-top: 128px; } }

  section[data-bottom-gap="none"] { padding-bottom: 0; }

  /* Подложка акта — правкой 2026-08-18 (пункт 11) больше не сама секция:
     `.panel` — отдельный узел, обёрнутый вокруг `<slot />` в разметке выше,
     заголовок (`.t-label`/`.section-heading`) стоит ПЕРЕД ним, вне подложки.
     `.panel` уже вложена в `Container` (главная собирает секции внутри
     него), поэтому подложка встаёт вровень с содержимым, не во всю ширину
     вьюпорта; это тот же приём, что у карточек и панели тизера фабрики
     (`--surface` как замкнутая поверхность, не полноширинная плашка).

     Решение «полем внутри, не во всю ширину окна» (ревью 2026-08-13,
     часть 1): полноширинная плашка потребовала бы вырываться из `Container`
     (`margin-inline: calc(50% - 50vw)`) — приёма, которого сегодня на
     странице нет НИГДЕ. Приём «замкнутая панель» уже есть и уже объяснён —
     тот же самый, что у карточек и у панели тизера фабрики
     (`FactoryTeaser.astro`: поля 24/32, обвод, скругление).

     Поле теперь одно число на все четыре стороны панели (24/32), не только
     по бокам: пока подложкой была вся секция, верх и низ несла собственная
     `padding-block` секции (48/64/96/128, общая для заголовка И тела), а
     между заголовком и панелью не было отдельного внутреннего поля вовсе —
     заголовок и тело делили одну подложку. Теперь заголовок снаружи, и без
     верхнего/нижнего поля панели текст первой и последней строки тела лёг
     бы вплотную к её обводу (тот самый дефект «нижнее поле 0», уже однажды
     найденный ревью 2026-08-13 для двух секций из трёх — `bottomGap="none"`
     у `pain`/`process` гасил нижний зазор секции в ноль, и подложке нечем
     было отбить текст снизу). Единое поле на весь периметр панели закрывает
     это для всех трёх секций разом, включая `faq`, которая тогда обходилась
     без отдельного поля — второго случайного числа не вводится, оба поля
     панели (мобильное 24, настольное 32) уже есть в шкале и уже были в
     параметре `padding-inline` до этой правки. */
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
  }
  @media (min-width: 900px) { .panel { padding: 32px; } }

  /* Заголовок в общем ритме страницы (правило пункта 11): отбивка до панели
     — те же 32px, которыми заголовок отбивается от тела содержимого во ВСЕХ
     остальных секциях главной (`Guarantees.astro`, было и здесь до правки) —
     переезд заголовка наружу этот интервал не меняет, только переносит его
     с «до тела» на «до панели». */
  .section-heading { margin: 0 0 32px; }

  /* Липкая шапка (`Header.astro`) не должна закрывать цель якоря при плавной
     прокрутке (правки владельца 2026-08-13, задача 1). Числа — измеренная
     высота шапки на тех же трёх точках перелома, что и остальная вёрстка
     (`tokens.css`), плюс запас ~20 px: 125 px на <480 px (шапка переносится в
     два ряда), 110 px на 480–899 px (строка «Меню» в потоке), 65 px от
     900 px (одна строка, раскрывашки нет). Измерено `getBoundingClientRect()`
     в браузере на этих же трёх ширинах. */
  section { scroll-margin-top: 150px; }
  @media (min-width: 480px) { section { scroll-margin-top: 132px; } }
  @media (min-width: 900px) { section { scroll-margin-top: 90px; } }
</style>
