---
import { railPoints } from '../lib/rail';

/* Семь точек — из lib/rail.ts, которая строит их из lib/sections.ts. Второго
   перечня секций/точек здесь нет (план, задача 4, «Никаких вторых списков»). */
const points = railPoints();
---
{/* Рельс живёт вне <main> в разметке (Base.astro кладёт его после <Footer>),
    чтобы фиксированное позиционирование не выдавало его как визуально первый
    элемент: клавиатурный фокус идёт skip-link → шапка → main → подвал →
    рельс. Рельс не перехватывает фокус раньше содержимого страницы, хотя
    визуально висит поверх него. */}
<nav class="rail" aria-label="Разделы страницы" data-rail>
  <ol>
    {points.map((p) => (
      <li>
        <button
          type="button"
          class="point"
          data-target={p.targetId}
          data-sections={p.sectionIds.join(',')}
          aria-label={p.label}
        >
          <span class="label" aria-hidden="true">{p.label}</span>
          <span class="dot" aria-hidden="true"></span>
        </button>
      </li>
    ))}
  </ol>
</nav>

<style>
  /* Точка перелома — владелец 2026-08-13 («Рельс: кружки, подпись только у
     активной точки, как было в v2. Ширина с 200 до ~50 px, порог появления с
     1600 до ~1220»), `70-workshop/specs/site-v3/02-redesign-options.md`,
     раздел «Принято владельцем», пункт 10. Число ниже — не выбрано, а
     посчитано по той же формуле, что и прежний порог 1600 px (см. историю
     файла), с новой шириной рельса вместо старой:

       viewport = контейнер + 2×(отступ рельса + ширина рельса)
                = 1180      + 2×(24              + 48)
                = 1180      + 144
                = 1324

     Формула НЕ вычитает 2×паддинг контейнера, хотя более ранняя редакция
     этого комментария заявляла обратное: проверено фактическим расчётом
     прежних чисел (1060 контейнер → 1204 порог: 1060+144=1204 без вычитания
     паддинга; с вычитанием 80 px вышло бы 1124) и подтверждено полным
     прогоном `rail.spec.ts` (32/32, включая блок «не пересекает панель» на
     самой точке перелома) — ревью 2026-08-13, часть 3 задания. Панель
     контента упирается в правый паддинг контейнера (40 px от 900 px), а не в
     его полную ширину, поэтому рельсу с отступом от края экрана достаточно
     компенсировать только эти 40 px с одной стороны — вторые 40 px с другой
     стороны страницы формула компенсирует зеркально через `2×(24+48)`.

     Пересчитано 2026-08-13 после возврата контейнера 1060 → 1180 px (решение
     владельца по замеру: узкий контейнер давал вдвое больше переносов,
     «Корпоративный сайт» не помещался в строку карточки цены): порог
     поднялся 1204 → 1324.

     Отступ рельса от края экрана (`right: 24px` ниже) не менялся. Формула
     выведена из того, что и контейнер (`box-sizing: border-box`), и рельс —
     блоки с фиксированной шириной, центрированные/прижатые к краю независимо
     друг от друга: панель контента касается рельса ровно на этой ширине
     экрана, подтверждено измерением `getBoundingClientRect()` в браузере
     (`rail.spec.ts`, блок «не пересекает панель»). Ниже точки перелома рельс
     не рисуется вовсе (не только прячется визуально): `display: none` снимает
     его и из таб-порядка, а замену — полосу прогресса — рисует
     ReadingProgress рядом (Header.astro, проп `rail`). */
  .rail {
    display: none;
    position: fixed;
    top: 50%;
    right: 24px;
    transform: translateY(-50%);
    width: var(--rail);
    z-index: 40;
  }
  @media (min-width: 1324px) {
    .rail { display: block; }
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  /* `button` уже получает 44×44 px из общего правила целей нажатия
     (base.css) — здесь только раскладка содержимого внутри цели. Подпись
     стоит ПЕРЕД точкой в разметке (а не после), хотя на экране точка правее:
     `justify-content: flex-end` пакует содержимое к правому краю кнопки, и
     точка — последний узел в потоке — остаётся у самого края независимо от
     того, показана ли подпись. Это и есть причина, по которой точка не
     «гуляет» между активным и неактивным состоянием (см. `.label` ниже):
     будь порядок обратным, разворачивание подписи сдвигало бы саму точку. */
  .point {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding-inline: 8px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
  }

  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--text-faint);
    background: transparent;
    transition: background-color var(--dur-micro) var(--ease),
                border-color var(--dur-micro) var(--ease),
                transform var(--dur-micro) var(--ease);
  }

  /* Правка владельца 2026-08-13 (см. комментарий у точки перелома выше):
     подпись видна только у активной точки, остальные — просто кружки, как
     было в v2. `max-width` вместо `width`/`display`: ноль в закрытом
     состоянии не увеличивает содержимое кнопки (посадочное место рельса —
     `--rail`, 48 px — не расширяется, кнопка просто заметно уже 48 px и
     выравнена по правому краю через `align-items: flex-end` у `ol`), а
     переход к раскрытому состоянию анимируется тем же свойством, что и
     закрытие — не обрывается на середине при быстрой смене активной точки.
     У самой подписи есть фон и рамка (токены полей формы, `Field.astro`):
     разворачиваясь, она может лечь на поля страницы под рельсом, и текст без
     подложки на этой ширине читался бы поверх чужого текста, а не рядом с
     ним. `96px` — набранная ширина самой длинной подписи (`ПРОЦЕСС` /
     `ОБО МНЕ` / `КОНТАКТ`, ≈58,5 px при 11 px/JetBrains Mono/трекинге
     0.16em) плюс горизонтальные поля подложки (16 px) и запас на разницу
     рендеринга шрифта между браузерами — лишний запас справа не виден:
     подложки без текста не видно, `overflow: hidden` рисует только то, что
     реально влезло. `prefers-reduced-motion: reduce` гасит переход глобально
     (`base.css`, `transition-duration: 0.01ms`) — точка переключается сразу,
     без отдельного правила здесь. */
  .label {
    flex: none;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font: 500 0.6875rem/1 var(--font-mono);
    letter-spacing: .16em;
    text-transform: uppercase;
    text-align: right;
    color: var(--text);
    background: var(--surface);
    /* Ширина рамки, а не только цвет, идёт в переход: с `box-sizing:
       border-box` (base.css) `max-width: 0` не может сжать сам бордюр —
       браузер не ужимает заданную толщину линии ниже её пикселей, и
       неактивная подпись оставалась бы видна двухпиксельной чертой (по
       1 px с каждой стороны) даже с нулевым `max-width`. `border-width: 0`
       в состоянии покоя убирает и её. */
    border: 1px solid var(--border);
    border-width: 0;
    border-radius: var(--radius-sm);
    padding-block: 6px;
    padding-inline: 0;
    opacity: 0;
    transition: max-width var(--dur-reveal) var(--ease),
                opacity var(--dur-micro) var(--ease),
                padding-inline var(--dur-reveal) var(--ease),
                border-width var(--dur-reveal) var(--ease);
  }

  /* Подпись раскрывается у активной точки — и у той, на которую наведён
     курсор или пришёл фокус с клавиатуры (владелец 2026-08-13): из кружков
     без подписей не видно, куда можно перейти, а рельс — это навигация, а не
     украшение. Наведение показывает ЦЕЛЬ, активная точка показывает МЕСТО;
     правило одно, потому что раскрытие — одно и то же движение. */
  .point.active .label,
  .point:hover .label,
  .point:focus-visible .label {
    max-width: 96px;
    opacity: 1;
    padding-inline: 8px;
    border-width: 1px;
  }

  .point:hover .dot,
  .point:focus-visible .dot {
    border-color: var(--accent);
  }

  /* Подсветка перетекает, а не прыгает (владелец 2026-08-13): все три
     свойства ниже уже несут `transition` (см. `.dot` выше), переключение
     `.active` только меняет их конечное значение — то же правило CSS
     отвечает и за плавность, и за её отключение при уменьшенном движении. */
  .point.active .dot {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.25);
  }
</style>

<script>
  /* Скроллспай без IntersectionObserver-порогов: активная точка — та, чья
     ближайшая (по порядку страницы) секция уже пересекла линию отсчёта.
     Линия стоит не у верхней границы окна, а на трети его высоты вниз от
     неё (полировка перед приёмкой, находка 1). Прежнее правило («секция
     ушла за верхнюю границу окна целиком») формально работало, но
     расходилось с глазом: заголовок следующей секции уже стоял крупно
     в верхней части экрана, читатель уже был уверен, что перешёл в новый
     раздел, а рельс ещё подсвечивал предыдущую точку, потому что верх
     секции ещё не долетел до самой верхней кромки. Линия на трети высоты
     окна примерно совпадает с той точкой прокрутки, на которой заголовок
     раздела заходит в верхнюю треть экрана и читатель считает, что уже в
     нём, — а не с моментом, когда предыдущая секция физически покидает
     кадр. Треть, а не половина: при половине линия уходит в середину
     экрана, где обычно лежит контент раздела, и переключение опережало бы
     заголовок ещё сильнее, только в другую сторону. Приём работает
     одинаково надёжно и на длинной секции с настоящим текстом, и на
     короткой (секция 4, пока заголовок-заглушка). Список точек читается
     из уже отрисованной разметки (`data-target`, `data-sections`) —
     второй раз `lib/sections.ts` в клиентский бандл не идёт, чтобы не
     тащить исходники всех секций в JS ради семи строк.

     `prefers-reduced-motion: reduce` выключает анимацию клика: скролл
     мгновенный, а не плавный (план, задача 4). */
  const nav = document.querySelector<HTMLElement>('nav.rail[data-rail]');
  const buttons = nav
    ? Array.from(nav.querySelectorAll<HTMLButtonElement>('button.point'))
    : [];

  if (nav && buttons.length > 0) {
    const sectionToButton = new Map<string, HTMLButtonElement>();
    for (const btn of buttons) {
      for (const id of (btn.dataset.sections ?? '').split(',').filter(Boolean)) {
        sectionToButton.set(id, btn);
      }
    }

    const sections = Array.from(sectionToButton.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null)
      // `data-sections` перечисляет якоря в порядке страницы (Map держит
      // порядок вставки), так что пересортировка не нужна — но проверяем
      // явно, а не полагаемся молча на порядок Map.
      .sort((a, b) => a.offsetTop - b.offsetTop);

    const setActive = (id: string | null) => {
      const active = id ? sectionToButton.get(id) ?? null : null;
      for (const btn of buttons) {
        const isActive = btn === active;
        btn.classList.toggle('active', isActive);
        if (isActive) btn.setAttribute('aria-current', 'true');
        else btn.removeAttribute('aria-current');
      }
    };

    // Прокрутка достигла низа страницы: браузер не может подвинуть окно
    // дальше, даже если верх последней секции ещё не долетел до линии
    // отсчёта (короткая последняя секция плюс подвал под ней — обычное
    // дело). Без этой поправки последняя точка рельса не подсвечивалась бы
    // вовсе, пока секция не станет достаточно длинной, чтобы дотянуть верх
    // страницы до своего начала.
    const atBottom = () =>
      window.scrollY + window.innerHeight >=
      document.documentElement.scrollHeight - 2;

    // Линия отсчёта — треть высоты окна вниз от его верха (см. комментарий
    // выше). Секция становится «текущей», как только её верх пересёк эту
    // линию, и остаётся ей, пока верх следующей секции не пересечёт её
    // тоже: точка активна, пока раздел занимает верхнюю треть экрана, а не
    // только пока секция целиком в кадре.
    const ACTIVATION_LINE_RATIO = 1 / 3;

    const currentSectionId = (): string | null => {
      if (atBottom()) return sections[sections.length - 1]?.id ?? null;
      const line = window.scrollY + window.innerHeight * ACTIVATION_LINE_RATIO;
      let current: HTMLElement | null = null;
      for (const el of sections) {
        if (el.offsetTop <= line + 1) current = el;
        else break;
      }
      return (current ?? sections[0])?.id ?? null;
    };

    let ticking = false;
    const update = () => {
      setActive(currentSectionId());
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();

    const reduceMotion =
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        const target = document.getElementById(btn.dataset.target ?? '');
        if (!target) return;
        target.scrollIntoView({
          behavior: reduceMotion ? 'auto' : 'smooth',
          block: 'start',
        });
      });
    }
  }
</script>
