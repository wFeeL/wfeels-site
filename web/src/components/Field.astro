---
interface Props {
  name: string;
  label: string;
  type?: string;
  required?: boolean;
  textarea?: boolean;
  /** Поле — выпадающий список: разметку `<option>`/`<optgroup>` несёт слот,
   *  сам `Field` знает только про рамку, подпись и обязательность. Источник
   *  вариантов — вызывающий компонент (задача 18: `LeadForm.astro` читает
   *  каталог услуг из `data/services.ts`, второго списка здесь не заводится). */
  select?: boolean;
  hint?: string;
  /** Текст-подсказка внутри поля. У `select` браузер `placeholder` не знает —
   *  туда его не передают; первым вариантом там стоит выключенный `<option>`
   *  с тем же смыслом (собирает вызывающий компонент). */
  placeholder?: string;
  /** Значение атрибута `autocomplete`. На телефоне это разница между одним
   *  касанием и ручным вводом ровно там, где заявку и бросают. */
  autocomplete?: string;
}
const {
  name, label, type = 'text', required = false, textarea = false, select = false,
  hint, placeholder, autocomplete,
} = Astro.props;
const id = `f-${name}`;
---
<p class="field">
  <label for={id}>{label}{required && <span class="req" aria-hidden="true"> *</span>}</label>
  {textarea
    ? <textarea id={id} name={name} required={required} rows="5"
                placeholder={placeholder} autocomplete={autocomplete}></textarea>
    : select
    ? <select id={id} name={name} required={required}><slot /></select>
    : <input id={id} name={name} type={type} required={required}
             placeholder={placeholder} autocomplete={autocomplete} />}
  {hint && <small>{hint}</small>}
</p>

<style>
  .field { display: flex; flex-direction: column; gap: 6px; margin: 0 0 20px; }
  label { font-size: 1rem; color: var(--text-muted); }
  /* Звёздочка обязательного поля. `--danger` — служебный цвет состояния, а не
     второй акцент бренда: тем же цветом будут показаны ошибки полей. Смысл на
     цвете не держится — сама звёздочка видна и без него, а поле обязательно по
     атрибуту `required`, который читает и браузер, и читалка. Поэтому у
     звёздочки `aria-hidden`: озвучивать «звёздочка» поверх «обязательное поле»
     значит сказать одно и то же дважды. */
  .req { color: var(--danger); }
  input, textarea, select {
    font: 400 1.125rem/1.5 var(--font-text);
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    width: 100%;
    transition: border-color var(--dur-micro) var(--ease);
  }
  select { min-height: 44px; cursor: pointer; }
  /* Поле обязано отвечать на наведение и на фокус, иначе форма ощущается
     нарисованной картинкой. Рамка — единственное, что здесь меняется:
     заливка и размер прыгали бы на глазах. */
  input:hover, textarea:hover, select:hover { border-color: var(--text-muted); }
  /* Состояние ошибки — задача 8 (дизайн-ревью 2026-08-22): `:invalid` голым
     красил бы пустое обязательное поле с первого кадра, до всякого касания —
     этого делать нельзя. `:user-invalid` матчит ТОЛЬКО после того, как поле
     потеряло фокус с негодным значением или после попытки отправки формы —
     то есть ровно тогда, когда подсветка уместна. Правило стоит ДО `:focus`
     намеренно: пока поле в фокусе (человек ещё правит значение), рамка
     остаётся акцентной; `--danger` — служебный токен ошибки, тот же, что уже
     красит звёздочку обязательности (`.req` выше), второго цвета не
     заводится. */
  input:user-invalid, textarea:user-invalid, select:user-invalid { border-color: var(--danger); }
  input:focus, textarea:focus, select:focus { border-color: var(--accent); }
  textarea {
    resize: vertical;
    /* `rows="5"` резервирует контент высотой 5 строк (line-height 1,5 × кегль
       поля 18 px = 27 px, ×5 = 135 px), но сам атрибут не задаёт CSS
       `height` — расчёт браузера не учитывал `padding`/`border` этого поля
       (10 px ×2 + 1 px ×2 = 22 px), и на шестую строку не хватало 2 px
       (замер дизайн-ревью 2026-08-22, находка 7: полоса прокрутки при этом
       не появляется, текст выглядит обрубленным). `min-height` считает то же
       самое явно, при действующем `box-sizing: border-box` (`base.css`). */
    min-height: calc(5 * 1.5em + 2 * 10px + 2 * 1px);
  }
  /* Плейсхолдер обязан читаться, а не растворяться: браузерный дефолт (обычно
     около 2,5:1 на белом) ниже AA. `--text-muted` — тот же токен, что уже
     доказал 5,6:1/6,4:1 на `--surface` в обеих темах (подсказка под полем,
     тот же файл ниже); `opacity: 1` снимает приглушение, которое Firefox
     добавляет плейсхолдеру по умолчанию поверх цвета.
     Кегль — отдельно от значения `font` выше (18 px, ступень `body`):
     плейсхолдер был крупнее СОБСТВЕННОЙ подписи поля (16 px, `.field label`
     ниже) — второстепенный текст оказывался крупнее первостепенного
     (дизайн-ревью 2026-08-22, находка 5). `1rem` — не новая ступень, а та
     же, что уже несёт подпись и подсказка `small` в этом файле. */
  input::placeholder, textarea::placeholder { color: var(--text-muted); opacity: 1; font-size: 1rem; }
  /* Подсказка под полем — не декор, а единственная конверсионная инструкция
     формы, поэтому цвет читаемый: `--text-faint` даёт 2,73:1 и спека допускает
     его только для украшений. */
  /* Было 13 px — самовольный кегль, вне шкалы. Подсказка — обычный
     приглушённый текст, ступень `small` (14 px), правка 2026-08-13, свод к
     семи объявленным ([[02-redesign-options]], предусловие пункта 8). */
  small { font-size: 1rem; color: var(--text-muted); }
</style>
