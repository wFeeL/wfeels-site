---
/* Печать — финальная поза ядра у ссылки «Смотреть фабрику →» (бриф
 * `02-home-core.md`, раздел 7). Отдельная упрощённая форма из двух штрихов,
 * НЕ уменьшенная копия большого рисунка: `transform: scale()` большого
 * рисунка проверен рендером и даёт кашу — тики и подписи сливаются.
 *
 * Одна разметка на оба размера (40×40 от 900 px, 32×32 ниже). `viewBox`
 * остаётся «0 0 40 40» в обоих случаях; `vector-effect: non-scaling-stroke`
 * держит обводку ровно 2 CSS px независимо от того, во что раскрывается
 * SVG (замена «второму viewBox» из брифа — тот же результат, один узел
 * разметки вместо двух). Меньше 32 px печать не ставится: `.stamp` ниже
 * 900 px имеет ровно один размер, дальше не уменьшается.
 *
 * Декоративна: `aria-hidden`, смысл несёт текст ссылки-соседа, не эта форма.
 */
---
<svg
  class="core-stamp"
  viewBox="0 0 40 40"
  aria-hidden="true"
  focusable="false"
>
  <circle
    class="core-stamp-ring"
    cx="20"
    cy="20"
    r="14"
    fill="none"
    stroke-width="2"
    stroke-dasharray="17 5"
    stroke-dashoffset="11"
    vector-effect="non-scaling-stroke"
  />
  <rect
    class="core-stamp-square"
    x="16"
    y="16"
    width="8"
    height="8"
    fill="none"
    stroke-width="2"
    vector-effect="non-scaling-stroke"
  />
</svg>

<style>
  .core-stamp {
    flex: none;
    width: 40px;
    height: 40px;
    display: block;
    pointer-events: none;
  }
  @media (max-width: 899px) {
    .core-stamp { width: 32px; height: 32px; }
  }

  .core-stamp-ring,
  .core-stamp-square {
    stroke: var(--accent);
  }

  .core-stamp-square {
    transition: fill var(--dur-micro) var(--ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .core-stamp-square { transition-duration: 0.01ms; }
  }

  /* Печать — последняя фаза хореографии ядра (бриф `02-home-core.md`, раздел
     9: 0.92–1.00 «проявляется печать у ссылки»), самостоятельная и не
     завязана на разметку `FactoryCore.astro` — компоненты разные файлы, а
     Astro скоупит стили по файлу (общий класс из другого компонента сюда бы
     не дотянулся). Запасное состояние по умолчанию — видна целиком, как и
     весь рисунок; анимация навешивается только внутри `@supports`. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .core-stamp {
        opacity: 0;
        animation-name: core-stamp-fade;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-duration: 440ms;
        animation-timeline: view();
        animation-range: entry 15% cover 65%;
      }
    }
  }
  @keyframes core-stamp-fade {
    to { opacity: 1; }
  }
</style>
