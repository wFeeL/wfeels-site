---
interface Props { value: string; caption: string }
const { value, caption } = Astro.props;
---
<div class="metric">
  <b>{value}</b>
  <span>{caption}</span>
</div>

<style>
  .metric b {
    display: block;
    font: 800 1.375rem/1.1 var(--font-head);
    letter-spacing: -0.01em;
  }
  .metric span {
    font: 400 0.75rem/1.3 var(--font-mono);
    color: var(--text-muted);
  }
</style>
