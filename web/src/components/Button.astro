---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit';
  title?: string;
  /** Язык страницы, куда ведёт ссылка, если он не совпадает с языком кнопки. */
  hreflang?: string;
  /** Отношение к цели для внешних адресов (`me` — профиль того же человека). */
  rel?: string;
  /** Не кнопка, а её место: тот же ящик, но невидимый и неинтерактивный.
   *  Нужен там, где кнопку намеренно сняли, а раскладка обязана устоять. */
  placeholder?: boolean;
}
const {
  href, variant = 'primary', type = 'button', title, hreflang, rel,
  placeholder = false,
} = Astro.props;

/* Заполнитель — <span>: не ссылка и не кнопка, поэтому в фокус не попадает
   вовсе, а не «спрятан от фокуса» отдельным правилом, которое можно забыть.
   Читалка его тоже не видит: `aria-hidden` плюс `visibility: hidden`. */
const Tag = placeholder ? 'span' : href ? 'a' : 'button';
---
<Tag
  class:list={['btn', variant, { placeholder }]}
  href={placeholder ? undefined : href}
  type={placeholder || href ? undefined : type}
  title={placeholder ? undefined : title}
  hreflang={placeholder ? undefined : hreflang}
  rel={placeholder ? undefined : rel}
  aria-hidden={placeholder ? 'true' : undefined}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: var(--radius-pill);
    padding: 10px 20px;
    min-height: 44px;
    /* Было 15 px — самовольный кегль, вне шкалы. Текст кнопки — главное
       действие экрана, ступень `body` (16 px), правка 2026-08-13, свод к
       семи объявленным ([[02-redesign-options]], предусловие пункта 8). */
    font: 600 1.125rem/1 var(--font-text);
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    transition: opacity var(--dur-micro) var(--ease),
                transform var(--dur-micro) var(--ease);
  }
  .btn:hover { opacity: 0.88; }
  /* Нажатие обязано ощущаться, иначе кнопка кажется неживой. Один пиксель вниз —
     весь эффект: смещение больше сдвигает соседей на глазах. */
  .btn:active { transform: translateY(1px); }
  /* Состояние отправки. Правило стоит после `:hover` намеренно: у них равная
     специфичность, и при обратном порядке наведение на выключенную кнопку
     вернуло бы ей вид рабочей.
     Было `opacity: 0.6` — приём смешивал ВСЮ кнопку (заливку и текст) с
     фоном страницы разом, поэтому текст терял контраст вместе с заливкой:
     2,56:1 у белой надписи на посветлевшей синей плашке (дизайн-ревью
     2026-08-22, находка 1) — ниже даже нетекстового порога 3:1, при том что
     это не «недоступно», а «идёт отправка», единственное сообщение о том,
     что заявка ушла. Приглушённый фон — `--text-muted`, уже read AA против
     `--text-on-accent` в обеих темах (5,83:1 светлая / 6,96:1 тёмная,
     `tokens.css`), второго цвета не заводится. */
  .btn:disabled {
    cursor: progress;
    transform: none;
    background: var(--text-muted);
    color: var(--text-on-accent);
  }
  .primary { background: var(--accent); color: var(--text-on-accent); }
  .secondary { background: transparent; color: var(--text); border-color: var(--border); }
  /* `visibility: hidden`, а не `opacity: 0`: место занимает, но не участвует ни
     в наведении, ни в попадании курсора. */
  .placeholder { visibility: hidden; }
</style>
