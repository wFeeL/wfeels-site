---
interface Props { href?: string }
const { href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="card" href={href}><slot /></Tag>

<style>
  .card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
    color: inherit;
    text-decoration: none;
  }
</style>
