---
interface Props {
  href?: string;
  /** Карточка несёт нижний блок, который обязан стоять на одной линии у всех
   *  карточек ряда независимо от длины текста над ним (строка стека кейсов
   *  и услуг — полировка перед приёмкой, находка 2). При `true` `.card`
   *  становится flex-колонкой на всю высоту грида, и `margin-top: auto` у
   *  последнего блока внутри неё прижимает его к низу.
   *
   *  Стиль живёт здесь, а не в `:global(.card)` у компонента-потребителя,
   *  намеренно: у Astro-скоупинга правило этого файла получает атрибут
   *  `[data-astro-cid-…]`, специфичность которого выше, чем у голого
   *  `.card` снаружи, — внешний `:global(.card){display:flex}` тихо
   *  проигрывал этому `display: block` и никогда не применялся (проверено
   *  вычисленным стилем в браузере при разборе находки 2). Модификатор внутри
   *  самого `Card.astro` этой войны специфичностей не создаёт. */
  stack?: boolean;
  /** Акцентное выделение — рамка акцентного цвета вместо серой и подложка
   *  на тон темнее обычной поверхности. Заведено для рекомендуемой карточки
   *  секции 4 «Цены» («Корпоративный сайт», правка владельца 2026-08-13,
   *  часть 2), но не завязано на неё по имени — общий модификатор карточки,
   *  тем же приёмом, что и `stack` выше: живёт внутри `Card.astro`, а не
   *  борется специфичностью с `:global(.card)` снаружи. */
  accent?: boolean;
}
const { href, stack = false, accent = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class={`card${stack ? ' card--stack' : ''}${accent ? ' card--accent' : ''}`} href={href}><slot /></Tag>

<style>
  .card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
    color: inherit;
    text-decoration: none;
  }
  .card--stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
  }
  /* Рамка акцентного цвета вместо серой + подложка на тон темнее обычной
     поверхности (`--surface`) карточек рядом. `--accent-soft` — уже
     откалиброванный по теме акцентный тон (не изобретён здесь), тот же,
     которым красится ховер строк и подложка меток. */
  .card--accent {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
</style>
