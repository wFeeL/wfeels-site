---
interface Props {
  /** Дополнительный класс потребителя. Нужен для адресных состояний карточки,
   *  которые не являются общими модификаторами `Card` (например, событие
   *  линии у рекомендуемого тарифа). */
  class?: string;
  href?: string;
  /** Карточка несёт нижний блок, который обязан стоять на одной линии у всех
   *  карточек ряда независимо от длины текста над ним (строка стека кейсов
   *  и услуг — полировка перед приёмкой, находка 2). При `true` `.card`
   *  становится flex-колонкой на всю высоту грида, и `margin-top: auto` у
   *  последнего блока внутри неё прижимает его к низу.
   *
   *  Стиль живёт здесь, а не в `:global(.card)` у компонента-потребителя,
   *  намеренно: у Astro-скоупинга правило этого файла получает атрибут
   *  `[data-astro-cid-…]`, специфичность которого выше, чем у голого
   *  `.card` снаружи, — внешний `:global(.card){display:flex}` тихо
   *  проигрывал этому `display: block` и никогда не применялся (проверено
   *  вычисленным стилем в браузере при разборе находки 2). Модификатор внутри
   *  самого `Card.astro` этой войны специфичностей не создаёт. */
  stack?: boolean;
  /** Универсальное акцентное выделение: рамка акцентного цвета и подложка
   *  на тон темнее обычной поверхности. Тарифы этим статическим состоянием
   *  больше не пользуются: их рекомендация включается только после линии. */
  accent?: boolean;
  /** Целевая коробка линии-рассказчика (`70-workshop/specs/site-v3/
   *  15-line-through-scale-brief.md`, раздел 5.2): карточка получает обвод
   *  по кромке (`.line-trace`, `styles/base.css`), который загорается,
   *  когда перо линии уходит из её коробки — вместо того, чтобы просвечивать
   *  сквозь лицо. Ставится точечно вызывающей секцией по замеру пересечения
   *  (`Services.astro`), а не наугад. */
  trace?: boolean;
}
const { href, class: className = '', stack = false, accent = false, trace = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---
{/* `reveal` — появление по прокрутке, одна утилита в `styles/base.css`
    (`70-workshop/specs/site-v3/02-card-motion.md`). Секции снаружи задают
    только `--reveal-i` через `:nth-child` в своих `<style>` — сама карточка
    не объявляет ни `opacity`, ни `animation-*`, войны специфичности со
    скоупингом Astro тут нет (см. комментарий к пропу `stack` выше). */}
<Tag class={`card reveal${stack ? ' card--stack' : ''}${accent ? ' card--accent' : ''}${className ? ` ${className}` : ''}`} href={href}>
  {trace && <span class="line-trace" aria-hidden="true"></span>}
  <slot />
</Tag>

<style>
  .card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
    color: inherit;
    text-decoration: none;
    position: relative;
    isolation: isolate;
  }
  /* Ф-9.1: четыре короткие угловые засечки без дополнительных узлов. */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background-repeat: no-repeat;
    background-image:
      linear-gradient(var(--grid) 0 0),
      linear-gradient(var(--grid) 0 0),
      linear-gradient(var(--grid) 0 0),
      linear-gradient(var(--grid) 0 0);
    background-size: 8px 1px;
    background-position:
      left 12px top 12px,
      right 12px top 12px,
      left 12px bottom 12px,
      right 12px bottom 12px;
    transition: background-image var(--dur-micro) var(--ease);
  }
  .card:hover::before {
    background-image:
      linear-gradient(var(--border) 0 0),
      linear-gradient(var(--border) 0 0),
      linear-gradient(var(--border) 0 0),
      linear-gradient(var(--border) 0 0);
  }
  /* Ф-9.2: неподвижная лампа меняет только opacity и существует лишь там,
     где устройство действительно умеет наводить курсор. */
  @media (hover: hover) {
    .card::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      border-radius: inherit;
      opacity: 0;
      background-image: radial-gradient(
        120% 64% at 50% 0%,
        var(--accent-soft),
        transparent 70%
      );
      transition: opacity var(--dur-micro) var(--ease);
    }
    .card:hover::after { opacity: 1; }
  }
  .card--stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
  }
  /* Рамка акцентного цвета вместо серой + подложка на тон темнее обычной
     поверхности (`--surface`) карточек рядом. `--accent-soft` — уже
     откалиброванный по теме акцентный тон (не изобретён здесь), тот же,
     которым красится ховер строк и подложка меток.

     ПРАВКА `70-workshop/specs/site-v3/15-line-through-scale-brief.md`,
     раздел 5: было `background: var(--accent-soft)` — заливка ЦЕЛИКОМ
     полупрозрачна (rgba, альфа 9%/14% по теме), и потому пропускала
     линию-рассказчик сквозь лицо карточки в её полной полевой плотности
     (карточка-акцент — единственная из своей секции, исключённая из
     кальки Р-1 починкой специфичности; калька снята целиком этим же
     брифом, раздел 5.1). Для потребителей этого общего модификатора цель
     обязана быть непрозрачной («Лицо не просвечивает никогда», раздел
     5.2). Тон при этом НЕ меняется ни на бит: тот же `--accent-soft`
     рисуется вторым слоем `background` НАД непрозрачным `--surface`, а не
     заливкой самой карточки — итоговый композитный пиксель тот же самый
     (альфа-смешение поверх `--surface`, тем же числом, что и раньше), но
     теперь это смешение происходит ВНУТРИ фона одного элемента, а не между
     карточкой и тем, что физически нарисовано под ней в DOM. */
  .card--accent {
    border-color: var(--accent);
    background: linear-gradient(var(--accent-soft), var(--accent-soft)), var(--surface);
  }
</style>
