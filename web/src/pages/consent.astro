---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import LangSwitch from '../components/LangSwitch.astro';
import Prose from '../components/Prose.astro';
import DraftNotice from '../components/DraftNotice.astro';

const SECTIONS = [
  'Кому и на что дается согласие',
  'Какие данные обрабатываются',
  'Цели обработки',
  'Срок действия согласия',
  'Как отозвать согласие',
];
---
<Base title="Согласие на обработку персональных данных — wfeels"
      description="Согласие на обработку данных, отправленных через форму."
      noindex={true}>
  <LangSwitch slot="lang" />
  <Container>
    <Section>
      <DraftNotice>
        Черновик. Документ не действует, пока в нем не проставлены реальные
        реквизиты оператора. Страница закрыта от индексации.
      </DraftNotice>
      <h1 class="t-h1">Согласие на обработку персональных данных</h1>
      <Prose>
        {SECTIONS.map((s, i) => (
          <>
            <h2>{i + 1}. {s}</h2>
            <p>Текст раздела заполняется владельцем.</p>
          </>
        ))}
      </Prose>
    </Section>
  </Container>
</Base>
