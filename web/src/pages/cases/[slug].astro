---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import CaseGallery from '../../components/cases/CaseGallery.astro';
import CaseSpread from '../../components/cases/CaseSpread.astro';
import {
  caseGallerySlides,
  caseNarrative,
  caseServiceLinks,
} from '../../data/casePages';
import { caseSpreads } from '../../data/case-spreads';
import { CASES_CATALOG_HREF, caseHref, publishedCases, type PublishedCase } from '../../data/cases';
import { caseStudySchema } from '../../lib/schema';

export const getStaticPaths = (() => publishedCases().map((item) => ({
  params: { slug: item.slug },
  props: { item },
}))) satisfies GetStaticPaths;

const { item } = Astro.props as { item: PublishedCase };
const slides = caseGallerySlides(item.slug);
const services = caseServiceLinks(item.slug);
const narrative = caseNarrative(item.slug);
const title = `${item.title}: кейс разработки | wfeels`;
const site = Astro.site!.toString().replace(/\/$/, '');
const structuredData = caseStudySchema({
  site,
  canonical: `${site}${CASES_CATALOG_HREF}/${item.slug}`,
  title,
  description: item.description,
  lang: 'ru',
  name: item.title,
  about: services.map((service) => service.title).join(', ') || item.title,
});

/* Развороты — 70-workshop/specs/site-v3/12-case-pages-brief.md, раздел 2
   (правило разворота) и раздел 4 (устройство каждого кейса). Перенесены все
   пять кейсов: `zayavka-hub`, `websites`, `storefront`, `site-v3` и
   `ai-consultant` (раздел 4.4 — три кадра сняты со стенда
   `50-code/rag-consultant`). */
const spreads = caseSpreads(item.slug);
const hasSpreads = spreads.length > 0;

/* Блок действия у разворота (раздел 3.7 брифа: «Связанные услуги» и «Все
   кейсы» входят в один блок действия внизу страницы вместе с кнопкой).
   Следующий кейс — по кольцу публикуемых кейсов, тем же порядком, что несёт
   каталог `/cases` (`publishedCases()`), а не отдельным списком. */
const allCases = publishedCases();
const currentIndex = allCases.findIndex((c) => c.slug === item.slug);
const nextCase = allCases[(currentIndex + 1) % allCases.length];
---
<Base
  title={title}
  description={item.description}
  structuredData={structuredData}
  line={false}
>
  <Container>
    <div class="crumbs">
      <Breadcrumbs items={[
        { text: 'Главная', href: '/' },
        { text: 'Кейсы', href: CASES_CATALOG_HREF },
        { text: item.title },
      ]} />
    </div>

    <article>
      <header class="case-header" data-slug={item.slug}>
        <p class="case-label">КЕЙС</p>
        <h1 class="t-h1">{item.title}</h1>
        <p class="case-description t-body-lg">{item.description}</p>
        <p class="case-stack"><code>{item.stack}</code></p>
      </header>

      {hasSpreads ? (
        <>
          {/* Раздел 6 брифа: оговорка происхождения переезжает перед первым
              разворотом — «подпись у входа в зал, а не сноска на выходе» —
              и здесь не дублируется внутри `narrative`. Полоса рисуется,
              только когда оговорка есть: у `storefront` её сняли решением
              владельца (2026-08-28, D-138), и полоса-заголовок без текста
              под ним сама по себе стала бы новой ложью о происхождении. */}
          {narrative.disclosure && (
            <div class="origin-strip">
              <p class="origin-label">ПРОИСХОЖДЕНИЕ</p>
              <p class="origin-text t-small">{narrative.disclosure}</p>
            </div>
          )}

          <section id="case-story" class="narrative" aria-labelledby="case-task-heading">
            <div>
              <p class="section-label">ЗАДАЧА</p>
              <h2 id="case-task-heading" class="t-h2">Что нужно было решить</h2>
              <p class="t-body">{narrative.task}</p>
            </div>
            <div>
              <p class="section-label">ПОДХОД</p>
              <h2 class="t-h2">Как устроено решение</h2>
              <p class="t-body">{narrative.approach}</p>
            </div>
            <div>
              <p class="section-label">РЕЗУЛЬТАТ</p>
              <h2 class="t-h2">Что подтверждает кейс</h2>
              <p class="t-body">{narrative.result}</p>
            </div>
          </section>

          <section class="spreads" aria-label={`Экраны продукта «${item.title}»`}>
            {spreads.map((spread, i) => (
              <CaseSpread spread={spread} index={i} />
            ))}
          </section>

          <section class="case-actions" aria-label="Дальнейшие действия">
            <Button href="/contact" variant="primary">Обсудить задачу</Button>
            <p class="action-link">
              Следующий кейс: <a href={caseHref(nextCase.slug)}>{nextCase.title} →</a>
            </p>
            {services.length > 0 && (
              <p class="action-link">
                Связанная услуга: <a href={services[0].href}>{services[0].title} →</a>
              </p>
            )}
            <p class="action-link"><a href={CASES_CATALOG_HREF}>Все кейсы →</a></p>
          </section>
        </>
      ) : (
        <>
          <section id="case-story" class="narrative" aria-labelledby="case-task-heading">
            <div>
              <p class="section-label">ЗАДАЧА</p>
              <h2 id="case-task-heading" class="t-h2">Что нужно было решить</h2>
              <p class="t-body">{narrative.task}</p>
            </div>
            <div>
              <p class="section-label">ПОДХОД</p>
              <h2 class="t-h2">Как устроено решение</h2>
              <p class="t-body">{narrative.approach}</p>
            </div>
            <div>
              <p class="section-label">РЕЗУЛЬТАТ</p>
              <h2 class="t-h2">Что подтверждает кейс</h2>
              <p class="t-body">{narrative.result}</p>
            </div>
            {narrative.disclosure && <p class="disclosure t-small">{narrative.disclosure}</p>}
          </section>

          {slides.length > 0 && (
            <section aria-labelledby="case-gallery-heading">
              <h2 id="case-gallery-heading" class="t-h2">Экраны</h2>
              <CaseGallery slides={slides} galleryKey={`${item.slug}-ru`} />
            </section>
          )}

          {services.length > 0 && (
            <section aria-labelledby="case-services-heading">
              <h2 id="case-services-heading" class="t-h2">Связанные услуги</h2>
              <ul class="service-links">
                {services.map((service) => (
                  <li><a href={service.href}>{service.title}</a></li>
                ))}
              </ul>
            </section>
          )}

          <p class="back-link"><a href={CASES_CATALOG_HREF}>Все кейсы</a></p>
        </>
      )}
    </article>
  </Container>
</Base>

<style>
  .crumbs { padding-top: 24px; }
  article { padding-bottom: 96px; }

  .case-header { max-width: 920px; padding: 48px 0 96px; }
  .case-label {
    margin: 0 0 16px;
    color: var(--accent);
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
  }
  /* Раздел 3.4 брифа: было `max-width: 60ch` — мера в `ch` вычисляется из
     ширины символа «0» ТЕКУЩЕГО начертания, а она у запасного и настоящего
     `Onest` расходится (замер: 756,1 px у запасного, 877,8 px у
     настоящего — на 122 px, то есть на 16%). После снятия `min-height`
     (раздел 3.4) эта разница перестала гаситься запасом высоты шапки и
     стала видимой раскладкой: у `ai-consultant` и `storefront` лид
     укладывался в разное число строк на 1440 px (2 против 3, 3 против 4) —
     `font-fallback-metrics.spec.ts` покраснел на этих двух страницах.
     `hyphens: auto` (испытано первым, по образцу `.t-h1`) убрал расхождение
     у `storefront`, но не у `ai-consultant` — ни один из словарных
     переносов не подошёл к границе строки достаточно близко, чтобы
     выиграть целую строку. Фиксированный `px` (мера того же порядка, что и
     `60ch` настоящего начертания) не зависит от того, какое начертание
     сейчас на экране — тот же приём, что уже стабилизировал перенос `h1`
     «Панель обращений и админка» (`ServiceHero.astro`, `em`/`px` вместо
     завязки на метрику шрифта). */
  /* П-2 (бриф страниц кейсов, `70-workshop/specs/site-v3/
     12-case-pages-brief.md`): заголовок «ИИ-консультант» на ≤479px рвался
     на ТРИ куска — «ИИ-», «кон-», «сультант». Причина не в самом
     `hyphens: auto` (`.t-h1`, `base.css`, раздел выше по файлу): жёсткий
     дефис в «ИИ-» — уже сам по себе точка переноса независимо от значения
     `hyphens` (обычные правила разбивки строк UAX#14), а словарный
     перенос `auto` следом ищет ЕЩЁ одну точку внутри «консультант», хотя
     слово из 11 букв само по себе умещается в поле 358px безо всякого
     переноса. `hyphens: none` здесь снимает только вторую, лишнюю точку —
     разбивка по жёсткому дефису «ИИ-» / «консультант» остаётся (это и есть
     желаемые два куска), а перенос других заголовков кейсов (`.t-h1`
     глобально) не трогается — правило точечное, по `data-slug`, а не
     общее. */
  .case-header[data-slug="ai-consultant"] h1 {
    hyphens: none;
    -webkit-hyphens: none;
  }

  .case-description { max-width: 878px; margin: 24px 0 0; color: var(--text-muted); }
  .case-stack { margin: 16px 0 0; }
  .case-stack code {
    padding: 0;
    background: none;
    color: var(--text-muted);
    font: 400 1rem/1.4 var(--font-mono);
  }

  section + section, .origin-strip + section { margin-top: 96px; }
  section h2 { margin-bottom: 32px; }

  /* Строка происхождения — раздел 6 брифа: метка моно/акцент, текст
     `--text` (не `--text-muted`, не `--text-faint`) — оговорка это факт
     наравне со сроком и стеком, а не извинение. */
  .origin-strip {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    padding: 24px 0;
    margin-top: 96px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .origin-label {
    margin: 0;
    color: var(--accent);
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .origin-text { margin: 0; color: var(--text); }

  .narrative {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .narrative > div { min-width: 0; }
  /* Было `clamp(1.5rem, 2.4vw, 2rem)` — плавающая величина вне объявленной
     шкалы (`base.css:249…292`), скрытая до сих пор только тем, что стили
     этой страницы были малы и Astro встраивала их прямо в HTML: сторож
     `dist-typography-scale.test.ts` смотрит только вынесенный CSS
     (`50-code/CLAUDE.md`, ловушка 10). С разворотами файл стилей подрос,
     Astro вынесла его в `_astro/*.css`, и сторож закономерно покраснел —
     чинится предмет: `1.75rem` (28px) — ступень `.t-h3`, уже в шкале. */
  .narrative h2 { margin: 0 0 16px; font-size: 1.75rem; line-height: 1.3; }
  .narrative p { margin: 0; }
  .section-label {
    margin-bottom: 12px !important;
    color: var(--accent);
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .disclosure {
    grid-column: 1 / -1;
    max-width: 74ch;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
  }

  .service-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service-links a,
  .back-link a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .back-link { margin: 96px 0 0; }

  /* Блок действия — раздел 3.7 брифа: кнопка «Обсудить задачу» (единственная
     залитая акцентом кнопка на странице), следующий кейс, связанная услуга,
     все кейсы. Прозаические ссылки подчёркнуты всегда (D-055/D-098). Это
     единственный путь дальше со страницы кейса, кроме самой кнопки —
     дизайн-ревью 2026-08-26 нашло на `/cases/ai-consultant`, 390 px, высоту
     цели 22 px при шаге 16 px между абзацами (порог 44 px).

     Растить цель нажатия здесь `min-height` нельзя (правило раздела 10 брифа
     подвала, тот же приём уже стоит у `.requisites a` в `Footer.astro`):
     `<a>` — не единственное содержимое абзаца («Следующий кейс: {текст} →»),
     и блочный бокс сдвинул бы вниз подпись перед ссылкой. `padding-block` на
     САМОЙ ссылке (ниже) растит только её кликабельный бокс, не строчный бокс
     абзаца, — раскладка не двигается.

     Побочный эффект тот же, что уже нашли и починили в подвале: инлайновый
     padding переливается ЗА пределы своего абзаца и наступает на зазор до
     соседней цели с обеих сторон (сверху и снизу), поэтому `gap` этого
     контейнера поднят с 16 до 48, чтобы после протрузии 2 × 13 px
     фактический зазор остался 22 px — с запасом над порогом 16. */
  .case-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .action-link { margin: 0; color: var(--text-muted); }
  /* 13 px даёт цели высоту 22 + 13 × 2 = 48 px — запас 4 px над порогом
     44 px (строчный бокс на всех пяти страницах кейсов набран одним
     кеглем/интерлиньяжем `.action-link`, число подтверждено сторожем
     `e2e/case-actions-tap-targets.spec.ts` на каждой). */
  .action-link a {
    display: inline;
    padding-block: 13px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 479px) {
    .case-header { padding: 32px 0 64px; }
    .case-header h1 { max-width: 300px; }
    section + section, .back-link, .origin-strip { margin-top: 64px; }
  }

  @media (max-width: 899px) {
    .narrative { grid-template-columns: 1fr; }
    .disclosure { grid-column: 1; }
    .origin-strip { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
