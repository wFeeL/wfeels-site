---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import CaseGallery from '../../components/cases/CaseGallery.astro';
import CaseSpread from '../../components/cases/CaseSpread.astro';
import {
  caseGallerySlides,
  caseNarrative,
  caseServiceLinks,
} from '../../data/casePages';
import { caseSpreads } from '../../data/case-spreads';
import { CASES_CATALOG_HREF, caseHref, publishedCases, type PublishedCase } from '../../data/cases';
import { caseStudySchema } from '../../lib/schema';

export const getStaticPaths = (() => publishedCases().map((item) => ({
  params: { slug: item.slug },
  props: { item },
}))) satisfies GetStaticPaths;

const { item } = Astro.props as { item: PublishedCase };
const slides = caseGallerySlides(item.slug);
const services = caseServiceLinks(item.slug);
const narrative = caseNarrative(item.slug);
const title = `${item.title}: кейс разработки | wfeels`;
const site = Astro.site!.toString().replace(/\/$/, '');
const structuredData = caseStudySchema({
  site,
  canonical: `${site}${CASES_CATALOG_HREF}/${item.slug}`,
  title,
  description: item.description,
  lang: 'ru',
  name: item.title,
  about: services.map((service) => service.title).join(', ') || item.title,
});

/* Развороты — 70-workshop/specs/site-v3/12-case-pages-brief.md, раздел 2
   (правило разворота) и раздел 4 (устройство каждого кейса). Перенесены
   `zayavka-hub`, `websites`, `storefront` и `site-v3`; `ai-consultant`
   остаётся в нынешнем устройстве — у него нет кадров (раздел 4.4/5 брифа),
   `caseSpreads()` возвращает для него пустой массив. */
const spreads = caseSpreads(item.slug);
const hasSpreads = spreads.length > 0;

/* Раздел 10.2 брифа: у `websites` порядок кадров разворота совпадает с
   `WEBSITE_SLIDES` (`data/case-galleries.ts`), поэтому разворот донашивает
   тот же манифест `/case-galleries.json`, что уже раздаёт `CaseGallery` —
   только первый кадр страницы несёт литеральный `src`, остальные восемь
   идут по манифесту (иначе девять кадров по ~100…120 КБ дают > 1 МБ
   литералом, замерено при первой сборке этой правки). У `zayavka-hub`
   кадры лёгкие (19…38 КБ) и манифеста для них нет — ключ не задаётся,
   `CaseSpread` оставляет прежний литеральный `src` на всех кадрах. */
const CASE_SPREAD_GALLERY_KEY: Readonly<Record<string, string>> = {
  websites: 'websites-ru',
  storefront: 'storefront-ru',
};
const spreadGalleryKey = CASE_SPREAD_GALLERY_KEY[item.slug];
let spreadImageOffset = 0;
const spreadsWithOffset = spreads.map((spread) => {
  const imageOffset = spreadImageOffset;
  spreadImageOffset += spread.images?.length ?? 0;
  return { spread, imageOffset };
});

/* Блок действия у разворота (раздел 3.7 брифа: «Связанные услуги» и «Все
   кейсы» входят в один блок действия внизу страницы вместе с кнопкой).
   Следующий кейс — по кольцу публикуемых кейсов, тем же порядком, что несёт
   каталог `/cases` (`publishedCases()`), а не отдельным списком. */
const allCases = publishedCases();
const currentIndex = allCases.findIndex((c) => c.slug === item.slug);
const nextCase = allCases[(currentIndex + 1) % allCases.length];
---
<Base
  title={title}
  description={item.description}
  structuredData={structuredData}
  line={false}
>
  <Container>
    <div class="crumbs">
      <Breadcrumbs items={[
        { text: 'Главная', href: '/' },
        { text: 'Кейсы', href: CASES_CATALOG_HREF },
        { text: item.title },
      ]} />
    </div>

    <article>
      <header class="case-header" data-slug={item.slug}>
        <p class="case-label">КЕЙС</p>
        <h1 class="t-h1">{item.title}</h1>
        <p class="case-description t-body-lg">{item.description}</p>
        <p class="case-stack"><code>{item.stack}</code></p>
      </header>

      {hasSpreads ? (
        <>
          {/* Раздел 6 брифа: оговорка происхождения переезжает перед первым
              разворотом — «подпись у входа в зал, а не сноска на выходе» —
              и здесь не дублируется внутри `narrative`. */}
          <div class="origin-strip">
            <p class="origin-label">ПРОИСХОЖДЕНИЕ</p>
            <p class="origin-text t-small">{narrative.disclosure}</p>
          </div>

          <section id="case-story" class="narrative" aria-labelledby="case-task-heading">
            <div>
              <p class="section-label">ЗАДАЧА</p>
              <h2 id="case-task-heading" class="t-h2">Что нужно было решить</h2>
              <p class="t-body">{narrative.task}</p>
            </div>
            <div>
              <p class="section-label">ПОДХОД</p>
              <h2 class="t-h2">Как устроено решение</h2>
              <p class="t-body">{narrative.approach}</p>
            </div>
            <div>
              <p class="section-label">РЕЗУЛЬТАТ</p>
              <h2 class="t-h2">Что подтверждает кейс</h2>
              <p class="t-body">{narrative.result}</p>
            </div>
          </section>

          <section class="spreads" aria-label={`Экраны продукта «${item.title}»`}>
            {spreadsWithOffset.map(({ spread, imageOffset }, i) => (
              <CaseSpread spread={spread} index={i} galleryKey={spreadGalleryKey} imageOffset={imageOffset} />
            ))}
          </section>

          <section class="case-actions" aria-label="Дальнейшие действия">
            <Button href="/contact" variant="primary">Обсудить задачу</Button>
            <p class="action-link">
              Следующий кейс: <a href={caseHref(nextCase.slug)}>{nextCase.title} →</a>
            </p>
            {services.length > 0 && (
              <p class="action-link">
                Связанная услуга: <a href={services[0].href}>{services[0].title} →</a>
              </p>
            )}
            <p class="action-link"><a href={CASES_CATALOG_HREF}>Все кейсы →</a></p>
          </section>
        </>
      ) : (
        <>
          <section id="case-story" class="narrative" aria-labelledby="case-task-heading">
            <div>
              <p class="section-label">ЗАДАЧА</p>
              <h2 id="case-task-heading" class="t-h2">Что нужно было решить</h2>
              <p class="t-body">{narrative.task}</p>
            </div>
            <div>
              <p class="section-label">ПОДХОД</p>
              <h2 class="t-h2">Как устроено решение</h2>
              <p class="t-body">{narrative.approach}</p>
            </div>
            <div>
              <p class="section-label">РЕЗУЛЬТАТ</p>
              <h2 class="t-h2">Что подтверждает кейс</h2>
              <p class="t-body">{narrative.result}</p>
            </div>
            <p class="disclosure t-small">{narrative.disclosure}</p>
          </section>

          {slides.length > 0 && (
            <section aria-labelledby="case-gallery-heading">
              <h2 id="case-gallery-heading" class="t-h2">Экраны</h2>
              <CaseGallery slides={slides} galleryKey={`${item.slug}-ru`} />
            </section>
          )}

          {services.length > 0 && (
            <section aria-labelledby="case-services-heading">
              <h2 id="case-services-heading" class="t-h2">Связанные услуги</h2>
              <ul class="service-links">
                {services.map((service) => (
                  <li><a href={service.href}>{service.title}</a></li>
                ))}
              </ul>
            </section>
          )}

          <p class="back-link"><a href={CASES_CATALOG_HREF}>Все кейсы</a></p>
        </>
      )}
    </article>
  </Container>
</Base>

<style>
  .crumbs { padding-top: 24px; }
  article { padding-bottom: 96px; }

  .case-header { max-width: 920px; padding: 48px 0 96px; }
  .case-label {
    margin: 0 0 16px;
    color: var(--accent);
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .case-description { max-width: 60ch; margin: 24px 0 0; color: var(--text-muted); }
  .case-stack { margin: 16px 0 0; }
  .case-stack code {
    padding: 0;
    background: none;
    color: var(--text-muted);
    font: 400 1rem/1.4 var(--font-mono);
  }

  section + section, .origin-strip + section { margin-top: 96px; }
  section h2 { margin-bottom: 32px; }

  /* Строка происхождения — раздел 6 брифа: метка моно/акцент, текст
     `--text` (не `--text-muted`, не `--text-faint`) — оговорка это факт
     наравне со сроком и стеком, а не извинение. */
  .origin-strip {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    padding: 24px 0;
    margin-top: 96px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .origin-label {
    margin: 0;
    color: var(--accent);
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .origin-text { margin: 0; color: var(--text); }

  .narrative {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .narrative > div { min-width: 0; }
  /* Было `clamp(1.5rem, 2.4vw, 2rem)` — плавающая величина вне объявленной
     шкалы (`base.css:249…292`), скрытая до сих пор только тем, что стили
     этой страницы были малы и Astro встраивала их прямо в HTML: сторож
     `dist-typography-scale.test.ts` смотрит только вынесенный CSS
     (`50-code/CLAUDE.md`, ловушка 10). С разворотами файл стилей подрос,
     Astro вынесла его в `_astro/*.css`, и сторож закономерно покраснел —
     чинится предмет: `1.75rem` (28px) — ступень `.t-h3`, уже в шкале. */
  .narrative h2 { margin: 0 0 16px; font-size: 1.75rem; line-height: 1.3; }
  .narrative p { margin: 0; }
  .section-label {
    margin-bottom: 12px !important;
    color: var(--accent);
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .disclosure {
    grid-column: 1 / -1;
    max-width: 74ch;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
  }

  .service-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service-links a,
  .back-link a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .back-link { margin: 96px 0 0; }

  /* Блок действия — раздел 3.7 брифа: кнопка «Обсудить задачу» (единственная
     залитая акцентом кнопка на странице), следующий кейс, связанная услуга,
     все кейсы. Прозаические ссылки подчёркнуты всегда (D-055/D-098). */
  .case-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .action-link { margin: 0; color: var(--text-muted); }
  .action-link a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 479px) {
    /* Высота первого блока фиксирует начало истории при подмене запасного
       шрифта на Unbounded/Onest. Значения округлены вверх к 8px-сетке от
       фактической высоты самого длинного варианта каждой композиции. */
    .case-header { min-height: 448px; padding: 32px 0 64px; }
    .case-header[data-slug="ai-consultant"] { min-height: 488px; }
    .case-header[data-slug="site-v3"] { min-height: 520px; }
    .case-header[data-slug="storefront"] { min-height: 592px; }
    /* `zayavka-hub` — единственный кейс этой правки (раздел 3.4 брифа):
       панель разворота резервирует свою высоту через `width`/`height` кадра,
       поэтому скачок при подмене шрифта здесь гасится геометрией кадра, а не
       запасом в шапке (раздел 3.4, «Скачок ниже шапки лечится отдельно»).
       Остальные четыре шапки не трогаются этой правкой. */
    .case-header[data-slug="zayavka-hub"] { min-height: 0; }
    .case-header h1 { max-width: 300px; }
    section + section, .back-link, .origin-strip { margin-top: 64px; }
  }

  @media (max-width: 899px) {
    .narrative { grid-template-columns: 1fr; }
    .disclosure { grid-column: 1; }
    .origin-strip { grid-template-columns: 1fr; gap: 8px; }
  }

  @media (min-width: 900px) {
    .case-header { min-height: 416px; }
    .case-header[data-slug="storefront"] { min-height: 464px; }
    .case-header[data-slug="zayavka-hub"] { min-height: 0; }
  }
</style>
