---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Container from '../../components/Container.astro';
import CaseGallery from '../../components/cases/CaseGallery.astro';
import CaseWeightIllustration from '../../components/home/CaseWeightIllustration.astro';
import {
  caseGallerySlides,
  caseNarrative,
  caseServiceLinks,
} from '../../data/casePages';
import { CASES_CATALOG_HREF, publishedCases, type PublishedCase } from '../../data/cases';
import { caseStudySchema } from '../../lib/schema';

export const getStaticPaths = (() => publishedCases().map((item) => ({
  params: { slug: item.slug },
  props: { item },
}))) satisfies GetStaticPaths;

const { item } = Astro.props as { item: PublishedCase };
const slides = caseGallerySlides(item.slug);
const services = caseServiceLinks(item.slug);
const narrative = caseNarrative(item.slug);
const title = `${item.title}: кейс разработки | wfeels`;
const site = Astro.site!.toString().replace(/\/$/, '');
const structuredData = caseStudySchema({
  site,
  canonical: `${site}${CASES_CATALOG_HREF}/${item.slug}`,
  title,
  description: item.description,
  lang: 'ru',
  name: item.title,
  about: services.map((service) => service.title).join(', ') || item.title,
});
---
<Base
  title={title}
  description={item.description}
  structuredData={structuredData}
  line={false}
>
  <Container>
    <div class="crumbs">
      <Breadcrumbs items={[
        { text: 'Главная', href: '/' },
        { text: 'Кейсы', href: CASES_CATALOG_HREF },
        { text: item.title },
      ]} />
    </div>

    <article>
      <header class="case-header" data-slug={item.slug}>
        <p class="case-label">КЕЙС</p>
        <h1 class="t-h1">{item.title}</h1>
        <p class="case-description t-body-lg">{item.description}</p>
        <p class="case-stack"><code>{item.stack}</code></p>
      </header>

      <section id="case-story" class="narrative" aria-labelledby="case-task-heading">
        <div>
          <p class="section-label">ЗАДАЧА</p>
          <h2 id="case-task-heading" class="t-h2">Что нужно было решить</h2>
          <p class="t-body">{narrative.task}</p>
        </div>
        <div>
          <p class="section-label">ПОДХОД</p>
          <h2 class="t-h2">Как устроено решение</h2>
          <p class="t-body">{narrative.approach}</p>
        </div>
        <div>
          <p class="section-label">РЕЗУЛЬТАТ</p>
          <h2 class="t-h2">Что подтверждает кейс</h2>
          <p class="t-body">{narrative.result}</p>
        </div>
        <p class="disclosure t-small">{narrative.disclosure}</p>
      </section>

      {slides.length > 0 && (
        <section aria-labelledby="case-gallery-heading">
          <h2 id="case-gallery-heading" class="t-h2">Экраны</h2>
          <CaseGallery slides={slides} galleryKey={`${item.slug}-ru`} />
        </section>
      )}

      {/* Иллюстрация «Замер» на самой странице кейса — решение D-122
          (`70-workshop/specs/site-v3/12-case-pages-brief.md`, раздел 4.6):
          страница показывает вес и время СЕБЯ, а не главной. Проп `host`
          обязателен здесь — без него компонент печатал бы числа главной
          под заголовком, который называет эту страницу.

          Это подключение, а не разворот раздела 4.5: полноценная витрина
          из двух панелей («Замер» + «Проверка на месте») — отдельная,
          следующая задача; здесь только доказано, что рисунок способен
          стоять на чужой странице и говорить правду о ней. */}
      {item.slug === 'site-v3' && (
        <section aria-labelledby="case-weight-heading">
          <h2 id="case-weight-heading" class="t-h2">Столько весит эта страница</h2>
          <CaseWeightIllustration host="case-site-v3" />
        </section>
      )}

      {services.length > 0 && (
        <section aria-labelledby="case-services-heading">
          <h2 id="case-services-heading" class="t-h2">Связанные услуги</h2>
          <ul class="service-links">
            {services.map((service) => (
              <li><a href={service.href}>{service.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      <p class="back-link"><a href={CASES_CATALOG_HREF}>Все кейсы</a></p>
    </article>
  </Container>
</Base>

<style>
  .crumbs { padding-top: 24px; }
  article { padding-bottom: 96px; }

  .case-header { max-width: 920px; padding: 48px 0 96px; }
  .case-label {
    margin: 0 0 16px;
    color: var(--accent);
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .case-description { max-width: 60ch; margin: 24px 0 0; color: var(--text-muted); }
  .case-stack { margin: 16px 0 0; }
  .case-stack code {
    padding: 0;
    background: none;
    color: var(--text-muted);
    font: 400 1rem/1.4 var(--font-mono);
  }

  section + section { margin-top: 96px; }
  section h2 { margin-bottom: 32px; }

  .narrative {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .narrative > div { min-width: 0; }
  .narrative h2 { margin: 0 0 16px; font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .narrative p { margin: 0; }
  .section-label {
    margin-bottom: 12px !important;
    color: var(--accent);
    font: 600 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
  }
  .disclosure {
    grid-column: 1 / -1;
    max-width: 74ch;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
  }

  .service-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service-links a,
  .back-link a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .back-link { margin: 96px 0 0; }

  @media (max-width: 479px) {
    /* Высота первого блока фиксирует начало истории при подмене запасного
       шрифта на Unbounded/Onest. Значения округлены вверх к 8px-сетке от
       фактической высоты самого длинного варианта каждой композиции. */
    .case-header { min-height: 448px; padding: 32px 0 64px; }
    .case-header[data-slug="ai-consultant"] { min-height: 488px; }
    .case-header[data-slug="site-v3"] { min-height: 520px; }
    .case-header[data-slug="storefront"] { min-height: 592px; }
    .case-header h1 { max-width: 300px; }
    section + section, .back-link { margin-top: 64px; }
  }

  @media (max-width: 899px) {
    .narrative { grid-template-columns: 1fr; }
    .disclosure { grid-column: 1; }
  }

  @media (min-width: 900px) {
    .case-header { min-height: 416px; }
    .case-header[data-slug="storefront"] { min-height: 464px; }
  }
</style>
