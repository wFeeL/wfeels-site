---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { TELEGRAM_URL } from '../lib/contacts';
---
<Base title="Заявка отправлена — wfeels" description="Заявка получена." noindex={true} nofollow={true}>
  <Container>
    <Section label="Контакт">
      <h1 class="t-h1" data-short-page>Заявка ушла</h1>
      <p class="t-body-lg lead">Отвечу в течение дня.</p>
      <!-- Запасной канал был дан тому, у кого отправка не получилась, и не дан
           тому, у кого получилась. Адрес тот же, что в сообщении об ошибке. -->
      <!-- Ссылка стоит на той же строке намеренно: перенос строки перед тегом
           компилятор Astro съедает вместе с пробелом, и выходит «напрямую:Telegram». -->
      <p class="fallback">Если за сутки ответа не будет — напишите напрямую: <a href={TELEGRAM_URL}>Telegram</a></p>
      <Button href="/" variant="secondary">На главную</Button>
    </Section>
  </Container>
</Base>

<style>
  /* Ритм по шкале отступов 24/32/48: до правки заголовок, строка и кнопка
     стояли слипшимися блоком. */
  .lead { margin: 24px 0 0; }
  .fallback {
    margin: 24px 0 32px;
    /* Было 15 px — самовольный кегль, вне шкалы. Запасной путь — второстепенная
       строка под ведущим `body-lg`, ступень `small` (14 px), правка
       2026-08-13, свод к семи объявленным. */
    font-size: 1rem;
    color: var(--text-muted);
  }
  .fallback a {
    color: var(--accent);
    text-decoration-line: underline;
  }

  /* Б-3 (решение исполнителя, обоснование и разбор дефекта первого захода —
     `pages/404.astro`, тот же приём дословно): на высоких мониторах тело
     `/thanks` стояло прижатым к верху, подвал — к низу, между ними пустой
     фон. Маркер `data-short-page` — на уже существующем `h1`, без новой
     обёртки; авто-поля — на `.container`, не `justify-content: center`. */
  :global(main:has([data-short-page])) {
    display: flex;
    flex-direction: column;
  }
  :global(main:has([data-short-page]) > .container) {
    margin-block: auto;
  }
</style>
