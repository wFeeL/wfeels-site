---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import LangSwitch from '../components/LangSwitch.astro';
import Prose from '../components/Prose.astro';
import DraftNotice from '../components/DraftNotice.astro';

const SECTIONS = [
  'Общие положения',
  'Сведения об исполнителе',
  'Услуги и правила их оказания',
  'Порядок заключения договора',
  'Порядок оказания услуг и передачи результата',
  'Оплата',
  'Отказ от услуги и возврат средств',
  'Гарантии и претензии',
  'Интеллектуальные права',
  'Персональные данные',
  'Заключительные положения',
];
---
<Base title="Пользовательское соглашение — wfeels"
      description="Условия оказания услуг."
      noindex={true}>
  <LangSwitch slot="lang" />
  <Container>
    <Section>
      <DraftNotice>
        Черновик. Документ не действует, пока в нем не проставлены реальные
        реквизиты исполнителя. Страница закрыта от индексации.
      </DraftNotice>
      <h1 class="t-h1">Пользовательское соглашение</h1>
      <Prose>
        {SECTIONS.map((s, i) => (
          <>
            <h2>{i + 1}. {s}</h2>
            <p>Текст раздела заполняется владельцем.</p>
          </>
        ))}
      </Prose>
    </Section>
  </Container>
</Base>
