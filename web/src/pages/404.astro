---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ShortPageGrid from '../components/ShortPageGrid.astro';
import ShortPageSections from '../components/ShortPageSections.astro';
import { dict } from '../i18n/locales';

/* Рычаг С-3 (`09-footer-brief.md`, раздел 7.5): `siteTagline` ушёл из
 * подвала и выводится ровно на одной странице сайта — здесь. Строка берётся
 * из общего словаря, а не дублируется литералом: у неё уже есть канонический
 * источник (`i18n/ru.ts`), и второй текст-двойник здесь же снова развёл бы
 * их при следующей правке. */
const t = dict('ru');

/* ПРАВКА 2026-08-28 (`70-workshop/specs/site-v3/13-short-pages-brief.md`,
 * раздел 4, вариант A «Указатель», D-129): вторая кнопка тела «Написать»
 * снята (раздел 2.2 брифа — три маршрута к одной двери в одном кадре, лишний
 * снимается везде, а не только здесь), а справа встаёт список разделов сайта
 * (`ShortPageSections`) — главное действие страницы вместо кнопки. Полоса
 * действия подвала на `/404` снята той же правкой (`lib/nav.ts`,
 * `showFooterCta`, второй признак `nofollow`) — без этого раскладка ниже
 * возвращает полосу прокрутки на 1440×900 (раздел 4.0 брифа: «раскладка и
 * подавление полосы едут одной правкой, а не двумя»). */
---
<Base title="Страница не найдена — wfeels"
      description="Такой страницы нет."
      noindex={true}
      nofollow={true}>
  <Container>
    <Section label="404">
      <ShortPageGrid>
        <Fragment slot="main">
          <h1 class="t-h1" data-short-page>Такой страницы нет</h1>
          <p class="lead t-body-lg">
            Возможно, адрес набран с опечаткой или страница переехала.
          </p>
          <p class="tagline t-body">{t.siteTagline}</p>
          <div class="ways">
            <Button href="/" variant="secondary">На главную</Button>
          </div>
        </Fragment>
        <Fragment slot="aside">
          <ShortPageSections lang="ru" />
        </Fragment>
      </ShortPageGrid>
    </Section>
  </Container>
</Base>

<style>
  /* Находка 5 дизайн-ревью 2026-08-22: `h1` (60 px, line-height 1.1) и абзац
     ничем не разведены — `base.css` ставит на заголовки `margin: 0`, а у
     `.t-body-lg` своего отступа нет, и Tailwind обнуляет отступ `<p>` по
     умолчанию. Замер до правки: зазор между строками — 0 px, выносные
     буквы заголовка почти касаются текста. 16px — шаг шкалы отступов
     компонента (тот же, что у `.ways` ниже), не число «чтобы прошло». */
  .lead { margin-top: 16px; }
  /* Рычаг С-3: та же строка, что раньше стояла в подвале, теперь единственный
     раз — здесь, приглушённым тоном прозы, а не второй репликой призыва к
     действию. З-1 (2026-08-26, `09-footer-brief.md`, раздел 15.1): узел
     переставлен под `.lead` и до `.ways` — раздел 7.5 требует именно этот
     порядок чтения. */
  .tagline { margin-top: 16px; color: var(--text-muted); }
  /* Кнопка «На главную» была `primary` вместе с кнопкой «Обсудить задачу» в
     шапке (шапка её не прячет на 404 — `lib/nav.ts`, `showHeaderCta`): два
     одинаковых акцентных CTA в одном кадре, правило «одна главная кнопка на
     вид» нарушено. Обе кнопки тела теперь `secondary` — единственный
     акцентный призыв на экране остаётся в шапке. Обёртка `.ways` остаётся,
     хотя после снятия «Написать» несёт один элемент (раздел 4.3 брифа
     `13-short-pages-brief.md`): она несёт `margin-top`, вторую кнопку
     раскладка не потеряла, она просто больше не нужна (раздел 2.2). */
  .ways { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }

  /* Б-3 (решение исполнителя захода 2026-08-26, обоснование — отчёт того
     дня). На высоких мониторах тело страницы стояло прижатым к верху окна, а
     подвал — к низу: между ними голый фон. Причина — `main` в `base.css`
     остаётся ОБЫЧНЫМ блоком (`display` не задан, растёт `flex: 1 0 auto`
     внутри `body`), и единственный блочный потомок в нём ложится сверху, а
     не в центр коробки.

     `main` не трогается: `base.css` вне области этой правки. Переключатель —
     ЧЕРЕЗ `:has()` (приём уже есть в проекте, `base.css:199`), адресный ровно
     к страницам, несущим маркер `[data-short-page]`.

     Маркер — атрибут на уже существующем `<h1>`, без единого нового узла
     разметки между `main` и `.container`: `base.css` сокращает верхний
     отступ первой секции страницы правилом
     `main > *:first-child > section:first-child` — ровно один уровень
     обёртки (`Container`), и вторая обёртка однажды уже увела селектор мимо
     цели (`50-code/CLAUDE.md`, ловушка 8). Структура
     `main → .container → section` не меняется ни на один узел. */
  :global(main:has([data-short-page])) {
    display: flex;
    flex-direction: column;
  }

  /* ПРАВКА 2026-08-28 (раздел 4.5 брифа `13-short-pages-brief.md`):
     `margin-block: auto` (симметричные авто-поля, делившие свободное место
     пополам без предела — механика самой претензии владельца, раздел 1.3
     брифа, факт 1) заменяется на `margin-block: 0 auto` с потолком у
     верхнего поля. До высоты окна 900 блок стоит от шапки на собственном
     поле секции (верхнее поле — 0, всю работу делает `padding-top` секции
     ниже); выше 900 верх уходит вниз со скоростью половины прироста окна, но
     не дальше 160px (две ступени шкалы отступов, 128+32) — остаток уходит
     под блок через `margin-block-end: auto`, унаследованный от `auto` в
     сокращённом свойстве. Правило заперто за `min-width: 1100`: ниже этого
     порога содержимое выше окна (раскладка одноколоночная, список
     разделов ниже кнопки), и положительное верхнее поле только удлинило бы
     страницу. */
  :global(main:has([data-short-page]) > .container) {
    margin-block: 0 auto;
  }
  @media (min-width: 1100px) {
    :global(main:has([data-short-page]) > .container) {
      margin-block-start: clamp(0px, calc((100dvh - 900px) * 0.5), 160px);
    }
  }

  /* Поля секции (раздел 4.5 брифа): два бакета вместо тройной ступени
     `Section.astro` (48/64/96 по 480/900) — нижнее поле уменьшено на ступень
     шкалы отступов, освобождая место для списка разделов без возврата
     полосы прокрутки на 1440×900 (раздел 1.3 брифа, факт 2: запас там был
     1px). Селектор адресует именно секцию — прямого потомка `.container`
     внутри помеченного `main`, тем же путём `main → .container → section`,
     которым уже идёт правило выше; специфичность длиннее, чем у собственных
     правил `Section.astro`, поэтому побеждает без `!important`. */
  :global(main:has([data-short-page]) > .container > section) {
    padding-block: 32px 48px;
  }
  @media (min-width: 1100px) {
    :global(main:has([data-short-page]) > .container > section) {
      padding-block: 48px 64px;
    }
  }
</style>
