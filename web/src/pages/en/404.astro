---
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import ShortPageGrid from '../../components/ShortPageGrid.astro';
import ShortPageSections from '../../components/ShortPageSections.astro';
import { dict } from '../../i18n/locales';

/* Английский двойник `/404`, построен 2026-08-26. Как и русская страница,
 * это обычная страница по своему адресу (`/en/404`, отвечает 200) — она не
 * подменяет собой обработку настоящих ошибок 404 на непредвиденных адресах
 * под `/en/*`: это забота раздачи (сервера/CDN), а не отдельного файла в
 * этой директории Astro. */
const t = dict('en');

/* ПРАВКА 2026-08-28 — вариант A «Указатель», тот же приём, что у русской
 * `pages/404.astro`, обоснование там же. */
---
<Base title="Page Not Found — wfeels"
      description="This page doesn't exist."
      noindex={true}
      nofollow={true}>
  <Container>
    <Section label="404">
      <ShortPageGrid>
        <Fragment slot="main">
          <h1 class="t-h1" data-short-page>This page doesn't exist</h1>
          <p class="lead t-body-lg">
            The address may be mistyped, or the page may have moved.
          </p>
          <p class="tagline t-body">{t.siteTagline}</p>
          <div class="ways">
            <Button href="/en" variant="secondary">Home</Button>
          </div>
        </Fragment>
        <Fragment slot="aside">
          <ShortPageSections lang="en" />
        </Fragment>
      </ShortPageGrid>
    </Section>
  </Container>
</Base>

<style>
  /* Тот же ритм, что у русской страницы (`pages/404.astro`) — разбор там же. */
  .lead { margin-top: 16px; }
  .tagline { margin-top: 16px; color: var(--text-muted); }
  .ways { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }

  :global(main:has([data-short-page])) {
    display: flex;
    flex-direction: column;
  }
  :global(main:has([data-short-page]) > .container) {
    margin-block: 0 auto;
  }
  @media (min-width: 1100px) {
    :global(main:has([data-short-page]) > .container) {
      margin-block-start: clamp(0px, calc((100dvh - 900px) * 0.5), 160px);
    }
  }
  :global(main:has([data-short-page]) > .container > section) {
    padding-block: 32px 48px;
  }
  @media (min-width: 1100px) {
    :global(main:has([data-short-page]) > .container > section) {
      padding-block: 48px 64px;
    }
  }
</style>
