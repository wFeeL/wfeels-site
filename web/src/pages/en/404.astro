---
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import { dict } from '../../i18n/locales';

/* Английский двойник `/404`, построен 2026-08-26. Как и русская страница,
 * это обычная страница по своему адресу (`/en/404`, отвечает 200) — она не
 * подменяет собой обработку настоящих ошибок 404 на непредвиденных адресах
 * под `/en/*`: это забота раздачи (сервера/CDN), а не отдельного файла в
 * этой директории Astro. */
const t = dict('en');
---
<Base title="Page Not Found — wfeels"
      description="This page doesn't exist."
      noindex={true}
      nofollow={true}>
  <div class="short-page">
    <Container>
      <Section label="404">
        <h1 class="t-h1">This page doesn't exist</h1>
        <p class="lead t-body-lg">
          The address may be mistyped, or the page may have moved.
        </p>
        <p class="tagline t-body">{t.siteTagline}</p>
        <div class="ways">
          <Button href="/en" variant="secondary">Home</Button>
          <Button href="/en#contact" variant="secondary">Get in touch</Button>
        </div>
      </Section>
    </Container>
  </div>
</Base>

<style>
  /* Тот же ритм, что у русской страницы (`pages/404.astro`), включая правку
     П-8 (2026-08-26) и перестановку узла З-1 (2026-08-26, `09-footer-brief.md`,
     раздел 15.1): `.tagline` — под `.lead`, до `.ways`, с тем же обменом чисел
     16px/12px (сумма отступов не меняется), переполнение при 1440×900 то же
     самое (текст и разметка идентичны). */
  .lead { margin-top: 16px; }
  .tagline { margin-top: 16px; color: var(--text-muted); }
  .ways { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }

  /* Б-3 — тот же приём, что у русской `pages/404.astro`, обоснование там же.
     `.short-page` даёт `main` переключатель `:has()` на центрирование по
     вертикали ТОЛЬКО на этой странице; на узких экранах авто-поля
     схлопываются в 0 и ничего не меняют. */
  :global(main:has(.short-page)) {
    display: flex;
    flex-direction: column;
  }
  .short-page { margin-block: auto; }
</style>
