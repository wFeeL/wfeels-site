---
/* Тонкий каталог `/services` — спека `70-workshop/specs/site-v3/
 * 08-service-pages.md`, раздел 5. Сетка плиток по строке текста на
 * каждую, без прозы ([[00-overview]], раздел 3): единственный вводный
 * текст страницы — заголовок `<h1>`, дальше сразу плитки.
 *
 * Цель каталога — довести до нужной посадочной за один клик; собственной
 * формы у него нет (раздел 1). */
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import Card from '../../components/Card.astro';
import Label from '../../components/Label.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { priceEntry } from '../../lib/priceLookup';
import { collectionPageSchema } from '../../lib/schema';
import { SERVICE_GROUPS } from '../../data/services';
import { servicePage } from '../../data/servicePages';

const TITLE = 'Веб-разработка и автоматизация — услуги и цены | wfeels';
const DESCRIPTION = 'Сайты под ключ, Telegram-боты и Mini Apps, интеграции, backend и ИИ-консультанты. Ориентиры цены и срока по каждой услуге.';
// Было «Разработка сайтов» — называло одну из четырёх групп каталога
// («Автоматизация и интеграции», «ИИ», «Telegram» — остальные три), хотя
// крошки и меню уже говорят «Услуги». Спека `70-workshop/specs/site-v3/
// 08-service-pages.md`, §3, требует дословно `<h1>Услуги</h1>`; правка
// 2026-08-26 возвращает по спеке. `<title>`/`description` не тронуты — они
// работают на поиск, и там более развёрнутая формулировка уместна.
const H1 = 'Услуги';
const site = Astro.site!.toString().replace(/\/$/, '');
const catalogSchema = collectionPageSchema({
  site,
  canonical: `${site}/services`,
  title: TITLE,
  description: DESCRIPTION,
  lang: 'ru',
}, SERVICE_GROUPS.flatMap((group) => group.links.map((link) => ({
  name: link.text,
  url: `${site}${link.href}`,
}))));
---
<Base
  title={TITLE}
  description={DESCRIPTION}
  structuredData={catalogSchema}
  line={false}
>
  <Container>
    <div class="crumbs">
      <Breadcrumbs items={[{ text: 'Главная', href: '/' }, { text: 'Услуги' }]} />
    </div>

    <h1 class="t-h1">{H1}</h1>

    {SERVICE_GROUPS.map((group) => (
      <div class="group">
        <Label as="h2">{group.title}</Label>
        <div class="grid">
          {group.links.map((link) => {
            const page = servicePage(
              // Хвост адреса совпадает со slug записи — петля с главной
              // замкнута тестом `servicePages.test.ts`.
              link.href.replace('/services/', ''),
            );
            const price = priceEntry(page.heroTier.group, page.heroTier.entry).price;
            return (
              <Card href={link.href} stack={true}>
                <h3 class="t-h3">{link.text}</h3>
                <p class="tile-line t-small">{page.catalogLine}</p>
                <p class="meta">
                  {page.heroPricePrefix && <span class="prefix">{page.heroPricePrefix}</span>}
                  <code>{price}</code>
                  <span class="sep" aria-hidden="true">·</span>
                  <span>{page.term}</span>
                </p>
              </Card>
            );
          })}
        </div>
      </div>
    ))}

    <p class="more t-body">
      Не нашли свою задачу — <a href="/contact">расскажите о ней</a>
    </p>
  </Container>
</Base>

<style>
  .crumbs { padding-top: 24px; }
  h1 { margin: 24px 0 48px; }

  .group + .group { margin-top: 48px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .tile-line { margin: 8px 0 0; color: var(--text-muted); }

  .meta {
    margin: auto 0 0;
    padding-top: 16px;
    display: flex;
    /* Дефект W4, design-ревью: на 375 px «от 15 000 ₽» рвалось на три строки
       («от 15 / 000 / ₽») — цена ломалась между разрядами тысяч. Цена сама
       не переносится (`white-space: nowrap` на `code` ниже); когда всей
       строке «от · цена · срок» не хватает ширины, в свою строку уходит
       срок — самый длинный и наименее хрупкий кусок строки, а не число. */
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    font: 500 0.875rem/1.4 var(--font-mono);
    color: var(--text-muted);
  }
  .prefix { font-size: 0.75rem; }
  .meta code {
    font: 700 1rem/1.3 var(--font-mono);
    color: var(--accent);
    background: none;
    padding: 0;
    white-space: nowrap;
  }
  .sep { color: var(--text-faint); }

  /* Ссылка в прозе — подчёркнута всегда (D-055), это не кнопка. */
  .more { margin-top: 64px; }
  .more a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
