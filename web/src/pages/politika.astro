---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import LangSwitch from '../components/LangSwitch.astro';

/* Семь фактов, без которых политика будет неправдой. Записаны здесь, рядом с
   местом, где владелец будет писать текст, потому что к тому моменту их легко
   забыть. Это факты о том, как работает код, а не юридический текст.

   1. При ненастроенном Telegram отправитель заявок пишет ТЕКСТ ЗАЯВКИ в журнал
      сервера — имя и способ связи посетителя открытой строкой (api/app/telegram.py).
      Это осознанный запасной путь: потерять заявку хуже, чем записать её в
      журнал. Но раздел «Способы и условия обработки» и раздел «Сроки обработки
      и хранения» обязаны упоминать журналы сервера.
   2. Заявка уходит в Telegram, то есть данные покидают инфраструктуру владельца
      и попадают к третьему лицу. Раздел «Передача третьим лицам» обязан это
      называть.
   3. Telegram — иностранное лицо, и вместе с заявкой данные уходят за пределы
      страны. Это отдельная обязанность оператора, а не частный случай передачи
      третьим лицам, поэтому ниже заведён отдельный раздел «Трансграничная
      передача данных»: без него политика умолчит о том, что происходит с каждой
      заявкой.
   4. Счётчик частоты берёт IP-адрес посетителя — при `trust_proxy` из заголовка
      `x-forwarded-for`, иначе адрес соединения (api/app/main.py, `client_ip`) —
      и держит его в памяти процесса в скользящем окне на час
      (api/app/ratelimit.py, окно 3600 секунд). Это обработка персональных данных
      ради защиты от спама: IP-адрес обязан быть назван в перечне данных, цель —
      в целях, час и сброс при перезапуске — в сроках.
   5. Форма собирает пять полей: имя, контакт, сообщение, бюджет, страница
      отправки (api/app/schemas.py, `LeadIn`). Перечень обязан называть их как
      есть. «Сообщение» и «бюджет» — свободный текст: посетитель может вписать
      туда данные третьих лиц и собственные коммерческие сведения, и политика не
      должна делать вид, что там только имя и телефон.
   6. Срок хранения журналов задан не сроком, а ротацией по размеру в настройках
      стенда: `max-size: 10m`, `max-file: 3` (deploy/docker-compose.yml). Сколько
      это дней — зависит от трафика. Раздел о сроках не должен обещать срок,
      которого механизм не обеспечивает.
   7. Cookie сайт не ставит, веб-аналитики нет. Единственное, что пишется на
      стороне посетителя, — ключ `theme` в локальном хранилище браузера от
      переключателя темы (components/ThemeToggle.astro, layouts/Base.astro).
      Правдивая формулировка — именно такая, а не «мы не используем cookie»
      без упоминания хранилища. */

const SECTIONS = [
  'Общие положения',
  'Оператор персональных данных',
  'Цели обработки',
  'Категории субъектов и перечень данных',
  'Правовые основания',
  'Способы и условия обработки',
  'Передача третьим лицам',
  'Трансграничная передача данных',
  'Сроки обработки и хранения',
  'Файлы cookie и локальное хранилище браузера',
  'Права субъектов',
  'Меры защиты',
  'Контакты оператора',
  'Изменения политики',
];
---
<Base title="Политика конфиденциальности — wfeels"
      description="Политика обработки персональных данных."
      noindex={true}>
  <LangSwitch slot="lang" />
  <Container>
    <Section>
      <p class="draft" data-draft-notice>
        Черновик. Документ не действует, пока в нём не проставлены реальные
        реквизиты оператора. Страница закрыта от индексации.
      </p>
      <h1 class="t-h1">Политика конфиденциальности</h1>
      {SECTIONS.map((s, i) => (
        <>
          <h2 class="t-h3">{i + 1}. {s}</h2>
          <p class="t-body">Текст раздела заполняется владельцем.</p>
        </>
      ))}
    </Section>
  </Container>
</Base>

<style>
  .draft {
    border: 1px solid var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    font-size: 0.875rem;
    margin-bottom: 32px;
  }
</style>
