---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import LangSwitch from '../components/LangSwitch.astro';

/* Два факта, без которых политика будет неправдой. Записаны здесь, рядом с
   местом, где владелец будет писать текст, потому что к тому моменту их легко
   забыть:

   1. При ненастроенном Telegram отправитель заявок пишет ТЕКСТ ЗАЯВКИ в журнал
      сервера — имя и способ связи посетителя открытой строкой (api/app/telegram.py).
      Это осознанный запасной путь: потерять заявку хуже, чем записать её в
      журнал. Но раздел «Способы и условия обработки» и раздел «Сроки обработки
      и хранения» обязаны упоминать журналы сервера.
   2. Заявка уходит в Telegram, то есть данные покидают инфраструктуру владельца
      и попадают к третьему лицу. Раздел «Передача третьим лицам» обязан это
      называть. */

const SECTIONS = [
  'Общие положения',
  'Оператор персональных данных',
  'Цели обработки',
  'Категории субъектов и перечень данных',
  'Правовые основания',
  'Способы и условия обработки',
  'Передача третьим лицам',
  'Сроки обработки и хранения',
  'Файлы cookie и веб-аналитика',
  'Права субъектов',
  'Меры защиты',
  'Контакты оператора',
  'Изменения политики',
];
---
<Base title="Политика конфиденциальности — wfeels"
      description="Политика обработки персональных данных."
      noindex={true}>
  <LangSwitch slot="lang" />
  <Container>
    <Section>
      <p class="draft" data-draft-notice>
        Черновик. Документ не действует, пока в нём не проставлены реальные
        реквизиты оператора. Страница закрыта от индексации.
      </p>
      <h1 class="t-h1">Политика конфиденциальности</h1>
      {SECTIONS.map((s, i) => (
        <>
          <h2 class="t-h3">{i + 1}. {s}</h2>
          <p class="t-body">Текст раздела заполняется владельцем.</p>
        </>
      ))}
    </Section>
  </Container>
</Base>

<style>
  .draft {
    border: 1px solid var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    font-size: 0.875rem;
    margin-bottom: 32px;
  }
</style>
