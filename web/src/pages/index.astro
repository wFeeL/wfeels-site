---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { HOME_SECTIONS } from '../lib/sections';
---
<Base
  title="wfeels — сайты и автоматизация"
  description="Сайты, интеграции и ИИ для малого бизнеса."
  schema="website"
  rail={true}
>
  {/* `rail` включает рельс-скроллспай (`Rail.astro`, рисует его сам
      `Base.astro` вне `<main>`) и переводит полосу прогресса в шапке в режим
      «только ниже 1100 px» (`Header.astro` → `ReadingProgress` `mobileOnly`).
      Состояние «ни рельса, ни полосы» невозможно ни при какой ширине: два
      элемента разведены общей точкой перелома 1100 px из `tokens.css`, а не
      двумя независимо подобранными числами. */}
  <LangSwitch slot="lang" />
  {/* Одиннадцать секций собираются из `lib/sections.ts` — единственного
      списка, который читают также шапка и (с задачи 4) рельс. Перечислять
      секции здесь руками нельзя: список путей в этом репозитории уже дважды
      расходился именно так.

      Секции сейчас пустые: заголовок-заглушка и якорь. Настоящий текст
      приходит отдельным проходом с владельцем (задача 1 плана) и заменяет
      заглушку секция за секцией в задачах 5–13; вёрстка по рыбе с
      последующей заменой запрещена, поэтому до этого момента здесь нет
      ничего похожего на маркетинговую копию — только структура. */}
  <Container>
    {HOME_SECTIONS.map((s) => (
      <Section id={s.id}>
        {s.order === 1
          ? <h1 class="t-display">{s.title}</h1>
          : <h2 class="t-h2">{s.title}</h2>}
      </Section>
    ))}
  </Container>
</Base>
