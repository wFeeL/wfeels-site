---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { HOME_SECTIONS } from '../lib/sections';
import Hero from '../components/home/Hero.astro';
import Pain from '../components/home/Pain.astro';
import Services from '../components/home/Services.astro';
import Pricing from '../components/home/Pricing.astro';
import Cases from '../components/home/Cases.astro';
import Proof from '../components/home/Proof.astro';
import Process from '../components/home/Process.astro';
import Guarantees from '../components/home/Guarantees.astro';
import About from '../components/home/About.astro';
import Faq from '../components/home/Faq.astro';
import Contact from '../components/home/Contact.astro';

/** Секции с настоящим текстом (план `02-home-plan.md`, задачи 5–13). Читает
 *  отсюда цикл ниже вместо `if`-цепочки в разметке — второй список секций
 *  здесь не заводится: и этот, и заглушка ниже используют один и тот же `id`
 *  из `lib/sections.ts`. */
const HOME_COMPONENTS: Partial<Record<string, typeof Hero>> = {
  hero: Hero,
  pain: Pain,
  services: Services,
  pricing: Pricing,
  cases: Cases,
  proof: Proof,
  process: Process,
  guarantees: Guarantees,
  about: About,
  faq: Faq,
  contact: Contact,
};
---
<Base
  title="wfeels — сайты и автоматизация"
  description="Сайты, интеграции и ИИ для малого бизнеса."
  schema="website"
  rail={true}
  line={true}
>
  {/* `rail` включает рельс-скроллспай (`Rail.astro`, рисует его сам
      `Base.astro` вне `<main>`) и переводит полосу прогресса в шапке в режим
      «только ниже 1244 px» (`Header.astro` → `ReadingProgress` `mobileOnly`).
      Состояние «ни рельса, ни полосы» невозможно ни при какой ширине: два
      элемента разведены общей точкой перелома 1244 px из `tokens.css`, а не
      двумя независимо подобранными числами. */}
  <LangSwitch slot="lang" />
  {/* Одиннадцать секций собираются из `lib/sections.ts` — единственного
      списка, который читают также шапка и (с задачи 4) рельс. Перечислять
      секции здесь руками нельзя: список путей в этом репозитории уже дважды
      расходился именно так.

      Все одиннадцать секций несут настоящий текст, утверждённый владельцем
      (`70-workshop/specs/site-v3/02-texts.md`) и свёрстанный своим
      компонентом (`components/home/*`, `HOME_COMPONENTS` выше). Заглушка
      ниже (`s.title`) остаётся только страховкой на случай, если якорь
      появится в `lib/sections.ts` раньше своего компонента. */}
  <Container>
    {HOME_SECTIONS.map((s) => {
      const Content = HOME_COMPONENTS[s.id];
      return (
        <Section id={s.id}>
          {Content ? (
            <Content />
          ) : s.order === 1 ? (
            <h1 class="t-display">{s.title}</h1>
          ) : (
            <h2 class="t-h2">{s.title}</h2>
          )}
        </Section>
      );
    })}
  </Container>
</Base>
