---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import LangSwitch from '../components/LangSwitch.astro';
---
<Base
  title="wfeels — сайты и автоматизация"
  description="Сайты, интеграции и ИИ для малого бизнеса."
  progress={false}
  schema="website"
>
  <LangSwitch slot="lang" />
  {/* Секция, а не голая пара «метка + заголовок» в контейнере: отступы страницы
      задаёт `Section`, и главная, писавшая разметку мимо него, не получала
      верхнего отступа вовсе — метка стояла вплотную к шапке. */}
  <Container>
    <Section label="Сайты и автоматизация">
      <h1 class="t-display">wfeels</h1>
    </Section>
  </Container>
</Base>
