---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { HOME_SECTIONS } from '../lib/sections';
import HomeSection from '../components/home/HomeSection.astro';
import MobileCtaBar from '../components/home/MobileCtaBar.astro';
import Hero from '../components/home/Hero.astro';
import Pain from '../components/home/Pain.astro';
import Services from '../components/home/Services.astro';
import Pricing from '../components/home/Pricing.astro';
import Cases from '../components/home/Cases.astro';
import Process from '../components/home/Process.astro';
import Guarantees from '../components/home/Guarantees.astro';
import About from '../components/home/About.astro';
import Faq from '../components/home/Faq.astro';
import Contact from '../components/home/Contact.astro';

/** Секции с настоящим текстом (план `02-home-plan.md`, задачи 5–13). Читает
 *  отсюда цикл ниже вместо `if`-цепочки в разметке — второй список секций
 *  здесь не заводится: и этот, и заглушка ниже используют один и тот же `id`
 *  из `lib/sections.ts`. */
const HOME_COMPONENTS: Partial<Record<string, typeof Hero>> = {
  hero: Hero,
  pain: Pain,
  services: Services,
  pricing: Pricing,
  cases: Cases,
  process: Process,
  guarantees: Guarantees,
  about: About,
  faq: Faq,
  contact: Contact,
};

/** Ритм «Три акта» (правка владельца 2026-08-13): проблема («Как обычно
 *  бывает») → предложение (услуги, цены, кейсы) → доверие (процесс,
 *  гарантии, обо мне, вопросы). Первый экран и контакт — вход и выход, вне
 *  актов буквально: у `hero` и `contact` в этой таблице нет ни одной записи,
 *  оба края (шапка→hero, hero→pain через дефолт `pain`, faq→contact,
 *  contact→подвал) сохраняют старое симметричное поведение `Section`
 *  (48/64/96, плюс отдельное правило `main > section:first-child` из
 *  `base.css` для самой первой секции страницы) — их этот заход не трогает.
 *
 *  Каждая ВНУТРИ-актовая секция отдаёт зазор своему верху (`topGap`), низ
 *  гасится в `'none'`, чтобы 128/96 не удваивались соседним верхом — см.
 *  комментарий в `Section.astro`. Ровно два края держит `bottomGap:'none'`
 *  на `pain` — акт 1 состоит из одной секции, и её единственный ВНУТРИ-
 *  актовый край это переход в акт 2, к «Услугам».
 *
 *  `surface` — три подложки, не подряд и не там, где уже стоят карточки на
 *  `--surface` (услуги, цены, кейсы, гарантии — увидела бы себя внутри
 *  подложки того же цвета и растворилась): «Как обычно бывает» отмечает
 *  первый акт, «Как я работаю» и «Частые вопросы» — третий. */
const GAP: Record<string, { topGap?: 'interior' | 'stitch'; bottomGap?: 'none'; surface?: boolean }> = {
  pain: { bottomGap: 'none', surface: true },
  services: { topGap: 'stitch', bottomGap: 'none' },
  pricing: { topGap: 'interior', bottomGap: 'none' },
  cases: { topGap: 'interior', bottomGap: 'none' },
  process: { topGap: 'stitch', bottomGap: 'none', surface: true },
  guarantees: { topGap: 'interior', bottomGap: 'none' },
  about: { topGap: 'interior', bottomGap: 'none' },
  faq: { topGap: 'interior', surface: true },
};
---
<Base
  title="wfeels — сайты и автоматизация"
  description="Сайты, интеграции и ИИ для малого бизнеса."
  schema="website"
  rail={true}
  line={true}
>
  {/* `rail` включает рельс-скроллспай (`Rail.astro`, рисует его сам
      `Base.astro` вне `<main>`) и переводит полосу прогресса в шапке в режим
      «только ниже 1324 px» (`Header.astro` → `ReadingProgress` `mobileOnly`).
      Состояние «ни рельса, ни полосы» невозможно ни при какой ширине: два
      элемента разведены общей точкой перелома 1324 px из `tokens.css`, а не
      двумя независимо подобранными числами. */}
  <LangSwitch slot="lang" />
  {/* Десять секций собираются из `lib/sections.ts` — единственного
      списка, который читают также шапка и рельс. Перечислять секции здесь
      руками нельзя: список путей в этом репозитории уже дважды расходился
      именно так.

      Все десять секций несут настоящий текст, утверждённый владельцем
      (`70-workshop/specs/site-v3/02-texts.md`) и свёрстанный своим
      компонентом (`components/home/*`, `HOME_COMPONENTS` выше). Заглушка
      ниже (`s.title`) остаётся только страховкой на случай, если якорь
      появится в `lib/sections.ts` раньше своего компонента. */}
  <Container>
    {HOME_SECTIONS.filter((s) => s.id === 'hero').map((s) => {
      const gap = GAP[s.id] ?? {};
      return (
        <HomeSection
          id={s.id} order={s.order} title={s.title}
          topGap={gap.topGap} bottomGap={gap.bottomGap} surface={gap.surface}
          Content={HOME_COMPONENTS[s.id]}
        />
      );
    })}

    {/* Диапазон липкой мобильной CTA-панели (`MobileCtaBar.astro`, дизайн-
        ревью 2026-08-13, часть 1) — акты 2 и 3 главной, Pain → Faq,
        физически обёрнуты в один `<div>`: панель внутри него — липкий якорь
        нулевой высоты, чей «коридор» прилипания ограничен именно границами
        этого `<div>` (подробный разбор — в самом компоненте). Герой и
        Контакт — оба края диапазона, вне обёртки: герой — потому что панель
        не должна быть видна поверх первого экрана, контакт — потому что
        панель обязана исчезнуть до того, как поля формы окажутся на
        экране. */}
    <div class="mobile-cta-range">
      <MobileCtaBar />
      {HOME_SECTIONS.filter((s) => s.id !== 'hero' && s.id !== 'contact').map((s) => {
        const gap = GAP[s.id] ?? {};
        return (
          <HomeSection
            id={s.id} order={s.order} title={s.title}
            topGap={gap.topGap} bottomGap={gap.bottomGap} surface={gap.surface}
            Content={HOME_COMPONENTS[s.id]}
          />
        );
      })}
    </div>

    {HOME_SECTIONS.filter((s) => s.id === 'contact').map((s) => {
      const gap = GAP[s.id] ?? {};
      return (
        <HomeSection
          id={s.id} order={s.order} title={s.title}
          topGap={gap.topGap} bottomGap={gap.bottomGap} surface={gap.surface}
          Content={HOME_COMPONENTS[s.id]}
        />
      );
    })}
  </Container>
</Base>

<style>
  /* Система отсчёта для `.mobile-cta-clip` (`MobileCtaBar.astro`,
     `position: absolute; inset: 0`) — сам диапазон вне потока не выходит:
     `position: relative` без смещений не двигает ни сам диапазон, ни ритм
     секций внутри него ни на пиксель, он только даёт обрезающему слою верную
     точку отсчёта по высоте (высоту диапазону задают сами секции — Pain →
     Faq, обычные потоковые дети). */
  .mobile-cta-range {
    position: relative;
  }
</style>
