SITE_DOMAIN=wfeels.site
SITE_URL=https://wfeels.site
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Необязательный HTTP(S)-прокси только для Telegram Bot API.
# Если логин или пароль содержит @, :, /, # или %, закодируй их как URL percent-encoding.
TELEGRAM_PROXY_URL=
RATE_LIMIT_PER_HOUR=5
MIN_FILL_SECONDS=2
TRUST_PROXY=true
LEADS_DB_PATH=/data/leads.sqlite3
LEAD_RETENTION_DAYS=90
CONSENT_RECEIPT_RETENTION_DAYS=1095
# В самом закрытом Telegram-чате дополнительно включается auto-delete «1 день».
TELEGRAM_RETENTION_HOURS=23
TELEGRAM_RETRY_MINUTES=15
MAINTENANCE_INTERVAL_SECONDS=300
BACKUP_DIRECTORY=/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
CONSENT_VERSION=1.2-2026-08-24
PRIVACY_VERSION=1.2-2026-08-24
